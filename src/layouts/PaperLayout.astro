---
/**
 * PaperLayout — the broadsheet chrome for every public page.
 *
 * Deliberately light: self-hosted fonts, one stylesheet, the ear, the
 * masthead, the footer. No Tailwind, no Google Fonts, no third-party
 * scripts on the public paper. The Lounge app keeps BaseLayout.
 */
import "../styles/paper.css";
import Ear from "../components/paper/Ear.astro";
import Masthead from "../components/paper/Masthead.astro";
import PaperFooter from "../components/paper/PaperFooter.astro";

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative OG image. */
  image?: string;
  canonicalURL?: string;
  noIndex?: boolean;
  /** Which nav item is underlined. */
  section?: "front" | "markets" | "finder" | "magazine" | "accessories" | "diary" | "lounge" | "shop" | "none";
  /** Small masthead for inner pages. */
  compact?: boolean;
  /** Hide the price ticker (e.g. legal pages). */
  noEar?: boolean;
  /** JSON-LD graph, already an object. */
  jsonLd?: unknown;
  ogType?: "website" | "article" | "product";
  /** Extra <link rel="alternate">, etc. */
  published?: string;
  modified?: string;
}

const {
  title,
  description,
  image = "/og-default.svg",
  canonicalURL = new URL(Astro.url.pathname, Astro.site).toString(),
  noIndex = false,
  section = "none",
  compact = false,
  noEar = false,
  jsonLd,
  ogType = "website",
  published,
  modified,
} = Astro.props;

const siteName = "The Next Cigar";
const ogImage = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#F2F0EA" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Impact.com / Partnerize publisher verification (kept from the previous build) -->
    <meta name="impact-site-verification" content="25aa9188-d00c-497a-9b96-3ae2e4a285dd" />
    <meta name="partnerize-verification" content="Ascend Confirmation" />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/newsreader-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/newsreader-italic.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-sans-latin-400-normal.woff2" crossorigin />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      {!noEar && <Ear />}
      <Masthead section={section} compact={compact} />
      <main id="main">
        <slot />
      </main>
      <PaperFooter />
    </div>
    <script is:inline>
      // Outbound-click counter. One delegated listener for the whole site, so
      // every link to a retailer — on the Finder, a country page, a SKU page,
      // or inside an article like the retailer map — is counted without
      // touching the links themselves. Fires a sendBeacon to /api/out, which
      // bumps one integer per (day, retailer host, our page). Nothing about
      // the reader is sent or stored. The list of hosts is enforced server
      // side; this only avoids pointless requests for links we do not count.
      (function () {
        var HOSTS = /(^|\.)(cigarmust\.com|noblego\.de|cigarworld\.de|sigarietabacchi\.it|lacasadelhabano\.brussels|cigarsmokerclub\.com|cgarsltd\.co\.uk|cigarrspecialisten\.se|cigarrummet\.com|hajenius\.com|jamesfox\.ie|siglomundo\.ch|jjfox\.co\.uk|sauttercigars\.com|havanahouse\.co\.uk|egmcigars\.com|cigarrhyllan\.se|lcdhantwerp\.com|cigarsmoke\.gr|cigarmaxx\.de|cigarone\.com|puros\.se|houseofcigars\.it|bottegadelfumatore\.com|cigarsgalaxy\.gr|danishpipeshop\.com|turmeaus\.co\.uk)$/i;
        document.addEventListener("click", function (e) {
          var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
          if (!a) return;
          var host;
          try { host = new URL(a.href, location.href).hostname; } catch (_) { return; }
          if (host === location.hostname || !HOSTS.test(host)) return;
          var payload = JSON.stringify({ host: host, page: location.pathname });
          try {
            if (navigator.sendBeacon) {
              navigator.sendBeacon("/api/out", new Blob([payload], { type: "application/json" }));
            } else {
              fetch("/api/out", { method: "POST", body: payload, keepalive: true, headers: { "content-type": "application/json" } });
            }
          } catch (_) {}
        }, true);
      })();
    </script>
  </body>
</html>
