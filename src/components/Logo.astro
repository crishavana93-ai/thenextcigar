---
interface Props {
  /** "wordmark" = full TNext Cigars logo, "mark" = compact smoke glyph for tight spaces */
  variant?: "wordmark" | "mark";
  /** Optional class list applied to the rendered element */
  class?: string;
  /** "light" forces the cream/dark-background variant */
  tone?: "dark" | "light";
}

const { variant = "mark", class: className = "", tone = "dark" } = Astro.props;
// Switched from .png to .svg in 2026-05 — the raster export had transparency
// artifacts (checkered background visible against the cream page surface).
// SVG renders crisply at every size and has no transparency edge case.
const wordmarkUrl = tone === "light" ? "/logo-light.svg" : "/logo.svg";
---

{/* The smoke-curl mark was retired 15 Sep 2026 — the paper's identity is
    the wordmark. Both variants render the wordmark now. */}
<img src={wordmarkUrl} alt="The Next Cigar" class={className} width="1000" height="460" />
