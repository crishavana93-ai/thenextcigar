---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  featured: CollectionEntry<"blog">;
  side: CollectionEntry<"blog">[];
  categoryByslug: Map<string, { name: string; slug: string }>;
}

const { featured, side, categoryByslug } = Astro.props;
const fc = featured.data.category ? categoryByslug.get(featured.data.category) : null;

const fmtDate = (d: Date | string) =>
  new Date(d).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });

// Newsplate-style long-form date used in the featured hero (e.g. "Monday, January 29, 2026")
const fmtLongDate = (d: Date | string) =>
  new Date(d).toLocaleDateString("en-US", {
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric",
  }).toUpperCase();
---

<section class="editorial container-wide pt-12 md:pt-16 pb-20 md:pb-24 border-t border-[color:var(--color-rule)]">
  <header class="flex items-end justify-between mb-12 md:mb-16 flex-wrap gap-4" data-reveal>
    <div>
      <p class="editorial-eyebrow mb-3">The Cover Story</p>
      <h2 class="editorial-h leading-[1.05] tracking-[-0.012em]" style="font-size: clamp(1.8rem, 3.4vw, 2.6rem);">
        This week's reading
      </h2>
    </div>
    <a
      href="/blog"
      class="text-[0.82rem] font-semibold tracking-[0.05em] underline underline-offset-[6px] transition-colors duration-200"
      style="color: var(--color-gold-hover); text-decoration-color: var(--color-rule);"
    >
      Open the magazine →
    </a>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
    {/* FEATURED COVER STORY — 8 columns on desktop, image-above-text editorial layout */}
    <a
      href={`/blog/${featured.data.slug}`}
      class="lg:col-span-8 group editorial-card"
      data-reveal
      aria-label={featured.data.title}
    >
      <figure class="editorial-image" data-reveal>
        <div class="editorial-image__mask" style="aspect-ratio: 16/9;">
          {featured.data.cover && (typeof featured.data.cover === "string" ? (
            <img
              src={featured.data.cover}
              alt={featured.data.title}
              class="editorial-image__img"
              style="filter: saturate(0.82) contrast(1.04);"
              loading="eager"
            />
          ) : (
            <Image
              src={featured.data.cover}
              alt={featured.data.title}
              widths={[600, 900, 1200, 1800]}
              sizes="(min-width: 1024px) 66vw, 100vw"
              class="editorial-image__img"
              style="filter: saturate(0.82) contrast(1.04);"
              loading="eager"
            />
          ))}
        </div>
      </figure>

      <div class="mt-6 md:mt-8">
        <p class="editorial-eyebrow mb-4">
          {fc ? fc.name : "Editorial"} · {fmtLongDate(featured.data.publishedAt)}
        </p>
        <h3
          class="editorial-h leading-[1.04] tracking-[-0.012em]"
          style="font-size: clamp(1.9rem, 3.8vw, 3rem);"
        >
          {featured.data.title}
        </h3>
        {featured.data.excerpt && (
          <p
            class="mt-5 max-w-2xl leading-[1.6] line-clamp-3"
            style="color: var(--color-ink-soft); font-size: 1.04rem;"
          >
            {featured.data.excerpt}
          </p>
        )}
      </div>
    </a>

    {/* SIDE — 2 stacked stories in 4-col rail */}
    <div class="lg:col-span-4 flex flex-col gap-10 lg:gap-12">
      {side.slice(0, 2).map((p, i) => {
        const c = p.data.category ? categoryByslug.get(p.data.category) : null;
        return (
          <a
            href={`/blog/${p.data.slug}`}
            class="group editorial-card"
            data-reveal
            data-reveal-delay={(i + 1) as 1 | 2}
          >
            <figure class="editorial-image" data-reveal>
              <div class="editorial-image__mask" style="aspect-ratio: 16/10;">
                {p.data.cover && (typeof p.data.cover === "string" ? (
                  <img
                    src={p.data.cover}
                    alt={p.data.title}
                    class="editorial-image__img"
                    style="filter: saturate(0.82) contrast(1.04);"
                    loading="eager"
                  />
                ) : (
                  <Image
                    src={p.data.cover}
                    alt={p.data.title}
                    widths={[400, 800]}
                    sizes="(min-width: 1024px) 33vw, 100vw"
                    class="editorial-image__img"
                    style="filter: saturate(0.82) contrast(1.04);"
                    loading="eager"
                  />
                ))}
              </div>
            </figure>
            <p class="editorial-eyebrow mt-4 mb-2">
              {c ? c.name : "Editorial"} · {fmtDate(p.data.publishedAt)}
            </p>
            <h4
              class="editorial-h leading-[1.15]"
              style="font-size: clamp(1.15rem, 1.6vw, 1.4rem);"
            >
              {p.data.title}
            </h4>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* Hero scrim — three-stop dark gradient. Charcoal at the bottom where
     the headline sits, gradually transparent toward the top so the image
     reads. Mobile gets a taller dark band because the portrait crop puts
     more of the image area underneath the headline block. */
  .hero-scrim {
    background-image: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-dark) 92%, transparent) 0%,
      color-mix(in srgb, var(--color-dark) 78%, transparent) 28%,
      color-mix(in srgb, var(--color-dark) 35%, transparent) 55%,
      transparent 80%
    );
  }

  @media (min-width: 1024px) {
    .hero-scrim {
      background-image: linear-gradient(
        to top,
        color-mix(in srgb, var(--color-dark) 90%, transparent) 0%,
        color-mix(in srgb, var(--color-dark) 60%, transparent) 38%,
        transparent 70%
      );
    }
  }

  /* Headline safety net — text-shadow keeps the title legible even if a
     particular cover image happens to be mostly black in the title band
     (rare with the scrim already in place, but cheap insurance). */
  .hero-title {
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.45), 0 2px 4px rgba(0, 0, 0, 0.35);
  }
</style>
