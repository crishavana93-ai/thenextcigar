---
/**
 * LivePaper — the front-page opener: someone in a club chair reading today's
 * paper, and the paper is this site.
 *
 * Layers, all in one "scene" sized to the photograph (1344 x 752):
 *   1. /hero/reader.webp — the reader holding a blank broadsheet
 *      (DRAFT: Higgsfield-generated stand-in, 19 Oct 2026, until real footage)
 *   2. .lp-spread — today's front and back page, live HTML, mapped onto the
 *      blank sheet with a measured matrix3d and printed with mix-blend-mode:
 *      multiply so the creases and lamp light of the photo show through
 *   3. /hero/reader-hands.webp — the hands cut out of the same photo, laid
 *      back over the print so the fingers sit on top of the paper
 *   4. smoke, rising from behind the sheet (CSS)
 * Scrolling moves a camera into the front page until it fills the screen;
 * the print hands over to plain newsprint and the real masthead follows.
 *
 * Budget: 47 KB photo + 8 KB hands + HTML/CSS + a small inline script.
 * prefers-reduced-motion: a static first frame, no pinning, no movement.
 */
import { MASTHEAD } from "../../data/masthead";

interface Row { name: string; where: string; price: string; live: boolean }
interface Props {
  leadTitle: string;
  leadDeck?: string;
  leadKicker?: string;
  leadCover?: { src: string; srcset?: string };
  rows: Row[];
  inside: string[];
}
const { leadTitle, leadDeck, leadKicker = "Report", leadCover, rows, inside } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "Europe/Stockholm" });
const buildDate = fmt(new Date());
const isDev = import.meta.env.DEV;
---

<section class="lp" id="lp" aria-label="Today's paper" data-lp>
  <div class="lp-stage">
    <div class="lp-scene">
      <img class="lp-photo" src="/hero/reader.webp" alt="" width="1344" height="752" fetchpriority="high" decoding="async" />
      <div class="lp-spread" aria-hidden="true">
        <div class="lp-page lp-back">
          <div class="lp-ear"><span>The board</span><span data-lp-date>{buildDate}</span></div>
          <div class="lp-bh">Markets <i>· cheapest box, today</i></div>
          {rows.map((r) => (
            <div class="lp-row"><b>{r.name}</b><span>{r.price}</span><small>{r.where}{r.live ? " · live" : ""}</small></div>
          ))}
          <div class="lp-bh lp-gap">Inside today</div>
          <ol class="lp-in">{inside.map((t) => <li>{t}</li>)}</ol>
        </div>
        <div class="lp-page lp-front">
          <div class="lp-ear"><span data-lp-date>{buildDate}</span><span>Malmö</span></div>
          <div class="lp-name">The Next Cigar</div>
          <div class="lp-tag">The anthology of the leaf — Cuban cigars, the European market, and the things worth owning.</div>
          <div class="lp-ed"><span>{MASTHEAD.volume} · {MASTHEAD.issue.replace("Issue", "No.")}</span><span>No tobacco sold here</span><span>{MASTHEAD.date}</span></div>
          <div class="lp-kick">{leadKicker}</div>
          <div class="lp-head">{leadTitle}</div>
          {leadCover && <img class="lp-foto" src={leadCover.src} srcset={leadCover.srcset} sizes="600px" alt="" width="1200" height="675" loading="eager" />}
          {leadDeck && <p class="lp-deck">{leadDeck}</p>}
        </div>
      </div>
      <img class="lp-hands" src="/hero/reader-hands.webp" alt="" width="795" height="240" decoding="async" />
      <div class="lp-smoke" aria-hidden="true"><span></span><span></span><span></span></div>
    </div>
    <div class="lp-veil" aria-hidden="true"></div>
    <p class="lp-cue" aria-hidden="true">Today's paper <span>— scroll to read it</span></p>
    {isDev && <p class="lp-draft">Draft image · generated stand-in</p>}
  </div>
</section>

<style>
  .lp{position:relative;height:100vh;height:100svh;background:#110d0a;margin:0}
  .lp.armed{height:300vh;margin-bottom:-100vh;margin-bottom:-100svh}
  /* the page slides up over the last, blank frame: the paper becomes the site */
  :global(.lp.armed ~ .wrap){position:relative;z-index:1;background:var(--paper)}
  .lp-stage{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden}
  .lp-scene{position:absolute;left:0;top:0;width:1344px;height:752px;transform-origin:0 0;will-change:transform;
    transform:translate3d(var(--tx,0px),var(--ty,0px),0) scale(var(--k,1))}
  .lp-photo{position:absolute;inset:0;width:1344px;height:752px;max-width:none}
  .lp-hands{position:absolute;left:280px;top:260px;width:795px;height:240px;max-width:none;pointer-events:none}

  /* the spread, designed at 1400 x 946, mapped onto the blank sheet */
  .lp-spread{position:absolute;left:0;top:0;width:1400px;height:946px;transform-origin:0 0;
    transform:matrix3d(0.4623514,0.00091954023,0,1.6420361e-06,0.040176804,0.49799835,0,6.6268575e-05,0,0,1,0,352,124,0,1);
    display:grid;grid-template-columns:1fr 1fr;mix-blend-mode:multiply;color:#1b1713;opacity:.94}
  .lp-page{padding:44px 64px 40px;overflow:hidden}
  .lp-back{padding-left:150px}
  .lp-front{padding-right:150px}
  .lp-ear{display:flex;justify-content:space-between;font:500 15px/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;border-bottom:2px solid currentColor;padding-bottom:10px}
  .lp-name{font:600 92px/1 var(--serif);letter-spacing:-.02em;text-align:center;margin-top:22px;white-space:nowrap}
  .lp-tag{font:italic 400 19px/1.3 var(--serif);text-align:center;margin-top:10px;opacity:.85}
  .lp-ed{display:flex;justify-content:space-between;margin-top:18px;padding:9px 0;border-top:5px double currentColor;border-bottom:2px solid currentColor;font:500 13px/1 var(--sans);letter-spacing:.14em;text-transform:uppercase}
  .lp-kick{display:inline-block;margin-top:26px;background:#7B2622;color:#EEEBE3;font:600 13px/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;padding:6px 9px}
  .lp-head{font:600 50px/1.04 var(--serif);letter-spacing:-.01em;margin-top:14px;text-wrap:balance}
  .lp-foto{width:100%;height:auto;margin-top:18px;filter:grayscale(.35) contrast(1.05)}
  .lp-deck{font:400 20px/1.4 var(--serif);margin-top:14px}
  .lp-bh{font:600 30px/1.1 var(--serif);margin-top:20px;border-bottom:2px solid currentColor;padding-bottom:8px}
  .lp-bh i{font-weight:400;font-style:italic;color:#7B2622}
  .lp-gap{margin-top:30px}
  .lp-row{display:grid;grid-template-columns:1fr auto;gap:3px 12px;padding:12px 0;border-bottom:1px solid rgba(27,23,19,.35);font:400 22px/1.2 var(--serif)}
  .lp-row span{font-weight:600;font-variant-numeric:tabular-nums}
  .lp-row small{grid-column:1/-1;font:400 12.5px/1.2 var(--sans);letter-spacing:.08em;text-transform:uppercase;opacity:.75}
  .lp-in{margin:12px 0 0;padding-left:28px;font:600 21px/1.25 var(--serif)}
  .lp-in li{margin-bottom:12px}

  .lp-smoke{position:absolute;left:826px;top:110px;width:0;height:0;opacity:calc(1 - var(--p,0) * 4)}
  .lp-smoke span{position:absolute;left:-40px;top:-40px;width:80px;height:110px;border-radius:50%;background:radial-gradient(closest-side,rgba(225,218,205,.28),transparent);filter:blur(9px);animation:lp-smoke 8s linear infinite;opacity:0}
  .lp-smoke span:nth-child(2){animation-delay:-2.7s;left:-30px}
  .lp-smoke span:nth-child(3){animation-delay:-5.3s;left:-50px}
  @keyframes lp-smoke{0%{transform:translate(0,20px) scale(.5);opacity:0}20%{opacity:1}100%{transform:translate(28px,-150px) scale(2.2) rotate(20deg);opacity:0}}

  .lp-veil{position:absolute;inset:0;background:var(--paper);opacity:calc((var(--p,0) - .74) * 4);pointer-events:none}
  .lp-cue{position:absolute;left:0;right:0;bottom:3.5vh;margin:0;text-align:center;font:500 11px/1 var(--sans);letter-spacing:.22em;text-transform:uppercase;color:#e2d6c2;opacity:calc(1 - var(--p,0) * 10);text-shadow:0 1px 8px rgba(0,0,0,.8)}
  .lp-cue span{color:#a99b84}
  .lp-draft{position:absolute;right:12px;top:12px;margin:0;font:600 10px/1 var(--sans);letter-spacing:.12em;text-transform:uppercase;background:#7B2622;color:#fff;padding:5px 7px}
  .lp.armed.rest .lp-scene{animation:lp-breathe 9s ease-in-out infinite}
  @keyframes lp-breathe{50%{translate:0 -2px;scale:1.004}}
  @media (prefers-reduced-motion:reduce){ .lp-smoke span,.lp.armed.rest .lp-scene{animation:none} }
</style>

<script is:inline>
(function () {
  var root = document.querySelector("[data-lp]");
  if (!root) return;
  var fmt = { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "Europe/Stockholm" };
  root.querySelectorAll("[data-lp-date]").forEach(function (el) { el.textContent = new Date().toLocaleDateString("en-GB", fmt); });
  var still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  var IW = 1344, IH = 752;
  // Front page of the spread, in photo pixels: x 672..997, top edge y 125.
  var PX0 = 672, PX1 = 997, PTOP = 125, PCX = (PX0 + PX1) / 2;
  if (!still) root.classList.add("armed");
  var lerp = function (a, b, t) { return a + (b - a) * t; };
  var ease = function (t) { return t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; };
  var raf = 0;
  function frame() {
    raf = 0;
    var vw = innerWidth, vh = innerHeight, phone = vw < 700;
    var total = root.offsetHeight - 2 * vh; // last screen is the hand-over
    var raw = still ? 0 : Math.min(1, Math.max(0, -root.getBoundingClientRect().top / Math.max(1, total)));
    var t = ease(Math.min(1, raw / 0.78));
    // Start: the whole room (cover) on wide screens; the front page on phones.
    var k0 = phone ? (vw * 0.94) / (PX1 - PX0) : Math.max(vw / IW, vh / IH);
    var cx0 = phone ? PCX : IW / 2, cy0 = phone ? Math.min(IH - vh / (2 * k0), Math.max(vh / (2 * k0), 360)) : IH / 2;
    // End: the front page fills the width, its top edge at the top of the screen.
    var k1 = vw / (PX1 - PX0) * 1.02;
    var cx1 = PCX, cy1 = PTOP + vh / (2 * k1) - 6 / k1;
    var k = lerp(k0, k1, t), cx = lerp(cx0, cx1, t), cy = lerp(cy0, cy1, t);
    root.style.setProperty("--k", k.toFixed(4));
    root.style.setProperty("--tx", (vw / 2 - cx * k).toFixed(1) + "px");
    root.style.setProperty("--ty", (vh / 2 - cy * k).toFixed(1) + "px");
    root.style.setProperty("--p", raw.toFixed(4));
    root.classList.toggle("rest", raw < 0.01);
  }
  function req() { if (!raf) raf = requestAnimationFrame(frame); }
  addEventListener("scroll", req, { passive: true });
  addEventListener("resize", req);
  frame();
})();
</script>
