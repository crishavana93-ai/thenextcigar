---
import { MASTHEAD } from "../../data/masthead";

interface Props {
  section?: string;
  compact?: boolean;
}
const { section = "none", compact = false } = Astro.props;
const isHome = Astro.url.pathname === "/";

const items: [string, string, string][] = [
  // Order matters on a phone. The rail scrolls, and whatever sits past the
  // fold is found only by a swipe nobody is told about — so the destinations
  // that earn (the Lounge, the Shop) come before the ones that don't.
  ["front", "/", "Front page"],
  ["markets", "/finder/", "Markets"],
  ["magazine", "/blog/", "Magazine"],
  ["lounge", "/lounge/", "The Lounge"],
  ["shop", "/shop/", "Shop"],
  ["diary", "/category/cigar-events/", "Diary"],
  ["watch", "/watch/", "Watch"],
  ["tools", "/tools/", "Tools"],
];
---

<header class:list={["mast", { small: compact }]}>
  {isHome
    ? <h1><a href="/">The Next Cigar</a></h1>
    : <p class="h1"><a href="/">The Next Cigar</a></p>}
  <p class="tag">The anthology of the leaf — Cuban cigars, the European market, and the things worth owning.</p>
  <div class="ed">
    <span>{MASTHEAD.volume} · {MASTHEAD.issue.replace("Issue", "No.")}</span>
    <span>Independent · Reader-supported · No tobacco sold here</span>
    <span>{MASTHEAD.date} · Published from Sweden</span>
  </div>
  <nav class="sec" aria-label="Sections">
    <ul>
      {items.map(([key, href, label]) => (
        <li class:list={{ home: key === "front" }}>
          <a href={href} class:list={{ on: key === section }}>
            {label === "The Lounge" ? <><span class="the">The </span>Lounge</> : label}
          </a>
        </li>
      ))}
    </ul>
    <div class="acct">
      <a href="/lounge/app/">Sign in</a>
      <a class="join" href="/lounge/signup/">Join · free</a>
    </div>
  </nav>
</header>
