---
import { MASTHEAD } from "../../data/masthead";

interface Props {
  section?: string;
  compact?: boolean;
}
const { section = "none", compact = false } = Astro.props;
const isHome = Astro.url.pathname === "/";

const items: [string, string, string][] = [
  // Order matters on a phone. The rail scrolls, and whatever sits past the
  // fold is found only by a swipe nobody is told about — so the destinations
  // that earn (the Lounge, the Shop) come before the ones that don't.
  ["front", "/", "Front page"],
  ["markets", "/finder/", "Markets"],
  ["magazine", "/blog/", "Magazine"],
  ["lounge", "/lounge/", "The Lounge"],
  ["shop", "/shop/", "Shop"],
  ["diary", "/category/cigar-events/", "Diary"],
  ["watch", "/watch/", "Watch"],
  ["tools", "/tools/", "Tools"],
];
---

<header class:list={["mast", { small: compact }]}>
  {isHome
    ? <h1><a href="/">The Next Cigar</a></h1>
    : <p class="h1"><a href="/">The Next Cigar</a></p>}
  <p class="tag">The anthology of the leaf — Cuban cigars, the European market, and the things worth owning.</p>
  <div class="ed">
    <span>{MASTHEAD.volume} · {MASTHEAD.issue.replace("Issue", "No.")}</span>
    <span>Independent · Reader-supported · No tobacco sold here</span>
    <span>{MASTHEAD.date} · Published from Sweden</span>
  </div>
  {isHome && (
    <p class="phone-lede">An independent paper on Cuban cigars. No tobacco sold. Box prices at European retailers, compared live — <a href="/finder/">see the board →</a></p>
  )}
  <nav class="sec" aria-label="Sections">
    <ul>
      {items.map(([key, href, label]) => (
        <li class:list={{ home: key === "front" }}>
          <a href={href} class:list={{ on: key === section }}>
            {label === "The Lounge" ? <><span class="the">The </span>Lounge</> : label}
          </a>
        </li>
      ))}
    </ul>
    <div class="acct">
      <button type="button" class="srch-btn" id="srch-btn" aria-label="Search" aria-expanded="false" aria-controls="srch">Search</button>
      <a href="/lounge/app/">Sign in</a>
      <a class="join" href="/lounge/signup/">Join · free</a>
    </div>
  </nav>
  <form class="srch" id="srch" role="search" hidden action="/finder/" method="get">
    <input type="search" id="srch-q" name="q" placeholder="A vitola, a retailer, an article…" autocomplete="off" aria-label="Search the paper" />
    <ol id="srch-out" class="srch-out" hidden></ol>
  </form>
</header>
<script>
  // Masthead search. One JSON index fetched on first keystroke; substring
  // match on every word typed; ten results, vitolas first. Enter goes to the
  // first result. No server round-trip per keystroke, nothing recorded.
  const btn = document.getElementById("srch-btn") as HTMLButtonElement | null;
  const form = document.getElementById("srch") as HTMLFormElement | null;
  const q = document.getElementById("srch-q") as HTMLInputElement | null;
  const out = document.getElementById("srch-out") as HTMLOListElement | null;
  type Item = { k: string; t: string; h: string; s: string };
  let index: Item[] | null = null;
  const KIND: Record<string, string> = { vitola: "Vitola", retailer: "Retailer", article: "Magazine", page: "Page" };
  const norm = (x: string) => x.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[.'’]/g, "");
  async function load() { if (index) return index; try { const r = await fetch("/search-index.json"); index = (await r.json()).items; } catch { index = []; } return index!; }
  function esc(x: string) { return x.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]!)); }
  async function run() {
    if (!q || !out) return;
    const words = norm(q.value).split(/\s+/).filter(Boolean);
    if (!words.length) { out.hidden = true; out.innerHTML = ""; return; }
    const items = await load();
    const rank = (i: Item) => (i.k === "vitola" ? 0 : i.k === "retailer" ? 1 : i.k === "page" ? 2 : 3);
    const hits = items
      .filter((i) => { const hay = norm(i.t + " " + i.s); return words.every((w) => hay.includes(w)); })
      .sort((a, b) => rank(a) - rank(b) || a.t.localeCompare(b.t))
      .slice(0, 10);
    out.innerHTML = hits.length
      ? hits.map((i) => `<li><a href="${i.h}"><span class="k">${KIND[i.k] ?? i.k}</span>${esc(i.t)}<small>${esc(i.s)}</small></a></li>`).join("")
      : `<li class="none">Nothing for “${esc(q.value)}”. Try a brand, a vitola, a retailer, or a word from a headline.</li>`;
    out.hidden = false;
  }
  btn?.addEventListener("click", () => {
    if (!form || !q) return;
    const open = form.hidden;
    form.hidden = !open;
    btn.setAttribute("aria-expanded", String(open));
    if (open) { q.focus(); load(); }
  });
  q?.addEventListener("input", run);
  form?.addEventListener("submit", (e) => {
    const first = out?.querySelector<HTMLAnchorElement>("a");
    if (first) { e.preventDefault(); location.href = first.href; }
  });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && form && !form.hidden) { form.hidden = true; btn?.setAttribute("aria-expanded", "false"); } });
</script>
