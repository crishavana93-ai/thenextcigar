---
// Slim cookie consent banner. Shows once, dismissible, stored in localStorage.
// Required for EU/UK visitors and best practice once we add ad networks.
---

<div id="cookie-banner"
  class="fixed bottom-4 left-4 right-4 sm:left-6 sm:right-auto sm:bottom-6 sm:max-w-md z-50 shadow-[0_8px_32px_rgba(26,26,26,0.18)] border border-[color:var(--color-rule)] rounded-sm"
  style="background: var(--color-paper); color: var(--color-ink);"
  hidden
>
  <div class="px-4 py-3 sm:px-5 sm:py-4 flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-5">
    <p class="text-xs leading-snug flex-1" style="color: var(--color-ink-soft);">
      Cookies for analytics keep this editorial free. <a href="/privacy" class="underline underline-offset-2" style="color: var(--color-gold-hover);">Privacy</a>.
    </p>
    <div class="flex items-center gap-1 flex-shrink-0">
      <button id="cookie-decline"
        class="text-[0.7rem] uppercase tracking-wider px-3 py-1.5 transition-colors"
        style="color: var(--color-ink-muted);"
      >
        Decline
      </button>
      <button id="cookie-accept"
        class="text-[0.7rem] uppercase tracking-wider font-semibold px-3 py-1.5 transition-colors"
        style="background: var(--color-ink); color: var(--color-paper);"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = "tnc_cookie_consent";

  function setupCookieBanner() {
    const banner = document.getElementById("cookie-banner");
    if (!banner || (banner as any).dataset.bound === "1") return;
    (banner as any).dataset.bound = "1";

    const consent = (() => { try { return localStorage.getItem(STORAGE_KEY); } catch { return "accept"; } })();
    if (consent) return; // already decided

    banner.removeAttribute("hidden");

    const decide = (value: "accept" | "decline") => {
      try { localStorage.setItem(STORAGE_KEY, value); } catch {}
      banner.setAttribute("hidden", "");
      // dispatch event so analytics/ad scripts can listen
      document.dispatchEvent(new CustomEvent("tnc:cookie-consent", { detail: { value } }));
    };

    document.getElementById("cookie-accept")?.addEventListener("click", () => decide("accept"));
    document.getElementById("cookie-decline")?.addEventListener("click", () => decide("decline"));
  }

  document.addEventListener("astro:page-load", setupCookieBanner);
  setupCookieBanner();
</script>
