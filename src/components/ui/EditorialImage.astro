---
/**
 * EditorialImage — Direction A clip-path image reveal (Floema pattern).
 *
 * Photos slide up from behind a clip-path mask when scrolled into view.
 * Caption (if provided) sits BELOW the image — magazine print convention,
 * not overlaid like a SaaS hero.
 *
 * Pure Astro / pure CSS. Uses the existing [data-reveal] IntersectionObserver
 * in src/scripts/editorial-reveal.ts — no extra JS, no React island, no
 * Framer Motion load. Works on every image including blog post covers,
 * Finder country pages, and Lounge marketing surfaces.
 *
 * Usage:
 *   <EditorialImage
 *     src="https://images.pexels.com/..."
 *     alt="Cuban torcedor at work"
 *     caption="Anonymous torcedor at Partagás · Havana · February 2026"
 *     aspect="16/9"
 *   />
 *
 * Aspect ratio is CSS aspect-ratio property (16/9, 4/3, 3/2, 1/1, etc).
 * Set `eager={true}` for above-the-fold images so they don't lazy-load.
 */

interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** Aspect ratio as a CSS aspect-ratio value, e.g. "16/9", "4/5". */
  aspect?: string;
  /** Set true for above-the-fold images (LCP candidates). */
  eager?: boolean;
  /** Optional className for the outer wrapper. */
  class?: string;
  /** CSS object-position for the image, e.g. "50% 30%". */
  focal?: string;
}

const {
  src,
  alt,
  caption,
  aspect = "16/9",
  eager = false,
  class: className = "",
  focal = "50% 50%",
} = Astro.props;
---

<figure class:list={["editorial-image", className]} data-reveal>
  <div class="editorial-image__mask" style={`aspect-ratio: ${aspect};`}>
    <img
      class="editorial-image__img"
      src={src}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      style={`object-position: ${focal};`}
      {...(eager ? { fetchpriority: "high" } : {})}
    />
  </div>
  {caption && (
    <figcaption class="editorial-image__caption">{caption}</figcaption>
  )}
</figure>

<style>
  /* Override the global [data-reveal] opacity/transform — the figure itself
     stays at opacity 1, the inner mask handles the visual reveal via clip-path.
     Higher specificity than the global rule via element + class selector. */
  figure.editorial-image[data-reveal] {
    opacity: 1 !important;
    transform: none !important;
    transition: none;
  }

  .editorial-image {
    margin: 0;
    display: block;
  }

  .editorial-image__mask {
    position: relative;
    overflow: hidden;
    width: 100%;
    /* Floema-pattern clip — the image starts hidden from the bottom and
       reveals upward as the [data-reveal].is-visible class lands. */
    clip-path: inset(100% 0 0 0);
    will-change: clip-path;
    transition: clip-path 1100ms cubic-bezier(0.77, 0, 0.175, 1);
  }
  [data-reveal].is-visible > .editorial-image__mask {
    clip-path: inset(0% 0 0 0);
  }

  .editorial-image__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Subtle ken-burns to add life once revealed (matches MagazineHero) */
    transform: scale(1.04);
    transition: transform 1800ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-reveal].is-visible .editorial-image__img {
    transform: scale(1);
  }

  .editorial-image__caption {
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted, var(--color-text-muted));
    line-height: 1.55;
    /* 50ms-after-caption-reveal trick: caption is visible immediately at
       the parent's reveal time, but the IMAGE's clip-path takes 1.1s, so
       the caption naturally beats the image to the user's eye. */
    opacity: 0;
    transition: opacity 600ms ease-out 50ms;
  }
  [data-reveal].is-visible .editorial-image__caption {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-image__mask,
    .editorial-image__img,
    .editorial-image__caption {
      transition: none !important;
      clip-path: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>
