---
/**
 * MagazineMasthead — homepage Volume-label masthead.
 *
 * Direction A's brand bookplate at the top of /. Gold rules above and
 * below, centered Volume / Issue / Date label in Source Serif 4, with
 * a small editorial tagline beneath. Sits above the HighlightHero.
 *
 * Pure Astro, no React island needed — runs on every visit.
 */

interface Props {
  volume: string;       // e.g. "Volume III"
  issue: string;        // e.g. "Issue 05"
  date: string;         // e.g. "May 2026"
  tagline?: string;     // e.g. "Cuban cigars, written for people who actually smoke them."
}

const { volume, issue, date, tagline } = Astro.props;
---

<section class="masthead editorial" data-reveal>
  <div class="container-wide masthead__inner">
    <div class="masthead__rule masthead__rule--top" aria-hidden="true"></div>

    <div class="masthead__bookplate">
      <p class="masthead__volume">{volume}</p>
      <p class="masthead__divider" aria-hidden="true">·</p>
      <p class="masthead__issue">{issue}</p>
      <p class="masthead__divider" aria-hidden="true">·</p>
      <p class="masthead__date">{date}</p>
    </div>

    {tagline && (
      <p class="masthead__tagline">{tagline}</p>
    )}

    <div class="masthead__rule masthead__rule--bottom" aria-hidden="true"></div>
  </div>
</section>

<style>
  .masthead {
    padding-top: 2rem;
    padding-bottom: 1.25rem;
  }
  @media (min-width: 768px) {
    .masthead { padding-top: 2.5rem; padding-bottom: 1.5rem; }
  }

  .masthead__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .masthead__rule {
    width: 100%;
    max-width: 18rem;
    height: 1px;
    background: var(--color-gold);
    opacity: 0.55;
  }
  .masthead__rule--top    { margin-bottom: 1.25rem; }
  .masthead__rule--bottom { margin-top: 1.5rem; }
  @media (min-width: 768px) {
    .masthead__rule--top    { margin-bottom: 1.5rem; }
    .masthead__rule--bottom { margin-top: 2rem; }
  }

  .masthead__bookplate {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-serif);
    font-size: clamp(0.95rem, 1.6vw, 1.2rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink);
    font-weight: 500;
  }
  .masthead__divider {
    color: var(--color-gold-hover);
    margin: 0;
    line-height: 1;
  }
  .masthead__bookplate p {
    margin: 0;
  }

  .masthead__tagline {
    margin-top: 0.9rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    color: var(--color-ink-soft);
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.5;
    max-width: 38rem;
  }
</style>
