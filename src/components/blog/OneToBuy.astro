---
/**
 * <OneToBuy picks={[…]} checked="19 October 2026" />
 *
 * The first-screen answer in a buying guide: one to three picks, each with
 * why, the Amazon rating, the US price when Amazon shows one, and a single
 * button. Clicks inside the box are counted separately from the rest of the
 * page (data-out="box" → host "box.amazon.com" in retailer_clicks), so we
 * can see whether the box earns its place.
 */
interface Pick { label: string; name: string; url: string; why: string; rating: string; price?: string; image?: string }
interface Props { picks: Pick[]; checked: string; title?: string }
const { picks, checked, title = "The one to buy" } = Astro.props;
---
<aside class="otb" data-out="box" aria-label={title}>
  <p class="otb__kick">{title}</p>
  <div class:list={["otb__grid", `n${picks.length}`]}>
    {picks.map((p) => (
      <div class="otb__pick">
        <span class="otb__label">{p.label}</span>
        <div class="otb__row">
          {p.image && <img src={p.image} alt="" width="72" height="72" loading="eager" />}
          <div>
            <a class="otb__name" href={p.url} rel="sponsored nofollow noopener" target="_blank">{p.name}</a>
            <p class="otb__why">{p.why}</p>
          </div>
        </div>
        <p class="otb__meta"><span>{p.rating}</span>{p.price && <b>{p.price}</b>}</p>
        <a class="otb__btn" href={p.url} rel="sponsored nofollow noopener" target="_blank">See it on Amazon <span aria-hidden="true">→</span></a>
      </div>
    ))}
  </div>
  <p class="otb__fine">Amazon.com ratings and US prices checked {checked}. Affiliate links: we earn a small commission at no cost to you.</p>
</aside>

<style>
  .otb{margin:28px 0 30px;border:1.5px solid var(--ink);background:var(--paper-2);padding:16px 18px 12px}
  .otb__kick{margin:0 0 12px;font:600 11px/1 var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--ox)}
  .otb__grid{display:grid;gap:14px}
  .otb__grid.n2{grid-template-columns:repeat(2,minmax(0,1fr))}
  .otb__grid.n3{grid-template-columns:repeat(3,minmax(0,1fr))}
  @media (max-width:760px){.otb__grid.n2,.otb__grid.n3{grid-template-columns:1fr}}
  .otb__pick{display:flex;flex-direction:column;gap:8px;min-width:0;border-top:1px solid var(--ink);padding-top:10px}
  .otb__label{font:600 10.5px/1.2 var(--sans);letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}
  .otb__row{display:flex;gap:12px;align-items:flex-start}
  .otb__row img{width:72px;height:72px;object-fit:contain;background:#fff;border:1px solid var(--rule-2);flex:none}
  .otb__name{font:600 19px/1.15 var(--serif);color:var(--ink);text-decoration:none}
  .otb__name:hover{text-decoration:underline}
  .otb__why{margin:4px 0 0;font:400 15px/1.35 var(--serif);color:var(--ink-2)}
  .otb__meta{margin:auto 0 0;display:flex;justify-content:space-between;gap:8px;font:400 12.5px/1.3 var(--sans);color:var(--mute)}
  .otb__meta b{color:var(--ink);font-weight:600}
  .otb__btn{display:block;text-align:center;background:var(--ink);color:var(--paper);text-decoration:none;font:600 12px/1 var(--sans);letter-spacing:.1em;text-transform:uppercase;padding:13px 10px;min-height:44px;box-sizing:border-box}
  .otb__btn:hover{background:var(--ox)}
  .otb__fine{margin:12px 0 0;font:400 11.5px/1.4 var(--sans);color:var(--mute)}
</style>
