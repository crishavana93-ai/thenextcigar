---
/**
 * <ProductGallery products={d.products} />
 *
 * Every product a buying guide recommends, with its Amazon photo, so a reader
 * sees what they would get before clicking. Products come from the article's
 * `products` frontmatter (the same list that feeds the Product JSON-LD).
 *
 * NO_PHOTO: SKUs whose only Amazon photos show cigars with readable bands.
 * Under KOVFS 2024:2 a non-selling site must not display tobacco brands.
 * Prefer swapping in a band-free listing photo in the frontmatter (done for
 * Tesonway B0CP1ZNWJ7, Woodronic B08CDFK18T, Xikar Envoy B003SK2UC0).
 */
interface Product { name: string; image: string; url: string; priceLow?: number; price?: number | string; currency?: string; sku?: string; description?: string; rating?: number; reviewCount?: number }
interface Props { products?: Product[]; title?: string }
const { products = [], title = "Every product in this guide" } = Astro.props;
const NO_PHOTO = new Set<string>([]);
const items = products.filter((p) => /amazon\./.test(p.url));
const money = (p: Product) => {
  const v = p.priceLow ?? (typeof p.price === "number" ? p.price : undefined);
  return v ? `$${v.toFixed(2)}` : "";
};
---
{items.length > 0 && (
  <section class="pg" data-out="gallery" aria-label={title}>
    <div class="rulehead flat"><h2>{title}</h2></div>
    <p class="pg__note">Photos from Amazon.com. See today's price on Amazon. Affiliate links: we earn a small commission at no cost to you.</p>
    <ul class="pg__grid">
      {items.map((p) => (
        <li class="pg__card">
          <a class="pg__img" href={p.url} rel="sponsored nofollow noopener" target="_blank" aria-label={p.name}>
            {p.sku && NO_PHOTO.has(p.sku)
              ? <span class="pg__nophoto">Photo on Amazon</span>
              : <img src={p.image} alt={p.name} width="400" height="400" loading="lazy" decoding="async" />}
          </a>
          <a class="pg__name" href={p.url} rel="sponsored nofollow noopener" target="_blank">{p.name}</a>
          {p.description && <p class="pg__desc">{p.description}</p>}
          <p class="pg__meta">
            {p.rating && <span>{p.rating.toFixed(1)}{p.reviewCount ? ` · ${p.reviewCount.toLocaleString("en-US")} ratings` : ""}</span>}
          </p>
          <a class="pg__btn" href={p.url} rel="sponsored nofollow noopener" target="_blank">See it on Amazon <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .pg{margin:8px 0 28px}
  .pg__note{margin:6px 0 14px;font:400 12.5px/1.4 var(--sans);color:var(--mute)}
  .pg__grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  @media (max-width:900px){.pg__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:520px){.pg__grid{grid-template-columns:1fr}}
  .pg__card{display:flex;flex-direction:column;gap:8px;border-top:1.5px solid var(--ink);padding-top:12px;min-width:0}
  .pg__img{display:block;position:relative;background:#fff;border:1px solid var(--rule-2);aspect-ratio:1/1;overflow:hidden}
  .pg__img img{position:absolute;inset:8%;width:84%;height:84%;max-width:none;object-fit:contain;display:block}
  .pg__nophoto{display:flex;height:100%;align-items:center;justify-content:center;font:600 11px/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--mute)}
  .pg__name{font:600 18px/1.2 var(--serif);color:var(--ink);text-decoration:none}
  .pg__name:hover{text-decoration:underline}
  .pg__desc{margin:0;font:400 15px/1.35 var(--serif);color:var(--ink-2)}
  .pg__meta{margin:auto 0 0;display:flex;justify-content:space-between;gap:8px;font:400 12.5px/1.3 var(--sans);color:var(--mute)}
  .pg__meta b{color:var(--ink);font-weight:600}
  .pg__btn{display:block;text-align:center;background:var(--ink);color:var(--paper);text-decoration:none;font:600 12px/1 var(--sans);letter-spacing:.1em;text-transform:uppercase;padding:13px 10px;min-height:44px;box-sizing:border-box}
  .pg__btn:hover{background:var(--ox)}
  @media (max-width:520px){.pg .pg__card{display:grid;grid-template-columns:104px 1fr;column-gap:14px;row-gap:4px;align-items:start}.pg .pg__img{grid-row:1/5;width:104px}.pg .pg__meta{margin:4px 0 0}.pg .pg__btn{grid-column:1/-1;margin-top:6px}.pg .pg__desc{font-size:14px}}
</style>
