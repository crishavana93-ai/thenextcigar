---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  categoryName: string;
  categorySlug: string;
  posts: CollectionEntry<"blog">[];
  /** Visual variant — controls bg color */
  variant?: "default" | "dark" | "warm";
}

const { categoryName, categorySlug, posts, variant = "default" } = Astro.props;
if (posts.length === 0) return null;

const featured = posts[0];
const rest = posts.slice(1, 4);

const fmtDate = (d: Date | string) =>
  new Date(d).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<section class:list={[
  "editorial py-20 md:py-24",
  "border-t border-[color:var(--color-rule)]",
  variant === "dark" && "bg-[color:var(--color-paper-soft)]",
]}>
  <div class="container-wide">
    {/* Direction A masthead — replaces "What's hot in" SaaS style */}
    <header class="flex items-end justify-between mb-12 md:mb-16 flex-wrap gap-4" data-reveal>
      <div>
        <p class="editorial-eyebrow mb-3">Department</p>
        <h2 class="editorial-h leading-[1.05] tracking-[-0.012em]" style="font-size: clamp(2rem, 4vw, 3.2rem);">
          {categoryName}
        </h2>
      </div>
      <a
        href={`/category/${categorySlug}`}
        class="text-[0.82rem] font-semibold tracking-[0.05em] underline underline-offset-[6px] transition-colors duration-200"
        style="color: var(--color-gold-hover); text-decoration-color: var(--color-rule);"
      >
        See all in {categoryName} →
      </a>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
      {/* Featured story — Direction A editorial card with serif title */}
      <a href={`/blog/${featured.data.slug}`} class="block group editorial-card" data-reveal>
        <div class="relative overflow-hidden aspect-[16/10] mb-6" style="background: var(--color-paper-soft);">
          {featured.data.cover && (typeof featured.data.cover === "string" ? (
            <img
              src={featured.data.cover}
              alt={featured.data.title}
              class="w-full h-full object-cover"
              style="filter: saturate(0.85) contrast(1.02);"
              loading="lazy"
            />
          ) : (
            <Image
              src={featured.data.cover}
              alt={featured.data.title}
              widths={[600, 1200]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="w-full h-full object-cover"
              style="filter: saturate(0.85) contrast(1.02);"
              loading="lazy"
            />
          ))}
        </div>
        <p class="editorial-eyebrow mb-3">{categoryName} · {fmtDate(featured.data.publishedAt)}</p>
        <h3
          class="editorial-h leading-[1.08] tracking-[-0.01em] mb-4"
          style="font-size: clamp(1.5rem, 2.6vw, 2.1rem);"
        >
          {featured.data.title}
        </h3>
        {featured.data.excerpt && (
          <p class="leading-[1.6] line-clamp-2" style="color: var(--color-ink-soft); font-size: 1rem;">
            {featured.data.excerpt}
          </p>
        )}
      </a>

      {/* 3 secondary stories — editorial list, hairline rules between */}
      <div class="flex flex-col" style="border-top: 1px solid var(--color-rule);">
        {rest.map((p, i) => (
          <a
            href={`/blog/${p.data.slug}`}
            class="group flex gap-5 py-6 editorial-card"
            style="border-bottom: 1px solid var(--color-rule);"
            data-reveal
          >
            <div class="relative overflow-hidden w-28 h-20 lg:w-36 lg:h-24 flex-shrink-0" style="background: var(--color-paper-soft);">
              {p.data.cover && (typeof p.data.cover === "string" ? (
                <img
                  src={p.data.cover}
                  alt={p.data.title}
                  class="w-full h-full object-cover"
                  style="filter: saturate(0.85) contrast(1.02);"
                  loading="lazy"
                />
              ) : (
                <Image
                  src={p.data.cover}
                  alt={p.data.title}
                  widths={[200, 400]}
                  sizes="160px"
                  class="w-full h-full object-cover"
                  style="filter: saturate(0.85) contrast(1.02);"
                  loading="lazy"
                />
              ))}
            </div>
            <div class="flex-1 min-w-0">
              <p class="editorial-eyebrow mb-2" style="font-size: 0.62rem;">{fmtDate(p.data.publishedAt)}</p>
              <h4
                class="editorial-h leading-snug line-clamp-3"
                style="font-size: clamp(1rem, 1.4vw, 1.18rem);"
              >
                {p.data.title}
              </h4>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
