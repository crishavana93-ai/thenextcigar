---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/newspaper.css";
import CigarCursor from "../components/newspaper/CigarCursor.astro";
import NewspaperMasthead from "../components/newspaper/NewspaperMasthead.astro";
import SectionFlag from "../components/newspaper/SectionFlag.astro";
import { MASTHEAD as masthead } from "../data/masthead";
---

<BaseLayout
  title="My Shelf — The Next Cigar"
  description="Your saved articles. Read later, share as a collection."
  bareChrome={true}
  noIndex={true}
>
  <link is:inline href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <div class="tnc-cinema">
    <CigarCursor />

    <main class="site-body">
      <NewspaperMasthead {...masthead} />

      <SectionFlag
        number="/09"
        section="Your Shelf"
        title={`Saved for <em>later reading.</em>`}
        status="Private · Stored in your browser · Shareable"
      />

      <section class="shelf-wrap">
        <div class="shelf-toolbar">
          <div class="shelf-count">
            <span data-shelf-count>0</span>
            <span class="shelf-count-label">articles saved</span>
          </div>
          <div class="shelf-actions">
            <button type="button" class="reader-tool" id="copyShareUrl" data-hover>
              Copy share URL
            </button>
            <a href="/blog/" class="reader-tool" data-hover>Back to the Magazine →</a>
          </div>
        </div>

        <div id="shelfList" class="shelf-list">
          <!-- Populated by client script -->
        </div>

        <div id="shelfEmpty" class="shelf-empty">
          <div class="shelf-empty-mark">◆</div>
          <h2>Your shelf is <em>empty.</em></h2>
          <p>Open any article, tap <strong>Save to shelf</strong>, and it lands here. Read at your pace, share the collection when you want. Nothing goes to a server — everything's in your browser.</p>
          <a href="/blog/" class="reader-tool" data-hover>Browse the Magazine →</a>
        </div>
      </section>

      <section class="footer-strip">
        <div class="footer-strip-inner">
          <div>
            <a href="/" class="footer-strip-mark" data-hover>The Next Cigar</a>
            <div class="footer-strip-tag">The Anthology of the Leaf &middot; Malmö · Lisbon</div>
          </div>
          <div class="footer-strip-links">
            <a href="/finder/" data-hover>Finder</a>
            <a href="/lounge/" data-hover>Lounge</a>
            <a href="/blog/" data-hover>Magazine</a>
            <a href="/shop/" data-hover>Shop</a>
            <a href="/about/" data-hover>About</a>
            <a href="/contact/" data-hover>Contact</a>
          </div>
        </div>
        <div class="footer-strip-copy">
          <span>© 2025–2026 The Next Cigar</span>
          <a href="https://turquinostudios.com" target="_blank" rel="noopener" class="footer-turquino" data-hover>
            <img src="/cinematic/turquino-mark.jpg" alt="" />
            <span>Designed by <em>Turquino Studios</em></span>
          </a>
        </div>
      </section>
    </main>
  </div>

  <script is:inline>
    (function () {
      const list = document.getElementById("shelfList");
      const empty = document.getElementById("shelfEmpty");
      const btnCopy = document.getElementById("copyShareUrl");

      // Support shared shelves via ?ids=slug1,slug2,slug3
      const params = new URLSearchParams(window.location.search);
      const sharedIds = params.get("ids")?.split(",").filter(Boolean) || [];

      function render() {
        // Merge local shelf + shared shelf if URL has ?ids=
        const local = (function () {
          try { return JSON.parse(localStorage.getItem("tnc_shelf") || "[]"); }
          catch { return []; }
        })();

        const items = sharedIds.length
          ? sharedIds.map((slug) => local.find((s) => s.slug === slug) || { slug, title: slug.replace(/-/g, " ") })
          : local;

        list.innerHTML = "";
        if (!items.length) {
          empty.style.display = "block";
          return;
        }
        empty.style.display = "none";
        items.forEach((it, i) => {
          const row = document.createElement("a");
          row.className = "shelf-row";
          row.href = `/blog/${it.slug}/`;
          row.setAttribute("data-hover", "");
          row.innerHTML = `
            <span class="shelf-num">${String(i + 1).padStart(2, "0")}</span>
            <div class="shelf-body">
              <div class="shelf-title">${it.title || it.slug}</div>
              ${it.savedAt ? `<div class="shelf-meta">Saved ${new Date(it.savedAt).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}</div>` : ""}
            </div>
            <span class="shelf-remove" data-slug="${it.slug}" title="Remove">×</span>
            <span class="shelf-arrow">→</span>
          `;
          list.appendChild(row);
        });

        // Remove handler
        list.querySelectorAll(".shelf-remove").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            const slug = btn.getAttribute("data-slug");
            if (window.tnc && window.tnc.shelf) {
              window.tnc.shelf.remove(slug);
              render();
            }
          });
        });
      }

      if (btnCopy) {
        btnCopy.addEventListener("click", () => {
          if (!window.tnc || !window.tnc.shelf) return;
          const url = window.tnc.shelf.shareUrl();
          navigator.clipboard.writeText(url).then(() => {
            btnCopy.textContent = "Copied ✓";
            setTimeout(() => (btnCopy.textContent = "Copy share URL"), 1600);
          });
        });
      }

      // Wait a tick for reader-tools.js to init
      setTimeout(render, 50);
      window.addEventListener("storage", render);
    })();
  </script>
</BaseLayout>

<style>
  .site-body { padding-bottom: 40px; }
  .shelf-wrap { max-width: 900px; margin: 0 auto; padding: 48px 40px 80px; }

  .shelf-toolbar {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: 20px; margin-bottom: 32px;
    border-bottom: 4px double var(--news-ink); flex-wrap: wrap; gap: 16px;
  }
  .shelf-count { display: flex; align-items: baseline; gap: 10px; }
  .shelf-count span[data-shelf-count] {
    font-family: var(--news-serif); font-weight: 700;
    font-size: clamp(2.4rem, 4vw, 3.6rem); line-height: 1;
    letter-spacing: -0.028em; color: var(--news-oxblood);
  }
  .shelf-count-label {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--news-ink-mute);
  }
  .shelf-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }

  .shelf-list { display: flex; flex-direction: column; }
  .shelf-row {
    display: grid; grid-template-columns: 40px 1fr auto auto;
    gap: 20px; align-items: center;
    padding: 20px 8px 20px 4px;
    border-bottom: 1px solid var(--news-rule);
    transition: padding-left 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .shelf-row:hover { padding-left: 12px; }
  .shelf-row:hover .shelf-title { color: var(--news-oxblood); }
  .shelf-num {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.14em;
    color: var(--news-oxblood);
  }
  .shelf-title {
    font-family: var(--news-serif); font-weight: 500; font-size: 18px;
    line-height: 1.25; letter-spacing: -0.012em; color: var(--news-ink);
    transition: color 0.2s;
  }
  .shelf-meta {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--news-ink-mute); margin-top: 4px;
  }
  .shelf-remove {
    font-family: var(--news-mono); font-size: 20px; line-height: 1;
    color: var(--news-ink-mute); padding: 4px 8px; border: 1px solid transparent;
    transition: all 0.2s;
  }
  .shelf-remove:hover {
    color: var(--news-paper); background: var(--news-oxblood); border-color: var(--news-oxblood);
  }
  .shelf-arrow { font-family: var(--news-mono); color: var(--news-ink-mute); }

  .shelf-empty {
    display: none; text-align: center; padding: 80px 24px;
    max-width: 560px; margin: 0 auto;
  }
  .shelf-empty-mark {
    font-family: var(--news-serif); font-size: 32px;
    color: var(--news-oxblood); margin-bottom: 20px;
  }
  .shelf-empty h2 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.8rem, 3vw, 2.4rem); line-height: 1.05;
    letter-spacing: -0.02em; margin: 0 0 20px;
  }
  .shelf-empty h2 :global(em) { font-style: italic; color: var(--news-oxblood); font-weight: 400; }
  .shelf-empty p {
    font-family: var(--news-serif); font-style: italic;
    font-size: 16px; line-height: 1.55; color: var(--news-ink-soft);
    margin: 0 0 28px;
  }

  .footer-strip { max-width: 1520px; margin: 0 auto; padding: 40px 40px 24px; }
  .footer-strip-inner {
    display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center;
    padding-bottom: 20px; border-bottom: 1px solid var(--news-rule);
  }
  .footer-strip-mark { font-family: var(--news-serif); font-weight: 600; font-size: 22px; letter-spacing: -0.008em; color: var(--news-ink); display: block; }
  .footer-strip-tag { font-family: var(--news-serif); font-style: italic; font-size: 13px; color: var(--news-ink-mute); margin-top: 2px; }
  .footer-strip-links { display: flex; gap: 24px; flex-wrap: wrap; font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--news-ink-mute); }
  .footer-strip-links a { padding: 4px 0; border-bottom: 1px solid transparent; transition: all 0.2s; }
  .footer-strip-links a:hover { color: var(--news-oxblood); border-bottom-color: var(--news-oxblood); }
  .footer-strip-copy { margin-top: 16px; font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--news-ink-mute); }

  @media (max-width: 900px) {
    .shelf-wrap, .footer-strip { padding: 32px 20px; }
    .footer-strip-inner { grid-template-columns: 1fr; gap: 20px; }
    .shelf-row { grid-template-columns: 32px 1fr auto; }
    .shelf-arrow { display: none; }
  }
</style>
