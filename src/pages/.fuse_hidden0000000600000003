---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/newspaper.css";
import CigarCursor from "../components/newspaper/CigarCursor.astro";
import NewspaperMasthead from "../components/newspaper/NewspaperMasthead.astro";
import SectionFlag from "../components/newspaper/SectionFlag.astro";

const authors = await getCollection("authors");
const author = authors[0];


---

<BaseLayout
  title="About — The Next Cigar"
  description="Why this magazine exists, who writes it, and what we believe about good cigars."
  bareChrome={true}
>
  <link is:inline href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <div class="tnc-cinema">
    <CigarCursor />

    <main class="site-body">
      <NewspaperMasthead {...masthead} />

      <SectionFlag
        number="/05"
        section="About"
        title={`The people behind <em>the paper.</em>`}
        status="Malmö · Lisbon · Since 2025"
      />

      <article class="prose-wrap">
        <div class="lead-eyebrow">Editorial statement</div>
        <h1>A modern home for the cigar aficionado.</h1>
        <p class="standfirst">
          The cigar world is older than most magazines. The way it gets covered is not. The Next Cigar exists because people who actually smoke deserve writing that respects them — and a place that treats the leaf, the makers, and the rituals around them with the same seriousness as the cigar itself.
        </p>

        <div class="prose-body">
          <p>News on the brands, regulators, and factories that move the industry. Long reads on the history and culture of cigars and the people who make them. Practical writing for people who want to smoke better — not louder. Coverage of events worth your travel and shops worth your visit.</p>

          <h2>Editorial. Independent. Practical.</h2>
          <p>Every piece we publish sits under one of four rooms: <a href="/finder/">The Finder</a> tracks live retailer prices across Europe. <a href="/lounge/">The Lounge</a> is where members find each other in a city. <a href="/blog/">The Magazine</a> is where the long reads live. <a href="/shop/">The Shop</a> is our own small line — cedar tubes, concrete ashtrays, and the <a href="/shop/">Guatabey guayabera</a>.</p>

          <p>We take money from readers, not from advertisers. When we accept sponsorship it's labelled and it's for products we'd carry ourselves. When we make a mistake we say so on the same page — corrections are noted, not buried.</p>

          <h2>Who writes it.</h2>
          {author && (
            <p>
              <strong>{author.data?.name || "Cristian Ortiz Suárez"}</strong> is the founder + editor. Cuban-Portuguese, based between Malmö and Lisbon. Writes about the leaf, the markets, and the people who shape the European Habanos world. Formerly Turquino Studios.
            </p>
          )}

          <h2>Get in touch.</h2>
          <p>Story tips, brand pitches, partnership ideas, corrections: <a href="mailto:contact@thenextcigar.com">contact@thenextcigar.com</a>.</p>
        </div>
      </article>

      <section class="footer-strip">
        <div class="footer-strip-inner">
          <div>
            <a href="/" class="footer-strip-mark" data-hover>The Next Cigar</a>
            <div class="footer-strip-tag">The Anthology of the Leaf &middot; Malmö · Lisbon</div>
          </div>
          <div class="footer-strip-links">
            <a href="/finder/" data-hover>Finder</a>
            <a href="/lounge/" data-hover>Lounge</a>
            <a href="/blog/" data-hover>Magazine</a>
            <a href="/shop/" data-hover>Shop</a>
            <a href="/about/" data-hover>About</a>
            <a href="/contact/" data-hover>Contact</a>
          </div>
        </div>
        <div class="footer-strip-copy">© 2025–2026 The Next Cigar · Cristian Ortiz Suárez</div>
      </section>
    </main>
  </div>
</BaseLayout>

<style is:global>
  .site-body { padding-bottom: 40px; }
  .prose-wrap {
    max-width: 780px; margin: 0 auto; padding: 48px 40px 80px;
  }
  .prose-wrap .lead-eyebrow {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--news-oxblood); margin-bottom: 24px;
    display: flex; align-items: center; gap: 12px;
  }
  .prose-wrap .lead-eyebrow::before {
    content: ""; width: 32px; height: 1px; background: var(--news-oxblood);
  }
  .prose-wrap h1 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(2.2rem, 4.4vw, 4rem); line-height: 1.0;
    letter-spacing: -0.028em; color: var(--news-ink); margin: 0 0 28px;
  }
  .prose-wrap .standfirst {
    font-family: var(--news-serif); font-style: italic;
    font-size: clamp(1.1rem, 1.6vw, 1.4rem); line-height: 1.55;
    color: var(--news-ink-soft); margin: 0 0 40px;
    padding-bottom: 32px; border-bottom: 1px solid var(--news-rule);
  }
  .prose-body {
    font-family: var(--news-serif); font-size: 18px; line-height: 1.68;
    color: var(--news-ink);
  }
  .prose-body > p:first-of-type::first-letter {
    font-family: var(--news-serif); font-weight: 700;
    font-size: 5.2em; line-height: 0.85; float: left;
    margin: 0.05em 10px -0.05em 0; color: var(--news-oxblood);
  }
  .prose-body p { margin: 0 0 1.35em; }
  .prose-body h2 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.1;
    letter-spacing: -0.018em; color: var(--news-ink);
    margin: 2em 0 0.6em; padding-top: 1em; border-top: 1px solid var(--news-rule);
  }
  .prose-body a {
    color: var(--news-oxblood); border-bottom: 1px solid var(--news-oxblood);
    padding-bottom: 1px;
  }
  .prose-body a:hover { color: var(--news-ember); border-bottom-color: var(--news-ember); }
  .prose-body strong { font-weight: 600; }

  .footer-strip { max-width: 1520px; margin: 0 auto; padding: 40px 40px 24px; }
  .footer-strip-inner {
    display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center;
    padding-bottom: 20px; border-bottom: 1px solid var(--news-rule);
  }
  .footer-strip-mark {
    font-family: var(--news-serif); font-weight: 600; font-size: 22px;
    letter-spacing: -0.008em; color: var(--news-ink); display: block;
  }
  .footer-strip-tag {
    font-family: var(--news-serif); font-style: italic; font-size: 13px;
    color: var(--news-ink-mute); margin-top: 2px;
  }
  .footer-strip-links {
    display: flex; gap: 24px; flex-wrap: wrap;
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--news-ink-mute);
  }
  .footer-strip-links a { padding: 4px 0; border-bottom: 1px solid transparent; transition: all 0.2s; }
  .footer-strip-links a:hover { color: var(--news-oxblood); border-bottom-color: var(--news-oxblood); }
  .footer-strip-copy {
    margin-top: 16px;
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.16em;
    color: var(--news-ink-mute);
  }
  @media (max-width: 900px) {
    .prose-wrap, .footer-strip { padding: 32px 20px; }
    .footer-strip-inner { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
