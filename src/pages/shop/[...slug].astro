---
import { getCollection, render } from "astro:content";
import PaperLayout from "../../layouts/PaperLayout.astro";
import WelcomeBox from "../../components/shop/WelcomeBox.astro";
import { TIERS, TIER_LINE } from "../../../functions/api/shop/pricing";
import CartBar from "../../components/shop/CartBar.astro";
import ServiceStrip from "../../components/shop/ServiceStrip.astro";

/** /shop/[slug]/
 *  The client sends only the slug; price, name and supplier are resolved
 *  server-side from catalogue.json by /api/shop/checkout. */
export async function getStaticPaths() {
  const products = (await getCollection("products")).filter((p) => !p.data.isArchived);
  return products.map((p) => ({ params: { slug: p.data.slug }, props: { product: p } }));
}
const { product } = Astro.props;
const { Content } = await render(product);
const d: any = product.data;
const img = (c: any) => (!c ? "" : typeof c === "string" ? c : c.src);
const cover = img(d.cover);
const gallery: string[] = [cover, ...((d.gallery ?? []).map(img))].filter((x, i, a) => x && a.indexOf(x) === i);
// Structured data needs absolute image URLs. Astro emits /_astro/… for images
// it processes, and Google silently drops a listing whose image it cannot
// resolve — which is a listing that never appears in a product result.
const abs = (u: string) => (u.startsWith("http") ? u : `https://thenextcigar.com${u}`);
const galleryAbs = gallery.map(abs);
const sym = d.currency === "EUR" ? "€" : d.currency === "GBP" ? "£" : "$";
// One price, in the list currency (USD), for every country we ship to.
// Checkout charges exactly this; the customer's bank does any conversion.
const OFFERS = [{ cur: d.currency || "USD", price: d.price, region: ["SE","PT","DE","FR","IT","ES","NL","BE","DK","FI","IE","AT","GB","CH","US","CA","NO"] }];
const soon = !!d.comingSoon;
const buyable = !soon && d.inStock;
const etaT = Date.parse(`1 ${d.expectedArrival ?? ""}`);
const eta = d.expectedArrival && !isNaN(etaT) && etaT + 31 * 86400e3 > Date.now() ? `Expected ${d.expectedArrival}` : "Price when it lands";
const allLive = (await getCollection("products")).filter((p) => !p.data.isArchived && !p.data.comingSoon && p.data.inStock && p.data.slug !== d.slug);
// "Goes with it": curated slugs from the entry; otherwise the natural pairing by kind.
const PAIR: Record<string, string[]> = { lighter: ["cutter", "ashtray"], cutter: ["lighter", "case", "humidor"], humidor: ["accessories", "cutter"], case: ["cutter", "accessories"], ashtray: ["lighter", "cutter"], accessories: ["humidor", "case"] };
const wanted: string[] = (d.related ?? []) as string[];
let goesWith = wanted.map((s) => allLive.find((p) => p.data.slug === s)).filter(Boolean) as typeof allLive;
if (goesWith.length < 3) for (const k of PAIR[d.category] ?? []) for (const p of allLive) if (goesWith.length < 3 && (p.data as any).category === k && !goesWith.includes(p)) goesWith.push(p);
const others = (await getCollection("products")).filter((p) => !p.data.isArchived && p.data.slug !== d.slug && (p.data as any).category === d.category).slice(0, 3);
const url = `https://thenextcigar.com/shop/${d.slug}/`;
// Google warns on an offer with no priceValidUntil and treats a past date as
// an expired price. A year out, recomputed at every build, is honest for a
// list price we review rather than schedule.
const priceValidUntil = new Date(Date.now() + 365 * 86400e3).toISOString().slice(0, 10);
// The countries checkout.ts will accept a shipping address for. Kept here so
// the structured data cannot drift away from what the shop actually does.
const SHIP_TO = ["SE","PT","DE","FR","IT","ES","NL","BE","DK","FI","IE","AT","GB","CH","US","CA","NO"];
const jsonLd = { "@context": "https://schema.org", "@graph": [
  { "@type": "Product", name: d.name, description: d.excerpt || d.name, image: galleryAbs, url,
    sku: d.sku,
    mpn: d.mpn || d.sku,
    brand: { "@type": "Brand", name: d.brand || "The Next Cigar" },
    ...(d.gtin ? { gtin: d.gtin } : {}),
    ...(buyable && { offers: OFFERS.map((o) => ({
      "@type": "Offer", price: o.price, priceCurrency: o.cur,
      eligibleRegion: o.region.map((c) => ({ "@type": "Country", name: c })),
      availability: "https://schema.org/InStock",
      itemCondition: "https://schema.org/NewCondition",
      priceValidUntil, url,
      // Google marks an item ineligible for merchant listings without both of
      // these. They are not decoration: every figure below is the policy on
      // /shipping-and-returns/, and if that page changes these change with it.
      shippingDetails: {
        "@type": "OfferShippingDetails",
        shippingRate: { "@type": "MonetaryAmount", value: 0, currency: o.cur },
        // Exactly the countries checkout.ts accepts a shipping address for.
        // If that list changes, this one changes — a schema that promises
        // delivery somewhere the checkout refuses is a lie Google indexes.
        shippingDestination: o.region.map((c) => ({ "@type": "DefinedRegion", addressCountry: c })),
        deliveryTime: {
          "@type": "ShippingDeliveryTime",
          // The supplier dispatches within a couple of days; the long pole is
          // the freight, which is the 1-2 weeks the product pages state.
          handlingTime: { "@type": "QuantitativeValue", minValue: 1, maxValue: 3, unitCode: "DAY" },
          transitTime: { "@type": "QuantitativeValue", minValue: 7, maxValue: 14, unitCode: "DAY" },
        },
      },
      hasMerchantReturnPolicy: {
        "@type": "MerchantReturnPolicy",
        applicableCountry: o.region,
        returnPolicyCategory: "https://schema.org/MerchantReturnFiniteReturnWindow",
        merchantReturnDays: 14,
        returnMethod: "https://schema.org/ReturnByMail",
        // The customer pays return postage unless the item was faulty, which is
        // lawful in the EU only because /shipping-and-returns/ says so before
        // the sale. Do not change one without the other.
        returnFees: "https://schema.org/ReturnShippingFees",
        merchantReturnLink: "https://thenextcigar.com/shipping-and-returns/",
      },
    })) }) },
  { "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Shop", item: "https://thenextcigar.com/shop/" }, { "@type": "ListItem", position: 2, name: d.name, item: url } ] },
] };
---

<PaperLayout title={`${d.name} · The Shop · The Next Cigar`} description={d.seo?.metaDescription || d.excerpt || d.name} image={cover} section="shop" compact={true} ogType="product" jsonLd={jsonLd}>
  <p class="miga">Shop · <a href="/shop/">all goods</a>{d.category && <> · {d.category}</>}</p>
  <div class="product">
    <div class="gal">
      {cover ? <img src={cover} alt={d.name} width="900" height="900" fetchpriority="high" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'stamp',textContent:'Photographed when it lands'}))" /> : <div class="ph" style="aspect-ratio:1;border:1px solid var(--rule);display:flex;align-items:center;justify-content:center"><span class="stamp">Photographed when it lands</span></div>}
      {gallery.length > 1 && <div class="thumbs">{gallery.slice(1, 6).map((g) => <img src={g} alt="" width="200" height="200" loading="lazy" />)}</div>}
    </div>
    <div>
      <span class="kick">{soon ? "In the pipeline" : buyable ? "Available" : "Sold out"}{d.sku ? ` · ${d.sku}` : ""}</span>
      <h1>{d.name}</h1>
      {d.excerpt && <p class="deck">{d.excerpt}</p>}
      {buyable ? (
        <>
          <p class="price">{sym}{d.price}{d.compareAtPrice && <s>{sym}{d.compareAtPrice}</s>}</p>
          <p class="fine" style="margin-top:-6px">Charged in US dollars. Free tracked delivery, duties and VAT included.</p>
          <div class="buybox">
            <div class="qtyrow">
              <span class="qtyrow__label">Quantity</span>
              <div class="stepper" role="group" aria-label="Quantity">
                <button type="button" class="stepper__btn" data-step="-1" aria-label="Fewer">−</button>
                <input id="qty" type="number" min="1" max="6" value="1" inputmode="numeric" aria-label="Quantity">
                <button type="button" class="stepper__btn" data-step="1" aria-label="More">+</button>
              </div>
              <span class="qtyrow__note">{TIER_LINE}</span>
            </div>
            <div class="buyrow">
              <button type="button" class="buy" id="add" data-slug={d.slug}>Add to cart</button>
              <button type="button" class="buy buy--ghost" id="buy" data-slug={d.slug} data-price={d.price} data-sym={sym}>Buy now <span class="arrow">→</span></button>
            </div>
            <p class="buy-status" id="buy-status" aria-live="polite"></p>
            <ServiceStrip />
          <WelcomeBox source="product" compact />
          </div>
          <noscript><p class="note">Checkout needs JavaScript: the button opens a Stripe payment page. With scripts off, email <a href="mailto:orders@thenextcigar.com">orders@thenextcigar.com</a> and we send a payment link.</p></noscript>
        </>
      ) : (
        <>
          <p class="price" style="font-size:22px">{soon ? eta : "Sold out"}</p>
          <a class="cta" href="/lounge/signup/" style="display:block;text-align:center">Tell me when it's available →</a>
          <p class="fine">No button until we have held it, photographed it and confirmed stock.</p>
        </>
      )}
    </div>
  </div>

  <div class="artbody">
    <aside class="side">
      <details class="acc" open><summary class="t">The file</summary>
      <dl>
        {d.category && <><dt>Kind</dt><dd style="text-transform:capitalize">{d.category}</dd></>}
        {d.weight && <><dt>Weight</dt><dd>{d.weight} g</dd></>}
        <dt>Ships</dt><dd>{d.requiresShipping ? "EU, UK, CH, NO, US, CA" : "Digital"}</dd>
      </dl>
      </details>
      {others.length > 0 && (<details class="acc" open><summary class="t">Also in this drawer</summary><ul class="eds">{others.map((p) => (<li><a href={`/shop/${p.data.slug}/`}>{p.data.name}</a></li>))}</ul></details>)}
    </aside>
    <details class="acc prose-acc" open><summary class="t">About this piece</summary><div class="prose"><Content /></div></details>
  </div>

  {goesWith.length > 0 && (
    <section class="goes">
      <p class="t">Goes with it</p>
      <div class="goes__row">
        {goesWith.map((p) => { const pd: any = p.data; const c = img(pd.cover); return (
          <a class="goes__card" href={`/shop/${pd.slug}/`}>
            {c ? <img src={c} alt="" width="300" height="300" loading="lazy" /> : <span class="goes__ph" />}
            <span class="goes__name">{pd.name}</span>
            <span class="goes__price">{pd.currency === "EUR" ? "€" : pd.currency === "GBP" ? "£" : "$"}{pd.price}</span>
          </a>
        ); })}
      </div>
    </section>
  )}

  {buyable && (
    <script is:inline>
      (function () {
        var btn = document.getElementById("buy"), add = document.getElementById("add"), st = document.getElementById("buy-status"), qty = document.getElementById("qty");
        if (!btn) return;
        var price = Number(btn.dataset.price), sym = btn.dataset.sym;
        function n() { var v = Math.round(Number(qty && qty.value || 1)); return Math.max(1, Math.min(6, isNaN(v) ? 1 : v)); }
        function refresh() { if (qty) qty.value = String(n()); var k = n(); btn.innerHTML = (k > 1 ? "Buy " + k + " now — " + sym + (Math.round(price * k * 100) / 100) : "Buy now — " + sym + price) + " <span class=\"arrow\">→</span>"; }
        if (qty) { qty.addEventListener("change", refresh); qty.addEventListener("input", refresh); refresh(); }
        document.querySelectorAll(".stepper__btn").forEach(function (b) { b.addEventListener("click", function () { qty.value = String(n() + Number(b.dataset.step)); refresh(); }); });
        if (add) add.addEventListener("click", function () {
          if (!window.TNCCart) return;
          window.TNCCart.add(add.dataset.slug, n());
          var t = window.TNCCart.totals();
          st.innerHTML = "<b>Added.</b> " + t.pieces + (t.pieces === 1 ? " piece" : " pieces") + " in your cart" + (t.pct ? ", " + t.pct + "% off the total" : "") + ". <a href=\"/shop/cart/\">View cart →</a>";
          add.textContent = "Added ✓"; setTimeout(function () { add.textContent = "Add to cart"; }, 1400);
        });
        btn.addEventListener("click", async function () {
          if (btn.disabled) return;
          var orig = btn.textContent; btn.disabled = true; btn.textContent = "Opening checkout…";
          try {
            var res = await fetch("/api/shop/checkout", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ items: [{ slug: btn.dataset.slug, quantity: n() }] }) });
            var data = await res.json();
            if (data.ok && data.url) { window.location.href = data.url; return; }
            st.textContent = data.error || "Checkout failed — try again.";
          } catch (e) { st.textContent = "Network error — try again."; }
          btn.disabled = false; btn.textContent = orig;
        });
      })();
    </script>
  )}
  {buyable && (
    <div class="buy-sticky" id="buy-sticky" hidden>
      <span class="buy-sticky__price">{sym}{d.price}</span>
      <button type="button" class="buy add" id="add-sticky">Add to cart</button>
      <a class="buy-sticky__cart cart-top" href="/shop/cart/" aria-label="Cart"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 4h2.6l2.3 10.4a1.6 1.6 0 0 0 1.6 1.3h8.4a1.6 1.6 0 0 0 1.6-1.2L21 7.5H6.2"/><circle cx="10" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg><span class="cart-top__n" data-cart-count hidden></span></a>
    </div>
  )}
  <CartBar />
  <script is:inline>
    // Phone: when the buy buttons scroll away, a slim bar with the price and
    // Add to cart stays at the bottom (the cart bar yields to it).
    (function () {
      var s = document.getElementById("buy-sticky"), add = document.getElementById("add"), a2 = document.getElementById("add-sticky"), m = window.matchMedia("(max-width: 640px)");
      if (!s || !add || !("IntersectionObserver" in window)) return;
      var out = false;
      function set() { s.hidden = !(m.matches && out); var cb = document.getElementById("cart-bar"); if (cb) cb.classList.toggle("yield", !s.hidden); }
      new IntersectionObserver(function (es) { out = !es[0].isIntersecting && es[0].boundingClientRect.top < 0; set(); }, { threshold: 0 }).observe(add);
      m.addEventListener ? m.addEventListener("change", set) : m.addListener(set);
      if (a2) a2.addEventListener("click", function () { add.click(); a2.textContent = "Added ✓"; setTimeout(function () { a2.textContent = "Add to cart"; }, 1600); });
    })();
    // Amazon-style: on a phone the sections start folded (first one open);
    // on a wide screen they are always open and the summaries act as headings.
    (function () {
      var m = window.matchMedia("(max-width: 640px)"), acc = document.querySelectorAll("details.acc");
      function set() { acc.forEach(function (d, i) { d.open = !m.matches || d.classList.contains("prose-acc"); }); }
      set(); m.addEventListener ? m.addEventListener("change", set) : m.addListener(set);
    })();
  </script>
</PaperLayout>
