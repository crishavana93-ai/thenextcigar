---
import PaperLayout from "../../layouts/PaperLayout.astro";

/**
 * /shop/
 *
 * 19 Oct 2026: the drop-ship accessory shop is closed. The same pieces were
 * cheaper on Amazon, so the guides now link readers there (affiliate,
 * disclosed). This page keeps the address alive for what only the paper can
 * make — the Guatabey guayabera and the paper's own goods — and sends anyone
 * looking for gear to the tested guides. The old checkout code is kept in
 * the repo (functions/api/shop, src/pages/shop/[...slug].astro), switched off
 * by every product being isArchived.
 */
const guides = [
  { href: "/blog/best-cigar-lighters-2026/", kick: "Lighters", t: "Best cigar lighters of 2026", d: "Single-jet, double-jet and the budget workhorse, picked for real-world smokers." },
  { href: "/blog/best-cigar-cutters-2026/", kick: "Cutters", t: "Best cigar cutters of 2026", d: "Guillotine, V-cut and punch: which cut suits which Cuban, and the cutters worth owning." },
  { href: "/blog/cigar-travel-cases-which-to-buy-2026/", kick: "Travel cases", t: "Leather fingers, tubes or a hard humidor?", d: "What each kind of case does to the cigars inside after a day, a weekend and a week." },
  { href: "/blog/how-to-store-cuban-cigars-65-not-70/", kick: "Storage", t: "How to store Cuban cigars: 65%, not 70%", d: "Humidity, hygrometers and the cheapest setup that keeps a box right." },
  { href: "/blog/best-cigar-gifts-under-100/", kick: "Gifts", t: "Best cigar gifts under $100", d: "For the smoker who already has a cutter." },
];
const jsonLd = { "@context": "https://schema.org", "@type": "CollectionPage", name: "The Shop · The Next Cigar", url: "https://thenextcigar.com/shop/" };
---

<PaperLayout title="The Shop · The Next Cigar" description="The Next Cigar's own goods: the Guatabey guayabera, in the making. For cutters, lighters, cases and humidors, our buying guides link to where they cost least." section="shop" compact={true} jsonLd={jsonLd}>
  <div class="dateline">
    <h1>The Shop <em>— what only we make.</em></h1>
    <p class="st">No tobacco sold here · no accessories either, for now</p>
  </div>

  <section class="band" style="padding-top:0">
    <p class="deck" style="max-width:64ch">We used to sell cutters, lighters and cases shipped from our supplier. The same pieces cost less elsewhere, so we stopped: a paper that tells you where a Cohiba is cheapest should not charge you double for the lighter. Our guides now point you to where each piece costs least, with the affiliate links labelled. What we will sell here is what nobody else can.</p>
  </section>

  <section class="gb">
    <div>
      <span class="kick">Guatabey · in the making</span>
      <h2>Guatabey. <em>A guayabera, done properly.</em></h2>
      <p class="deck">Our own guayabera, cut in the Cuban tradition. We are working on the first small run now; when the shirts exist you will see the real ones here, photographed, with the maker named.</p>
      <dl class="file" style="display:grid;grid-template-columns:1fr 1fr;gap:0 24px">
        <div><dt>What</dt><dd style="font-size:15px">A four-pocket guayabera, Cuban cut</dd></div>
        <div><dt>How many</dt><dd style="font-size:15px">A small numbered run</dd></div>
        <div><dt>Where</dt><dd style="font-size:15px">The maker is named when the run is confirmed</dd></div>
        <div><dt>Who first</dt><dd style="font-size:15px">Lounge members, then everyone</dd></div>
      </dl>
      <a class="cta" href="/lounge/signup/">Tell me when it's ready →</a>
    </div>
    <div class="mark"><b>GB</b><small>Guatabey (n.) — Taíno for chief. The first people to smoke tobacco.</small></div>
  </section>

  <section class="band" aria-label="Accessory guides">
    <div class="rulehead flat"><h2>Looking for gear? <em>· the tested guides</em></h2><a class="more" href="/category/cigar-accessories/">All accessory pieces →</a></div>
    <div class="three">
      {guides.map((g) => (
        <article><span class="kick">{g.kick}</span><a class="head" href={g.href} style="display:block;margin-top:6px;font-size:22px;line-height:1.15">{g.t}</a><p class="t" style="margin-top:8px">{g.d}</p></article>
      ))}
    </div>
  </section>
</PaperLayout>
