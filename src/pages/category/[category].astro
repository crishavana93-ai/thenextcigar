---
import { getCollection } from "astro:content";
import { srcFor, srcsetFor } from "../../lib/img";
import PaperLayout from "../../layouts/PaperLayout.astro";

/** /category/[slug]/
 *  A section front: lead piece, then the dated index. cigar-events has its own page. */
export async function getStaticPaths() {
  const cats = await getCollection("categories");
  return cats.filter((c) => c.data.slug !== "cigar-events").map((c) => ({ params: { category: c.data.slug }, props: { cat: c.data } }));
}
const { cat } = Astro.props;
const posts = (await getCollection("blog"))
  .filter((p) => !(p.data as any).draft && p.data.category === cat.slug)
  .sort((a, b) => Date.parse(b.data.publishedAt as any) - Date.parse(a.data.publishedAt as any));
const authors = await getCollection("authors");
const by = (slug?: string) => (authors.find((a) => a.id === slug || (a.data as any).slug === slug)?.data as any)?.name ?? "The Next Cigar";
const cover = (p: (typeof posts)[number]) => { const c: any = p.data.cover; return !c ? undefined : typeof c === "string" ? c : c.src; };
const [lead, ...rest] = posts;
const cats = (await getCollection("categories")).filter((c) => c.data.slug !== cat.slug);
const fmt = (d: any, long = false) => new Date(d).toLocaleDateString("en-GB", long ? { day: "numeric", month: "long", year: "numeric" } : { day: "numeric", month: "short" });
const jsonLd = { "@context": "https://schema.org", "@type": "CollectionPage", name: cat.name, url: `https://thenextcigar.com/category/${cat.slug}/`, isPartOf: { "@type": "WebSite", url: "https://thenextcigar.com/" } };
---

<PaperLayout title={`${cat.name} · The Next Cigar`} description={cat.description || `${posts.length} pieces filed under ${cat.name} in The Next Cigar magazine.`} section="none" compact={true} jsonLd={jsonLd}>
  <p class="miga" style="padding-bottom:0;margin-bottom:-14px">Magazine · <a href="/blog/">all sections</a></p>
  <div class="dateline">
    <h1>{cat.name}{cat.description && <em> — {cat.description}</em>}</h1>
    <p class="st">{posts.length} pieces</p>
  </div>

  {lead ? (
    <div class="front">
      <section class="lead" style="grid-column:1 / span 2;border-right:1px solid var(--rule);padding-left:0">
        <span class="kick">Latest</span>
        <h2 class="head" style="margin-top:8px"><a href={`/blog/${lead.data.slug}/`}>{lead.data.title}</a></h2>
        {lead.data.excerpt && <p class="deck">{lead.data.excerpt}</p>}
        <p class="by">By {by(lead.data.author)} · {fmt(lead.data.publishedAt, true)}</p>
        {cover(lead) && <figure><a href={`/blog/${lead.data.slug}/`} aria-hidden="true" tabindex="-1"><img class="foto" src={srcFor(cover(lead), 1024)} srcset={srcsetFor(cover(lead))} sizes="(max-width: 900px) 100vw, 620px" alt="" width="1200" height="675" fetchpriority="high" /></a></figure>}
        <ul class="list" style="margin-top:18px">
          {rest.map((p) => (
            <li style="grid-template-columns:1fr auto;gap:18px;align-items:baseline">
              <div><a class="head" style="font-size:20px" href={`/blog/${p.data.slug}/`}>{p.data.title}</a>{p.data.excerpt && <p class="by" style="margin-top:4px">{p.data.excerpt.slice(0, 130)}…</p>}</div>
              <span class="by" style="white-space:nowrap">{fmt(p.data.publishedAt)}</span>
            </li>
          ))}
        </ul>
      </section>
      <aside class="rail">
        <div class="rulehead"><h2>Other sections</h2></div>
        <ul class="eds">{cats.map((c) => (<li><a href={c.data.slug === "cigar-events" ? "/category/cigar-events/" : `/category/${c.data.slug}/`}>{c.data.name}</a></li>))}</ul>
        <div class="box"><span class="kick">The paper, by email</span><h3 class="head">One dispatch, when there's something to say.</h3><a class="cta" href="/subscribe/">Get the newsletter</a></div>
      </aside>
    </div>
  ) : (
    <div class="box"><span class="kick">{cat.name}</span><h3 class="head">Nothing filed here yet.</h3><p>Try the <a href="/blog/">Magazine</a>.</p></div>
  )}
</PaperLayout>
