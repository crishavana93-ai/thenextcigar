---
/**
 * /lounge — public landing page for The Lounge.
 *
 * As of May 2026 the product is LIVE — public Finder, member app, watchlist
 * alerts, OG Member tier. This page is the conversion funnel: explains what
 * The Lounge actually is today (price-tracking + IRL community), the three
 * tiers (Free / Lounge / OG Member), and lands the OG-Member cutoff
 * (1 June 2026) without making it feel like a fake-urgency hustle.
 *
 * Older draft (pre-Finder, "launching Q3 2026", WhatsApp-beta language) has
 * been rewritten — keep the styles below, the cities band, and the FAQ
 * shell, but every word that promises a future product has been replaced
 * with what's actually shipping.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { places } from "../data/cigar-places";
import {
  SKUS as FINDER_SKUS,
  RETAILERS as FINDER_RETAILERS,
  PRICE_SNAPSHOTS as FINDER_SNAPSHOTS,
  COUNTRIES as FINDER_COUNTRIES,
} from "../data/finder-data";
import MagazineMasthead from "../components/ui/MagazineMasthead.astro";
import EditorialSectionHead from "../components/ui/EditorialSectionHead.astro";
import WordStaggerHeadline from "../components/ui/WordStaggerHeadline.tsx";

const heroPlaces = places.slice(0, 6);
const cityCount = new Set(places.map((p) => p.city)).size;

// Pull live counts so the Finder pitch isn't built on stale promises.
const skuCount       = FINDER_SKUS.length;
const retailerCount  = FINDER_RETAILERS.length;
const snapshotCount  = FINDER_SNAPSHOTS.length;
const countryCount   = FINDER_COUNTRIES.length;
---

<BaseLayout
  title="The Lounge — Cuban cigar price tracking + members' network"
  description={`The Next Cigar's members' room. Track ${snapshotCount} Cuban cigar prices across ${retailerCount} European retailers, get drop alerts, and find verified members at the lounge tonight. From $9/month or free for everything public.`}
>
  {/* Direction A — magazine masthead (different label than / to mark room) */}
  <MagazineMasthead
    volume="Volume III"
    issue="Issue 04 · The Lounge"
    date="May 2026"
    tagline="A private network of European Cuban-cigar smokers. Members' room behind the magazine."
  />

  {/* ─── HERO — Direction A (Vitra word-stagger + cream paper) ─── */}
  <section class="editorial relative py-16 md:py-24 lg:py-28">
    <div class="container-wide">
      <div class="max-w-5xl">
        <p class="editorial-eyebrow mb-6 md:mb-8">
          Live · OG Member tier closes 1 June 2026
        </p>

        <WordStaggerHeadline
          lines={["The room behind", "the price tag."]}
          accentLine={1}
          client:load
        />

        <p
          class="mt-10 max-w-3xl italic"
          style="font-family: var(--font-serif); font-size: clamp(1.1rem, 1.55vw, 1.32rem); line-height: 1.55; color: var(--color-ink-soft);"
        >
          The Lounge is two things in one place. <strong>The Finder</strong> tracks
          {snapshotCount.toLocaleString("en-US")} live Cuban cigar prices across
          {retailerCount} European retailers, refreshed every six hours — so you
          never overpay by €100 for a box that's cheaper at the shop next door.
          <strong>The members' app</strong> shows you which verified smokers are
          in your city tonight, where they're sitting, and which lounges abroad
          will welcome you when you land.
        </p>

        <p
          class="mt-6 max-w-3xl"
          style="font-size: 1rem; line-height: 1.65; color: var(--color-ink-muted);"
        >
          Free public Finder for everyone. Lounge membership unlocks unlimited
          watchlists, price-drop alerts, travel mode, direct messaging, and
          every feature we ship next. Sign up before 1 June and you're an
          <strong style="color: var(--color-ink);">OG Member</strong> — every paid feature, free for you, forever.
        </p>

        <div class="mt-12 flex flex-wrap items-center gap-6">
          <a
            href="/lounge/signup/"
            class="inline-flex items-center justify-center px-8 py-4 text-sm font-medium tracking-wide rounded-none transition-[transform,background,border-color] duration-200"
            style="background: var(--color-ink); color: var(--color-paper); border: 1px solid var(--color-ink);"
            onmouseover="this.style.background='var(--color-gold-hover)'; this.style.borderColor='var(--color-gold-hover)';"
            onmouseout="this.style.background='var(--color-ink)'; this.style.borderColor='var(--color-ink)';"
          >
            Become an OG Member →
          </a>
          <a
            href="/finder/"
            class="text-sm font-medium tracking-wide underline underline-offset-[6px] transition-colors duration-200"
            style="color: var(--color-ink-soft); text-decoration-color: var(--color-rule);"
          >
            Try the free Finder
          </a>
        </div>

        <p
          class="mt-10 max-w-2xl"
          style="font-size: 0.82rem; line-height: 1.55; color: var(--color-ink-muted);"
        >
          OG Member is a one-time, date-based grant — not a tier you can upgrade
          into. After 1 June 2026 the door closes and the path to a free
          membership is earned through referrals + event hosting. 21+ only.
        </p>
      </div>
    </div>
  </section>

  {/* ─── HOW IT WORKS ─── */}
  <section class="editorial container-wide py-20 border-t border-[color:var(--color-rule)]">
    <EditorialSectionHead
      eyebrow="What you get"
      title="Two products, one membership."
    />

    <div class="lounge-features">
      <div class="lounge-feature reveal">
        <span class="lounge-feature__num">01</span>
        <h3>The Finder — free for everyone</h3>
        <p>
          {snapshotCount.toLocaleString("en-US")} Cuban cigar prices across
          {retailerCount} licensed European retailers in {countryCount} countries.
          Refreshed every six hours, sorted cheapest first, click through to the
          shop. No signup. No ads. No commission padded into the price you see.
        </p>
      </div>
      <div class="lounge-feature reveal" data-reveal-delay="2">
        <span class="lounge-feature__num">02</span>
        <h3>Watchlist + drop alerts</h3>
        <p>
          Save any cigar, set a target price. The moment a retailer in your country
          drops below it, you get an email — and, for Lounge members, a push notification.
          Dedupe baked in: one alert per drop, not five copies of the same news.
        </p>
      </div>
      <div class="lounge-feature reveal" data-reveal-delay="3">
        <span class="lounge-feature__num">03</span>
        <h3>Travel mode</h3>
        <p>
          Flag your next trip. See verified members who'll be in the same city the
          same week, locals who've offered to welcome visitors, and the editorial
          map of lounges worth your time. Switch your Finder lens to that country
          so prices match what you'll actually pay on the ground.
        </p>
      </div>
      <div class="lounge-feature reveal">
        <span class="lounge-feature__num">04</span>
        <h3>Check in, see who's here</h3>
        <p>
          Walk into a partner lounge, tap "I'm here." Other verified members
          inside see you've arrived — they can wave across the room or send a
          quiet "join me?" tap. No public broadcast. No location sharing unless
          you actively check in.
        </p>
      </div>
      <div class="lounge-feature reveal" data-reveal-delay="2">
        <span class="lounge-feature__num">05</span>
        <h3>Slow messaging</h3>
        <p>
          DMs unlock only after you've been at the same lounge, been host-introduced,
          or sent a single template intro. No mass-messaging, no swipes, no hustle.
          Real-time when both members are typing, polite when only one is.
        </p>
      </div>
      <div class="lounge-feature reveal" data-reveal-delay="3">
        <span class="lounge-feature__num">06</span>
        <h3>Events + partner lounges</h3>
        <p>
          A growing roster of verified houses across Europe where Lounge members
          are recognized at the door — complimentary first coffee at most,
          members-only nights at some. RSVP to launch events, tastings, and
          travel-week pop-ups from inside the app.
        </p>
      </div>
    </div>
  </section>

  {/* ─── CITIES STRIP ─── */}
  <section class="lounge-cities-band">
    <div class="container-wide py-16 reveal">
      <p class="section-eyebrow text-[color:var(--color-text-on-dark-mute)]">Founding network</p>
      <h2 class="font-display text-3xl md:text-4xl leading-tight mt-2 text-[color:var(--color-text-on-dark)]">
        Hand-picked across {cityCount} cities. Growing every month.
      </h2>
      <div class="lounge-cities-grid">
        {heroPlaces.map((p) => (
          <div class="lounge-city-card">
            <p class="lounge-city-card__city">{p.city}</p>
            <p class="lounge-city-card__name">{p.name}</p>
            <p class="lounge-city-card__country">{p.country}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-sm text-[color:var(--color-text-on-dark-mute)]">
        Full map of partner-eligible houses on the <a href="/category/cigar-events/" class="underline hover:text-[color:var(--color-accent)]">Events &amp; Map page →</a>
      </p>
    </div>
  </section>

  {/* ─── PRICING ─── */}
  <section class="editorial container-wide py-20 border-t border-[color:var(--color-rule)]">
    <EditorialSectionHead
      eyebrow="Membership"
      title="Free to start. Pay when the Finder pays you back."
      dek="The public Finder is free forever — most Cuban cigar buyers save more than the Lounge price on their first box. The paid tier unlocks unlimited alerts, travel mode, and the members' app. Sign up before 1 June 2026 and the paid tier is free for you for life."
    />

    <div class="lounge-pricing lounge-pricing--three">
      {/* Free tier */}
      <div class="lounge-tier reveal">
        <p class="lounge-tier__name">Free</p>
        <p class="lounge-tier__price">$0<span>/forever</span></p>
        <p class="lounge-tier__pitch">For the curious. The public Finder, plus one watchlist alert — enough to feel the value before you commit.</p>
        <ul>
          <li>Full access to the public Finder — {snapshotCount.toLocaleString("en-US")} prices, {retailerCount} retailers</li>
          <li><strong>1 saved cigar</strong> with one price-drop alert by email</li>
          <li>Verified profile + flavor preferences</li>
          <li>Browse the editorial map of {cityCount}+ vetted lounges</li>
          <li>Read every event</li>
          <li>Submit shops to the map</li>
        </ul>
        <a href="/lounge/signup/" class="lounge-tier__cta">Start free →</a>
      </div>

      {/* Lounge tier — featured */}
      <div class="lounge-tier lounge-tier--featured reveal" data-reveal-delay="2">
        <span class="lounge-tier__flag">Recommended</span>
        <p class="lounge-tier__name">Lounge</p>
        <p class="lounge-tier__price">$9<span>/month</span></p>
        <p class="lounge-tier__sub">or $79/year — save $29</p>
        <p class="lounge-tier__pitch">For the traveler and the price-watcher. Everything unlocked, no caps anywhere.</p>
        <ul>
          <li>Everything in Free</li>
          <li><strong>Unlimited Finder watchlists</strong> + push notifications when a price drops</li>
          <li>Taste-matched cigar recommendations from your flavor profile</li>
          <li>90-day price history charts on every tracked SKU</li>
          <li><strong>Travel mode</strong> — switch the Finder lens to wherever you're flying</li>
          <li>Unlimited direct messages with verified members</li>
          <li>Check-ins, member matches, event RSVPs</li>
          <li>Lounge badge on profile + map</li>
        </ul>
        <a href="/lounge/signup/?intent=lounge" class="lounge-tier__cta lounge-tier__cta--primary">Start free, upgrade later →</a>
      </div>

      {/* OG Member — date-gated lifetime grant */}
      <div class="lounge-tier reveal" data-reveal-delay="3">
        <p class="lounge-tier__name">OG Member</p>
        <p class="lounge-tier__price lounge-tier__price--small">Lifetime · door closes 1 June 2026</p>
        <p class="lounge-tier__sub">Any account opened before the cutoff. Not an upgrade — a date.</p>
        <p class="lounge-tier__pitch">For the early ones. The members who showed up before the network was the network.</p>
        <ul>
          <li>Every Lounge feature, free for life</li>
          <li>Every paid feature we ship next, free for life</li>
          <li>Permanent OG Member badge — distinct from Lounge</li>
          <li>First access to every new feature before public release</li>
          <li>Direct line to Cris on WhatsApp</li>
          <li>Annual gift from a partner house</li>
        </ul>
        <a href="/lounge/signup/" class="lounge-tier__cta">Become an OG Member →</a>
      </div>
    </div>

    <p class="mt-8 text-sm text-[color:var(--color-text-muted)] max-w-2xl">
      Cancel any time, no contract. Lounge pricing locks for the first 24 months once you upgrade.
      After 1 June 2026 the OG Member door closes — late joiners can still earn a free Lounge
      membership through the referrer + event-host program.
    </p>
  </section>

  {/* ─── INSTALL THE APP ─── */}
  <section class="container-wide pb-20 reveal">
    <div class="lounge-install">
      <div>
        <p class="section-eyebrow">Install</p>
        <h2 class="font-display text-2xl md:text-3xl leading-tight mt-2">Add The Next Cigar to your home screen</h2>
        <p class="mt-3 text-[color:var(--color-text-soft)] max-w-2xl">
          The Lounge is web-first. Install thenextcigar.com as an app on iOS or
          Android in two taps — full-screen, no browser chrome, and check-in
          notifications when you arrive at a partner lounge.
        </p>
      </div>
      <div class="lounge-install__actions">
        <button id="install-pwa" class="btn btn-accent" hidden>Install the app</button>
        <details class="lounge-install__help">
          <summary>How to install manually</summary>
          <div>
            <p><strong>iPhone / iPad (Safari):</strong> tap the Share button → "Add to Home Screen" → Add.</p>
            <p><strong>Android (Chrome):</strong> tap the three-dot menu → "Install app" / "Add to Home Screen."</p>
            <p><strong>Desktop (Chrome, Edge, Brave):</strong> address bar shows an install icon — click it.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  {/* ─── FAQ ─── */}
  <section class="editorial container-wide pb-24">
    <EditorialSectionHead
      eyebrow="Common questions"
      title="Honest answers."
    />

    <div class="lounge-faq reveal">
      <details>
        <summary>Is the Lounge live?</summary>
        <p>Yes — the public Finder, watchlist alerts, member directory, map, travel mode, messaging, and events are all in production. The Cuban catalogue covers {skuCount} flagship SKUs and {retailerCount} European retailers right now, with new retailers being added every month.</p>
      </details>
      <details>
        <summary>What does $9/month or $79/year actually unlock?</summary>
        <p>The free Finder + the public site stay free forever. Lounge membership unlocks: unlimited Finder watchlists, push notifications on price drops, 90-day price history charts, taste-matched recommendations, travel mode, unlimited direct messaging with verified members, check-ins, member matches, and event RSVPs. Most Cuban buyers save more than $79 on their first box thanks to the Finder — the rest of the year, the network is a bonus.</p>
      </details>
      <details>
        <summary>What is an OG Member?</summary>
        <p>Any account opened before 1 June 2026 becomes an OG Member automatically — no extra signup step, no money, no application. OG Members get every Lounge feature free for life plus every paid feature we ship after that. It's a one-time, date-based grant. After the cutoff the door closes; late joiners can still earn free Lounge membership through the referrer + event-host program.</p>
      </details>
      <details>
        <summary>Is this an app I download or a website?</summary>
        <p>Both. It's web-first, installable as a PWA (Progressive Web App). Tap the install button above or use your browser's "Add to Home Screen" — you get a full-screen native-feeling app without App Store gatekeeping. Native iOS/Android come later.</p>
      </details>
      <details>
        <summary>I run a lounge. Can I be a partner?</summary>
        <p>Yes — partner houses are a core part of the model. <a href="/contact/" class="text-[color:var(--color-accent)] underline">Get in touch</a> and we'll send the partner deck. Partner lounges get listed in-app, verified-member walk-ins, and quarterly featured-house slots in TNC editorial.</p>
      </details>
      <details>
        <summary>What about privacy?</summary>
        <p>Discretion is baked in. Profiles default to first-name + initial. No public broadcasts. No location sharing unless you actively check in. No data sold. The community polices itself — anyone reported by two members is auto-suspended pending review.</p>
      </details>
    </div>
  </section>
</BaseLayout>

<style>
  .lounge-hero {
    background:
      radial-gradient(circle at 20% 30%, rgba(110, 38, 32, 0.08), transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(255, 46, 46, 0.05), transparent 55%),
      var(--color-bg);
  }
  .lounge-eyebrow {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }
  .lounge-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 30ch;
    color: var(--color-text);
  }
  @media (min-width: 768px) { .lounge-title { font-size: 4.5rem; } }
  @media (min-width: 1024px) { .lounge-title { font-size: 5.5rem; } }
  .lounge-lead {
    margin-top: 1.5rem;
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--color-text-soft);
    max-width: 36rem;
  }
  .lounge-lead--soft { color: var(--color-text-muted); }
  .lounge-hero__cta-row {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: center;
  }
  .lounge-hero__cta-row .btn {
    min-width: 11rem;
  }
  .lounge-waitlist {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    max-width: 40rem;
  }
  .lounge-waitlist input[type="email"],
  .lounge-waitlist input[type="text"] {
    flex: 1 1 12rem;
    min-width: 12rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    background: #fff;
    font-size: 0.95rem;
    color: var(--color-text);
  }
  .lounge-waitlist input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .lounge-waitlist .btn { flex: 0 0 auto; }
  .lounge-fineprint {
    margin-top: 0.85rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .lounge-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 3rem;
  }
  @media (min-width: 768px) { .lounge-features { grid-template-columns: 1fr 1fr; gap: 2.5rem; } }
  @media (min-width: 1024px) { .lounge-features { grid-template-columns: 1fr 1fr 1fr; } }
  .lounge-feature__num {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    color: var(--color-accent);
    margin-bottom: 0.85rem;
  }
  .lounge-feature h3 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 0.65rem;
    color: var(--color-text);
  }
  .lounge-feature p {
    color: var(--color-text-soft);
    line-height: 1.6;
  }

  .lounge-cities-band {
    background: var(--color-dark);
    color: var(--color-text-on-dark);
  }
  .lounge-cities-grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) { .lounge-cities-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .lounge-cities-grid { grid-template-columns: repeat(3, 1fr); } }
  .lounge-city-card {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-dark-border);
    border-radius: 4px;
    background: var(--color-dark-surface);
  }
  .lounge-city-card__city {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.4rem;
  }
  .lounge-city-card__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1.25;
    color: var(--color-text-on-dark);
    margin-bottom: 0.3rem;
  }
  .lounge-city-card__country {
    font-size: 0.82rem;
    color: var(--color-text-on-dark-mute);
  }

  .lounge-pricing {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .lounge-pricing { grid-template-columns: 1fr 1fr; gap: 2rem; } }
  @media (min-width: 1024px) {
    .lounge-pricing--three { grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; }
  }
  .lounge-tier { display: flex; flex-direction: column; }
  .lounge-tier__price--small {
    font-size: 1.4rem;
    line-height: 1.2;
  }
  .lounge-tier__sub {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin: -0.25rem 0 0.85rem 0;
    font-weight: 500;
  }
  .lounge-tier ul { flex: 1; }
  .lounge-tier__cta {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.7rem 1.2rem;
    background: transparent;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .lounge-tier__cta:hover {
    background: var(--color-accent);
    color: #fff;
  }
  .lounge-tier__cta--primary {
    background: var(--color-accent);
    color: #fff;
  }
  .lounge-tier__cta--primary:hover {
    background: var(--color-accent-hover, #6e2620);
  }
  .lounge-tier {
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg-soft);
    position: relative;
  }
  .lounge-tier--featured {
    border-color: var(--color-accent);
    box-shadow: 0 8px 32px rgba(255, 46, 46, 0.08);
  }
  .lounge-tier__flag {
    position: absolute;
    top: -12px;
    left: 2rem;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.35rem 0.7rem;
    border-radius: 3px;
  }
  .lounge-tier__name {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .lounge-tier__price {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .lounge-tier__price span {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0;
  }
  .lounge-tier__pitch {
    color: var(--color-text-soft);
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }
