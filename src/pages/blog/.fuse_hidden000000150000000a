---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/newspaper.css";
import CigarCursor from "../../components/newspaper/CigarCursor.astro";
import NewspaperMasthead from "../../components/newspaper/NewspaperMasthead.astro";
import SectionFlag from "../../components/newspaper/SectionFlag.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const data = post.data;

const category = data.category ? await getEntry("categories", data.category) : null;
const author = data.author ? await getEntry("authors", data.author) : null;

const allPosts = await getCollection("blog");
const categoryByslug = new Map((await getCollection("categories")).map((c) => [c.data.slug, c.data]));

// Related — same category first, backfilled with recent
const sameCategory = allPosts
  .filter((p) => p.id !== post.id && p.data.category === data.category)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
const otherCategories = allPosts
  .filter((p) => p.id !== post.id && p.data.category !== data.category)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
const related = [...sameCategory, ...otherCategories].slice(0, 3);

const longDate = new Date(data.publishedAt).toLocaleDateString("en-GB", {
  weekday: "long", year: "numeric", month: "long", day: "numeric",
});
const shortDate = new Date(data.publishedAt).toLocaleDateString("en-GB", {
  day: "numeric", month: "short", year: "numeric",
});

const words = post.body?.split(/\s+/).length ?? 0;
const readMinutes = Math.max(1, Math.round(words / 220));

const shareUrl = `https://thenextcigar.com/blog/${data.slug}`;
const coverUrl = typeof data.cover === "string"
  ? data.cover
  : (data.cover?.src ?? "/og-default.svg");

// JSON-LD — preserve full SEO stack
const categoryName = category?.data?.name ?? "News";
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.excerpt || data.title,
  image: [coverUrl.startsWith("http") ? coverUrl : `https://thenextcigar.com${coverUrl}`],
  datePublished: new Date(data.publishedAt).toISOString(),
  dateModified: data.updatedAt ? new Date(data.updatedAt).toISOString() : new Date(data.publishedAt).toISOString(),
  author: [{ "@type": "Person", name: data.author ?? "The Next Cigar Editorial" }],
  publisher: {
    "@type": "Organization",
    name: "The Next Cigar",
    logo: { "@type": "ImageObject", url: "https://thenextcigar.com/logo.png" },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": shareUrl + "/" },
  wordCount: words,
  articleSection: categoryName,
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://thenextcigar.com/" },
    { "@type": "ListItem", position: 2, name: "Magazine", item: "https://thenextcigar.com/blog/" },
    { "@type": "ListItem", position: 3, name: data.title, item: shareUrl + "/" },
  ],
};



function coverOf(p: typeof allPosts[number]): string {
  const c = p.data.cover;
  if (!c) return "/og-default.svg";
  if (typeof c === "string") return c;
  return (c as { src: string }).src;
}
function categoryLabelOf(p: typeof allPosts[number]): string {
  const cat = p.data.category ? categoryByslug.get(p.data.category) : null;
  return cat?.data?.name ?? "Editorial";
}
function categoryFlag(slug: string | null): string {
  if (!slug) return "";
  const s = slug.toLowerCase();
  if (s.includes("finder") || s.includes("price")) return "finder";
  if (s.includes("leaf") || s.includes("cigar-101") || s.includes("vitola")) return "leaf";
  if (s.includes("people") || s.includes("culture") || s.includes("havana")) return "people";
  if (s.includes("shop") || s.includes("gear") || s.includes("accessor")) return "shop";
  if (s.includes("news") || s.includes("market")) return "market";
  return "";
}

const sectionFlag = categoryFlag(data.category);
---

<BaseLayout
  title={`${data.title} — The Next Cigar`}
  description={data.excerpt || data.title}
  image={coverUrl}
  bareChrome={true}
>
  <link
    is:inline
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="tnc-cinema">
    <CigarCursor />

    <!-- Reading progress bar — thin gold rule at top -->
    <div id="reading-progress" class="reading-progress" aria-hidden="true">
      <div id="reading-progress-bar" class="reading-progress-bar"></div>
    </div>

    <main class="site-body">
      <NewspaperMasthead
        volume={masthead.volume}
        issue={masthead.issue}
        date={masthead.date}
      />

      <SectionFlag
        number="/03"
        section={categoryName}
        title={`${data.title.length > 60 ? data.title.slice(0, 58) + "…" : data.title}<em></em>`}
        status={`${readMinutes} min read`}
      />

      <!-- ARTICLE MASTHEAD BLOCK — byline, headline, standfirst, cover -->
      <article class="article">

        <div class="article-inner">

          <div class="article-byline">
            <a href="/blog/" data-hover>Back to the Magazine</a>
            <span class="dot">·</span>
            <span>{longDate}</span>
            {data.author && (
              <>
                <span class="dot">·</span>
                <span>by <em>{data.author}</em></span>
              </>
            )}
            <span class="dot">·</span>
            <span>{readMinutes} min read</span>
          </div>

          <h1 class="article-title">{data.title}</h1>

          {data.excerpt && (
            <p class="article-standfirst">{data.excerpt}</p>
          )}
        </div>

        {data.cover && (
          <figure class="article-hero">
            <img src={coverUrl} alt={data.title} loading="eager" />
            <figcaption>
              <strong>Above &middot;</strong> {data.title}. Photography via TNC editorial archive.
            </figcaption>
          </figure>
        )}

        <!-- BODY — two-column with drop cap treatment via CSS -->
        <div class="article-body prose">
          <Content />
        </div>

        <!-- Share + meta ornament -->
        <div class="article-ornament">
          <span class="article-ornament-mark">◆ ◆ ◆</span>
          <div class="article-share">
            <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl + '/')}&text=${encodeURIComponent(data.title)}`} data-hover target="_blank" rel="noopener">Share on X</a>
            <span class="dot">·</span>
            <a href={`mailto:?subject=${encodeURIComponent(data.title)}&body=${encodeURIComponent(shareUrl + '/')}`} data-hover>Email</a>
            <span class="dot">·</span>
            <a href="/blog/" data-hover>All issues</a>
          </div>
        </div>

      </article>

      <!-- RELATED — "Continued reading" -->
      {related.length > 0 && (
        <section class="related">
          <div class="related-head">
            <div class="related-eyebrow">Continued reading</div>
            <h2>Three more <em>from the archive.</em></h2>
          </div>
          <div class="related-grid">
            {related.map((post) => (
              <a href={`/blog/${post.data.slug}/`} class="related-card" data-hover>
                <div class="related-photo" style={`background-image: url("${coverOf(post)}")`}></div>
                <span class={`related-flag ${categoryFlag(post.data.category)}`}>{categoryLabelOf(post)}</span>
                <h3>{post.data.title}</h3>
                {post.data.excerpt && <p>{post.data.excerpt}</p>}
                <div class="meta"><span>{new Date(post.data.publishedAt).toLocaleDateString("en-GB", { day: "numeric", month: "short" })}</span></div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="footer-strip">
        <div class="footer-strip-inner">
          <div>
            <a href="/" class="footer-strip-mark" data-hover>The Next Cigar</a>
            <div class="footer-strip-tag">The Anthology of the Leaf &middot; Malmö · Lisbon</div>
          </div>
          <div class="footer-strip-links">
            <a href="/finder/" data-hover>Finder</a>
            <a href="/lounge/" data-hover>Lounge</a>
            <a href="/blog/" data-hover>Magazine</a>
            <a href="/shop/" data-hover>Shop</a>
            <a href="/about/" data-hover>About</a>
            <a href="/contact/" data-hover>Contact</a>
          </div>
        </div>
        <div class="footer-strip-copy">© 2025–2026 The Next Cigar · Cristian Ortiz Suárez</div>
      </section>
    </main>
  </div>

  <script>
    // Reading progress bar
    const bar = document.getElementById('reading-progress-bar');
    if (bar) {
      const update = () => {
        const scrollTop = window.scrollY;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const pct = height > 0 ? Math.min(1, Math.max(0, scrollTop / height)) : 0;
        bar.style.transform = `scaleX(${pct})`;
      };
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }
  </script>
</BaseLayout>

<style is:global>
  /* Reading progress bar — thin gold rule pinned to viewport top */
  .reading-progress {
    position: fixed; top: 0; left: 0; right: 0; height: 2px;
    z-index: 60; pointer-events: none;
    background: transparent;
  }
  .reading-progress-bar {
    height: 100%; transform-origin: left; transform: scaleX(0);
    background: linear-gradient(90deg, var(--news-oxblood), var(--news-gold), var(--news-ember));
    transition: transform 0.15s linear;
  }

  /* ── Article layout ── */
  .site-body { padding-bottom: 40px; }

  .article {
    max-width: 1520px; margin: 0 auto; padding: 48px 40px 64px;
  }

  .article-inner {
    max-width: 780px; margin: 0 auto; text-align: left;
  }

  .article-byline {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--news-ink-mute); margin-bottom: 28px;
    display: flex; flex-wrap: wrap; gap: 12px; align-items: baseline;
  }
  .article-byline a {
    color: var(--news-oxblood); border-bottom: 1px solid transparent;
    padding-bottom: 2px; transition: all 0.2s;
  }
  .article-byline a:hover { border-bottom-color: var(--news-oxblood); }
  .article-byline .dot { color: var(--news-oxblood); }
  .article-byline em { font-style: italic; text-transform: none; letter-spacing: 0; color: var(--news-ink-soft); }

  .article-title {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    line-height: 0.98; letter-spacing: -0.03em;
    color: var(--news-ink); margin: 0 0 28px;
  }

  .article-standfirst {
    font-family: var(--news-serif); font-style: italic; font-weight: 400;
    font-size: clamp(1.15rem, 1.7vw, 1.45rem); line-height: 1.55;
    color: var(--news-ink-soft); margin: 0 0 40px;
    padding-bottom: 32px; border-bottom: 1px solid var(--news-rule);
  }

  .article-hero {
    max-width: 1200px; margin: 40px auto 48px;
  }
  .article-hero img {
    width: 100%; height: auto; display: block;
    aspect-ratio: 3 / 2; object-fit: cover;
    filter: grayscale(0.75) sepia(0.25) contrast(1.05);
    background: var(--news-paper-dark);
  }
  .article-hero figcaption {
    margin-top: 12px;
    font-family: var(--news-serif); font-style: italic; font-size: 13px;
    line-height: 1.45; color: var(--news-ink-mute); max-width: 780px;
  }
  .article-hero figcaption strong {
    font-style: normal; font-weight: 600; color: var(--news-ink-soft);
  }

  /* ── BODY typography — the reading experience ── */
  .article-body {
    max-width: 780px; margin: 0 auto;
    font-family: var(--news-serif); font-size: 18px; line-height: 1.68;
    color: var(--news-ink);
  }
  .article-body p {
    margin: 0 0 1.35em;
  }
  /* Drop cap on opening paragraph */
  .article-body > p:first-of-type::first-letter {
    font-family: var(--news-serif); font-weight: 700;
    font-size: 5.2em; line-height: 0.85; float: left;
    margin: 0.05em 10px -0.05em 0;
    color: var(--news-oxblood);
  }
  .article-body h2 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem); line-height: 1.1;
    letter-spacing: -0.018em; color: var(--news-ink);
    margin: 2.4em 0 0.6em;
    padding-top: 1.2em; border-top: 1px solid var(--news-rule);
  }
  .article-body h2 em { font-style: italic; color: var(--news-oxblood); font-weight: 400; }
  .article-body h3 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.25rem, 2vw, 1.55rem); line-height: 1.2;
    letter-spacing: -0.014em; color: var(--news-ink);
    margin: 2em 0 0.5em;
  }
  .article-body h3 em { font-style: italic; color: var(--news-oxblood); font-weight: 400; }
  .article-body a {
    color: var(--news-oxblood); border-bottom: 1px solid var(--news-oxblood);
    padding-bottom: 1px; transition: color 0.2s;
  }
  .article-body a:hover { color: var(--news-ember); border-bottom-color: var(--news-ember); }
  .article-body em, .article-body i { font-style: italic; }
  .article-body strong { font-weight: 600; color: var(--news-ink); }
  .article-body blockquote {
    margin: 2em 0; padding: 20px 32px;
    border-left: 3px solid var(--news-oxblood);
    background: var(--news-paper-cream);
    font-family: var(--news-serif); font-style: italic;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem); line-height: 1.5;
    color: var(--news-ink-soft);
  }
  .article-body blockquote p { margin: 0 0 0.6em; }
  .article-body blockquote p:last-child { margin: 0; }
  .article-body ul, .article-body ol {
    margin: 0 0 1.35em; padding-left: 1.5em;
  }
  .article-body li { margin-bottom: 0.5em; }
  .article-body img {
    width: 100%; height: auto; margin: 2em 0 1em;
    filter: grayscale(0.6) sepia(0.2) contrast(1.05);
  }
  .article-body figure img { margin-bottom: 0.5em; }
  .article-body figcaption {
    font-family: var(--news-serif); font-style: italic; font-size: 13px;
    color: var(--news-ink-mute); text-align: center; line-height: 1.45;
    margin-bottom: 1.5em;
  }
  .article-body hr {
    border: none;
    max-width: 200px; margin: 3em auto;
    text-align: center; height: 12px;
    background: none;
    color: var(--news-oxblood);
  }
  .article-body hr::before {
    content: "◆ ◆ ◆";
    font-family: var(--news-serif); font-size: 12px;
    letter-spacing: 0.5em; color: var(--news-oxblood);
    display: block;
  }
  .article-body code {
    font-family: var(--news-mono); font-size: 0.9em;
    background: var(--news-paper-cream); padding: 2px 6px;
    border: 1px solid var(--news-rule); border-radius: 2px;
    color: var(--news-oxblood);
  }

  /* Article ornament + share */
  .article-ornament {
    max-width: 780px; margin: 48px auto 0; text-align: center;
    padding-top: 32px; border-top: 4px double var(--news-ink);
  }
  .article-ornament-mark {
    display: block;
    font-family: var(--news-serif); font-size: 14px; letter-spacing: 0.6em;
    color: var(--news-oxblood); margin-bottom: 20px;
  }
  .article-share {
    display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--news-ink-mute);
  }
  .article-share a { color: var(--news-oxblood); border-bottom: 1px solid transparent; padding-bottom: 2px; transition: border-color 0.2s; }
  .article-share a:hover { border-bottom-color: var(--news-oxblood); }
  .article-share .dot { color: var(--news-oxblood); }

  /* Related */
  .related {
    max-width: 1520px; margin: 0 auto; padding: 64px 40px;
    border-top: 1px solid var(--news-rule); border-bottom: 1px solid var(--news-rule);
  }
  .related-head {
    display: flex; justify-content: space-between; align-items: end;
    margin-bottom: 40px; flex-wrap: wrap; gap: 24px;
  }
  .related-eyebrow {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--news-oxblood);
    display: flex; align-items: center; gap: 12px; margin-bottom: 16px;
  }
  .related-eyebrow::before {
    content: ""; width: 32px; height: 1px; background: var(--news-oxblood);
  }
  .related-head h2 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.8rem, 3vw, 2.4rem); line-height: 1.02;
    letter-spacing: -0.022em; margin: 0;
  }
  .related-head h2 em { font-style: italic; color: var(--news-oxblood); font-weight: 400; }
  .related-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px;
  }
  .related-card { display: flex; flex-direction: column; transition: transform 0.3s var(--news-ease); }
  .related-card:hover { transform: translateY(-2px); }
  .related-photo {
    aspect-ratio: 4 / 3; margin-bottom: 16px;
    background-size: cover; background-position: center;
    background-color: var(--news-paper-dark);
    filter: grayscale(0.75) sepia(0.28) contrast(1.06);
    transition: filter 0.4s var(--news-ease);
  }
  .related-card:hover .related-photo { filter: grayscale(0.5) sepia(0.15) contrast(1.08); }
  .related-flag {
    display: inline-block; align-self: flex-start;
    font-family: var(--news-sans); font-size: 9px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-ink); color: var(--news-paper);
    padding: 3px 8px; margin-bottom: 10px;
  }
  .related-flag.finder { background: var(--news-oxblood); }
  .related-flag.leaf   { background: var(--news-pine); }
  .related-flag.people { background: #3a2a1c; }
  .related-flag.shop   { background: var(--news-mahogany); }
  .related-flag.market { background: #4a3826; }
  .related-card h3 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem); line-height: 1.15;
    letter-spacing: -0.012em; color: var(--news-ink); margin: 0 0 8px;
    transition: color 0.2s;
  }
  .related-card:hover h3 { color: var(--news-oxblood); }
  .related-card p {
    font-family: var(--news-serif); font-style: italic;
    font-size: 14px; line-height: 1.5; color: var(--news-ink-soft);
    margin: 0 0 10px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .related-card .meta {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--news-ink-mute); margin-top: auto;
  }

  /* Footer strip */
  .footer-strip {
    max-width: 1520px; margin: 0 auto; padding: 40px 40px 24px;
  }
  .footer-strip-inner {
    display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center;
    padding-bottom: 20px; border-bottom: 1px solid var(--news-rule);
  }
  .footer-strip-mark {
    font-family: var(--news-serif); font-weight: 600; font-size: 22px;
    letter-spacing: -0.008em; color: var(--news-ink); display: block;
  }
  .footer-strip-tag {
    font-family: var(--news-serif); font-style: italic; font-size: 13px;
    color: var(--news-ink-mute); margin-top: 2px;
  }
  .footer-strip-links {
    display: flex; gap: 24px; flex-wrap: wrap;
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--news-ink-mute);
  }
  .footer-strip-links a { padding: 4px 0; border-bottom: 1px solid transparent; transition: all 0.2s; }
  .footer-strip-links a:hover { color: var(--news-oxblood); border-bottom-color: var(--news-oxblood); }
  .footer-strip-copy {
    margin-top: 16px;
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.16em;
    color: var(--news-ink-mute);
  }

  @media (max-width: 900px) {
    .article, .related, .footer-strip { padding: 32px 20px; }
    .article-body { font-size: 17px; }
    .article-body > p:first-of-type::first-letter { font-size: 4em; }
    .related-grid { grid-template-columns: 1fr; }
    .footer-strip-inner { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
