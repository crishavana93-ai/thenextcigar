---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/newspaper.css";
import CigarCursor from "../../components/newspaper/CigarCursor.astro";
import NewspaperMasthead from "../../components/newspaper/NewspaperMasthead.astro";
import SectionFlag from "../../components/newspaper/SectionFlag.astro";
import { MASTHEAD as masthead } from "../../data/masthead";
import { SKUS, RETAILERS, bestPriceForSku, formatPrice } from "../../data/finder-data";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const data = post.data;

const category = data.category ? await getEntry("categories", data.category) : null;
const author = data.author ? await getEntry("authors", data.author) : null;

const allPosts = await getCollection("blog");
const categoryByslug = new Map((await getCollection("categories")).map((c) => [c.data.slug, c.data]));

// Related — same category first, backfilled with recent
const sameCategory = allPosts
  .filter((p) => p.id !== post.id && p.data.category === data.category)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
const otherCategories = allPosts
  .filter((p) => p.id !== post.id && p.data.category !== data.category)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
const related = [...sameCategory, ...otherCategories].slice(0, 3);

const longDate = new Date(data.publishedAt).toLocaleDateString("en-GB", {
  weekday: "long", year: "numeric", month: "long", day: "numeric",
});
const shortDate = new Date(data.publishedAt).toLocaleDateString("en-GB", {
  day: "numeric", month: "short", year: "numeric",
});

const words = post.body?.split(/\s+/).length ?? 0;
const readMinutes = Math.max(1, Math.round(words / 220));

const shareUrl = `https://thenextcigar.com/blog/${data.slug}`;
const coverUrl = typeof data.cover === "string"
  ? data.cover
  : (data.cover?.src ?? "/og-default.svg");

// JSON-LD — preserve full SEO stack
const categoryName = category?.data?.name ?? "News";
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.excerpt || data.title,
  image: [coverUrl.startsWith("http") ? coverUrl : `https://thenextcigar.com${coverUrl}`],
  datePublished: new Date(data.publishedAt).toISOString(),
  dateModified: data.updatedAt ? new Date(data.updatedAt).toISOString() : new Date(data.publishedAt).toISOString(),
  author: [{ "@type": "Person", name: data.author ?? "The Next Cigar Editorial" }],
  publisher: {
    "@type": "Organization",
    name: "The Next Cigar",
    logo: { "@type": "ImageObject", url: "https://thenextcigar.com/logo.png" },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": shareUrl + "/" },
  wordCount: words,
  articleSection: categoryName,
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://thenextcigar.com/" },
    { "@type": "ListItem", position: 2, name: "Magazine", item: "https://thenextcigar.com/blog/" },
    { "@type": "ListItem", position: 3, name: data.title, item: shareUrl + "/" },
  ],
};



function coverOf(p: typeof allPosts[number]): string {
  const c = p.data.cover;
  if (!c) return "/og-default.svg";
  if (typeof c === "string") return c;
  return (c as { src: string }).src;
}
function categoryLabelOf(p: typeof allPosts[number]): string {
  const cat = p.data.category ? categoryByslug.get(p.data.category) : null;
  return cat?.data?.name ?? "Editorial";
}
function categoryFlag(slug: string | null): string {
  if (!slug) return "";
  const s = slug.toLowerCase();
  if (s.includes("finder") || s.includes("price")) return "finder";
  if (s.includes("leaf") || s.includes("cigar-101") || s.includes("vitola")) return "leaf";
  if (s.includes("people") || s.includes("culture") || s.includes("havana")) return "people";
  if (s.includes("shop") || s.includes("gear") || s.includes("accessor")) return "shop";
  if (s.includes("news") || s.includes("market")) return "market";
  return "";
}

const sectionFlag = categoryFlag(data.category);

/* ── AI "Cigars like this" recommendations ──
   If the article's frontmatter has relatedSkus, use those. Otherwise
   auto-detect from the article title — any SKU whose brand + vitola
   appears in the title becomes the seed. Then pick 3 more that share
   the seed's brand or prestige tier. */
const RETAILER_BY_ID = Object.fromEntries(RETAILERS.map((r) => [r.id, r]));
const seedIds: string[] = (data.relatedSkus && data.relatedSkus.length > 0)
  ? data.relatedSkus
  : SKUS.filter((s) => {
      const t = data.title.toLowerCase();
      return t.includes(s.brand.toLowerCase()) && t.includes(s.vitola.toLowerCase());
    }).map((s) => s.id);

const seed = seedIds.length ? SKUS.find((s) => s.id === seedIds[0]) : null;
const recommendations = seed
  ? SKUS
      .filter((s) => s.id !== seed.id)
      .map((s) => {
        let score = 0;
        if (s.brand === seed.brand) score += 3;
        if (s.prestige === seed.prestige) score += 2;
        if (s.strength === seed.strength) score += 1;
        // Flavor-notes overlap
        const overlap = (s.flavorNotes || []).filter((n) => (seed.flavorNotes || []).includes(n)).length;
        score += overlap;
        const best = bestPriceForSku(s.id);
        return { sku: s, score, best };
      })
      .filter((r) => r.best)
      .sort((a, b) => b.score - a.score)
      .slice(0, 3)
  : [];

// Inline SKU widget — expose the SKU catalogue as a compact JSON island for
// the client-side regex scanner. We keep it small: id, brand, vitola, best
// EUR price, cheapest retailer name + country, click-through URL.
const inlineSkuData = SKUS
  .map((s) => {
    const best = bestPriceForSku(s.id);
    if (!best) return null;
    const r = RETAILER_BY_ID[best.snap.retailerId];
    return {
      id: s.id,
      slug: s.slug,
      brand: s.brand,
      vitola: s.vitola,
      priceLabel: formatPrice(best.snap.price, best.snap.currency),
      eur: Math.round(best.eur),
      country: r?.country || "",
      retailer: r?.name || "",
    };
  })
  .filter(Boolean);
---

<BaseLayout
  title={`${data.title} — The Next Cigar`}
  description={data.excerpt || data.title}
  image={coverUrl}
  bareChrome={true}
>
  <link
    is:inline
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="tnc-cinema">
    <CigarCursor />

    <!-- Reading progress bar — thin gold rule at top -->
    <div id="reading-progress" class="reading-progress" aria-hidden="true">
      <div id="reading-progress-bar" class="reading-progress-bar"></div>
    </div>

    <!-- Sticky chapter nav — auto-populated from H2s in article body -->
    <nav class="chapter-nav" id="chapterNav" aria-hidden="true">
      <div class="chapter-nav-inner">
        <div class="chapter-nav-label">In this issue</div>
        <ul id="chapterList" class="chapter-list"></ul>
      </div>
    </nav>

    <main class="site-body">
      <NewspaperMasthead
        volume={masthead.volume}
        issue={masthead.issue}
        date={masthead.date}
      />

      <SectionFlag
        number="/03"
        section={categoryName}
        title={`${data.title.length > 60 ? data.title.slice(0, 58) + "…" : data.title}<em></em>`}
        status={`${readMinutes} min read`}
      />

      <!-- ARTICLE — supports heroBleed (100vh cinematic hero) opt-in -->
      <article class:list={["article", data.heroBleed && "hero-bleed"]}>

        {data.heroBleed && data.cover ? (
          <section class="hero-bleed-scene" style={`background-image: url("${coverUrl}")`}>
            <div class="hero-bleed-overlay"></div>
            <div class="hero-bleed-copy">
              <div class="hero-bleed-byline">
                <a href="/blog/" data-hover>← Back to the Magazine</a>
                <span class="dot">·</span>
                <span>{longDate}</span>
                {data.author && (<><span class="dot">·</span><span>by <em>{data.author}</em></span></>)}
                <span class="dot">·</span>
                <span>{readMinutes} min read</span>
              </div>
              <h1 class="hero-bleed-title">{data.title}</h1>
              {data.excerpt && <p class="hero-bleed-standfirst">{data.excerpt}</p>}
              <div class="hero-bleed-scroll">Scroll to read →</div>
            </div>
          </section>
        ) : (
          <div class="article-inner">
            <div class="article-byline">
              <a href="/blog/" data-hover>Back to the Magazine</a>
              <span class="dot">·</span>
              <span>{longDate}</span>
              {data.author && (
                <>
                  <span class="dot">·</span>
                  <span>by <em>{data.author}</em></span>
                </>
              )}
              <span class="dot">·</span>
              <span>{readMinutes} min read</span>
            </div>

            <h1 class="article-title">{data.title}</h1>

            {data.excerpt && (
              <p class="article-standfirst">{data.excerpt}</p>
            )}
          </div>
        )}

        {!data.heroBleed && data.cover && (
          <figure class="article-hero">
            <img src={coverUrl} alt={data.title} loading="eager" />
            <figcaption>
              <strong>Above &middot;</strong> {data.title}. Photography via TNC editorial archive.
            </figcaption>
          </figure>
        )}

        <!-- BODY — two-column with drop cap treatment via CSS -->
        <div class="article-body prose">
          <Content />
        </div>

        <!-- Reader tools row — Save to shelf, Print magazine, Share -->
        <div class="article-tools">
          <button
            type="button"
            class="reader-tool"
            data-shelf-save
            data-slug={data.slug}
            data-title={data.title}
            data-hover
          >
            <svg viewBox="0 0 24 24"><path d="M5 3v18l7-5 7 5V3H5z"/></svg>
            <span data-label>Save to shelf</span>
          </button>
          <button type="button" class="reader-tool" data-print-trigger data-hover>
            <svg viewBox="0 0 24 24"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z"/></svg>
            <span>Print magazine</span>
          </button>
          <a
            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl + '/')}&text=${encodeURIComponent(data.title)}`}
            class="reader-tool"
            data-hover
            target="_blank"
            rel="noopener"
          >
            <svg viewBox="0 0 24 24"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13"/></svg>
            <span>Share on X</span>
          </a>
        </div>

        <div class="article-ornament">
          <span class="article-ornament-mark">◆ ◆ ◆</span>
          <div class="article-share">
            <a href={`mailto:?subject=${encodeURIComponent(data.title)}&body=${encodeURIComponent(shareUrl + '/')}`} data-hover>Email</a>
            <span class="dot">·</span>
            <a href="/shelves/" data-hover>My shelf</a>
            <span class="dot">·</span>
            <a href="/blog/" data-hover>All issues</a>
          </div>
        </div>

        {/* Auto-collect a cigar-band sticker after 6 seconds of reading */}
        <div
          data-collect-band
          data-band-slug={data.slug}
          data-band-brand={data.category || "Editorial"}
          data-band-name={data.title}
          style="display:none"
        ></div>

      </article>

      {/* AI · Cigars like this — pulled from finder-data flavor profile */}
      {recommendations.length > 0 && (
        <section class="ai-recs">
          <div class="ai-recs-head">
            <div class="ai-recs-flag">AI · Cigars like this</div>
            <h2>If you liked <em>{seed?.brand} {seed?.vitola}</em> — try these three.</h2>
            <p class="ai-recs-caveat">Matched on brand, prestige tier, strength, and shared flavour notes. Live prices from the Finder.</p>
          </div>
          <div class="ai-recs-grid">
            {recommendations.map(({ sku, best }) => (
              <a href={`/finder/sku/${sku.slug}/`} class="ai-rec" data-hover>
                <div class="ai-rec-brand">{sku.brand}</div>
                <div class="ai-rec-vitola">{sku.vitola}</div>
                <div class="ai-rec-notes">
                  {(sku.flavorNotes || []).slice(0, 4).join(" · ") || sku.blurb.slice(0, 100)}
                </div>
                <div class="ai-rec-price">
                  <span class="k">Cheapest</span>
                  <span class="v">€{Math.round(best!.eur).toLocaleString()}</span>
                </div>
                <div class="ai-rec-cta">Open on the Finder →</div>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* Inline SKU catalogue — consumed by reader-tools.js to auto-badge
          any brand+vitola mention inside .article-body with a live price. */}
      <script type="application/json" id="tncSkuCatalogue" set:html={JSON.stringify(inlineSkuData)}></script>

      <!-- RELATED — "Continued reading" -->
      {related.length > 0 && (
        <section class="related">
          <div class="related-head">
            <div class="related-eyebrow">Continued reading</div>
            <h2>Three more <em>from the archive.</em></h2>
          </div>
          <div class="related-grid">
            {related.map((post) => (
              <a href={`/blog/${post.data.slug}/`} class="related-card" data-hover>
                <div class="related-photo" style={`background-image: url("${coverOf(post)}")`}></div>
                <span class={`related-flag ${categoryFlag(post.data.category)}`}>{categoryLabelOf(post)}</span>
                <h3>{post.data.title}</h3>
                {post.data.excerpt && <p>{post.data.excerpt}</p>}
                <div class="meta"><span>{new Date(post.data.publishedAt).toLocaleDateString("en-GB", { day: "numeric", month: "short" })}</span></div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="footer-strip">
        <div class="footer-strip-inner">
          <div>
            <a href="/" class="footer-strip-mark" data-hover>The Next Cigar</a>
            <div class="footer-strip-tag">The Anthology of the Leaf &middot; Malmö · Lisbon</div>
          </div>
          <div class="footer-strip-links">
            <a href="/finder/" data-hover>Finder</a>
            <a href="/lounge/" data-hover>Lounge</a>
            <a href="/blog/" data-hover>Magazine</a>
            <a href="/shop/" data-hover>Shop</a>
            <a href="/about/" data-hover>About</a>
            <a href="/contact/" data-hover>Contact</a>
          </div>
        </div>
        <div class="footer-strip-copy">
          <span>© 2025–2026 The Next Cigar</span>
          <a href="https://turquinostudios.com" target="_blank" rel="noopener" class="footer-turquino" data-hover>
            <img src="/cinematic/turquino-mark.jpg" alt="" />
            <span>Designed by <em>Turquino Studios</em></span>
          </a>
        </div>
      </section>
    </main>
  </div>

  <script>
    // ── Reading progress bar ──
    const bar = document.getElementById('reading-progress-bar');
    if (bar) {
      const update = () => {
        const scrollTop = window.scrollY;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const pct = height > 0 ? Math.min(1, Math.max(0, scrollTop / height)) : 0;
        bar.style.transform = `scaleX(${pct})`;
      };
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }

    // ── Chapter nav — auto-generated from H2s in .article-body ──
    // Runs after DOM ready. Assigns each H2 an id, builds the left-rail
    // nav, and uses IntersectionObserver to highlight the current chapter.
    // Falls back gracefully if there are no H2s (short posts) — nav hidden.
    const nav = document.getElementById('chapterNav');
    const list = document.getElementById('chapterList');
    const headings = Array.from(document.querySelectorAll('.article-body h2'));

    if (nav && list && headings.length >= 2) {
      headings.forEach((h, i) => {
        // Slugify heading text for anchor id (fallback to numeric)
        const raw = (h.textContent || '').trim().toLowerCase();
        const slug = raw
          .replace(/<[^>]*>/g, '')
          .replace(/[^\w\s-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .slice(0, 60) || `chapter-${i + 1}`;
        h.id = slug;

        const li = document.createElement('li');
        li.className = 'chapter-item';
        li.dataset.target = slug;
        li.innerHTML = `
          <span class="chapter-num">${String(i + 1).padStart(2, '0')}</span>
          <span class="chapter-title">${h.textContent || ''}</span>
        `;
        li.addEventListener('click', () => {
          const el = document.getElementById(slug);
          if (!el) return;
          // Prefer Lenis smooth scroll if available; fall back to native
          const lenis = (window).lenis;
          if (lenis) {
            lenis.scrollTo(el, { offset: -80 });
          } else {
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
        list.appendChild(li);
      });

      // Reveal the nav once user scrolls past the hero
      const revealAt = window.innerHeight * 0.4;
      const toggleNav = () => {
        if (window.scrollY > revealAt) nav.classList.add('is-visible');
        else nav.classList.remove('is-visible');
      };
      window.addEventListener('scroll', toggleNav, { passive: true });
      toggleNav();

      // Highlight current chapter as user scrolls through
      const items = Array.from(list.querySelectorAll('.chapter-item'));
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              items.forEach((it) => it.classList.remove('is-active'));
              const active = list.querySelector(`[data-target="${entry.target.id}"]`);
              if (active) active.classList.add('is-active');
            }
          });
        },
        { rootMargin: '-30% 0px -60% 0px' }
      );
      headings.forEach((h) => observer.observe(h));
    }
  </script>
</BaseLayout>

<style is:global>
  /* ── Chapter nav — sticky left rail, auto-populated from H2s ──
     Desktop only (>1240px). Fades in when user scrolls past hero.
     Current chapter highlighted via IntersectionObserver. */
  .chapter-nav {
    position: fixed; top: 50%; left: 24px;
    transform: translateY(-50%);
    z-index: 55;
    max-width: 200px;
    opacity: 0; pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .chapter-nav.is-visible { opacity: 1; pointer-events: auto; }
  .chapter-nav-inner {
    padding: 16px 18px;
    background: rgba(242, 237, 225, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid var(--news-rule);
    max-height: 70vh; overflow-y: auto;
  }
  .chapter-nav-label {
    font-family: var(--news-mono); font-size: 9px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--news-oxblood);
    padding-bottom: 8px; margin-bottom: 10px;
    border-bottom: 1px solid var(--news-rule);
  }
  .chapter-list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: 2px;
  }
  .chapter-item {
    display: grid; grid-template-columns: 24px 1fr; gap: 8px;
    padding: 8px 4px; cursor: none;
    transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    border-radius: 2px;
  }
  .chapter-item:hover { background: rgba(138, 43, 30, 0.06); }
  .chapter-item.is-active { background: rgba(138, 43, 30, 0.1); }
  .chapter-num {
    font-family: var(--news-mono); font-size: 9px; letter-spacing: 0.12em;
    color: var(--news-oxblood); padding-top: 2px;
  }
  .chapter-title {
    font-family: var(--news-serif); font-size: 12px; line-height: 1.35;
    letter-spacing: -0.008em; color: var(--news-ink-soft);
    transition: color 0.25s;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .chapter-item.is-active .chapter-title,
  .chapter-item:hover .chapter-title { color: var(--news-ink); }

  @media (max-width: 1240px) {
    .chapter-nav { display: none; }
  }

  /* Reading progress bar — thin gold rule pinned to viewport top */
  .reading-progress {
    position: fixed; top: 0; left: 0; right: 0; height: 2px;
    z-index: 60; pointer-events: none;
    background: transparent;
  }
  .reading-progress-bar {
    height: 100%; transform-origin: left; transform: scaleX(0);
    background: linear-gradient(90deg, var(--news-oxblood), var(--news-gold), var(--news-ember));
    transition: transform 0.15s linear;
  }

  /* ── Article layout ── */
  .site-body { padding-bottom: 40px; }

  .article {
    max-width: 1520px; margin: 0 auto; padding: 48px 40px 64px;
  }

  .article-inner {
    max-width: 780px; margin: 0 auto; text-align: left;
  }

  .article-byline {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--news-ink-mute); margin-bottom: 28px;
    display: flex; flex-wrap: wrap; gap: 12px; align-items: baseline;
  }
  .article-byline a {
    color: var(--news-oxblood); border-bottom: 1px solid transparent;
    padding-bottom: 2px; transition: all 0.2s;
  }
  .article-byline a:hover { border-bottom-color: var(--news-oxblood); }
  .article-byline .dot { color: var(--news-oxblood); }
  .article-byline em { font-style: italic; text-transform: none; letter-spacing: 0; color: var(--news-ink-soft); }

  .article-title {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    line-height: 0.98; letter-spacing: -0.03em;
    color: var(--news-ink); margin: 0 0 28px;
  }

  .article-standfirst {
    font-family: var(--news-serif); font-style: italic; font-weight: 400;
    font-size: clamp(1.15rem, 1.7vw, 1.45rem); line-height: 1.55;
    color: var(--news-ink-soft); margin: 0 0 40px;
    padding-bottom: 32px; border-bottom: 1px solid var(--news-rule);
  }

  .article-hero {
    max-width: 1200px; margin: 40px auto 48px;
  }
  .article-hero img {
    width: 100%; height: auto; display: block;
    aspect-ratio: 3 / 2; object-fit: cover;
    filter: grayscale(0.75) sepia(0.25) contrast(1.05);
    background: var(--news-paper-dark);
  }
  .article-hero figcaption {
    margin-top: 12px;
    font-family: var(--news-serif); font-style: italic; font-size: 13px;
