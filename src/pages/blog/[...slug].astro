---
import { getCollection, getEntry, render } from "astro:content";
import PaperLayout from "../../layouts/PaperLayout.astro";
import { SKUS, RETAILERS, bestPriceForSku, formatPrice, checkedLabel } from "../../data/finder-live";

/**
 * Article template — the broadsheet feature page.
 *
 * Furniture: breadcrumb, headline, standfirst, credit line, cover, then a
 * sticky rail (contents + facts + live prices for the cigars the piece is
 * about) beside the prose. Schema: Article + Breadcrumb, plus FAQPage when
 * the body has an FAQ list.
 */

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const category = d.category ? await getEntry("categories", d.category) : null;
const author = d.author ? await getEntry("authors", d.author) : null;
const all = await getCollection("blog");

const sameCat = all.filter((p) => p.id !== post.id && p.data.category === d.category)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
const rest = all.filter((p) => p.id !== post.id && p.data.category !== d.category)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
const related = [...sameCat, ...rest].slice(0, 3);

const words = post.body?.split(/\s+/).length ?? 0;
const readMinutes = Math.max(1, Math.round(words / 220));
const published = new Date(d.publishedAt);
const modified = d.updatedAt ? new Date(d.updatedAt) : null;
const fmt = (x: Date) => x.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const coverUrl = typeof d.cover === "string" ? d.cover : (d.cover as any)?.src ?? "/og-default.svg";
const url = `https://thenextcigar.com/blog/${d.slug}/`;

// Cigars this piece is about → live prices in the rail.
const RET = Object.fromEntries(RETAILERS.map((r) => [r.id, r]));
const t = d.title.toLowerCase();
const seedIds: string[] = (d.relatedSkus && d.relatedSkus.length > 0)
  ? d.relatedSkus
  : SKUS.filter((s) => t.includes(s.brand.toLowerCase()) && t.includes(s.vitola.toLowerCase())).map((s) => s.id);
const mentioned = seedIds
  .map((id) => SKUS.find((s) => s.id === id))
  .filter((s): s is NonNullable<typeof s> => !!s)
  .map((sku) => ({ sku, best: bestPriceForSku(sku.id) }))
  .filter((r) => r.best)
  .slice(0, 4);

// FAQ blocks in the body → FAQPage schema (matches "## Questions" H2 + H3 pairs).
const faqPairs: { q: string; a: string }[] = [];
{
  const body = post.body ?? "";
  const rx = /^###\s+(.+?)\s*\n+([^#][\s\S]*?)(?=\n###\s|\n##\s|$)/gm;
  const faqSection = body.match(/^##\s+(?:Questions|FAQ|Frequently[^\n]*)\n([\s\S]*?)(?=\n##\s|$)/m);
  if (faqSection) {
    let m: RegExpExecArray | null;
    while ((m = rx.exec(faqSection[1])) !== null && faqPairs.length < 12) {
      faqPairs.push({ q: m[1].trim(), a: m[2].replace(/[*_`>\[\]]|\(https?:[^)]*\)/g, "").trim().slice(0, 900) });
    }
  }
}

const graph: any[] = [
  {
    "@type": "Article",
    headline: d.title,
    description: d.excerpt || d.title,
    image: coverUrl.startsWith("http") ? coverUrl : `https://thenextcigar.com${coverUrl}`,
    datePublished: published.toISOString(),
    dateModified: (modified ?? published).toISOString(),
    author: { "@type": author ? "Person" : "Organization", name: (author?.data as any)?.name ?? "The Next Cigar" },
    publisher: { "@type": "Organization", name: "The Next Cigar", logo: { "@type": "ImageObject", url: "https://thenextcigar.com/logo.png" } },
    mainEntityOfPage: url,
    inLanguage: "en",
    wordCount: words,
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "The Next Cigar", item: "https://thenextcigar.com/" },
      { "@type": "ListItem", position: 2, name: "Magazine", item: "https://thenextcigar.com/blog/" },
      { "@type": "ListItem", position: 3, name: d.title, item: url },
    ],
  },
];
if (faqPairs.length >= 2) {
  graph.push({
    "@type": "FAQPage",
    mainEntity: faqPairs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  });
}
const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<PaperLayout
  title={`${d.title} · The Next Cigar`}
  description={d.excerpt || d.title}
  image={coverUrl}
  section="magazine"
  compact={true}
  ogType="article"
  published={published.toISOString()}
  modified={(modified ?? published).toISOString()}
  jsonLd={jsonLd}
>
  <article class="art">
    <p class="miga"><a href="/">Front page</a> · <a href="/blog/">Magazine</a>{category && <> · <a href={`/blog/`}>{(category.data as any).name}</a></>}</p>
    <h1>{d.title}</h1>
    {d.excerpt && <p class="standfirst">{d.excerpt}</p>}
    <p class="credit">
      <span>By <b>{(author?.data as any)?.name ?? "The Next Cigar"}</b></span>
      <span>{fmt(published)}</span>
      {modified && modified.getTime() - published.getTime() > 86400000 && <span>Updated {fmt(modified)}</span>}
      <span>{readMinutes} min read</span>
    </p>

    {coverUrl && coverUrl !== "/og-default.svg" && (
      <figure class="cubierta">
        <img class="foto" src={coverUrl} alt="" width="1600" height="800" fetchpriority="high" />
      </figure>
    )}

    <div class="artbody">
      <aside class="side">
        <div id="toc-wrap" hidden>
          <p class="t">In this piece</p>
          <ol id="toc"></ol>
        </div>

        <p class="t">The file</p>
        <dl>
          {category && <><dt>Section</dt><dd>{(category.data as any).name}</dd></>}
          <dt>Published</dt><dd>{fmt(published)}</dd>
          {modified && <><dt>Last checked</dt><dd>{fmt(modified)}</dd></>}
          <dt>Length</dt><dd>{words.toLocaleString()} words</dd>
        </dl>

        {mentioned.length > 0 && (
          <div class="pricebox" style="margin-top:0">
            <p class="t">Prices in this piece</p>
            <table>
              {mentioned.map(({ sku, best }) => (
                <tr>
                  <td><a href={`/finder/sku/${sku.slug}/`}>{sku.brand} {sku.vitola}</a><small>box of {sku.boxSize} · {RET[best!.snap.retailerId]?.name}</small></td>
                  <td>{formatPrice(best!.snap.price, best!.snap.currency)}<small>{checkedLabel(best!.snap)}</small></td>
                </tr>
              ))}
            </table>
            <a class="cta" href="/finder/">See the whole board</a>
          </div>
        )}
      </aside>

      <div class="prose cap">
        <Content />
      </div>
    </div>

    <section class="band">
      <div class="rulehead flat"><h2>Read next</h2><a class="more" href="/blog/">The archive →</a></div>
      <div class="three">
        {related.map((p) => {
          const c = typeof p.data.cover === "string" ? p.data.cover : (p.data.cover as any)?.src;
          return (
            <article>
              <span class="kick mute">{String(p.data.category).replace(/-/g, " ")}</span>
              {c && <a href={`/blog/${p.data.slug}/`}><img class="foto" src={c} alt="" width="640" height="480" loading="lazy" style="aspect-ratio:4/3;object-fit:cover;width:100%;margin:8px 0 10px" /></a>}
              <a class="head" style="font-size:21px" href={`/blog/${p.data.slug}/`}>{p.data.title}</a>
              {p.data.excerpt && <p class="t" style="margin-top:8px">{p.data.excerpt.slice(0, 120)}…</p>}
            </article>
          );
        })}
      </div>
    </section>
  </article>

  <script is:inline>
    // Contents rail, built from the article's own H2s. Progressive enhancement:
    // if this never runs, the rail simply has no contents block.
    (function () {
      var body = document.querySelector(".artbody .prose");
      var list = document.getElementById("toc");
      var wrap = document.getElementById("toc-wrap");
      if (!body || !list || !wrap) return;
      var hs = body.querySelectorAll("h2");
      if (hs.length < 3) return;
      hs.forEach(function (h, i) {
        if (!h.id) h.id = "s" + (i + 1) + "-" + (h.textContent || "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 40);
        var li = document.createElement("li");
        var a = document.createElement("a");
        a.href = "#" + h.id;
        // Headings often start with their own "1." — do not number twice.
        a.textContent = (h.textContent || "").replace(/^\s*\d+[.)]\s*/, "");
        li.appendChild(a);
        list.appendChild(li);
      });
      wrap.hidden = false;
    })();
  </script>
</PaperLayout>
