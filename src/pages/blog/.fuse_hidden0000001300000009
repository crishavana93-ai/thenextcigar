---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/newspaper.css";
import CigarCursor from "../../components/newspaper/CigarCursor.astro";
import NewspaperMasthead from "../../components/newspaper/NewspaperMasthead.astro";
import SectionFlag from "../../components/newspaper/SectionFlag.astro";

/**
 * /blog/ — The Magazine section in the cinematic newspaper design.
 *
 * Layout: masthead + section flag + cover story + six-card feature
 * grid + category-organized subsections + full archive listing. No
 * video intro — that's the homepage's job. Direct entry lands
 * straight on the paper.
 */

const allPosts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);
const categories = await getCollection("categories");
const categoryByslug = new Map(categories.map((c) => [c.data.slug, c.data]));

// Cover — featured post or most recent
const cover = allPosts.find((p) => p.data.featured) ?? allPosts[0];

// Six most recent AFTER the cover
const usedIds = new Set([cover?.id]);
const features = allPosts.filter((p) => !usedIds.has(p.id)).slice(0, 6);
features.forEach((p) => usedIds.add(p.id));

// Category-organized subsections — 3 stories per category
function bySlug(slug: string, limit = 3) {
  return allPosts.filter((p) => p.data.category === slug && !usedIds.has(p.id)).slice(0, limit);
}
const cigar101 = bySlug("cigar-101");
cigar101.forEach((p) => usedIds.add(p.id));
const havana = bySlug("havana-cigar-life");
havana.forEach((p) => usedIds.add(p.id));
const culture = bySlug("cigar-culture");
culture.forEach((p) => usedIds.add(p.id));

// Archive — everything else, chronological
const archive = allPosts.filter((p) => !usedIds.has(p.id));

function coverOf(post: typeof allPosts[number]): string {
  const c = post.data.cover;
  if (!c) return "/og-default.svg";
  if (typeof c === "string") return c;
  return (c as { src: string }).src;
}
function excerptOf(post: typeof allPosts[number]): string {
  return post.data.excerpt || `Read this feature on ${post.data.title}.`;
}
function categoryLabel(post: typeof allPosts[number]): string {
  const cat = post.data.category ? categoryByslug.get(post.data.category) : null;
  return cat?.data?.name ?? "Editorial";
}
function categoryFlag(slug: string | null): string {
  if (!slug) return "";
  const s = slug.toLowerCase();
  if (s.includes("finder") || s.includes("price")) return "finder";
  if (s.includes("leaf") || s.includes("cigar-101") || s.includes("vitola")) return "leaf";
  if (s.includes("people") || s.includes("culture") || s.includes("havana")) return "people";
  if (s.includes("shop") || s.includes("gear") || s.includes("accessor")) return "shop";
  if (s.includes("news") || s.includes("market")) return "market";
  return "";
}
const fmtShort = (d: Date | string) =>
  new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });


---

<BaseLayout
  title="The Magazine — Long reads · The Next Cigar"
  description={`Every essay we've published — ${allPosts.length} long reads on cigars, the leaf, the markets, and the people who shape the European Habanos world.`}
  bareChrome={true}
>
  <link
    is:inline
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <div class="tnc-cinema">
    <CigarCursor />

    <main class="site-body">
      <NewspaperMasthead
        volume={masthead.volume}
        issue={masthead.issue}
        date={masthead.date}
      />

      <SectionFlag
        number="/03"
        section="The Magazine"
        title={`Long reads<em> — the leaf, the markets, the people.</em>`}
        status={`${allPosts.length} essays in the archive`}
      />

      {cover && (
        <section class="lead-wrap">
          <div class="lead-eyebrow">This issue's cover story</div>
          <div class="lead-grid">
            <a
              href={`/blog/${cover.data.slug}/`}
              class="lead-photo"
              data-hover
              style={`background-image: url("${coverOf(cover)}")`}
              aria-label={`Read: ${cover.data.title}`}
            >
              <span class="cutline"><strong>Above &middot;</strong> {cover.data.title}</span>
            </a>
            <div class="lead-copy">
              <div class="byline">
                Cover story · <em>by {cover.data.author || "TNC editorial"} · {fmtShort(cover.data.publishedAt)}</em>
              </div>
              <h1>{cover.data.title}</h1>
              <p class="standfirst">{excerptOf(cover)}</p>
              <a href={`/blog/${cover.data.slug}/`} class="lead-cta" data-hover>
                Read the full report <span class="arrow">→</span>
              </a>
            </div>
          </div>
        </section>
      )}

      {features.length > 0 && (
        <section class="features">
          <div class="features-head">
            <div>
              <div class="eyebrow">Also in this issue</div>
              <h2>Six more <em>for the pocket.</em></h2>
            </div>
          </div>
          <div class="features-grid">
            {features.map((post) => (
              <a href={`/blog/${post.data.slug}/`} class="feature" data-hover>
                <div class="feature-photo" style={`background-image: url("${coverOf(post)}")`}></div>
                <span class={`feature-flag ${categoryFlag(post.data.category)}`}>{categoryLabel(post)}</span>
                <h3>{post.data.title}</h3>
                <p>{excerptOf(post)}</p>
                <div class="meta"><span>{fmtShort(post.data.publishedAt)}</span></div>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* Category subsections — each category as its own broadsheet band */}
      {cigar101.length > 0 && (
        <section class="cat-band">
          <div class="cat-band-head">
            <div class="cat-band-flag">The Leaf · Cigar 101</div>
            <h2>What every smoker <em>eventually asks.</em></h2>
          </div>
          <div class="cat-band-grid">
            {cigar101.map((post) => (
              <a href={`/blog/${post.data.slug}/`} class="cat-card" data-hover>
                <div class="cat-card-photo" style={`background-image: url("${coverOf(post)}")`}></div>
                <div class="cat-card-copy">
                  <h4>{post.data.title}</h4>
                  <p>{excerptOf(post)}</p>
                  <div class="meta"><span>{fmtShort(post.data.publishedAt)}</span></div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {havana.length > 0 && (
        <section class="cat-band">
          <div class="cat-band-head">
            <div class="cat-band-flag people">Havana · Cuban cigar life</div>
            <h2>From the island <em>outward.</em></h2>
          </div>
          <div class="cat-band-grid">
            {havana.map((post) => (
              <a href={`/blog/${post.data.slug}/`} class="cat-card" data-hover>
                <div class="cat-card-photo" style={`background-image: url("${coverOf(post)}")`}></div>
                <div class="cat-card-copy">
                  <h4>{post.data.title}</h4>
                  <p>{excerptOf(post)}</p>
                  <div class="meta"><span>{fmtShort(post.data.publishedAt)}</span></div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {culture.length > 0 && (
        <section class="cat-band">
          <div class="cat-band-head">
            <div class="cat-band-flag market">Culture · The wider room</div>
            <h2>Everything that <em>surrounds the leaf.</em></h2>
          </div>
          <div class="cat-band-grid">
            {culture.map((post) => (
              <a href={`/blog/${post.data.slug}/`} class="cat-card" data-hover>
                <div class="cat-card-photo" style={`background-image: url("${coverOf(post)}")`}></div>
                <div class="cat-card-copy">
                  <h4>{post.data.title}</h4>
                  <p>{excerptOf(post)}</p>
                  <div class="meta"><span>{fmtShort(post.data.publishedAt)}</span></div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {archive.length > 0 && (
        <section class="archive">
          <div class="archive-head">
            <div class="archive-eyebrow">The archive</div>
            <h2>Everything else <em>we've printed.</em></h2>
            <p>{archive.length} pieces, most recent first. Categories filter above.</p>
          </div>
          <div class="archive-list">
            {archive.map((post) => (
              <a href={`/blog/${post.data.slug}/`} class="archive-row" data-hover>
                <span class="archive-date">{fmtShort(post.data.publishedAt)}</span>
                <span class="archive-cat">{categoryLabel(post)}</span>
                <span class="archive-title">{post.data.title}</span>
                <span class="archive-read">Read →</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="footer-strip">
        <div class="footer-strip-inner">
          <div>
            <a href="/" class="footer-strip-mark" data-hover>The Next Cigar</a>
            <div class="footer-strip-tag">The Anthology of the Leaf &middot; Malmö · Lisbon</div>
          </div>
          <div class="footer-strip-links">
            <a href="/finder/" data-hover>Finder</a>
            <a href="/lounge/" data-hover>Lounge</a>
            <a href="/blog/" data-hover>Magazine</a>
            <a href="/shop/" data-hover>Shop</a>
            <a href="/about/" data-hover>About</a>
            <a href="/contact/" data-hover>Contact</a>
          </div>
        </div>
        <div class="footer-strip-copy">© 2025–2026 The Next Cigar · Cristian Ortiz Suárez</div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .site-body { padding-bottom: 40px; }

  /* ── Cover story ── */
  .lead-wrap {
    max-width: 1520px; margin: 0 auto; padding: 48px 40px 64px;
    border-bottom: 1px solid var(--news-rule);
  }
  .lead-eyebrow {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--news-oxblood); margin-bottom: 24px;
    display: flex; align-items: center; gap: 12px;
  }
  .lead-eyebrow::before {
    content: ""; width: 32px; height: 1px; background: var(--news-oxblood);
  }
  .lead-grid {
    display: grid; grid-template-columns: 7fr 5fr; gap: 64px; align-items: end;
  }
  .lead-photo {
    display: block; aspect-ratio: 4 / 5; position: relative;
    background-size: cover; background-position: center;
    background-color: var(--news-paper-dark);
    filter: grayscale(0.85) sepia(0.35) contrast(1.06);
    min-height: 320px;
  }
  .lead-photo .cutline {
    position: absolute; left: 0; right: 0; bottom: -32px;
    font-family: var(--news-serif); font-style: italic; font-size: 12px;
    color: var(--news-ink-mute); line-height: 1.4;
  }
  .lead-photo .cutline strong { font-style: normal; font-weight: 600; color: var(--news-ink-soft); }
  .lead-copy .byline {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--news-ink-mute); margin-bottom: 20px;
  }
  .lead-copy .byline em { font-style: italic; text-transform: none; letter-spacing: 0; color: var(--news-ink-soft); }
  .lead-copy h1 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(2rem, 4vw, 4rem); line-height: 1.0; letter-spacing: -0.028em;
    color: var(--news-ink); margin: 0 0 24px;
  }
  .lead-copy .standfirst {
    font-family: var(--news-serif); font-style: italic;
    font-size: clamp(1.05rem, 1.5vw, 1.35rem); line-height: 1.55;
    color: var(--news-ink-soft); margin: 0 0 32px;
    padding-bottom: 32px; border-bottom: 1px solid var(--news-rule); max-width: 560px;
  }
  .lead-cta {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 16px 28px; background: var(--news-ink); color: var(--news-paper);
    font-family: var(--news-sans); font-weight: 600; font-size: 13px; letter-spacing: 0.02em;
    transition: background 0.25s var(--news-ease);
  }
  .lead-cta:hover { background: var(--news-oxblood); }
  .lead-cta .arrow { font-family: var(--news-mono); }

  /* ── Six-card feature grid ── */
  .features {
    max-width: 1520px; margin: 0 auto; padding: 64px 40px;
    border-bottom: 1px solid var(--news-rule);
  }
  .features-head {
    display: flex; justify-content: space-between; align-items: end;
    margin-bottom: 48px; flex-wrap: wrap; gap: 24px;
  }
  .features-head .eyebrow {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--news-oxblood);
    display: flex; align-items: center; gap: 12px; margin-bottom: 16px;
  }
  .features-head .eyebrow::before {
    content: ""; width: 32px; height: 1px; background: var(--news-oxblood);
  }
  .features-head h2 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(2rem, 3.6vw, 3.2rem); line-height: 1.0; letter-spacing: -0.024em;
    margin: 0;
  }
  .features-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px;
  }
  .feature { display: flex; flex-direction: column; transition: transform 0.3s var(--news-ease); }
  .feature:hover { transform: translateY(-2px); }
  .feature-photo {
    aspect-ratio: 4 / 3; margin-bottom: 20px;
    background-size: cover; background-position: center;
    background-color: var(--news-paper-dark);
    filter: grayscale(0.75) sepia(0.28) contrast(1.06);
    transition: filter 0.4s var(--news-ease);
  }
  .feature:hover .feature-photo { filter: grayscale(0.5) sepia(0.15) contrast(1.08); }
  .feature-flag {
    display: inline-block; align-self: flex-start;
    font-family: var(--news-sans); font-size: 9px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-ink); color: var(--news-paper);
    padding: 4px 9px; margin-bottom: 12px;
  }
  .feature-flag.finder { background: var(--news-oxblood); }
  .feature-flag.leaf   { background: var(--news-pine); }
  .feature-flag.people { background: #3a2a1c; }
  .feature-flag.shop   { background: var(--news-mahogany); }
  .feature-flag.market { background: #4a3826; }
  .feature h3 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.25rem, 1.8vw, 1.6rem); line-height: 1.12; letter-spacing: -0.014em;
    color: var(--news-ink); margin: 0 0 10px;
    transition: color 0.2s;
  }
  .feature:hover h3 { color: var(--news-oxblood); }
  .feature p {
    font-family: var(--news-serif); font-style: italic;
    font-size: 15px; line-height: 1.55; color: var(--news-ink-soft);
    margin: 0 0 14px;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .feature .meta {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--news-ink-mute); margin-top: auto;
  }

  /* ── Category subsections — bands with own flag colour ── */
  .cat-band {
    max-width: 1520px; margin: 0 auto; padding: 56px 40px;
    border-bottom: 1px solid var(--news-rule);
  }
  .cat-band-head {
    display: grid; grid-template-columns: auto 1fr; gap: 32px; align-items: baseline;
    margin-bottom: 36px; padding-bottom: 16px; border-bottom: 1px solid var(--news-ink);
  }
  .cat-band-flag {
    font-family: var(--news-sans); font-weight: 700; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-pine); color: var(--news-paper);
    padding: 6px 12px; white-space: nowrap; align-self: start;
  }
  .cat-band-flag.people { background: #3a2a1c; }
  .cat-band-flag.market { background: #4a3826; }
  .cat-band-flag.finder { background: var(--news-oxblood); }
  .cat-band-flag.shop   { background: var(--news-mahogany); }
  .cat-band-head h2 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem); line-height: 1.1; letter-spacing: -0.018em;
    color: var(--news-ink); margin: 0;
  }
  .cat-band-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px;
  }
  .cat-card {
    display: grid; grid-template-rows: auto 1fr; gap: 16px;
    transition: transform 0.3s var(--news-ease);
  }
  .cat-card:hover { transform: translateX(3px); }
  .cat-card-photo {
    aspect-ratio: 3 / 2;
    background-size: cover; background-position: center;
    background-color: var(--news-paper-dark);
    filter: grayscale(0.75) sepia(0.28) contrast(1.06);
  }
  .cat-card-copy h4 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem); line-height: 1.18; letter-spacing: -0.012em;
    color: var(--news-ink); margin: 0 0 6px;
    transition: color 0.2s;
  }
  .cat-card:hover .cat-card-copy h4 { color: var(--news-oxblood); }
  .cat-card-copy p {
    font-family: var(--news-serif); font-style: italic;
    font-size: 13.5px; line-height: 1.5; color: var(--news-ink-soft);
    margin: 0 0 10px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .cat-card-copy .meta {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--news-ink-mute);
  }

  /* ── Archive list — dense newspaper index style ── */
  .archive {
    max-width: 1520px; margin: 0 auto; padding: 64px 40px;
    border-bottom: 1px solid var(--news-rule);
  }
  .archive-head { margin-bottom: 32px; padding-bottom: 16px; border-bottom: 4px double var(--news-ink); }
  .archive-eyebrow {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--news-oxblood); margin-bottom: 12px;
  }
  .archive-head h2 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.8rem, 3vw, 2.4rem); line-height: 1.02; letter-spacing: -0.02em;
    color: var(--news-ink); margin: 0 0 8px;
  }
  .archive-head p {
    font-family: var(--news-serif); font-style: italic; font-size: 15px;
    color: var(--news-ink-soft); margin: 0;
  }
  .archive-list { display: grid; grid-template-columns: 1fr; }
  .archive-row {
    display: grid;
    grid-template-columns: 120px 140px 1fr auto;
    gap: 24px; align-items: baseline;
    padding: 14px 0; border-bottom: 1px solid var(--news-rule);
    transition: padding-left 0.25s var(--news-ease), color 0.25s;
  }
  .archive-row:hover { padding-left: 8px; }
  .archive-row:hover .archive-title { color: var(--news-oxblood); }
  .archive-date {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.14em;
    color: var(--news-ink-mute); text-transform: uppercase; white-space: nowrap;
  }
  .archive-cat {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--news-oxblood); white-space: nowrap;
  }
  .archive-title {
    font-family: var(--news-serif); font-weight: 500; font-size: 16px;
    line-height: 1.3; color: var(--news-ink); letter-spacing: -0.008em;
    transition: color 0.2s;
  }
  .archive-read {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.14em;
    color: var(--news-oxblood); text-transform: uppercase; white-space: nowrap;
  }

  /* ── Footer strip ── */
  .footer-strip {
    max-width: 1520px; margin: 0 auto; padding: 40px 40px 24px;
  }
  .footer-strip-inner {
    display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center;
    padding-bottom: 20px; border-bottom: 1px solid var(--news-rule);
  }
  .footer-strip-mark {
    font-family: var(--news-serif); font-weight: 600; font-size: 22px;
    letter-spacing: -0.008em; color: var(--news-ink); display: block;
  }
  .footer-strip-tag {
    font-family: var(--news-serif); font-style: italic; font-size: 13px;
    color: var(--news-ink-mute); margin-top: 2px;
  }
  .footer-strip-links {
    display: flex; gap: 24px; flex-wrap: wrap;
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--news-ink-mute);
  }
  .footer-strip-links a { padding: 4px 0; border-bottom: 1px solid transparent; transition: all 0.2s; }
  .footer-strip-links a:hover { color: var(--news-oxblood); border-bottom-color: var(--news-oxblood); }
  .footer-strip-copy {
    margin-top: 16px;
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.16em;
    color: var(--news-ink-mute);
  }

  @media (max-width: 900px) {
    .lead-grid { grid-template-columns: 1fr; gap: 32px; }
    .features-grid, .cat-band-grid { grid-template-columns: 1fr; }
    .cat-band-head { grid-template-columns: 1fr; gap: 12px; }
    .archive-row { grid-template-columns: auto 1fr; gap: 8px 16px; }
    .archive-cat, .archive-read { grid-column: 1 / -1; font-size: 9px; }
    .footer-strip-inner { grid-template-columns: 1fr; gap: 20px; }
    .lead-wrap, .features, .cat-band, .archive, .footer-strip { padding: 40px 20px; }
  }
</style>
