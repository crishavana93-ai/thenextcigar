---
import { getCollection } from "astro:content";
import PaperLayout from "../../layouts/PaperLayout.astro";

/**
 * /blog/
 * /blog/ — the Magazine archive, laid out as a section front:
 * the newest piece large, then a dense dated index grouped by month.
 */

const posts = (await getCollection("blog"))
  .filter((p) => !(p.data as any).draft)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
const cats = new Map((await getCollection("categories")).map((c) => [c.data.slug, c.data]));
const authors = await getCollection("authors");
const authorName = (slug?: string) =>
  (authors.find((a) => a.id === slug || (a.data as any).slug === slug)?.data as any)?.name ?? "The Next Cigar";
const cover = (p: (typeof posts)[number]) => {
  const c: any = p.data.cover; return !c ? undefined : typeof c === "string" ? c : c.src;
};
const catName = (slug?: string) => (slug && cats.get(slug)?.name) || "Editorial";

const [lead, ...others] = posts;
const featured = others.slice(0, 4);
const archive = others.slice(4);

// Group the tail by month so the index reads like a paper's back numbers.
const byMonth = new Map<string, typeof posts>();
for (const p of archive) {
  const k = new Date(p.data.publishedAt).toLocaleDateString("en-GB", { month: "long", year: "numeric" });
  if (!byMonth.has(k)) byMonth.set(k, []);
  byMonth.get(k)!.push(p);
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "The Next Cigar Magazine",
  url: "https://thenextcigar.com/blog/",
  isPartOf: { "@type": "WebSite", url: "https://thenextcigar.com/" },
};
---

<PaperLayout
  title="Magazine — long reads on Cuban cigars · The Next Cigar"
  description={`${posts.length} essays and guides on Cuban cigars: the leaf, the market, Havana, and the gear worth owning. Free to read.`}
  section="magazine"
  compact={true}
  jsonLd={jsonLd}
>
  <div class="dateline">
    <h1>Magazine <em>— the leaf, the markets, the people.</em></h1>
    <p class="st">{posts.length} essays · free to read</p>
  </div>

  <div class="front">
    <section class="lead" style="grid-column:1 / span 2;border-right:1px solid var(--rule);padding-left:0">
      <span class="kick">{catName(lead.data.category)}</span>
      <h2 class="head" style="margin-top:8px"><a href={`/blog/${lead.data.slug}/`}>{lead.data.title}</a></h2>
      {lead.data.excerpt && <p class="deck">{lead.data.excerpt}</p>}
      <p class="by">By {authorName(lead.data.author)} · {new Date(lead.data.publishedAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}</p>
      {cover(lead) && (
        <figure><a href={`/blog/${lead.data.slug}/`}><img class="foto" src={cover(lead)} alt="" width="1200" height="675" fetchpriority="high" /></a></figure>
      )}
      <div class="twin" style="grid-template-columns:1fr 1fr 1fr 1fr">
        {featured.map((p) => (
          <article style="border-left:0;padding-left:0">
            <span class="kick mute">{catName(p.data.category)}</span>
            <h3 class="head" style="font-size:19px;margin:6px 0 6px"><a href={`/blog/${p.data.slug}/`}>{p.data.title}</a></h3>
            <p class="by">{new Date(p.data.publishedAt).toLocaleDateString("en-GB", { day: "numeric", month: "short" })}</p>
          </article>
        ))}
      </div>
    </section>

    <aside class="rail">
      <div class="rulehead"><h2>Sections</h2></div>
      <ul class="eds">
        {[...cats.values()].map((c: any) => (
          <li><a href={`/blog/`}>{c.name}</a><span>{posts.filter((p) => p.data.category === c.slug).length}</span></li>
        ))}
      </ul>
      <div class="box">
        <span class="kick">The paper, by email</span>
        <h3 class="head">One dispatch, when there's something to say.</h3>
        <p>New guides, price moves worth knowing, and the odd essay. No schedule, no spam.</p>
        <a class="cta" href="/blog/">Get the newsletter</a>
      </div>
    </aside>
  </div>

  <section class="band">
    <div class="rulehead flat"><h2>The archive <em>· back numbers</em></h2><span class="more">{archive.length} more</span></div>
    {[...byMonth.entries()].map(([month, list]) => (
      <section style="margin-bottom:18px">
        <p class="kick mute" style="padding:10px 0 6px;border-bottom:1px solid var(--rule)">{month}</p>
        <ul class="list">
          {list.map((p) => (
            <li style="grid-template-columns:1fr auto;gap:18px;align-items:baseline">
              <div>
                <a class="head" style="font-size:19px" href={`/blog/${p.data.slug}/`}>{p.data.title}</a>
                {p.data.excerpt && <p class="by" style="margin-top:4px">{p.data.excerpt.slice(0, 120)}…</p>}
              </div>
              <span class="by" style="white-space:nowrap">{catName(p.data.category)} · {new Date(p.data.publishedAt).toLocaleDateString("en-GB", { day: "numeric", month: "short" })}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</PaperLayout>
