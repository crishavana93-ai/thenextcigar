---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/newspaper.css";
import CigarCursor from "../components/newspaper/CigarCursor.astro";
import NewspaperMasthead from "../components/newspaper/NewspaperMasthead.astro";
import SectionFlag from "../components/newspaper/SectionFlag.astro";
import { MASTHEAD as masthead } from "";
import { places } from "../data/cigar-places";
import {
  SKUS as FINDER_SKUS,
  RETAILERS as FINDER_RETAILERS,
  PRICE_SNAPSHOTS as FINDER_SNAPSHOTS,
  COUNTRIES as FINDER_COUNTRIES,
} from "../data/finder-data";

/**
 * /lounge/ — The Lounge public landing, styled as newspaper "Society & Travel".
 *
 * Layout: masthead + section flag + featured Casa del Habano + city index
 * grid + three-tier membership ad + notable places classifieds + footer.
 * The member app at /lounge/app/ keeps its own chrome.
 */

// Featured Casa — first casadelhabano place
const featuredCasa = places.find((p) => p.type === "casadelhabano") ?? places[0];

// Group places by city
const cityGroups: Record<string, typeof places> = {};
for (const p of places) {
  cityGroups[p.city] = cityGroups[p.city] || [];
  cityGroups[p.city].push(p);
}
const citiesList = Object.keys(cityGroups).sort();
const totalPlaces = places.length;
const cityCount = citiesList.length;

// Highlight 8 places for the classifieds grid
const highlightPlaces = places
  .filter((p) => p.slug !== featuredCasa.slug)
  .slice(0, 8);

const skuCount       = FINDER_SKUS.length;
const retailerCount  = FINDER_RETAILERS.length;
const snapshotCount  = FINDER_SNAPSHOTS.length;
const countryCount   = FINDER_COUNTRIES.length;



function typeLabel(t: string) {
  return ({
    lounge: "Lounge",
    retailer: "Retailer",
    house: "Brand house",
    casadelhabano: "Casa del Habano",
    pub: "Pub · cigar-friendly",
    club: "Private club",
  } as Record<string, string>)[t] || t;
}
function typeFlag(t: string) {
  return ({
    lounge: "people",
    retailer: "shop",
    house: "leaf",
    casadelhabano: "finder",
    pub: "market",
    club: "people",
  } as Record<string, string>)[t] || "";
}
---

<BaseLayout
  title="The Lounge — Society & Travel · The Next Cigar"
  description={`The private network of European Cuban-cigar smokers. ${totalPlaces} verified lounges across ${cityCount} cities, live-price watchlist alerts, city-by-city check-ins. From $9/month or free for everything public.`}
  bareChrome={true}
>
  <link
    is:inline
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <div class="tnc-cinema">
    <CigarCursor />

    <main class="site-body">
      <NewspaperMasthead volume={masthead.volume} issue={masthead.issue} date={masthead.date} />

      <SectionFlag
        number="/02"
        section="The Lounge"
        title={`Society &amp; Travel<em> — the room behind the price tag.</em>`}
        status={`${totalPlaces} verified lounges · ${cityCount} cities · OG Member tier closes 1 June`}
        live={true}
      />

      <!-- FEATURED CASA — cover story equivalent -->
      {featuredCasa && (
        <section class="lead-wrap">
          <div class="lead-eyebrow">This week's Casa del Habano</div>
          <div class="lead-grid">
            <div class="lead-photo" style={`background-image: url("${(featuredCasa as any).image || 'https://images.pexels.com/photos/1298844/pexels-photo-1298844.jpeg?auto=compress&cs=tinysrgb&w=1600'}")`}>
              <span class="cutline"><strong>Above &middot;</strong> {featuredCasa.name}, {featuredCasa.city}. {typeLabel(featuredCasa.type)}.</span>
            </div>
            <div class="lead-copy">
              <div class="byline">Featured place · <em>{featuredCasa.city}, {featuredCasa.country}</em></div>
              <h1>{featuredCasa.name}</h1>
              <p class="standfirst">
                {featuredCasa.note || `A verified ${typeLabel(featuredCasa.type).toLowerCase()} in ${featuredCasa.city}. One of ${totalPlaces} places in the Lounge index — cross-referenced with member check-ins so you know who's likely to be there tonight.`}
              </p>
              <div class="lead-facts">
                <div><span class="k">City</span><span class="v">{featuredCasa.city}</span></div>
                <div><span class="k">Type</span><span class="v">{typeLabel(featuredCasa.type)}</span></div>
                {featuredCasa.address && <div><span class="k">Address</span><span class="v">{featuredCasa.address}</span></div>}
                {featuredCasa.website && <div><span class="k">Web</span><span class="v"><a href={featuredCasa.website} target="_blank" rel="noopener" data-hover>{featuredCasa.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></span></div>}
              </div>
              <div class="lead-actions">
                <a href="/lounge/app/map/" class="lead-cta" data-hover>Open the map <span class="arrow">→</span></a>
                <a href="/lounge/app/" class="lead-link" data-hover>All {totalPlaces} places</a>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- MEMBERSHIP TIERS — three-column display ad -->
      <section class="tiers-band">
        <div class="tiers-head">
          <div class="tiers-flag">Membership</div>
          <h2>Three ways <em>to sit at the table.</em></h2>
        </div>
        <div class="tiers-grid">
          <div class="tier">
            <div class="tier-name">Free</div>
            <div class="tier-price">€0<span>/mo</span></div>
            <p class="tier-desc">Everything public. The Finder ({snapshotCount.toLocaleString()} live prices across {retailerCount} retailers), the Magazine, and full read access to every long-read.</p>
            <ul class="tier-list">
              <li>Live price ticker · {retailerCount} retailers · {countryCount} countries</li>
              <li>Every article, every issue</li>
              <li>Read-only Casa del Habano map</li>
            </ul>
            <a href="/subscribe/" class="tier-cta" data-hover>Start free</a>
          </div>

          <div class="tier featured">
            <div class="tier-flag">Most popular</div>
            <div class="tier-name">The Lounge</div>
            <div class="tier-price">$9<span>/mo</span></div>
            <p class="tier-desc">Watchlist alerts on any vitola, check into any Casa, message any member, weekly market letter, and travel-mode so you can find the room in a city you've never been to.</p>
            <ul class="tier-list">
              <li>Price-drop alerts by email + push</li>
              <li>City check-ins + member messaging</li>
              <li>Travel mode — Casa map for any city</li>
              <li>Weekly market letter</li>
            </ul>
            <a href="/lounge/app/" class="tier-cta primary" data-hover>Enter the Lounge →</a>
          </div>

          <div class="tier">
            <div class="tier-flag oxblood">Closes 1 June</div>
            <div class="tier-name">OG Member</div>
            <div class="tier-price">$79<span>/year</span></div>
            <p class="tier-desc">Lifetime OG-Member tier. Locked pricing for as long as your card keeps working, first access to every new drop (including Guatabey), and your name in the founding-members ledger.</p>
            <ul class="tier-list">
              <li>Everything in Lounge tier · locked pricing</li>
              <li>First access · every Guatabey drop</li>
              <li>Founding-members ledger listing</li>
              <li>Direct line to the editor</li>
            </ul>
            <a href="/subscribe/" class="tier-cta primary" data-hover>Lock founding price →</a>
          </div>
        </div>
      </section>

      <!-- CITY INDEX — dense list -->
      <section class="city-index-band">
        <div class="city-index-head">
          <div class="city-index-flag">City index</div>
          <h2>Every city <em>we've mapped.</em></h2>
          <p>{cityCount} cities · {totalPlaces} verified places. Click any city to open the members' map.</p>
        </div>
        <div class="city-index">
          {citiesList.map((city) => (
            <a href={`/lounge/app/map/?city=${encodeURIComponent(city)}`} class="city-cell" data-hover>
              <span class="city-name">{city}</span>
              <span class="city-count">{cityGroups[city].length}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- FEATURED PLACES — classifieds ads -->
      <section class="places-band">
        <div class="places-head">
          <div class="places-flag">Notable places</div>
          <h2>Eight rooms <em>worth the trip.</em></h2>
        </div>
        <div class="places-grid">
          {highlightPlaces.map((place) => (
            <a href={`/lounge/app/places/${place.slug}/`} class="place-ad" data-hover>
              <div class="place-photo" style={`background-image: url("${(place as any).image || 'https://images.pexels.com/photos/8129903/pexels-photo-8129903.jpeg?auto=compress&cs=tinysrgb&w=1400'}")`}></div>
              <div class="place-body">
                <span class={`place-flag ${typeFlag(place.type)}`}>{typeLabel(place.type)}</span>
                <h3>{place.name}</h3>
                <div class="place-loc">{place.city}, {place.country}</div>
                {place.note && <p>{place.note}</p>}
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="footer-strip">
        <div class="footer-strip-inner">
          <div>
            <a href="/" class="footer-strip-mark" data-hover>The Next Cigar</a>
            <div class="footer-strip-tag">The Anthology of the Leaf &middot; Malmö · Lisbon</div>
          </div>
          <div class="footer-strip-links">
            <a href="/finder/" data-hover>Finder</a>
            <a href="/lounge/" data-hover>Lounge</a>
            <a href="/blog/" data-hover>Magazine</a>
            <a href="/shop/" data-hover>Shop</a>
            <a href="/about/" data-hover>About</a>
            <a href="/contact/" data-hover>Contact</a>
          </div>
        </div>
        <div class="footer-strip-copy">© 2025–2026 The Next Cigar · Cristian Ortiz Suárez</div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .site-body { padding-bottom: 40px; }

  /* Featured Casa lead */
  .lead-wrap {
    max-width: 1520px; margin: 0 auto; padding: 48px 40px 64px;
    border-bottom: 1px solid var(--news-rule);
  }
  .lead-eyebrow {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--news-oxblood); margin-bottom: 24px;
    display: flex; align-items: center; gap: 12px;
  }
  .lead-eyebrow::before {
    content: ""; width: 32px; height: 1px; background: var(--news-oxblood);
  }
  .lead-grid {
    display: grid; grid-template-columns: 7fr 5fr; gap: 64px; align-items: end;
  }
  .lead-photo {
    aspect-ratio: 4 / 5; position: relative;
    background-size: cover; background-position: center;
    background-color: var(--news-paper-dark);
    filter: grayscale(0.85) sepia(0.35) contrast(1.06);
  }
  .lead-photo .cutline {
    position: absolute; left: 0; right: 0; bottom: -32px;
    font-family: var(--news-serif); font-style: italic; font-size: 12px;
    color: var(--news-ink-mute); line-height: 1.4;
  }
  .lead-photo .cutline strong { font-style: normal; font-weight: 600; color: var(--news-ink-soft); }
  .lead-copy .byline {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--news-ink-mute); margin-bottom: 20px;
  }
  .lead-copy .byline em { font-style: italic; text-transform: none; letter-spacing: 0; color: var(--news-ink-soft); }
  .lead-copy h1 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(2rem, 3.8vw, 3.6rem); line-height: 1.02;
    letter-spacing: -0.026em; color: var(--news-ink); margin: 0 0 24px;
  }
  .lead-copy .standfirst {
    font-family: var(--news-serif); font-style: italic;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem); line-height: 1.55;
    color: var(--news-ink-soft); margin: 0 0 24px;
    padding-bottom: 24px; border-bottom: 1px solid var(--news-rule);
  }
  .lead-facts {
    display: grid; grid-template-columns: 1fr; gap: 8px; margin-bottom: 28px;
  }
  .lead-facts > div { display: flex; gap: 14px; align-items: baseline; }
  .lead-facts .k {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--news-oxblood); min-width: 80px;
  }
  .lead-facts .v {
    font-family: var(--news-serif); font-size: 14px; color: var(--news-ink); line-height: 1.4;
  }
  .lead-facts .v a { color: var(--news-oxblood); border-bottom: 1px solid var(--news-oxblood); padding-bottom: 1px; }
  .lead-actions { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; }
  .lead-cta {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 14px 24px; background: var(--news-ink); color: var(--news-paper);
    font-family: var(--news-sans); font-weight: 600; font-size: 12px;
    letter-spacing: 0.1em; text-transform: uppercase;
    transition: background 0.25s var(--news-ease);
  }
  .lead-cta:hover { background: var(--news-oxblood); }
  .lead-cta .arrow { font-family: var(--news-mono); }
  .lead-link {
    font-family: var(--news-sans); font-weight: 500; font-size: 12px;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--news-oxblood);
    border-bottom: 1px solid var(--news-oxblood); padding-bottom: 3px;
  }

  /* Membership tiers */
  .tiers-band {
    max-width: 1520px; margin: 0 auto; padding: 56px 40px;
    border-bottom: 1px solid var(--news-rule);
  }
  .tiers-head {
    display: grid; grid-template-columns: auto 1fr; gap: 32px; align-items: baseline;
    margin-bottom: 32px; padding-bottom: 8px; border-bottom: 4px double var(--news-ink);
  }
  .tiers-flag {
    font-family: var(--news-sans); font-weight: 700; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-oxblood); color: var(--news-paper);
    padding: 6px 12px; align-self: start;
  }
  .tiers-head h2 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.8rem, 3vw, 2.4rem); line-height: 1.02; letter-spacing: -0.02em;
    color: var(--news-ink); margin: 0;
  }
  .tiers-head h2 :global(em) { font-style: italic; color: var(--news-oxblood); font-weight: 400; }
  .tiers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .tier {
    border: 1px solid var(--news-ink); padding: 32px 28px;
    display: flex; flex-direction: column;
    background: var(--news-paper);
    position: relative;
  }
  .tier.featured {
    border: 3px double var(--news-oxblood);
    background: var(--news-paper-cream);
  }
  .tier-flag {
    position: absolute; top: -12px; left: 20px;
    font-family: var(--news-mono); font-weight: 500; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-oxblood); color: var(--news-paper);
    padding: 4px 10px;
  }
  .tier-flag.oxblood { background: var(--news-ember); }
  .tier-name {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.4rem, 2vw, 1.75rem); line-height: 1;
    letter-spacing: -0.014em; color: var(--news-ink); margin-bottom: 10px;
  }
  .tier-price {
    font-family: var(--news-serif); font-weight: 600;
    font-size: clamp(2.2rem, 3.4vw, 3rem); line-height: 1;
    letter-spacing: -0.028em; color: var(--news-oxblood); margin-bottom: 20px;
    padding-bottom: 20px; border-bottom: 1px solid var(--news-rule);
  }
  .tier-price span { font-family: var(--news-mono); font-weight: 500; font-size: 12px; letter-spacing: 0.06em; color: var(--news-ink-mute); margin-left: 4px; }
  .tier-desc {
    font-family: var(--news-serif); font-style: italic; font-size: 14px;
    line-height: 1.55; color: var(--news-ink-soft); margin: 0 0 16px;
  }
  .tier-list {
    list-style: none; margin: 0 0 24px; padding: 0; flex: 1;
    display: flex; flex-direction: column; gap: 8px;
  }
  .tier-list li {
    font-family: var(--news-serif); font-size: 13.5px; line-height: 1.5;
    color: var(--news-ink); padding-left: 18px; position: relative;
  }
  .tier-list li::before {
    content: "◆"; position: absolute; left: 0; top: 4px;
    color: var(--news-oxblood); font-size: 8px;
  }
  .tier-cta {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 12px 18px; text-align: center;
    font-family: var(--news-sans); font-weight: 600; font-size: 12px;
    letter-spacing: 0.1em; text-transform: uppercase;
    border: 1px solid var(--news-ink); color: var(--news-ink);
    transition: all 0.25s var(--news-ease);
  }
  .tier-cta:hover { background: var(--news-ink); color: var(--news-paper); }
  .tier-cta.primary { background: var(--news-ink); color: var(--news-paper); }
  .tier-cta.primary:hover { background: var(--news-oxblood); border-color: var(--news-oxblood); }

  /* City index */
  .city-index-band {
    max-width: 1520px; margin: 0 auto; padding: 56px 40px;
    border-bottom: 1px solid var(--news-rule);
  }
  .city-index-head { margin-bottom: 24px; padding-bottom: 8px; border-bottom: 4px double var(--news-ink); }
  .city-index-flag {
    display: inline-block;
    font-family: var(--news-sans); font-weight: 700; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-ink); color: var(--news-paper);
    padding: 6px 12px; margin-bottom: 14px;
  }
  .city-index-head h2 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.8rem, 3vw, 2.4rem); line-height: 1.02; letter-spacing: -0.02em;
    color: var(--news-ink); margin: 0 0 8px;
  }
  .city-index-head h2 :global(em) { font-style: italic; color: var(--news-oxblood); font-weight: 400; }
  .city-index-head p {
    font-family: var(--news-serif); font-style: italic; font-size: 15px;
    color: var(--news-ink-soft); margin: 0;
  }
  .city-index {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1px; background: var(--news-rule); padding: 1px;
  }
  .city-cell {
    background: var(--news-paper); padding: 14px 14px;
    display: flex; justify-content: space-between; align-items: baseline;
    transition: background 0.2s;
  }
  .city-cell:hover { background: var(--news-paper-cream); }
  .city-name {
    font-family: var(--news-serif); font-weight: 500; font-size: 15px;
    color: var(--news-ink); letter-spacing: -0.01em;
  }
  .city-count {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.12em;
    color: var(--news-oxblood);
  }

  /* Featured places */
  .places-band {
    max-width: 1520px; margin: 0 auto; padding: 56px 40px;
    border-bottom: 1px solid var(--news-rule);
  }
  .places-head {
    display: grid; grid-template-columns: auto 1fr; gap: 32px; align-items: baseline;
    margin-bottom: 32px; padding-bottom: 8px; border-bottom: 4px double var(--news-ink);
  }
  .places-flag {
    font-family: var(--news-sans); font-weight: 700; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: #3a2a1c; color: var(--news-paper);
    padding: 6px 12px; align-self: start;
  }
  .places-head h2 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.8rem, 3vw, 2.4rem); line-height: 1.02; letter-spacing: -0.02em;
    color: var(--news-ink); margin: 0;
  }
  .places-head h2 :global(em) { font-style: italic; color: var(--news-oxblood); font-weight: 400; }
  .places-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .place-ad {
    display: flex; flex-direction: column;
    border: 1px solid var(--news-ink); background: var(--news-paper);
    transition: transform 0.25s var(--news-ease), box-shadow 0.25s var(--news-ease);
  }
  .place-ad:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(30, 20, 10, 0.15);
  }
  .place-photo {
    aspect-ratio: 3 / 2;
    background-size: cover; background-position: center;
    background-color: var(--news-paper-dark);
    filter: grayscale(0.75) sepia(0.28) contrast(1.06);
    border-bottom: 1px solid var(--news-ink);
  }
  .place-body { padding: 16px 18px 18px; display: flex; flex-direction: column; flex: 1; }
  .place-flag {
    display: inline-block; align-self: flex-start;
    font-family: var(--news-sans); font-size: 9px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-ink); color: var(--news-paper);
    padding: 3px 8px; margin-bottom: 10px;
  }
  .place-flag.finder { background: var(--news-oxblood); }
  .place-flag.leaf   { background: var(--news-pine); }
  .place-flag.people { background: #3a2a1c; }
  .place-flag.shop   { background: var(--news-mahogany); }
  .place-flag.market { background: #4a3826; }
  .place-ad h3 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1rem, 1.35vw, 1.15rem); line-height: 1.15;
    color: var(--news-ink); margin: 0 0 6px;
    transition: color 0.2s;
  }
  .place-ad:hover h3 { color: var(--news-oxblood); }
  .place-loc {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--news-ink-mute); margin-bottom: 10px;
  }
  .place-body p {
    font-family: var(--news-serif); font-style: italic; font-size: 13px;
    line-height: 1.5; color: var(--news-ink-soft); margin: 0;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* Footer strip */
  .footer-strip { max-width: 1520px; margin: 0 auto; padding: 40px 40px 24px; }
  .footer-strip-inner {
    display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center;
    padding-bottom: 20px; border-bottom: 1px solid var(--news-rule);
  }
  .footer-strip-mark {
