---
import { getCollection } from "astro:content";
import PaperLayout from "../layouts/PaperLayout.astro";
import { SKUS, RETAILERS, COUNTRIES, PRICE_SNAPSHOTS, bestPriceForSku, formatPrice, checkedLabel } from "../data/finder-live";
import { events } from "../data/cigar-events";

/**
 * Front page — the broadsheet.
 * Left rail: Markets (live prices) + country editions. Centre: lead report +
 * two secondaries. Right rail: Accessories · tested, Diary, the Lounge box.
 * Then Magazine long reads, Classifieds (shop) and Guatabey.
 * Everything comes from the collections and the Finder; nothing hand-typed.
 */

const posts = (await getCollection("blog"))
  .filter((p) => !(p.data as any).draft)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
const authors = await getCollection("authors");
const products = (await getCollection("products")).filter((p) => !p.data.isArchived);

function authorName(slug?: string) {
  const a = authors.find((x) => x.id === slug || (x.data as any).slug === slug);
  return (a?.data as any)?.name || "The Next Cigar";
}
function cover(p: (typeof posts)[number]): string | undefined {
  const c: any = p.data.cover;
  if (!c) return undefined;
  return typeof c === "string" ? c : c.src;
}
const fmtDate = (d: string | Date) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "long" });

// Lead: the featured post, else the newest.
const lead = posts.find((p) => p.data.featured) ?? posts[0];
const used = new Set<string>([lead.id]);
const take = (n: number, pred: (p: (typeof posts)[number]) => boolean = () => true) => {
  const out: typeof posts = [];
  for (const p of posts) { if (out.length >= n) break; if (!used.has(p.id) && pred(p)) { out.push(p); used.add(p.id); } }
  return out;
};
const secondaries = take(2, (p) => ["cubans", "latest-news"].includes(String(p.data.category)));
const accessories = take(4, (p) => String(p.data.category) === "cigar-accessories" || /cutter|lighter|humidor|gift|gear|travel kit/i.test(p.data.title));
const isMarketPiece = (p: (typeof posts)[number]) => /cheapest|price|prices|duty|spread|retailer map/i.test(p.data.title);
const longReads = take(4, (p) => ["cigar-101", "cigar-culture", "havana-cigar-life", "cubans"].includes(String(p.data.category)) && !isMarketPiece(p));

// Markets rail: cheapest in-stock price per SKU, flagship/premium first, live first.
const RET = Object.fromEntries(RETAILERS.map((r) => [r.id, r]));
const ranked = SKUS
  .map((sku) => ({ sku, best: bestPriceForSku(sku.id) }))
  .filter((r) => r.best)
  .sort((a, b) => {
    const la = a.best!.snap.live ? 0 : 1, lb = b.best!.snap.live ? 0 : 1;
    if (la !== lb) return la - lb;
    const rank = (p: string) => (p === "flagship" ? 0 : p === "premium" ? 1 : 2);
    return rank(a.sku.prestige) - rank(b.sku.prestige);
  });
// A front-page table of seven Cohibas reads like a catalogue, not a market.
// Cap each brand at two so the rail shows the spread of the market.
const perBrand = new Map<string, number>();
const market: typeof ranked = [];
for (const row of ranked) {
  const n = perBrand.get(row.sku.brand) ?? 0;
  if (n >= 2) continue;
  perBrand.set(row.sku.brand, n + 1);
  market.push(row);
  if (market.length === 7) break;
}
const covered = new Map<string, { skus: Set<string>; shops: number }>();
for (const c of COUNTRIES) covered.set(c.code, { skus: new Set(), shops: RETAILERS.filter((r) => r.country === c.code).length });
for (const s of PRICE_SNAPSHOTS) { const c = RET[s.retailerId]?.country; if (c && s.inStock) covered.get(c)?.skus.add(s.skuId); }
const editions = COUNTRIES
  .map((c) => ({ c, n: covered.get(c.code)!.skus.size, shops: covered.get(c.code)!.shops }))
  .filter((e) => e.n > 0 || e.shops > 4)
  .sort((a, b) => b.n - a.n)
  .slice(0, 6);

// Diary: next four events from today.
const today = new Date().toISOString().slice(0, 10);
const diary = events
  .filter((e) => e.endDate >= today)
  .sort((a, b) => a.startDate.localeCompare(b.startDate))
  .slice(0, 4)
  .map((e) => {
    const d = new Date(e.startDate);
    return { ...e, day: d.toLocaleDateString("en-GB", { day: "numeric" }), mon: d.toLocaleDateString("en-GB", { month: "short" }), when: `${d.toLocaleDateString("en-GB", { day: "numeric", month: "short" })}${e.endDate !== e.startDate ? "–" + new Date(e.endDate).toLocaleDateString("en-GB", { day: "numeric", month: "short" }) : ""}` };
  });

// Classifieds: four products, in-stock and buyable first.
const tiles = products
  .sort((a, b) => Number(b.data.inStock && !b.data.comingSoon) - Number(a.data.inStock && !a.data.comingSoon))
  .slice(0, 4);
const money = (n: number, cur: string) => new Intl.NumberFormat("en-GB", { style: "currency", currency: cur || "USD", maximumFractionDigits: 0 }).format(n);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "NewsMediaOrganization", "@id": "https://thenextcigar.com/#org", name: "The Next Cigar", url: "https://thenextcigar.com/", logo: "https://thenextcigar.com/logo.png", sameAs: [] },
    { "@type": "WebSite", url: "https://thenextcigar.com/", name: "The Next Cigar", publisher: { "@id": "https://thenextcigar.com/#org" } },
  ],
};
---

<PaperLayout
  title="The Next Cigar — Cuban cigar prices across Europe, and the magazine"
  description="An independent paper on Cuban cigars: box prices compared across European retailers four times a day, long reads on the leaf, honest accessory reviews and a diary of the season."
  section="front"
  jsonLd={jsonLd}
>
  <div class="front">

    <!-- LEFT RAIL · MARKETS -->
    <aside aria-label="Markets">
      <div class="rulehead"><h2>Markets <em>· box prices, live</em></h2><a class="more" href="/finder/">The Finder →</a></div>
      <table class="mk">
        <thead><tr><th>Vitola · canonical box</th><th class="num">Cheapest</th></tr></thead>
        <tbody>
          {market.map(({ sku, best }) => {
            const s = best!.snap; const r = RET[s.retailerId];
            return (
              <tr>
                <td class="v"><a href={`/finder/sku/${sku.slug}/`}>{sku.brand} {sku.vitola}</a><small>{r?.name} · {String(r?.country).toUpperCase()} · box of {sku.boxSize}</small></td>
                <td class="p">{formatPrice(s.price, s.currency)}<small class:list={{ old: !s.live }}>{checkedLabel(s)}</small></td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <p class="note">Live = re-read from the retailer's own page by our scraper within 14 days; the rest carry the date we last checked by hand. Confirm on the retailer before you order; duty applies across borders.</p>

      <div class="rulehead" style="margin-top:26px"><h2>Country editions</h2></div>
      <ul class="eds">
        {editions.map(({ c, n, shops }) => (
          <li><a href={`/finder/${c.code}/`}>{c.name}</a><span>{n > 0 ? `${n} SKUs · ` : ""}{shops} shops</span></li>
        ))}
      </ul>
    </aside>

    <!-- CENTRE · LEAD -->
    <section class="lead" aria-label="Lead story">
      <span class="kick">{String(lead.data.category || "report").replace(/-/g, " ")} · Report</span>
      <h2 class="head" style="margin-top:8px"><a href={`/blog/${lead.data.slug}/`}>{lead.data.title}</a></h2>
      {lead.data.excerpt && <p class="deck">{lead.data.excerpt}</p>}
      <p class="by">By {authorName(lead.data.author)} · {fmtDate(lead.data.updatedAt || lead.data.publishedAt)}</p>
      {cover(lead) && (
        <figure>
          <a href={`/blog/${lead.data.slug}/`}><img class="foto" src={cover(lead)} alt="" width="1200" height="675" fetchpriority="high" /></a>
        </figure>
      )}
      <div class="twin">
        {secondaries.map((p) => (
          <article>
            <span class="kick">{String(p.data.category).replace(/-/g, " ")}</span>
            <h3 class="head"><a href={`/blog/${p.data.slug}/`}>{p.data.title}</a></h3>
            {p.data.excerpt && <p class="t">{p.data.excerpt}</p>}
          </article>
        ))}
      </div>
    </section>

    <!-- RIGHT RAIL -->
    <aside class="rail" aria-label="Accessories and diary">
      <section>
        <div class="rulehead"><h2>Accessories <em>· tested</em></h2><a class="more" href="/category/cigar-accessories/">All reviews →</a></div>
        <ul class="list">
          {accessories.map((p) => (
            <li>
              <div><a class="head" href={`/blog/${p.data.slug}/`}>{p.data.title}</a>{p.data.excerpt && <p class="by">{p.data.excerpt.slice(0, 90)}{p.data.excerpt.length > 90 ? "…" : ""}</p>}</div>
              {cover(p) && <img class="foto" src={cover(p)} alt="" width="54" height="54" loading="lazy" />}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <div class="rulehead"><h2>Diary</h2><a class="more" href="/category/cigar-events/">Season →</a></div>
        <ul class="list diary">
          {diary.map((e) => (
            <li>
              <span class="d"><b>{e.day}</b>{e.mon}</span>
              <div><a class="head" href={e.url} rel="noopener" target="_blank">{e.name}</a><p class="by">{e.location} · {e.when}</p></div>
            </li>
          ))}
        </ul>
      </section>

      <div class="box">
        <span class="kick">The Lounge · members</span>
        <h3 class="head">A map of the rooms, no cover charge.</h3>
        <p>Casas del Habano and lounges mapped city by city, price watchlists on any vitola, and a check-in so you know who's around. Free.</p>
        <a class="cta" href="/lounge/">Join the Lounge</a>
      </div>
    </aside>
  </div>

  <!-- MAGAZINE -->
  <section class="band" aria-label="Magazine">
    <div class="rulehead flat"><h2>Magazine <em>· long reads</em></h2><a class="more" href="/blog/">{posts.length} essays in the archive →</a></div>
    <div class="four">
      {longReads.map((p) => (
        <article>
          <span class="kick mute">{String(p.data.category).replace(/-/g, " ")}</span>
          {cover(p) && <a href={`/blog/${p.data.slug}/`}><img class="foto" src={cover(p)} alt="" width="640" height="480" loading="lazy" /></a>}
          <a class="head" href={`/blog/${p.data.slug}/`}>{p.data.title}</a>
          {p.data.excerpt && <p class="t">{p.data.excerpt.slice(0, 140)}{p.data.excerpt.length > 140 ? "…" : ""}</p>}
        </article>
      ))}
    </div>
  </section>

  <!-- CLASSIFIEDS -->
  <section class="class" aria-label="The shop">
    <div class="rulehead flat"><h2>Classifieds <em>· the shop</em></h2><a class="more" href="/shop/">Opening soon · stocked in fives →</a></div>
    <div class="tiles">
      {tiles.map((p) => {
        const buyable = p.data.inStock && !p.data.comingSoon;
        return (
          <a class="tile" href={`/shop/${p.data.slug}/`}>
            <div><div class="n">{p.data.name}</div><div class="m">{p.data.excerpt}</div></div>
            <div class="pr">{money(p.data.price, p.data.currency)} <span>{buyable ? "in stock" : "pending stock"}</span></div>
          </a>
        );
      })}
    </div>
    <div class="gb">
      <div class="mark">GB</div>
      <div><span class="kick">Guatabey · in the making</span><h3 class="head" style="margin-top:4px">A guayabera, done properly.</h3><p>Our own four-pocket shirt in the Cuban cut. The first small run is being made now; you'll see the real shirts here, photographed, with the maker named — not before.</p></div>
      <a class="cta" href="/lounge/signup/">Tell me when</a>
    </div>
  </section>
</PaperLayout>
