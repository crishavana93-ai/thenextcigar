---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import HighlightHero from "../components/HighlightHero.astro";
import HomeVideos from "../components/HomeVideos.astro";
import CategoryBand from "../components/CategoryBand.astro";
import PremiumCTA from "../components/PremiumCTA.astro";
import AdSlot from "../components/AdSlot.astro";
import MagazineMasthead from "../components/ui/MagazineMasthead.astro";
import EditorialSectionHead from "../components/ui/EditorialSectionHead.astro";
import HomepageHero from "../components/ui/HomepageHero.tsx";
import ThreePillars from "../components/ui/ThreePillars.tsx";

// ─── Direction A masthead — Volume / Issue / Date label ──────────────────
// Issue number increments with each new issue release; tagline reflects TNC's
// editorial voice. Date is computed live so it stays current without manual
// edits on every push.
const masthead = {
  volume: "Volume III",
  issue: `Issue 0${Math.max(1, Math.min(9, new Date().getMonth() - 1))}`,
  date: new Date().toLocaleDateString("en-GB", { month: "long", year: "numeric" }),
  tagline: "Cuban cigars, written for people who actually smoke them. The Finder, the Lounge, and the long read.",
};

const allPosts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);
const categories = await getCollection("categories");
const categoryByslug = new Map(categories.map((c) => [c.data.slug, c.data]));

// HIGHLIGHT NEWS — 1 featured + 2 side stories
const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const featuredId = featured?.id;
const side = allPosts.filter((p) => p.id !== featuredId).slice(0, 2);

// LATEST NEWS — next 6 stories after the highlight section
const usedIds = new Set([featuredId, ...side.map((p) => p.id)]);
const latest = allPosts.filter((p) => !usedIds.has(p.id)).slice(0, 6);

// Helper — pull posts in a category. We allow re-use of posts that appeared in
// the highlight section so categories with few stories still render fully.
function postsByCategory(slug: string, limit = 4) {
  return allPosts.filter((p) => p.data.category === slug).slice(0, limit);
}

const cigar101 = postsByCategory("cigar-101");
const havana = postsByCategory("havana-cigar-life");
const culture = postsByCategory("cigar-culture");
const news = postsByCategory("latest-news");
---

<BaseLayout
  title="TNext Cigar — Modern editorial for the cigar aficionado"
  description="Highlight news, deep dives, and the cigar stories that shape the leaf — written for people who actually smoke them."
>
  {/* Direction A — magazine masthead bookplate */}
  <MagazineMasthead
    volume={masthead.volume}
    issue={masthead.issue}
    date={masthead.date}
    tagline={masthead.tagline}
  />

  {/* Direction A — Visia-scale headline hero (the brand declaration)
      Now photo-led: Cuban torcedor hand-rolling, cream wash + grain,
      14s ken-burns. Matches /finder/ hero treatment for visual cohesion. */}
  <HomepageHero
    lineOne="Read the leaf."
    lineTwo="Find the price."
    subtitle="The Next Cigar is a European magazine, price-comparison engine, and community for Cuban-cigar smokers. One masthead. Three rooms. No noise."
    ctaPrimary={{ label: "Open the Finder", href: "/finder/" }}
    ctaSecondary={{ label: "Read the magazine", href: "/blog/" }}
    image={{
      src: "https://images.pexels.com/photos/14017013/pexels-photo-14017013.jpeg?auto=compress&cs=tinysrgb&w=2400",
      alt: "Close-up of Cohiba Cuban cigars in a cedar humidor",
      focal: "55% 50%",
    }}
    client:load
  />

  {/* Direction A — the structural identity (Visia-pattern three pillars) */}
  <ThreePillars
    eyebrow="The Architecture"
    intro="Three rooms under one roof — a price engine for the buyer, a private club for the traveler, and an editorial desk for the curious."
    stats={[
      { value: 162, label: "Live prices" },
      { value: 116, label: "Licensed retailers" },
      { value: 18, label: "Countries" },
    ]}
    pillars={[
      {
        number: "01",
        label: "The Finder",
        title: "Cuban cigar prices, all of Europe, one page.",
        body: "162 live prices across 116 licensed retailers in 18 countries. Free, no signup, click through to the cheapest verified box in your country.",
        cta: { label: "Browse the catalogue", href: "/finder/" },
      },
      {
        number: "02",
        label: "The Lounge",
        title: "A private network of European Cuban-cigar smokers.",
        body: "Map of every Casa del Habano in Europe, check-ins by city, member messaging, travel mode. Free tier opens the doors; OG Members lock in at $9/mo before 1 June.",
        cta: { label: "Visit the Lounge", href: "/lounge/" },
      },
      {
        number: "03",
        label: "The Magazine",
        title: "Long reads on the leaf, the markets, and the buyers.",
        body: "Vitola explainers, retailer histories, the cross-border duty math, and the people who shape the European Habanos market. New issues every month.",
        cta: { label: "Read the issues", href: "/blog/" },
      },
    ]}
    client:visible
  />

  {/* HIGHLIGHT NEWS — featured + 2 side stories */}
  {featured && (
    <HighlightHero featured={featured} side={side} categoryByslug={categoryByslug} />
  )}

  {/* LATEST NEWS — editorial archival-index grid */}
  <section class="editorial container-wide py-16 md:py-20 border-t border-[color:var(--color-rule)]">
    <EditorialSectionHead
      eyebrow="This week"
      title="From the archive"
      dek={`The most recent ${latest.length} stories — every Habano shipment shift, every retailer change, every long read we've published.`}
      cta={{ label: `See all ${allPosts.length} stories`, href: "/blog" }}
    />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
      {latest.map((post, i) => {
        const cat = post.data.category ? categoryByslug.get(post.data.category) : null;
        return <PostCard post={post} categoryName={cat?.name} delay={((i % 3) + 1) as 1 | 2 | 3} />;
      })}
    </div>
  </section>

  {/* AD: leaderboard */}
  <div class="container-wide py-8">
    <AdSlot variant="leaderboard" />
  </div>

  {/* VIDEOS — latest cigar videos from across YouTube (dark section, breaks up the page) */}
  <HomeVideos />

  {/* WHAT'S HOT IN — Cigar 101 */}
  {cigar101.length > 0 && (
    <CategoryBand categoryName="Cigar 101" categorySlug="cigar-101" posts={cigar101} variant="dark" />
  )}

  {/* WHAT'S HOT IN — Havana Cigar Life (the Cuban content) */}
  {havana.length > 0 && (
    <CategoryBand categoryName="Havana Cigar Life" categorySlug="havana-cigar-life" posts={havana} />
  )}

  {/* AD: billboard */}
  <div class="container-wide py-8">
    <AdSlot variant="billboard" />
  </div>

  {/* WHAT'S HOT IN — Culture */}
  {culture.length > 0 && (
    <CategoryBand categoryName="Cigar Culture" categorySlug="cigar-culture" posts={culture} variant="warm" />
  )}

  {/* WHAT'S HOT IN — News */}
  {news.length > 0 && (
    <CategoryBand categoryName="Latest News" categorySlug="latest-news" posts={news} />
  )}

  {/* Premium CTA */}
  <PremiumCTA />
</BaseLayout>
