---
import PaperLayout from "../layouts/PaperLayout.astro";
import { channels } from "../data/youtube-channels";
import { fetchLatestVideos } from "../lib/youtube";

/** /watch/ — the screening room. Latest uploads from independent cigar
 *  channels, read from their public feeds at build time. Links open on
 *  YouTube; no player is embedded, so the page loads no third-party script. */
const videos = await fetchLatestVideos();
const enabled = channels.filter((c) => c.enabled);
const [feature, ...rest] = videos;
const grid = rest.slice(0, 12);
const more = rest.slice(12, 30);
const fmt = (d: string) => (d ? new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short" }) : "");
const byChannel = new Map<string, number>();
for (const v of videos) byChannel.set(v.channelName, (byChannel.get(v.channelName) ?? 0) + 1);
---

<PaperLayout title="Watch — the screening room · The Next Cigar" description={`The latest uploads from ${enabled.length} independent cigar channels, gathered in one place and refreshed on every build.`} section="magazine" compact={true}>
  <div class="dateline">
    <h1>Watch <em>— the screening room.</em></h1>
    <p class="st">{enabled.length} channels · {videos.length} recent uploads</p>
  </div>

  {feature ? (
    <div class="front">
      <section class="lead" style="grid-column:1 / span 2;border-right:1px solid var(--rule);padding-left:0">
        <span class="kick">Latest · {feature.channelName}</span>
        <h2 class="head" style="margin-top:8px"><a href={`https://www.youtube.com/watch?v=${feature.videoId}`} target="_blank" rel="noopener">{feature.title}</a></h2>
        <p class="by">{fmt(feature.publishedAt)} · opens on YouTube</p>
        <figure><a href={`https://www.youtube.com/watch?v=${feature.videoId}`} target="_blank" rel="noopener" aria-hidden="true" tabindex="-1"><img class="foto" src={feature.thumbnail} alt="" width="1280" height="720" fetchpriority="high" /></a></figure>
        <div class="three" style="grid-template-columns:repeat(auto-fill,minmax(200px,1fr));row-gap:22px;margin-top:22px">
          {grid.map((v) => (
            <article>
              <a href={`https://www.youtube.com/watch?v=${v.videoId}`} target="_blank" rel="noopener" aria-hidden="true" tabindex="-1"><img class="foto" src={v.thumbnail} alt="" width="640" height="360" loading="lazy" style="aspect-ratio:16/9;object-fit:cover;width:100%;margin:0 0 8px" /></a>
              <span class="kick mute">{v.channelName}</span>
              <a class="head" style="font-size:17px;display:block;margin-top:4px" href={`https://www.youtube.com/watch?v=${v.videoId}`} target="_blank" rel="noopener">{v.title}</a>
              <p class="by">{fmt(v.publishedAt)}</p>
            </article>
          ))}
        </div>
        {more.length > 0 && (
          <ul class="list" style="margin-top:22px">
            {more.map((v) => (<li style="grid-template-columns:1fr auto;gap:18px;align-items:baseline"><div><a class="head" style="font-size:18px" href={`https://www.youtube.com/watch?v=${v.videoId}`} target="_blank" rel="noopener">{v.title}</a><p class="by" style="margin-top:2px">{v.channelName}</p></div><span class="by" style="white-space:nowrap">{fmt(v.publishedAt)}</span></li>))}
          </ul>
        )}
      </section>
      <aside class="rail">
        <div class="rulehead"><h2>The channels</h2></div>
        <ul class="eds">{enabled.map((c) => (<li><a href={`https://www.youtube.com/${c.handle ?? "channel/" + c.id}`} target="_blank" rel="noopener">{c.name}</a><span>{byChannel.get(c.name) ?? 0} recent</span></li>))}</ul>
        <p class="note">Independent creators we watch ourselves. Nobody pays to be listed; nothing here is embedded, so YouTube sees you only when you click.</p>
        <div class="box"><span class="kick">Missing a channel?</span><h3 class="head">Tell the desk.</h3><a class="cta" href="/contact/">Write to us</a></div>
      </aside>
    </div>
  ) : (
    <div class="box" style="max-width:560px"><span class="kick">Screening room</span><h3 class="head">The feeds didn't answer at build time.</h3><p>The channels we follow: {enabled.map((c) => c.name).join(", ")}. Try again after the next build.</p></div>
  )}
</PaperLayout>
