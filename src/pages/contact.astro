---
import PaperLayout from "../layouts/PaperLayout.astro";
/** /contact/ */
const desks = [
  { k: "Story tips & corrections", t: "Something we got wrong, or something we should know. Corrections are noted on the page, not buried.", s: "Story tip" },
  { k: "Retailers", t: "A licensed Cuban-cigar retailer in Europe with public prices on your site? We'd like you on the board. No fee; readers in return.", s: "Retailer listing" },
  { k: "Shop suppliers", t: "You make cutters, lighters, humidors or cases you'd put your name to. Send samples, not decks.", s: "Shop supplier" },
  { k: "Sponsorship", t: "Labelled, on-page, and only for things we'd carry ourselves. Say what it is up front.", s: "Sponsorship" },
];
---
<PaperLayout title="Contact the desk · The Next Cigar" description="Story tips, corrections, retailer listings, shop suppliers and sponsorship — one address, four subjects." section="about" compact={true}>
  <div class="dateline"><h1>Contact <em>— reach the desk.</em></h1><p class="st">contact@thenextcigar.com</p></div>
  <div class="front">
    <section style="grid-column:1 / span 2;border-right:1px solid var(--rule);padding-left:0">
      <div class="three" style="grid-template-columns:1fr 1fr">
        {desks.map((d) => (<article><span class="kick">{d.k}</span><p class="t" style="margin:8px 0 12px">{d.t}</p><a class="head" style="font-size:18px" href={`mailto:contact@thenextcigar.com?subject=${encodeURIComponent(d.s)}`}>contact@thenextcigar.com →</a></article>))}
      </div>
    </section>
    <aside class="rail">
      <div class="rulehead"><h2>Before you write</h2></div>
      <ul class="eds">
        <li><a href="/finder/">A price is wrong</a><span>tell us the retailer</span></li>
        <li><a href="/category/cigar-events/">An event is missing</a><span>date, city, link</span></li>
        <li><a href="/lounge/">A room is missing</a><span>add it in the Lounge</span></li>
      </ul>
      <p class="note">We reply from the same address, usually within a day or two. We don't use contact forms because they lose things.</p>
    </aside>
  </div>
</PaperLayout>
