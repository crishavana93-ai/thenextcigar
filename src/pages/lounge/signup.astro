---
import PaperLayout from "../../layouts/PaperLayout.astro";
/** /lounge/signup/ — join the Lounge. Free; an email and a display name.
 *  Email + password (Supabase signUp); the referral code (creator links) is optional. */
---
<PaperLayout title="Join the Lounge — free · The Next Cigar" description="Join the members' room of The Next Cigar: the map, the watchlist, the members. Free. An email and a name." section="lounge" compact={true} noIndex>
  <div class="dateline"><h1>Join the Lounge <em>— free.</em></h1><p class="st">The members' room</p></div>
  <div class="auth">
    <div class="auth-card">
      <span class="kick">No card · no fee · nothing to cancel</span>
      <h2 class="head" style="margin:8px 0 6px">An email and a name.</h2>
      <p class="t">Pick a password and you're in. Forgot it later? One email resets it.</p>
      <form id="signup-form" class="rw" style="margin-top:18px">
        <label>Email<input type="email" name="email" required autocomplete="email" placeholder="you@example.com" /></label>
        <label>Password <small>8 characters or more</small><input type="password" name="password" required minlength="8" autocomplete="new-password" /></label>
        <label>Name, as other members see it<input type="text" name="display_name" required maxlength="40" autocomplete="nickname" placeholder="Cris O." /></label>
        <label>Referral code <small>optional</small><input type="text" id="signup-ref-code" name="referral_code" maxlength="32" autocomplete="off" placeholder="From a creator's link" /></label>
        <p class="note" id="ref-code-applied" hidden>Code applied — you'll be counted to that creator.</p>
        <label class="chk"><input type="checkbox" name="newsletter" value="1" /> <span>Also send me the paper's newsletter — the board's movers and the week's pieces, about twice a month. Unsubscribe in one click.</span></label>
        <button type="submit" class="cta">Join the Lounge →</button>
      </form>
      <p id="signup-status" class="note auth-status" hidden aria-live="polite"></p>
      <p class="note" style="margin-top:16px">Already a member? <a href="/lounge/login/">Sign in</a>. By joining you accept the <a href="/terms/">terms</a> and <a href="/privacy/">privacy policy</a>. Legal age to buy tobacco where you live.</p>
    </div>
    <aside class="auth-side">
      <div class="rulehead"><h2>What's inside</h2></div>
      <ul class="eds">
        <li><span>The map</span><span>lounges, Casas, shops</span></li>
        <li><span>The watchlist</span><span>price &amp; restock alerts</span></li>
        <li><span>Check-ins &amp; messages</span><span>members near you</span></li>
        <li><span>First access</span><span>Guatabey, Shop arrivals</span></li>
      </ul>
      <p class="note">Why it's free, and what we ask in return: <a href="/lounge/">the Lounge page</a>.</p>
    </aside>
  </div>
</PaperLayout>
<script>
  import { getSupabase } from "../../lib/supabase";

  function setup() {
    const form = document.getElementById("signup-form") as HTMLFormElement | null;
    const status = document.getElementById("signup-status") as HTMLParagraphElement | null;
    if (!form || form.dataset.bound === "1") return;
    form.dataset.bound = "1";

    // Capture a referral code from ?ref=CODE and stash in localStorage so it
    // survives the magic-link round-trip and gets applied in the welcome flow
    // after auth completes. Codes are normalized uppercase. Invalid/missing
    // is a no-op.
    //
    // Also pre-fill the visible ref-code input and show the "code applied"
    // confirmation message so the signer knows they're going through a
    // creator's link (not invisible attribution any more).
    const refInput = document.getElementById("signup-ref-code") as HTMLInputElement | null;
    const refApplied = document.getElementById("ref-code-applied") as HTMLElement | null;
    try {
      const ref = new URLSearchParams(window.location.search).get("ref");
      if (ref && /^[A-Za-z0-9_-]{2,32}$/.test(ref)) {
        const code = ref.toUpperCase();
        localStorage.setItem("lounge_referral_code", code);
        if (refInput) refInput.value = code;
        if (refApplied) refApplied.hidden = false;
      } else {
        // No URL param — restore last-saved code if the user navigated away
        // and came back. Don't show the "applied" confirmation since they
        // may want to clear it.
        const saved = localStorage.getItem("lounge_referral_code");
        if (saved && refInput && !refInput.value) refInput.value = saved;
      }
    } catch {}

    // Whenever the user edits the ref-code field, persist the change to
    // localStorage so the welcome flow picks up THIS value, not the URL one.
    refInput?.addEventListener("input", () => {
      const v = refInput.value.trim().toUpperCase();
      try {
        if (v && /^[A-Za-z0-9_-]{2,32}$/.test(v)) {
          localStorage.setItem("lounge_referral_code", v);
          if (refApplied) refApplied.hidden = false;
        } else {
          localStorage.removeItem("lounge_referral_code");
          if (refApplied) refApplied.hidden = true;
        }
      } catch {}
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get("email") || "").trim();
      const display_name = String(data.get("display_name") || "").trim();
      const password = String(data.get("password") || "");
      if (!email || !display_name || password.length < 8) return;

      const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = "Joining…";

      // Capture the entered ref code (already in localStorage, but include it
      // in user metadata too so the welcome flow has redundancy)
      let refCode: string | null = null;
      try {
        refCode = localStorage.getItem("lounge_referral_code");
      } catch {}

      try {
        const supabase = getSupabase();
        const { data: res, error } = await supabase.auth.signUp({
          email,
          password,
          options: {
            emailRedirectTo: `${window.location.origin}/lounge/login/?confirmed=1`,
            data: {
              display_name,
              ...(refCode ? { referral_code: refCode } : {}),
              ...(data.get("newsletter") ? { newsletter: "1" } : {}),
            },
          },
        });
        if (error) throw error;
        // Supabase returns a user with no identities when the email is already
        // registered (it hides that from the caller on purpose).
        if (res?.user && Array.isArray((res.user as any).identities) && (res.user as any).identities.length === 0) {
          throw new Error("That email is already a member. Sign in instead — or use \"Forgot / no password?\" on the sign-in page to set a password.");
        }
        if (res?.session) {
          // Email confirmation is off: signed in already.
          window.location.href = "/lounge/app/";
          return;
        }
        if (status) {
          status.hidden = false;
          status.classList.remove("is-error");
          status.innerHTML = `One more step: we sent an email to <strong>${email}</strong>. Tap the link inside to confirm it, then sign in with your password.`;
        }
        form.style.display = "none";
      } catch (err: any) {
        if (status) {
          status.hidden = false;
          status.classList.add("is-error");
          status.textContent = err.message || "Something went wrong. Try again, or email contact@thenextcigar.com if it persists.";
        }
        btn.disabled = false;
        btn.textContent = "Join the Lounge →";
      }
    });
  }

  document.addEventListener("astro:page-load", setup);
  setup();
</script>
