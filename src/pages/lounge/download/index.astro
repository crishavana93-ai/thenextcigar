---
import PaperLayout from "../../../layouts/PaperLayout.astro";
import { VENUES as places } from "../../../data/lounge-venues";

/** /lounge/download/
 *  The one page to send people to when they ask "how do I get the app".
 *  The Lounge is a web app: it installs from the browser, no store, no
 *  update to approve. The button below fires the browser's own install
 *  prompt where one exists (Android Chrome, desktop Chrome/Edge); on iPhone
 *  Safari it shows the two taps Apple allows instead. */
const cities = [...new Set(places.map((p) => p.city))].length;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "The Lounge",
  applicationCategory: "LifestyleApplication",
  operatingSystem: "iOS, Android, Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  url: "https://thenextcigar.com/lounge/download/",
  publisher: { "@type": "Organization", name: "The Next Cigar" },
};
---

<PaperLayout
  title="Download the Lounge — the members' app · The Next Cigar"
  description={`The Lounge on your phone: ${places.length} lounges, Casas del Habano and shops in ${cities} cities, your humidor, check-ins and price alerts. Free. Installs from the browser in two taps.`}
  section="lounge"
  image="/og-lounge.jpg"
  manifest="/manifest-lounge.webmanifest"
  compact={true}
  jsonLd={jsonLd}
>
  <div class="dateline">
    <h1>Get the Lounge <em>on your phone.</em></h1>
    <p class="st">Free · no store · installs in two taps</p>
  </div>

  <div class="dl">
    <section class="dl-hero">
      <img src="/lounge-app-icon-192.png" width="96" height="96" alt="" class="dl-icon" />
      <h2 class="head">The Lounge</h2>
      <p class="by">{places.length} rooms in {cities} cities on a map, your humidor, who is smoking near you tonight, and an email when a box you want drops in price.</p>
      <button id="dl-btn" class="btn-ox" type="button">Download now</button>
      <p class="dl-hint" id="dl-hint">Works on iPhone, Android and desktop. Nothing to pay.</p>
    </section>

    <section class="dl-steps" id="dl-steps" hidden>
      <div class="rulehead"><h2 id="dl-steps-title">How to install</h2></div>
      <ol id="dl-steps-list" class="steps"></ol>
      <p class="note">Already installed? Open the Lounge icon on your home screen — you stay signed in.</p>
    </section>

    <section class="dl-why">
      <div class="rulehead"><h2>Why there is no app store</h2></div>
      <div class="prose cap" style="max-width:none">
        <p>The Lounge is a web app. It lives at thenextcigar.com and installs straight from the browser, which means no store account, no 200 MB download, and no update to approve: every time you open it you have the latest version. It runs full-screen, keeps you signed in, and your humidor and alerts are the same whether you open it on a phone, a tablet or a desk.</p>
        <p>It also means Apple and Google never see what you smoke. Nothing on the phone is read except your location, and only when you ask it to find rooms near you.</p>
      </div>
      <p class="note">Not a member yet? <a href="/lounge/signup/">Join free</a> first, then install. Already one? <a href="/lounge/login/">Sign in</a>.</p>
    </section>
  </div>
</PaperLayout>

<style>
  .dl{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:40px;margin-top:8px}
  .dl-hero{border:1px solid var(--ink);padding:28px 26px;text-align:center}
  .dl-icon{width:96px;height:96px;border-radius:22px;box-shadow:0 6px 18px rgba(0,0,0,.18);margin:0 auto 14px;display:block}
  .dl-hero .head{font-size:34px;line-height:1.05}
  .dl-hero .by{margin:10px auto 0;max-width:420px;font-size:15px;color:var(--ink-2)}
  .btn-ox{display:inline-block;margin-top:20px;background:var(--ox);color:var(--paper);border:0;cursor:pointer;font-family:var(--sans);font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;padding:16px 34px}
  .btn-ox:hover{background:#5E1C19}
  .dl-hint{margin-top:12px;font-family:var(--sans);font-size:11.5px;letter-spacing:.06em;color:var(--mute)}
  .dl-steps{grid-column:1 / -1}
  .steps{margin:14px 0 0;padding:0 0 0 0;list-style:none;counter-reset:s;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
  .steps :global(li){counter-increment:s;border-top:1px solid var(--ink);padding-top:10px;font-size:15px;line-height:1.4}
  .steps :global(li)::before{content:counter(s);display:block;font-family:var(--serif);font-size:30px;line-height:1;color:var(--ox);margin-bottom:6px}
  .steps :global(b){font-weight:600}
  @media (max-width:820px){.dl{grid-template-columns:1fr;gap:28px}}
</style>

<script>
  // Install flow. Browser support is uneven, so:
  //  · Chrome/Edge (Android + desktop) fire `beforeinstallprompt` → we call it.
  //  · iPhone/iPad Safari never fires it → we show Share → Add to Home Screen.
  //  · Already installed (standalone) → button becomes "Open the Lounge".
  const btn = document.getElementById("dl-btn") as HTMLButtonElement;
  const hint = document.getElementById("dl-hint")!;
  const steps = document.getElementById("dl-steps")!;
  const stepsTitle = document.getElementById("dl-steps-title")!;
  const stepsList = document.getElementById("dl-steps-list")!;

  const ua = navigator.userAgent;
  const isIos = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
  const isIosSafari = isIos && !/CriOS|FxiOS|EdgiOS/i.test(ua);
  const isAndroid = /Android/i.test(ua);
  const standalone = window.matchMedia?.("(display-mode: standalone)").matches || (navigator as any).standalone === true;

  let deferred: any = null;
  window.addEventListener("beforeinstallprompt", (e) => { e.preventDefault(); deferred = e; hint.textContent = "One tap. The browser will ask you to confirm."; });

  function show(title: string, items: string[]) {
    stepsTitle.textContent = title;
    stepsList.innerHTML = items.map((t) => `<li>${t}</li>`).join("");
    steps.hidden = false;
    steps.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  if (standalone) {
    btn.textContent = "Open the Lounge";
    hint.textContent = "You already have it installed.";
    btn.addEventListener("click", () => { location.href = "/lounge/app/"; });
  } else {
    btn.addEventListener("click", async () => {
      if (deferred) {
        deferred.prompt();
        const { outcome } = await deferred.userChoice;
        deferred = null;
        if (outcome === "accepted") { btn.textContent = "Installed — open it"; hint.textContent = "Look for the Lounge icon on your home screen."; btn.onclick = () => { location.href = "/lounge/app/"; }; }
        return;
      }
      if (isIosSafari) {
        show("On iPhone or iPad", [
          "Tap the <b>Share</b> button at the bottom of Safari (the square with the arrow).",
          "Scroll down and tap <b>Add to Home Screen</b>.",
          "Tap <b>Add</b>. The Lounge appears on your home screen like any app.",
        ]);
      } else if (isIos) {
        show("On iPhone or iPad", [
          "Open this page in <b>Safari</b> — Apple only lets Safari install apps.",
          "Tap <b>Share</b>, then <b>Add to Home Screen</b>, then <b>Add</b>.",
        ]);
      } else if (isAndroid) {
        show("On Android", [
          "Tap the <b>⋮</b> menu in the top-right of Chrome.",
          "Tap <b>Install app</b> (or <b>Add to Home screen</b>).",
          "Confirm. The Lounge appears in your app drawer and home screen.",
        ]);
      } else {
        show("On desktop", [
          "In Chrome or Edge, look for the <b>install icon</b> at the right end of the address bar.",
          "Click it and confirm <b>Install</b>. The Lounge opens in its own window.",
          "On Safari for Mac: <b>File → Add to Dock</b>.",
        ]);
      }
    });
  }
</script>
