---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import LoungeHeader from "../../../../components/lounge/LoungeHeader.astro";
import LoungeTabBar from "../../../../components/lounge/LoungeTabBar.astro";
import {
  SKUS,
  COUNTRIES,
  PRICE_SNAPSHOTS,
  RETAILERS,
  bestPriceForSku,
  formatPrice,
  toEUR,
  snapshotsForSku,
} from "../../../../data/finder-data.ts";

// Editorial demo data — in production these come from Supabase per-member:
// watchlist rows, recent alerts fired, deal digest queue.
//
// For the prototype we surface the catalogue using the same data layer that
// powers the public /finder/. The "demo watchlist" is hard-coded so members
// see what the feature feels like before scraper writes start.
const DEMO_WATCHLIST_SKU_IDS = [
  "cohiba-behike-52",
  "cohiba-robustos",
  "partagas-serie-d-no-4",
  "trinidad-reyes",
];

const watchlistRows = DEMO_WATCHLIST_SKU_IDS
  .map((id) => SKUS.find((s) => s.id === id)!)
  .filter(Boolean)
  .map((sku) => ({ sku, best: bestPriceForSku(sku.id) }));

const dropRows = PRICE_SNAPSHOTS
  .filter((s) => s.originalPrice && s.inStock)
  .map((s) => {
    const sku = SKUS.find((k) => k.id === s.skuId)!;
    const retailer = RETAILERS.find((r) => r.id === s.retailerId)!;
    const pct = Math.round(((s.originalPrice! - s.price) / s.originalPrice!) * 100);
    return { snap: s, sku, retailer, pct };
  })
  .sort((a, b) => b.pct - a.pct)
  .slice(0, 5);

const totalSnapshots = PRICE_SNAPSHOTS.length;
const totalRetailers = RETAILERS.length;
const totalCountries = COUNTRIES.length;

// ─── Catalogue search data layer ───────────────────────────────────────────
// Reuses the same pattern as /finder/index.astro so the search behaviour is
// consistent across the public Finder and the member-app Finder.
const allBrands = Array.from(new Set(SKUS.map((s) => s.brand))).sort();
const countriesWithRetailers = Array.from(new Set(RETAILERS.map((r) => r.country)));
const searchCountries = COUNTRIES.filter((c) => countriesWithRetailers.includes(c.code));

// Pre-compute (sku -> countries) and (sku -> in-stock-countries) at build time
// so the client-side filter doesn't need to walk PRICE_SNAPSHOTS.
const skuCountryMap: Record<string, string[]> = {};
const skuInStockCountries: Record<string, string[]> = {};
for (const sku of SKUS) {
  const snaps = PRICE_SNAPSHOTS.filter((s) => s.skuId === sku.id);
  skuCountryMap[sku.id] = Array.from(new Set(snaps.map((s) => {
    const r = RETAILERS.find((x) => x.id === s.retailerId);
    return r ? r.country : null;
  }).filter((c): c is string => !!c)));
  skuInStockCountries[sku.id] = Array.from(new Set(snaps.filter((s) => s.inStock).map((s) => {
    const r = RETAILERS.find((x) => x.id === s.retailerId);
    return r ? r.country : null;
  }).filter((c): c is string => !!c)));
}

// Quick-lookup of best price per SKU for the catalogue cards
const cataloguePerSku = SKUS.map((sku) => ({
  sku,
  best: bestPriceForSku(sku.id),
  countries: skuCountryMap[sku.id],
  inStockCountries: skuInStockCountries[sku.id],
})).sort((a, b) => (a.best?.eur ?? Infinity) - (b.best?.eur ?? Infinity));
---

<BaseLayout
  title="Finder — The Lounge"
  description="Your Cuban cigar watchlist, recent price drops, and the European deal feed."
  noIndex
>
  <LoungeHeader active="finder" />

  <main class="lounge-app">

    {/* Region A — header strip */}
    <section class="container-wide pt-6 pb-3 reveal">
      <div class="finder-strip">
        <div class="finder-strip__art" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21 21 3" />
            <path d="m18 3 3 0 0 3" />
            <path d="M3 12h6a3 3 0 0 1 3 3v6" />
          </svg>
        </div>
        <div class="finder-strip__body">
          <p class="lounge-label lounge-label--gold">The Finder · Lounge edition</p>
          <h1 class="lounge-h1">Your Cuban cigar watchlist</h1>
          <p class="finder-strip__lead">
            Track {totalSnapshots} live prices across {totalRetailers} European retailers in {totalCountries} countries.
            Unlimited alerts, push notifications, full price history.
          </p>
        </div>
        <a href="/finder/" class="lbtn lbtn-secondary">Public catalogue →</a>
      </div>
    </section>

    {/* Region B — Watchlist */}
    <section class="container-wide pt-2 pb-6 reveal">
      <div class="finder-section-head">
        <p class="lounge-label">Your watchlist</p>
        <a href="#" id="add-to-watchlist" class="lbtn lbtn-ghost lbtn-sm">+ Add cigar</a>
      </div>

      <div class="finder-watchlist" id="lounge-watchlist" data-state="demo">
        <p class="finder-watch__demo-pill" data-demo-pill>
          Demo data — sign in and save a SKU to populate this with your real watchlist
        </p>
        {watchlistRows.map(({ sku, best }) => (
          <a href={`/finder/sku/${sku.slug}/`} class="finder-watch">
            <div class="finder-watch__body">
              <p class="finder-watch__brand">{sku.brand}</p>
              <p class="finder-watch__vitola">{sku.vitola}</p>
              <p class="finder-watch__spec">
                {sku.shape} · ring {sku.ring} · box {sku.boxSize}
              </p>
            </div>
            {best ? (
              <div class="finder-watch__price">
                <p class="finder-watch__price-now">{formatPrice(best.snap.price, best.snap.currency)}</p>
                <p class="finder-watch__price-eur">≈ €{best.eur.toLocaleString("en-US", { maximumFractionDigits: 0 })}</p>
                <p class="finder-watch__price-at">at {RETAILERS.find((r) => r.id === best.snap.retailerId)?.name}</p>
              </div>
            ) : (
              <div class="finder-watch__price">
                <p class="finder-watch__price-empty">Waiting for first snapshot</p>
              </div>
            )}
            <div class="finder-watch__alert">
              <span class="finder-watch__alert-dot" aria-hidden="true"></span>
              <span class="finder-watch__alert-label">Alert active</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* Region B+ — Picked for your taste.
        Personalized 3-card row computed from the member's profile
        (favorite_brands, flavor_notes, strength_preference). Falls back
        to Editor's Picks for members who haven't filled out preferences
        yet — that variant is the entry point to /profile setup. The
        section is hidden by default; hydrateRecommendations() reveals
        it once we know if the member is signed in + their profile state. */}
    <section class="container-wide pt-2 pb-6 reveal" id="picked-section" hidden>
      <div class="finder-section-head">
        <p class="lounge-label" id="picked-label">Picked for your taste</p>
        <a href="/lounge/app/profile/" class="finder-section-head__meta" id="picked-profile-link" hidden>
          Tune my taste profile →
        </a>
      </div>
      <p class="finder-picked-lead" id="picked-lead" hidden>
        Matched against your flavor profile, strength preference, and the brands you've saved.
      </p>
      <div class="finder-picked-grid" id="picked-grid">
        {/* Populated by JS — Astro can't read auth.uid() at build time. */}
      </div>
      {/* Empty-state CTA for profiles that lack taste data. */}
      <div class="finder-picked-empty" id="picked-empty" hidden>
        <p class="finder-picked-empty__lead">
          <strong>Tell us what you like.</strong> Pick a few flavor notes and a strength preference in
          your profile — we'll surface the cigars from our catalogue that match your taste.
        </p>
        <a href="/lounge/app/profile/?setup=1" class="lbtn lbtn-primary lbtn-sm">Complete my taste profile →</a>
      </div>
    </section>

    {/* Region B½ — Catalogue search.
        Lets a member type any cigar name to find SKUs they can add to
        their watchlist. Same filter pattern as /finder/ (free text + brand
        chip + country + in-stock), rendered as a compact card grid suited
        to the member-app layout. */}
    <section class="container-wide pt-2 pb-8 reveal">
      <div class="finder-section-head">
        <p class="lounge-label">Browse the catalogue</p>
        <span class="finder-section-head__meta" data-lcat-count>{SKUS.length} cigars</span>
      </div>
      <div class="lcat-search">
        <div class="lcat-search__row">
          <div class="lcat-search__input-wrap">
            <svg class="lcat-search__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              class="lcat-search__input"
              id="lcat-search-input"
              placeholder="Search 'Cohiba', 'Petit Edmundo', 'Trinidad'…"
              autocomplete="off"
              aria-label="Search Cuban cigars"
              aria-autocomplete="list"
              aria-controls="lcat-search-ac"
            />
            <button type="button" class="lcat-search__clear" data-lcat-clear aria-label="Clear search">×</button>
            {/* Autocomplete dropdown — same logic as public /finder/ */}
            <div
              class="lcat-search__autocomplete"
              id="lcat-search-ac"
              data-lcat-ac
              role="listbox"
              aria-label="Search suggestions"
              hidden
            ></div>
          </div>
          <select class="lcat-search__country" id="lcat-search-country" aria-label="Filter by country">
            <option value="">All countries</option>
            {searchCountries.map((c) => (
              <option value={c.code}>{c.flag} {c.name}</option>
            ))}
          </select>
          <label class="lcat-search__instock">
            <input type="checkbox" id="lcat-search-instock" />
            <span>In stock only</span>
          </label>
        </div>
        <div class="lcat-search__chips" role="group" aria-label="Filter by brand">
          <button type="button" class="lcat-search__chip is-active" data-brand-chip="">All</button>
          {allBrands.map((brand) => (
            <button type="button" class="lcat-search__chip" data-brand-chip={brand}>{brand}</button>
          ))}
        </div>
      </div>

      <div class="lcat-grid">
        {cataloguePerSku.map(({ sku, best, countries, inStockCountries }) => {
          // Broaden the match — include shape (Robusto/Churchill/Minuto),
          // line (Behike/Serie D/Línea Edmundo) and blurb so users can find
          // SKUs by shape or sub-line as well as by brand + vitola.
          const searchName = `${sku.brand} ${sku.vitola} ${sku.shape} ${sku.line} ${sku.id} ${sku.blurb}`.toLowerCase();
          return (
            <a
              href={`/finder/sku/${sku.slug}/`}
              class="lcat-card"
              data-lcat-card
              data-sku-name={searchName}
              data-sku-brand={sku.brand}
              data-sku-countries={countries.join(",")}
              data-sku-instock-countries={inStockCountries.join(",")}
              data-sku-any-instock={inStockCountries.length > 0 ? "1" : "0"}
            >
              <div class="lcat-card__head">
                <span class="lcat-card__brand">{sku.brand}</span>
                <span class="lcat-card__vitola">{sku.vitola}</span>
              </div>
              <p class="lcat-card__spec">{sku.shape} · ring {sku.ring} · box {sku.boxSize}</p>
              {best ? (
                <div class="lcat-card__price">
                  <span class="lcat-card__price-now">{formatPrice(best.snap.price, best.snap.currency)}</span>
                  {best.snap.currency !== "EUR" && (
                    <span class="lcat-card__price-eur">≈ €{Math.round(best.eur).toLocaleString("en-US")}</span>
                  )}
                </div>
              ) : (
                <div class="lcat-card__price">
                  <span class="lcat-card__price-empty">No live price</span>
                </div>
              )}
            </a>
          );
        })}
      </div>
      <div class="lcat-empty" data-lcat-empty hidden>
        <div data-lcat-empty-default>
          <p><strong>No cigars match those filters.</strong></p>
          <button type="button" class="lcat-empty__reset" data-lcat-reset>Reset filters</button>
        </div>
        <div data-lcat-empty-brand hidden>
          <p class="lcat-empty__brand-eyebrow" data-lcat-empty-brand-eyebrow>Cuban Habano · Not yet tracked</p>
          <p class="lcat-empty__brand-name" data-lcat-empty-brand-name>Juan López</p>
          <p class="lcat-empty__brand-note" data-lcat-empty-brand-note>We launched with the 12 most-traded Cuban premium SKUs. Expanding the catalogue monthly.</p>
          <button type="button" class="lcat-empty__reset" data-lcat-reset>← Back to all cigars</button>
        </div>
      </div>
    </section>

    {/* Region C — Deal feed */}
    <section class="container-wide pb-8 reveal">
      <div class="finder-section-head">
        <p class="lounge-label">Today's deal feed</p>
        <span class="finder-section-head__meta">{dropRows.length} active drops · refreshed 02:14 CET</span>
      </div>

      <div class="finder-deals">
        {dropRows.map(({ snap, sku, retailer, pct }) => (
          <a href={`/finder/sku/${sku.slug}/`} class="finder-deal">
            <div class="finder-deal__pct">−{pct}%</div>
            <div class="finder-deal__body">
              <p class="finder-deal__brand">{sku.brand} · {sku.line}</p>
              <p class="finder-deal__vitola">{sku.vitola} · box of {sku.boxSize}</p>
              <p class="finder-deal__price">
                <span class="finder-deal__was">{formatPrice(snap.originalPrice!, snap.currency)}</span>
                <strong>{formatPrice(snap.price, snap.currency)}</strong>
              </p>
              <p class="finder-deal__retailer">{retailer.name} · {retailer.country.toUpperCase()}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* Region D — Premium tools teaser */}
    <section class="container-wide pb-16 reveal">
      <div class="finder-tools">
        <div class="finder-tool">
          <p class="lounge-label lounge-label--gold">01</p>
          <h3 class="finder-tool__title">Price history charts</h3>
          <p class="finder-tool__body">
            Full 90-day price history for any tracked SKU. See how Cohiba Robustos has tracked since the
            2024 Habanos harmonisation.
          </p>
        </div>
        <div class="finder-tool">
          <p class="lounge-label lounge-label--gold">02</p>
          <h3 class="finder-tool__title">Threshold alerts</h3>
          <p class="finder-tool__body">
            Set a target price per cigar. We'll fire an email + push the second any retailer in your country
            crosses it. Dedupe baked in.
          </p>
        </div>
        <div class="finder-tool">
          <p class="lounge-label lounge-label--gold">03</p>
          <h3 class="finder-tool__title">Travel mode</h3>
          <p class="finder-tool__body">
            Switch your country lens to wherever you're flying to. See Madrid prices on a weekend trip;
            switch back when you land home.
          </p>
        </div>
      </div>
    </section>

    {/* Spacer so the bottom tab bar doesn't cover content on mobile */}
    <div style="height: 80px;"></div>
  </main>


<script>
  import { getCurrentUser, getSupabase } from "../../../../lib/supabase";
  import {
    matchKnownBrand, TRACKED_BRAND_NAMES, KNOWN_BRANDS, SKUS,
    selectRecommendedSkus, EDITORS_PICK_SKU_IDS, profileHasTasteData,
    SKU_BY_ID, bestPriceForSku, formatPrice,
  } from "../../../../data/finder-data";

  // Hydrate the watchlist with the signed-in member's saved SKUs. If they
  // have no rows yet, fall back to the demo cards (and keep the demo pill
  // visible). If they're signed out, leave demo as-is.
  async function hydrateWatchlist() {
    try {
      const user = await getCurrentUser();
      if (!user) return; // signed-out members see the demo

      const supabase = getSupabase();

      // Find this member's finder_email_subscribers row (or null if they
      // haven't saved anything yet).
      const { data: subs, error: subErr } = await supabase
        .from("finder_email_subscribers")
        .select("id")
        .eq("profile_id", user.id)
        .maybeSingle();
      if (subErr) { console.warn("[Lounge Finder] sub lookup failed", subErr); return; }
      if (!subs?.id) return; // no subscriber row yet

      const { data: rows, error: rowErr } = await supabase
        .from("finder_watchlists")
        .select("id, sku, target_price_eur, baseline_price_eur, created_at")
        .eq("subscriber_id", subs.id)
        .is("archived_at", null)
        .order("created_at", { ascending: false });
      if (rowErr) { console.warn("[Lounge Finder] watch query failed", rowErr); return; }
      if (!rows || rows.length === 0) return; // no saved cigars — keep demo

      const container = document.getElementById("lounge-watchlist");
      if (!container) return;

      // Drop the demo pill + demo cards.
      container.innerHTML = "";
      container.setAttribute("data-state", "live");

      // Render real rows.
      for (const r of rows) {
        const a = document.createElement("a");
        a.className = "finder-watch";
        a.href = "/finder/sku/" + r.sku + "/";
        a.innerHTML = `
          <div class="finder-watch__body">
            <p class="finder-watch__brand">Saved</p>
            <p class="finder-watch__vitola">${r.sku.replace(/-/g, " ")}</p>
            <p class="finder-watch__spec">
              ${r.target_price_eur != null ? "Target €" + Number(r.target_price_eur).toFixed(0) : "Any drop alert"}
              ${r.baseline_price_eur != null ? " · baseline €" + Number(r.baseline_price_eur).toFixed(0) : ""}
            </p>
          </div>
          <div class="finder-watch__alert">
            <span class="finder-watch__alert-dot" aria-hidden="true"></span>
            <span class="finder-watch__alert-label">Alert active</span>
          </div>
        `;
        container.appendChild(a);
      }
    } catch (err) {
      console.warn("[Lounge Finder] hydration error", err);
    }
  }
  document.addEventListener("astro:page-load", hydrateWatchlist);
  hydrateWatchlist();

  // ─── Picked for your taste ─────────────────────────────────────────────
  // Reads the member's profile preference fields, runs scoreSkuForProfile
  // over the catalogue, and renders the top 3 picks with match reasons.
  // Falls back to Editor's Picks when preferences are missing or the user
  // is signed out. Always reveals the section so the page never looks
  // half-built; the empty state has its own profile-completion CTA.
  async function hydrateRecommendations() {
    const section   = document.getElementById("picked-section");
    const grid      = document.getElementById("picked-grid");
    const lead      = document.getElementById("picked-lead");
    const empty     = document.getElementById("picked-empty");
    const label     = document.getElementById("picked-label");
    const profLink  = document.getElementById("picked-profile-link");
    if (!section || !grid) return;

    let mode: "personalized" | "editors" = "editors";
    let picks: ReturnType<typeof selectRecommendedSkus> = [];

    try {
      const user = await getCurrentUser();
      if (user) {
        const supabase = getSupabase();
        const { data: profile } = await supabase
          .from("profiles")
          .select("favorite_brands, flavor_notes, strength_preference")
          .eq("id", user.id)
          .maybeSingle();

        if (profile && profileHasTasteData(profile)) {
          mode = "personalized";
          picks = selectRecommendedSkus(profile as any);
        }
      }
    } catch (err) {
      console.warn("[Lounge Finder] taste recommendation failed:", err);
    }

    // Fall back to editor's picks if no personalised picks computed.
    if (picks.length === 0) {
      picks = EDITORS_PICK_SKU_IDS
        .map((id) => SKU_BY_ID[id])
        .filter(Boolean)
        .map((sku) => ({ sku, score: 0, reasons: [] }));
      mode = "editors";
    }

    // Render cards.
    section.hidden = false;
    if (mode === "editors") {
      if (label) label.textContent = "Editor's picks";
      if (lead) {
        lead.hidden = false;
        lead.textContent = "A starting trio while we get to know you. Tell us what you like to unlock taste-matched picks below.";
      }
      if (empty) empty.hidden = false;
      if (profLink) profLink.hidden = true;
    } else {
      if (label) label.textContent = "Picked for your taste";
      if (lead) {
        lead.hidden = false;
        lead.textContent = "Matched against your flavor profile, strength preference, and the brands you've saved.";
      }
      if (empty) empty.hidden = true;
      if (profLink) profLink.hidden = false;
    }

    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
    }

    grid.innerHTML = picks.map(({ sku, reasons }) => {
      const best = bestPriceForSku(sku.id);
      const priceHtml = best
        ? `<span class="finder-picked-card__price-now">${escapeHtml(formatPrice(best.snap.price, best.snap.currency))}</span>` +
          (best.snap.currency !== "EUR"
            ? `<span class="finder-picked-card__price-eur">≈ €${Math.round(best.eur).toLocaleString("en-US")}</span>`
            : "")
        : `<span class="finder-picked-card__price-empty">No live price yet</span>`;

      const reasonsHtml = reasons.length > 0 && mode === "personalized"
        ? `<p class="finder-picked-card__why">Matches: <strong>${reasons.slice(0, 3).map(escapeHtml).join(" · ")}</strong></p>`
        : "";

      return `<a class="finder-picked-card" href="/finder/sku/${escapeHtml(sku.slug)}/">
                <div class="finder-picked-card__head">
                  <span class="finder-picked-card__brand">${escapeHtml(sku.brand)}</span>
                  <span class="finder-picked-card__vitola">${escapeHtml(sku.vitola)}</span>
                </div>
                <p class="finder-picked-card__spec">${escapeHtml(sku.shape)} · ring ${sku.ring} · box ${sku.boxSize}</p>
                ${reasonsHtml}
                <div class="finder-picked-card__price">${priceHtml}</div>
              </a>`;
    }).join("");
  }
  document.addEventListener("astro:page-load", hydrateRecommendations);
  hydrateRecommendations();

  // ─── Catalogue search — filter the SKU card grid in real time. ────────
  // Mirrors the public /finder/ filter pattern: free-text + brand chip +
  // country + in-stock toggle. All client-side; no API calls.
  (function initLoungeCatalogSearch() {
    const input    = document.getElementById("lcat-search-input") as HTMLInputElement | null;
    const country  = document.getElementById("lcat-search-country") as HTMLSelectElement | null;
    const instock  = document.getElementById("lcat-search-instock") as HTMLInputElement | null;
    const wrap     = document.querySelector<HTMLElement>(".lcat-search");
    const clearBtn = document.querySelector<HTMLButtonElement>("[data-lcat-clear]");
    const resetBtn = document.querySelector<HTMLButtonElement>("[data-lcat-reset]");
    const empty    = document.querySelector<HTMLElement>("[data-lcat-empty]");
    const count    = document.querySelector<HTMLElement>("[data-lcat-count]");
    const cards    = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-lcat-card]")
    );
    const chips    = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".lcat-search__chip")
    );
    if (!input || !country || !instock || cards.length === 0) return;

    let activeBrand = "";

    function apply() {
      const q          = input.value.trim().toLowerCase();
      const wantCty    = country.value;
      const wantStock  = instock.checked;
      let visible      = 0;

      const tokens = q.split(/\s+/).filter(Boolean);
      for (const card of cards) {
        const name       = card.dataset.skuName || "";
        const brand      = card.dataset.skuBrand || "";
        const cties      = (card.dataset.skuCountries || "").split(",");
        const stockCties = (card.dataset.skuInstockCountries || "").split(",");
        const anyStock   = card.dataset.skuAnyInstock === "1";

        const textOk    = tokens.every((t) => name.includes(t));
        const brandOk   = !activeBrand || brand === activeBrand;
        const countryOk = !wantCty || (wantStock ? stockCties.includes(wantCty) : cties.includes(wantCty));
        const stockOk   = !wantStock || (wantCty ? stockCties.includes(wantCty) : anyStock);

        const show = textOk && brandOk && countryOk && stockOk;
        if (show) visible++;
        card.toggleAttribute("hidden", !show);
      }

      if (wrap) wrap.classList.toggle("has-text", q.length > 0);
      if (empty) empty.toggleAttribute("hidden", visible !== 0);

      // ─── Brand-aware empty state ─────────────────────────────────────────
      // Same logic as /finder/: when the query matches a known untracked
      // brand, show brand-specific messaging instead of generic "No matches".
      if (empty && visible === 0 && q.length >= 2) {
        const matched = matchKnownBrand(q);
        const defaultEl = empty.querySelector<HTMLElement>("[data-lcat-empty-default]");
        const brandEl   = empty.querySelector<HTMLElement>("[data-lcat-empty-brand]");
        const eyebrowEl = empty.querySelector<HTMLElement>("[data-lcat-empty-brand-eyebrow]");
        const nameEl    = empty.querySelector<HTMLElement>("[data-lcat-empty-brand-name]");
        const noteEl    = empty.querySelector<HTMLElement>("[data-lcat-empty-brand-note]");
        const isTracked = matched && TRACKED_BRAND_NAMES.has(matched.name);
        if (matched && !isTracked && defaultEl && brandEl && eyebrowEl && nameEl && noteEl) {
          const originLabel: Record<string, string> = {
            cuba: "Cuban Habano",
            dominican: "Dominican premium",
            nicaragua: "Nicaraguan premium",
            honduras: "Honduran premium",
            spain: "Spanish premium",
            other: "International premium",
          };
          eyebrowEl.textContent = `${originLabel[matched.origin] || "Premium cigar"} · Not yet tracked`;
          nameEl.textContent = matched.name;
          const defaultNote = matched.origin === "cuba"
            ? "We launched with the 12 most-traded Cuban premium SKUs. This brand is on the shortlist — expanding monthly."
            : "The Finder focuses on Cuban (Habanos) cigars at launch. This brand isn't in scope yet.";
          noteEl.textContent = matched.shortNote
            ? `${matched.shortNote} ${defaultNote}`
            : defaultNote;
          defaultEl.hidden = true;
          brandEl.hidden = false;
        } else if (defaultEl && brandEl) {
          defaultEl.hidden = false;
          brandEl.hidden = true;
        }
      }

      if (count) {
        if (visible === cards.length && !q && !wantCty && !wantStock && !activeBrand) {
          count.textContent = `${cards.length} cigars`;
        } else if (visible === 0) {
          count.textContent = "No matches";
        } else {
          count.textContent = `${visible} of ${cards.length} cigars`;
        }
      }
    }

    input.addEventListener("input", apply);
    country.addEventListener("change", apply);
    instock.addEventListener("change", apply);

    clearBtn?.addEventListener("click", () => { input.value = ""; input.focus(); apply(); });

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        activeBrand = chip.dataset.brandChip || "";
        chips.forEach((c) => c.classList.remove("is-active"));
        chip.classList.add("is-active");
        apply();
      });
    });

    resetBtn?.addEventListener("click", () => {
      input.value     = "";
      country.value   = "";
      instock.checked = false;
      activeBrand     = "";
      chips.forEach((c, i) => c.classList.toggle("is-active", i === 0));
      apply();
    });

    // ─── Autocomplete dropdown — Google-style typeahead ─────────────────
    const ac = document.querySelector<HTMLElement>("[data-lcat-ac]");
    let acActive = -1;
    let acItems: HTMLElement[] = [];

    function escapeHtmlAc(s: string): string {
      return s.replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
    }
    function highlight(text: string, q: string): string {
      if (!q) return escapeHtmlAc(text);
      const i = text.toLowerCase().indexOf(q.toLowerCase());
      if (i < 0) return escapeHtmlAc(text);
      return escapeHtmlAc(text.slice(0, i))
        + "<mark>" + escapeHtmlAc(text.slice(i, i + q.length)) + "</mark>"
        + escapeHtmlAc(text.slice(i + q.length));
    }

    function buildSuggestions(q: string): string {
      const ql = q.trim().toLowerCase();
      if (ql.length < 1) return "";
      const trackedHits = SKUS
        .map((sku) => ({ sku, hay: `${sku.brand} ${sku.vitola} ${sku.shape} ${sku.line}`.toLowerCase() }))
        .filter((x) => x.hay.includes(ql))
        .slice(0, 6);
      const brandHits = KNOWN_BRANDS.filter((b) => {
        if (TRACKED_BRAND_NAMES.has(b.name)) return false;
        return b.aliases.some((a) => a.includes(ql) || ql.includes(a)) || b.name.toLowerCase().includes(ql);
      }).slice(0, 4);
      if (trackedHits.length === 0 && brandHits.length === 0) return "";
      const originLabel: Record<string, string> = {
        cuba: "Cuban", dominican: "Dominican", nicaragua: "Nicaraguan",
        honduras: "Honduran", spain: "Spanish", other: "International",
      };
      const parts: string[] = [];
      if (trackedHits.length > 0) {
        parts.push(`<div class="lcat-search__ac-section-label">In our catalogue</div>`);
        for (let i = 0; i < trackedHits.length; i++) {
          const { sku } = trackedHits[i];
          parts.push(
            `<a class="lcat-search__ac-item" role="option" href="/finder/sku/${sku.slug}/" data-ac-index="${i}">
               <span class="lcat-search__ac-item-label">
                 <span class="lcat-search__ac-item-title">${highlight(`${sku.brand} ${sku.vitola}`, q)}</span>
                 <span class="lcat-search__ac-item-meta">${escapeHtmlAc(sku.shape)} · box ${sku.boxSize}</span>
               </span>
               <span class="lcat-search__ac-item-tag lcat-search__ac-item-tag--tracked">Tracked</span>
             </a>`
          );
        }
      }
      if (brandHits.length > 0) {
        parts.push(`<div class="lcat-search__ac-section-label">Other premium brands</div>`);
        const baseIdx = trackedHits.length;
        for (let i = 0; i < brandHits.length; i++) {
          const b = brandHits[i];
          parts.push(
            `<button type="button" class="lcat-search__ac-item" role="option" data-ac-brand="${escapeHtmlAc(b.name)}" data-ac-index="${baseIdx + i}">
               <span class="lcat-search__ac-item-label">
                 <span class="lcat-search__ac-item-title">${highlight(b.name, q)}</span>
                 <span class="lcat-search__ac-item-meta">${originLabel[b.origin] || "Premium"} · not yet in catalogue</span>
               </span>
               <span class="lcat-search__ac-item-tag lcat-search__ac-item-tag--untracked">Request</span>
             </button>`
          );
        }
      }
      return parts.join("");
    }

    function updateAc() {
      if (!ac) return;
      const html = buildSuggestions(input.value);
      if (!html) { ac.hidden = true; ac.innerHTML = ""; acItems = []; acActive = -1; return; }
      ac.innerHTML = html;
      ac.hidden = false;
      acItems = Array.from(ac.querySelectorAll<HTMLElement>("[data-ac-index]"));
      acActive = -1;
      acItems.forEach((item) => {
        const brandName = item.getAttribute("data-ac-brand");
        if (brandName) {
          item.addEventListener("click", () => {
            input.value = brandName;
            ac.hidden = true;
            apply();
            input.focus();
          });
        }
      });
    }
    function moveAc(delta: number) {
      if (acItems.length === 0) return;
      acActive = (acActive + delta + acItems.length) % acItems.length;
      acItems.forEach((it, i) => it.classList.toggle("is-active", i === acActive));
      acItems[acActive]?.scrollIntoView({ block: "nearest" });
    }
    input.addEventListener("input", updateAc);
    input.addEventListener("focus", updateAc);
    input.addEventListener("keydown", (e) => {
      if (!ac || ac.hidden) return;
      if (e.key === "ArrowDown") { e.preventDefault(); moveAc(1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); moveAc(-1); }
      else if (e.key === "Enter" && acActive >= 0) { e.preventDefault(); acItems[acActive]?.click(); }
      else if (e.key === "Escape") { ac.hidden = true; }
    });
    document.addEventListener("click", (e) => {
      if (!ac) return;
      const wrapEl = input.closest(".lcat-search__input-wrap");
      if (wrapEl && !wrapEl.contains(e.target as Node)) ac.hidden = true;
    });
    clearBtn?.addEventListener("click", () => { if (ac) ac.hidden = true; });
    resetBtn?.addEventListener("click", () => { if (ac) ac.hidden = true; });
  })();
</script>

