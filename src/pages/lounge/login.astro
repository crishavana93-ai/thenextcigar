---
import PaperLayout from "../../layouts/PaperLayout.astro";
/** /lounge/login/ — sign in with a password, or by emailed link / 6-digit code. */
---
<PaperLayout title="Sign in · The Lounge · The Next Cigar" description="Sign in to the Lounge." section="lounge" compact={true} noIndex>
  <div class="dateline"><h1>Sign in <em>— the Lounge.</em></h1><p class="st">Members</p></div>
  <div class="auth">
    <div class="auth-card">
      <span class="kick">With a password</span>
      <form id="login-pw-form" class="rw" style="margin-top:10px">
        <label>Email<input type="email" name="email" required autocomplete="email" placeholder="you@example.com" /></label>
        <label>Password<input type="password" name="password" required autocomplete="current-password" minlength="8" /></label>
        <button type="submit" class="cta">Sign in →</button>
        <button type="button" id="login-forgot" class="ghost">Forgot / no password? Email me a reset link</button>
      </form>
      <div class="rulehead" style="margin-top:26px"><h2>Or by email</h2></div>
      <form id="login-magic-form" class="rw">
        <label>Email<input type="email" name="email" required autocomplete="email" placeholder="you@example.com" /></label>
        <button type="submit" class="cta">Email me a sign-in link</button>
      </form>
      <form id="login-code-form" class="rw" hidden style="margin-top:10px">
        <label>The 6-digit code from that email<input type="text" name="token" inputmode="numeric" pattern="\d{6}" maxlength="6" autocomplete="one-time-code" placeholder="123456" /></label>
        <button type="submit" class="cta">Use the code →</button>
        <button type="button" id="login-resend" class="ghost">Resend the code</button>
      </form>
      <p id="login-status" class="note auth-status" hidden aria-live="polite"></p>
      <p class="note" style="margin-top:16px">Not a member? <a href="/lounge/signup/">Join free</a>.</p>
    </div>
    <aside class="auth-side">
      <div class="rulehead"><h2>Trouble?</h2></div>
      <p class="t">Links expire after an hour and work once. If yours has, ask for a new one above. Still stuck: <a href="mailto:contact@thenextcigar.com?subject=Lounge%20sign-in">write to the desk</a>.</p>
    </aside>
  </div>
</PaperLayout>
<script>
  import { getSupabase, getCurrentUser } from "../../lib/supabase";

  const LAST_EMAIL_KEY = "lounge_last_email";

  // The message lands directly under the form that produced it (not at the
  // bottom of the card, where a phone keyboard hides it) and scrolls into view.
  function showStatus(msg: string, isError = false, near?: HTMLElement | null) {
    const status = document.getElementById("login-status") as HTMLParagraphElement | null;
    if (!status) return;
    if (near) near.insertAdjacentElement("afterend", status);
    status.hidden = false;
    status.classList.toggle("is-error", isError);
    status.innerHTML = msg;
    status.scrollIntoView({ block: "center", behavior: "smooth" });
  }

  async function setup() {
    // If already signed in, skip the form
    const user = await getCurrentUser();
    if (user) {
      window.location.href = "/lounge/app/";
      return;
    }

    // Pre-fill saved email on both forms
    let savedEmail: string | null = null;
    try { savedEmail = localStorage.getItem(LAST_EMAIL_KEY); } catch {}
    if (savedEmail) {
      document.querySelectorAll<HTMLInputElement>('input[type=email]').forEach((el) => {
        if (!el.value) el.value = savedEmail!;
      });
    }

    // ── Primary: password sign-in ───────────────────────────────────────
    const pwForm = document.getElementById("login-pw-form") as HTMLFormElement | null;
    pwForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(pwForm);
      const email = String(fd.get("email") || "").trim();
      const password = String(fd.get("password") || "");
      if (!email || !password) return;

      const btn = pwForm.querySelector("button[type=submit]") as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = "Signing in…";
      try {
        const supabase = getSupabase();
        const { error } = await supabase.auth.signInWithPassword({ email, password });
        if (error) throw error;
        try { localStorage.setItem(LAST_EMAIL_KEY, email); } catch {}
        window.location.href = "/lounge/app/";
      } catch (err: any) {
        // Common case: existing user has no password set yet (signed up via
        // magic link before passwords were a thing). Steer them to the
        // forgot-password flow instead of just showing a confusing error.
        const msg = err?.message || "";
        const looksLikeNoPassword =
          /invalid login credentials/i.test(msg) || /invalid_grant/i.test(msg);
        if (looksLikeNoPassword) {
          showStatus(
            `<strong>Wrong password — or no password set for this email yet.</strong> Try again, or tap <strong>"Forgot / no password? Email me a reset link"</strong> and set one in 30 seconds.`,
            true, pwForm,
          );
        } else {
          showStatus(err?.message || "Sign-in failed. Try again.", true, pwForm);
        }
        btn.disabled = false;
        btn.textContent = "Sign in →";
      }
    });

    // ── "No password yet? Set one" — sends reset email ───────────────
    document.getElementById("login-forgot")?.addEventListener("click", async () => {
      const emailInput = pwForm?.querySelector('input[name=email]') as HTMLInputElement;
      const email = emailInput.value.trim();
      if (!email) {
        emailInput.focus();
        showStatus("Enter your email first, then tap this again.", true, pwForm);
        return;
      }
      const btn = document.getElementById("login-forgot") as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = "Sending email…";
      try {
        const supabase = getSupabase();
        const { error } = await supabase.auth.resetPasswordForEmail(email, {
          redirectTo: `${window.location.origin}/lounge/reset-password/`,
        });
        if (error) throw error;
        try { localStorage.setItem(LAST_EMAIL_KEY, email); } catch {}
        showStatus(
          `Email sent to <strong>${email}</strong>. Click the "Set password" link inside — works from any device, any browser. After you set the password, come back here and sign in.`,
          false, pwForm,
        );
      } catch (err: any) {
        showStatus(err?.message || "Couldn't send reset email. Try again.", true, pwForm);
      } finally {
        btn.disabled = false;
        btn.textContent = "Forgot / no password? Email me a reset link";
      }
    });

    // ── Fallback: magic-link / OTP code ─────────────────────────────────
    const magicForm = document.getElementById("login-magic-form") as HTMLFormElement | null;
    const codeForm = document.getElementById("login-code-form") as HTMLFormElement | null;
    let lastEmailSent = "";

    async function sendMagicLink(email: string) {
      const supabase = getSupabase();
      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: { emailRedirectTo: `${window.location.origin}/lounge/app/` },
      });
      if (error) throw error;
      lastEmailSent = email;
      try { localStorage.setItem(LAST_EMAIL_KEY, email); } catch {}
    }

    magicForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(magicForm);
      const email = String(fd.get("email") || "").trim();
      if (!email) return;
      const btn = magicForm.querySelector("button[type=submit]") as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = "Sending…";
      try {
        await sendMagicLink(email);
        showStatus(`Sent. Open the email from <strong>The Lounge</strong>. On a phone, the quickest way is the <strong>6-digit code</strong>: type it below and you stay in this app. The link works too, but opens in the browser.`, false, magicForm);
        if (codeForm) {
          codeForm.hidden = false;
          (codeForm.querySelector("input[name=token]") as HTMLInputElement).focus();
        }
      } catch (err: any) {
        showStatus(err?.message || "Couldn't send. Try again.", true, magicForm);
        btn.disabled = false;
        btn.textContent = "Email me a sign-in link";
      }
    });

    codeForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const token = (codeForm.querySelector("input[name=token]") as HTMLInputElement).value.trim();
      if (!/^\d{6}$/.test(token)) return;
      const btn = codeForm.querySelector("button[type=submit]") as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = "Signing in…";
      try {
        const supabase = getSupabase();
        const { error } = await supabase.auth.verifyOtp({
          email: lastEmailSent || localStorage.getItem(LAST_EMAIL_KEY) || "",
          token,
          type: "email",
        });
        if (error) throw error;
        window.location.href = "/lounge/app/";
      } catch (err: any) {
        showStatus(err?.message || "Invalid or expired code. Tap Resend below.", true, codeForm);
        btn.disabled = false;
        btn.textContent = "Sign in →";
      }
    });

    document.getElementById("login-resend")?.addEventListener("click", async () => {
      const email = lastEmailSent || localStorage.getItem(LAST_EMAIL_KEY) || "";
      if (!email) return;
      try {
        await sendMagicLink(email);
        showStatus(`Resent. Check your inbox.`, false, codeForm);
      } catch (err: any) {
        showStatus(err?.message || "Couldn't resend.", true);
      }
    });
  }

  document.addEventListener("astro:page-load", setup);
  setup();
</script>
