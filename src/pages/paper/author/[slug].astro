---
import { getCollection } from "astro:content";
import PaperLayout from "../../../layouts/PaperLayout.astro";
/** /paper/author/[slug]/ — PREVIEW ROUTE (noindex). Ships as /author/[slug]/. */
export async function getStaticPaths() {
  const authors = await getCollection("authors");
  const posts = (await getCollection("blog")).filter((p) => !(p.data as any).draft);
  return authors.map((a) => ({ params: { slug: (a.data as any).slug }, props: { author: a.data as any, posts: posts.filter((p) => p.data.author === (a.data as any).slug).sort((x, y) => Date.parse(y.data.publishedAt as any) - Date.parse(x.data.publishedAt as any)) } }));
}
const { author, posts } = Astro.props;
const fmt = (d: any) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const jsonLd = { "@context": "https://schema.org", "@type": "ProfilePage", mainEntity: { "@type": "Person", name: author.name, url: `https://thenextcigar.com/author/${author.slug}/` } };
---
<PaperLayout title={`${author.name} · The Next Cigar`} description={author.bio || `${posts.length} pieces by ${author.name} in The Next Cigar.`} section="magazine" compact={true} noIndex={true} jsonLd={jsonLd}>
  <p class="miga" style="padding-bottom:0;margin-bottom:-14px">Magazine · <a href="/paper/magazine/">all pieces</a> · byline</p>
  <div class="dateline"><h1>{author.name}{author.jobTitle && <em> — {author.jobTitle}</em>}</h1><p class="st">{posts.length} pieces</p></div>
  <div class="front">
    <section style="grid-column:1 / span 2;border-right:1px solid var(--rule);padding-left:0">
      {author.bio && <div class="prose" style="max-width:none"><p>{author.bio}</p></div>}
      <ul class="list">{posts.map((p) => (<li style="grid-template-columns:1fr auto;gap:18px;align-items:baseline"><div><a class="head" style="font-size:20px" href={`/paper/read/${p.data.slug}/`}>{p.data.title}</a>{p.data.excerpt && <p class="by" style="margin-top:4px">{p.data.excerpt.slice(0, 130)}…</p>}</div><span class="by" style="white-space:nowrap">{fmt(p.data.publishedAt)}</span></li>))}</ul>
    </section>
    <aside class="rail"><div class="box"><span class="kick">About the paper</span><h3 class="head">Independent, reader-supported.</h3><p>How it is paid for and what it will not do: <a href="/paper/about/">about the paper</a>.</p></div></aside>
  </div>
</PaperLayout>
