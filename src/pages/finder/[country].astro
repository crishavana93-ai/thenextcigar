---
import PaperLayout from "../../layouts/PaperLayout.astro";
import {
  COUNTRIES, COUNTRY_BY_CODE, RETAILERS, SKUS, RETAILER_BY_ID, snapshotsForCountry, retailersForCountry,
  bestPriceInCountry, formatPrice, toEUR, checkedLabel, effectiveShopUrl, type CountryCode,
} from "../../data/finder-live";
import { policyFor } from "../../data/country-config.ts";
import { places as cigarPlaces } from "../../data/cigar-places.ts";

/**
 * /finder/[country]/
 *
 * A country edition: what the law allows, who sells, what the board looks like
 * from inside that market, and the rooms worth knowing. Restricted markets get
 * a directory instead of a shop button — the legal posture comes from
 * country-config.ts, never from this page.
 */

export async function getStaticPaths() {
  return COUNTRIES.map((c) => ({ params: { country: c.code } }));
}
const { country: code } = Astro.params as { country: CountryCode };
const country = COUNTRY_BY_CODE[code];
if (!country) return Astro.redirect("/finder/");
const policy = policyFor(code);
const retailers = retailersForCountry(code);
const snapshots = snapshotsForCountry(code);

const rows = SKUS
  .map((sku) => ({ sku, snap: bestPriceInCountry(sku.id, code) }))
  .filter((r): r is { sku: (typeof SKUS)[number]; snap: NonNullable<ReturnType<typeof bestPriceInCountry>> } => !!r.snap)
  .map((r) => ({ ...r, retailer: RETAILER_BY_ID[r.snap.retailerId], eur: toEUR(r.snap.price, r.snap.currency) }))
  .sort((a, b) => a.eur / a.sku.boxSize - b.eur / b.sku.boxSize);
const liveCount = rows.filter((r) => (r.snap as any).live).length;

// Where this market is beaten: for each vitola priced here, the cheapest elsewhere.
const beaten = rows
  .map((r) => {
    const elsewhere = COUNTRIES.filter((c) => c.code !== code && c.status === "open")
      .map((c) => ({ c, s: bestPriceInCountry(r.sku.id, c.code) }))
      .filter((x) => x.s)
      .map((x) => ({ c: x.c, eur: toEUR(x.s!.price, x.s!.currency) }))
      .sort((a, b) => a.eur - b.eur)[0];
    if (!elsewhere || elsewhere.eur >= r.eur) return null;
    return { sku: r.sku, here: r.eur, there: elsewhere.eur, where: elsewhere.c, pct: Math.round(((r.eur - elsewhere.eur) / r.eur) * 100) };
  })
  .filter((x): x is NonNullable<typeof x> => !!x)
  .sort((a, b) => b.pct - a.pct)
  .slice(0, 5);

const statusLabel = { open: "Online sale legal", restricted: "Online sale restricted", closed: "No online sale" }[country.status];
const typeLabel: Record<string, string> = { casadelhabano: "Casa del Habano", house: "Brand flagship", lounge: "Lounge", retailer: "Retailer", club: "Private club", pub: "Cigar-friendly bar" };
const places = cigarPlaces.filter((p) => p.country.toLowerCase() === country.name.toLowerCase()).slice(0, 8);
const tier = (s: string) => (s === "lcdh" ? "La Casa del Habano" : s === "habanos-specialist" ? "Habanos Specialist" : s === "reservation" ? "Reservation only" : "Tobacconist");
const otherEditions = COUNTRIES.filter((c) => c.code !== code && retailersForCountry(c.code).length > 0);

const faq = [
  { q: `Can I buy Cuban cigars online in ${country.name}?`,
    a: country.status === "open" ? `Yes. Licensed retailers in ${country.name} sell Habanos online with public prices and ship domestically.${policy.crossBorderImportAllowed ? " Buying from another EU country is legal too, but the box picks up destination duty and VAT." : ""}`
     : country.status === "restricted" ? `Only in part. ${country.name} limits online tobacco sale — typically to domestic delivery, identity checks or no public price display. ${policy.regulatoryWarning ?? ""}`
     : `No. ${country.name} does not permit online sale of tobacco. The shops below are walk-in only.` },
  { q: `Where is the cheapest place to buy Cuban cigars in ${country.name} right now?`,
    a: rows[0] ? `On our board the cheapest box per cigar in ${country.name} is the ${rows[0].sku.brand} ${rows[0].sku.vitola} at ${formatPrice(rows[0].snap.price, rows[0].snap.currency)} from ${rows[0].retailer.name} (${checkedLabel(rows[0].snap)}).` : `We list ${retailers.length} retailers in ${country.name} but none publishes prices online.` },
  { q: `Will I pay duty and VAT on top of the listed price?`,
    a: `Not when you buy from a retailer in ${country.name} and ship within ${country.name} — duty and VAT are already in the price. Buying from abroad, ${country.name} charges its own tobacco excise and VAT at the border.` },
];

const url = `https://thenextcigar.com/finder/${code}/`;
const jsonLd = { "@context": "https://schema.org", "@graph": [
  { "@type": "ItemList", name: `Cuban cigar prices in ${country.name}`, numberOfItems: rows.length,
    // See the note in finder/index.astro — names and links only, no Product.
    itemListElement: rows.slice(0, 25).map((r, i) => ({
      "@type": "ListItem", position: i + 1,
      name: `${r.sku.brand} ${r.sku.vitola}`,
      url: `https://thenextcigar.com/finder/sku/${r.sku.slug}/`,
    })) },
  { "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Markets", item: "https://thenextcigar.com/finder/" }, { "@type": "ListItem", position: 2, name: country.name, item: url } ] },
  { "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
] };
---

<PaperLayout
  title={`Cuban cigar prices in ${country.name} — retailers, law and the board · The Next Cigar`}
  description={`${retailers.length} licensed Habanos retailers in ${country.name}, ${rows.length} vitolas priced, and what the law lets you order. ${statusLabel}.`}
  section="markets" compact={true} jsonLd={jsonLd}
>
  <p class="miga" style="padding-bottom:0;margin-bottom:-14px">Markets · <a href="/finder/">the board</a> · editions</p>
  <div class="dateline">
    <h1>{country.name} <em>— prices, shops and the law.</em></h1>
    <p class="st">{retailers.length} retailers · {rows.length} vitolas priced{liveCount > 0 && <> · <b style="color:var(--live)">{liveCount} live</b></>} · <span class:list={{ tag: true, ok: country.status === "open", warn: country.status !== "open" }} style="letter-spacing:.12em">{statusLabel}</span></p>
  </div>

  <div class="front">
    <aside>
      <div class="rulehead"><h2>The law</h2></div>
      <div class="prose" style="font-size:15px;max-width:none">
        <p>{country.note}</p>
        {policy.regulatoryWarning && <p><b>{policy.regulatoryWarning}</b></p>}
      </div>
      <dl class="file">
        <dt>Importer of record</dt><dd style="font-size:14px">{policy.importerOfRecord}</dd>
        <dt>Framework</dt><dd style="font-size:14px">{policy.regulationCite}</dd>
        <dt>Cross-border import</dt><dd style="font-size:14px">{policy.crossBorderImportAllowed ? "Permitted, duty and VAT due on arrival" : "Not permitted"}</dd>
        {policy.bestForCrossBorder && policy.bestForCrossBorder.length > 0 && <><dt>Legal routes in</dt><dd style="font-size:14px">{policy.bestForCrossBorder.map((c) => COUNTRY_BY_CODE[c]?.name).filter(Boolean).join(", ")}</dd></>}
      </dl>

      {beaten.length > 0 && (
        <>
          <div class="rulehead"><h2>Where {country.name} is beaten</h2></div>
          <table class="mk">
            <tbody>
              {beaten.map((b) => (
                <tr><td class="v"><a href={`/finder/sku/${b.sku.slug}/`}>{b.sku.brand} {b.sku.vitola}</a><small>{b.where.name} · €{Math.round(b.there)} vs €{Math.round(b.here)}</small></td><td class="p" style="color:var(--ox)">−{b.pct}%</td></tr>
              ))}
            </tbody>
          </table>
          <p class="note">Before duty. A cheaper box abroad is only cheaper if it stays cheaper after {country.name}'s excise and VAT.</p>
        </>
      )}
    </aside>

    <section>
      {rows.length > 0 ? (
        <>
          <div class="rulehead"><h2>The board <em>· cheapest per cigar, {country.name} retailers only</em></h2><span class="more">{rows.length} vitolas</span></div>
          <table class="mk wide">
            <thead><tr><th>Vitola</th><th>Retailer</th><th class="num">Box</th><th class="num">Per cigar</th></tr></thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <td class="v"><a href={`/finder/sku/${r.sku.slug}/`}>{r.sku.brand} {r.sku.vitola}</a><small>box of {r.sku.boxSize}</small></td>
                  <td class="v" style="font-size:14px">
                    {policy.onlineSaleAllowed ? <a href={effectiveShopUrl(r.snap.sourceUrl, r.sku, r.retailer).url} target="_blank" rel="noopener nofollow">{r.retailer.name}</a> : r.retailer.name}
                    <small>{checkedLabel(r.snap)}</small>
                  </td>
                  <td class="num p">{formatPrice(r.snap.price, r.snap.currency)}</td>
                  <td class="num p">€{(r.eur / r.sku.boxSize).toFixed(0)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          {!policy.onlineSaleAllowed && <p class="note">Prices are for reference — online sale to consumers is not permitted in {country.name}, so retailer names are not linked to shops.</p>}
        </>
      ) : (
        <div class="box" style="margin-top:0"><span class="kick">No public prices</span><h3 class="head">Nobody in {country.name} publishes a price online.</h3><p>The retailers below are the licensed rooms to visit. For a price comparison, see the <a href="/finder/">European board</a>.</p></div>
      )}

      <div class="rulehead" style="margin-top:26px"><h2>Licensed retailers <em>· {retailers.length} in {country.name}</em></h2></div>
      <div class="three" style="grid-template-columns:repeat(auto-fill,minmax(200px,1fr));row-gap:22px">
        {retailers.map((r) => (
          <article>
            <span class="kick mute">{tier(r.status)}</span>
            <a class="head" style="font-size:20px;display:block;margin:6px 0 2px" href={r.url} target="_blank" rel="noopener">{r.name}</a>
            <p class="by">{r.city ?? country.name} · {r.shipsTo === "worldwide" ? "ships worldwide" : r.shipsTo === "eu" ? "ships within the EU" : "domestic delivery"}{r.hasPublicPricing ? "" : " · no online prices"}</p>
          </article>
        ))}
      </div>

      {places.length > 0 && (
        <>
          <div class="rulehead" style="margin-top:26px"><h2>The rooms <em>· lounges, houses and bars</em></h2></div>
          <ul class="list">
            {places.map((p) => (
              <li><div><a class="head" href={p.website || `https://www.google.com/maps/search/?api=1&query=${p.lat},${p.lng}`} target="_blank" rel="noopener">{p.name}</a><p class="by">{typeLabel[p.type] ?? p.type} · {p.city}{p.address ? ` · ${p.address}` : ""}</p></div></li>
            ))}
          </ul>
        </>
      )}

      <div class="rulehead" style="margin-top:26px"><h2>Questions</h2></div>
      <ul class="faq">{faq.map((f) => (<li><h3>{f.q}</h3><div><p>{f.a}</p></div></li>))}</ul>
    </section>

    <aside class="rail">
      <div class="rulehead"><h2>Other editions</h2></div>
      <ul class="eds">
        {otherEditions.map((c) => (<li><a href={`/finder/${c.code}/`}>{c.name}</a><span>{retailersForCountry(c.code).length} shops</span></li>))}
      </ul>
      <div class="box">
        <span class="kick">Watchlist · free</span>
        <h3 class="head">Price drops in {country.name}.</h3>
        <p>Members can scope alerts to a country, so you only hear about boxes you can legally have delivered.</p>
        <a class="cta" href="/lounge/signup/">Join the Lounge</a>
      </div>
    </aside>
  </div>
</PaperLayout>
