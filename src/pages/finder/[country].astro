---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Newsletter from "../../components/Newsletter.astro";
import FaqSchema from "../../components/finder/FaqSchema.astro";
import {
  COUNTRIES,
  RETAILERS,
  SKUS,
  PRICE_SNAPSHOTS,
  snapshotsForCountry,
  retailersForCountry,
  bestPriceInCountry,
  formatPrice,
  toEUR,
  dutyPaidCountries,
  isPriceAllInFor,
  type CountryCode,
} from "../../data/finder-data.ts";
import { policyFor } from "../../data/country-config.ts";
import { places as cigarPlaces } from "../../data/cigar-places.ts";

export async function getStaticPaths() {
  return COUNTRIES.map((c) => ({ params: { country: c.code } }));
}

const { country: countryCode } = Astro.params as { country: CountryCode };
const country = COUNTRIES.find((c) => c.code === countryCode);
if (!country) return Astro.redirect("/finder/");

const policy = policyFor(country.code);
const retailers = retailersForCountry(country.code);
const snapshots = snapshotsForCountry(country.code);

// SKUs covered in this country, with their cheapest local snapshot
const skuRows = SKUS
  .map((sku) => ({ sku, snap: bestPriceInCountry(sku.id, country.code) }))
  .filter((r): r is { sku: typeof SKUS[number]; snap: NonNullable<ReturnType<typeof bestPriceInCountry>> } => !!r.snap)
  .sort((a, b) => a.snap.price - b.snap.price);

const skusWithoutLocal = SKUS.filter(
  (sku) => !skuRows.find((r) => r.sku.id === sku.id),
);

// Status-aware copy
const statusLabel: Record<typeof country.status, string> = {
  open: "Online sale legal",
  restricted: "Restricted online sale",
  closed: "No online sale",
};

// ─── Country FAQ ──────────────────────────────────────────────────────────
// 4 PAA-shaped questions specific to this market. The copy branches on
// country.status because Sweden / France / UK each face different
// regulatory truth. Renders as FAQPage JSON-LD + visible accordion.
const cheapestRow = skuRows[0];
const retailerCount = retailers.length;
const cheapestLine = cheapestRow
  ? `The cheapest in-stock box on our ${country.name} tracker right now is <strong><a href="/finder/sku/${cheapestRow.sku.slug}/">${cheapestRow.sku.brand} ${cheapestRow.sku.vitola}</a></strong> at approximately <strong>${cheapestRow.snap.currency} ${Math.round(cheapestRow.snap.price).toLocaleString("en-US")}</strong>.`
  : `We're tracking ${SKUS.length} Cuban SKUs across this market — refresh weekly for live availability.`;

const statusAnswers: Record<typeof country.status, string> = {
  open: `<p>Yes. Licensed retailers based in ${country.name} sell Cuban (Habanos) cigars online with public pricing and ship domestically. Cross-border EU shipments are accepted by many of them but face destination-country tobacco duty + VAT — see each retailer card's "Duty / Ships" line for specifics.</p>`,
  restricted: `<p>Restricted. ${country.name} permits online tobacco sale only under specific conditions (often: identity verification, no public price display, or shipping limited to certain regions). The retailers listed above operate inside those rules; prices may be brochure-only or require an account to view.</p>`,
  closed: `<p>No. ${country.name} does not permit online Cuban-cigar sale. The retailers listed are in-store walk-in only. To buy online and ship into ${country.name}, you'd need to import from another EU country — which makes the listed price subject to ${country.name} tobacco excise + VAT at customs.</p>`,
};

const countryFaq = [
  {
    q: `Can I legally buy Cuban cigars online in ${country.name}?`,
    a: statusAnswers[country.status],
  },
  {
    q: `Where is the cheapest place to buy Cuban cigars in ${country.name} right now?`,
    a: `<p>${cheapestLine} The full ranking is in the catalogue above, sorted by current price ascending across the ${retailerCount} licensed retailers we track in ${country.name}.</p><p>Prices and stock shift weekly — set a price alert on any individual SKU page to get an email the moment a retailer in ${country.name} drops below your target.</p>`,
  },
  {
    q: `Will I pay tobacco duty + VAT on top of the listed price?`,
    a: `<p>If you buy from a retailer based in ${country.name} and ship to a ${country.name} address: <strong>no</strong> — duty + VAT are already included in the listed price.</p><p>If you buy from a retailer in another country and ship to ${country.name}: <strong>yes</strong> — ${country.name} will charge its own tobacco excise + VAT at customs, regardless of whether the retailer is inside the EU. Sweden, Denmark, Finland, Ireland, the UK, and Switzerland all enforce this aggressively on inbound tobacco mail order. Stick with the duty-paid retailers above unless you're buying from a country with a lower net rate and you've done the math.</p>`,
  },
  {
    q: `What's the difference between an LCDH, a Habanos Specialist, and a generic tobacconist?`,
    a: `<p><strong>LCDH (La Casa del Habano)</strong> is the official franchise network of Habanos S.A. — the Cuban state tobacco company. LCDH stores get first allocation on Edición Limitada releases, sell exclusive house-line cigars, and are the highest-prestige tier. Look for the gold LCDH badge in the listings above.</p><p><strong>Habanos Specialist</strong> is a quality tier below LCDH — licensed by Habanos S.A., trained staff, guaranteed authenticity. Most premium Cuban-only shops fall here.</p><p><strong>Generic tobacconist</strong> sells Cuban alongside Dominican, Nicaraguan and supermarket-grade cigars. Authenticity is usually fine but allocation on rare SKUs is limited.</p>`,
  },
];

// Curated cigar places (lounges + LCDH + retailers) in this country — shows
// up under "Visit in person" so Finder users see the bricks-and-mortar map
// not just the price comparison.
const placeTypeLabels: Record<string, string> = {
  casadelhabano: "Casa del Habano",
  house: "Brand flagship",
  lounge: "Lounge",
  retailer: "Retailer",
  club: "Private club",
  pub: "Cigar-friendly bar",
};
const localPlaces = cigarPlaces
  .filter((p) => p.country.toLowerCase() === country.name.toLowerCase())
  .slice(0, 8)
  .map((p) => ({
    ...p,
    typeLabel: placeTypeLabels[p.type] || p.type,
    mapHref: p.website || `https://www.google.com/maps/search/?api=1&query=${p.lat},${p.lng}`,
  }));

// ----------------------------------------------------------------------------
// Structured data — ItemList of SKUs with prices in this country
// Gives Google a structured catalogue view, eligible for ItemList rich result.
// ----------------------------------------------------------------------------
const itemListJsonLd = {
  "@context": "https://schema.org/",
  "@type": "ItemList",
  name: `Cuban cigar prices in ${country.name}`,
  numberOfItems: skuRows.length,
  itemListElement: skuRows.map(({ sku, snap }, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Product",
      name: `${sku.brand} ${sku.vitola}`,
      brand: { "@type": "Brand", name: sku.brand },
      url: `https://thenextcigar.com/finder/sku/${sku.slug}/`,
      offers: {
        "@type": "Offer",
        priceCurrency: snap.currency,
        price: snap.price.toFixed(2),
        availability: "https://schema.org/InStock",
        seller: { "@type": "Organization", name: RETAILERS.find((r) => r.id === snap.retailerId)!.name },
      },
    },
  })),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org/",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "The Finder", item: "https://thenextcigar.com/finder/" },
    { "@type": "ListItem", position: 2, name: country.name, item: `https://thenextcigar.com/finder/${country.code}/` },
  ],
};

// OG / social
const ogTitle = `Cuban cigar prices in ${country.name} — ${retailers.length} retailers compared | The Finder`;
const ogDescription = country.note
  ? `${retailers.length} ${country.name} retailers, ${skuRows.length} live SKU prices. ${country.note}`
  : `Compare prices on ${skuRows.length} Cuban cigars across ${retailers.length} ${country.name} retailers.`;
---

<BaseLayout
  title={ogTitle}
  description={ogDescription}
  image="/og-finder.svg"
>
  {/* Structured data — ItemList + Breadcrumb */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListJsonLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)}></script>
  {/* ─── COUNTRY HEADER ─────────────────────────────────────────────────── */}
  <section class="finder-country-hero">
    <div class="container-wide pt-12 md:pt-16 pb-10 md:pb-14 reveal">
      <a href="/finder/" class="finder-country-hero__back">← All countries</a>

      <div class="finder-country-hero__head">
        <span class="finder-country-hero__flag">{country.flag}</span>
        <div>
          <p class="lounge-label" style={`color: ${country.status === 'open' ? 'var(--color-gold)' : country.status === 'restricted' ? 'var(--color-burgundy)' : 'var(--color-text-muted)'};`}>
            The Finder · {country.name}
          </p>
          <h1 class="finder-country-hero__title">{country.name}</h1>
        </div>
      </div>

      <div class="finder-country-hero__meta">
        <div class="finder-country-hero__metric">
          <span class="finder-country-hero__n">{retailers.length}</span>
          <span class="finder-country-hero__l">Retailers</span>
        </div>
        <div class="finder-country-hero__metric">
          <span class="finder-country-hero__n">{skuRows.length}</span>
          <span class="finder-country-hero__l">SKUs priced</span>
        </div>
        <div class="finder-country-hero__metric">
          <span class="finder-country-hero__n">{country.currency}</span>
          <span class="finder-country-hero__l">Local currency</span>
        </div>
        <div class="finder-country-hero__metric">
          <span class="finder-country-hero__status" data-status={country.status}>{statusLabel[country.status]}</span>
        </div>
      </div>

      {country.note && (
        <p class="finder-country-hero__note">{country.note}</p>
      )}
    </div>
  </section>

  {/* ─── REGULATORY DISCLOSURE BANNER ─────────────────────────────────────
       Shown when the country-config encodes a legal constraint that affects
       what users can do. Source of truth: src/data/country-config.ts.
       Six archetypes encoded — see docs/retailer-research/eu-deep-map-summary.md
       for the full legal mapping. */}
  {policy.regulatoryWarning && (
    <section class="container-wide pt-6 reveal">
      <div class={`finder-legal-banner finder-legal-banner--${policy.archetype}`} role="note">
        <div class="finder-legal-banner__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
        </div>
        <div class="finder-legal-banner__body">
          <p class="finder-legal-banner__title">
            {policy.archetype === "online_sale_banned" && "Online tobacco sale is prohibited in this country"}
            {policy.archetype === "cross_border_ban" && "Cross-border tobacco import is prohibited for residents"}
            {policy.archetype === "domestic_grey_zone" && "Domestic online sale operates in a legal grey zone"}
            {policy.archetype === "display_image_banned" && "Product imagery is restricted by national display law"}
            {policy.archetype === "state_price_uniform" && "Prices are state-fixed across all licensed retailers"}
            {policy.archetype === "open" && "Online tobacco sale is legal — note the import disclaimer"}
          </p>
          <p class="finder-legal-banner__text">{policy.regulatoryWarning}</p>
          <p class="finder-legal-banner__cite">
            Legal basis: <em>{policy.regulationCite}</em> · Habanos importer: {policy.importerOfRecord}
          </p>
          {policy.bestForCrossBorder && policy.bestForCrossBorder.length > 0 && (
            <p class="finder-legal-banner__alt">
              Legal cross-border channels for {country.name} residents:
              {policy.bestForCrossBorder.map((cc, i) => {
                const target = COUNTRIES.find((c) => c.code === cc);
                if (!target) return null;
                return (
                  <Fragment>
                    {i > 0 && ", "}
                    <a href={`/finder/${cc}/`}>{target.flag} {target.name}</a>
                  </Fragment>
                );
              })}
            </p>
          )}
        </div>
      </div>
    </section>
  )}

  {/* ─── CHEAPEST IN THIS COUNTRY ───────────────────────────────────────── */}
  {skuRows.length > 0 && (
    <section class="container-wide pt-10 pb-16 reveal">
      <div class="flex items-end justify-between mb-6 flex-wrap gap-4">
        <div>
          <h2 class="finder-h2">Cheapest in {country.name}</h2>
          <p class="mt-2 text-[color:var(--color-text-soft)]">
            Best verified price per SKU at retailers that ship inside {country.name}. Sorted by box price ascending.
          </p>
        </div>
      </div>

      <div class="finder-table-wrap">
        <table class="finder-table">
          <thead>
            <tr>
              <th class="finder-table__brand">Cigar</th>
              <th>Vitola</th>
              <th class="finder-table__num">Box size</th>
              <th class="finder-table__num">Box price</th>
              <th class="finder-table__num">Per cigar</th>
              <th>Retailer</th>
              <th class="finder-table__cta"></th>
            </tr>
          </thead>
          <tbody>
            {skuRows.map(({ sku, snap }) => {
              const retailer = RETAILERS.find((r) => r.id === snap.retailerId)!;
              const perCigar = snap.price / sku.boxSize;
              return (
                <tr>
                  <td class="finder-table__brand">
                    <span class="finder-table__brand-name">{sku.brand}</span>
                    <span class="finder-table__offers">{sku.line}</span>
                  </td>
                  <td>{sku.vitola}</td>
                  <td class="finder-table__num">{sku.boxSize}</td>
                  <td class="finder-table__num finder-table__price">
                    {formatPrice(snap.price, snap.currency)}
                    {snap.originalPrice && (
                      <span class="finder-table__was">was {formatPrice(snap.originalPrice, snap.currency)}</span>
                    )}
                  </td>
                  <td class="finder-table__num">{formatPrice(perCigar, snap.currency)}</td>
                  <td>
                    <span class="finder-table__retailer">{retailer.name}</span>
                    {retailer.status === "lcdh" && <span class="finder-badge finder-badge--gold">LCDH</span>}
                  </td>
                  <td class="finder-table__cta">
                    <a href={`/finder/sku/${sku.slug}/`} class="finder-table__compare">Compare →</a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      {skusWithoutLocal.length > 0 && (
        <p class="mt-5 text-sm text-[color:var(--color-text-muted)]">
          {skusWithoutLocal.length} more SKU{skusWithoutLocal.length === 1 ? "" : "s"} in the catalogue
          don't yet have a verified {country.name} price.
          <a href="/finder/" style="text-decoration:underline;color:var(--color-burgundy);"> See the European catalogue →</a>
        </p>
      )}
    </section>
  )}

  {skuRows.length === 0 && (
    <section class="container-wide py-16 reveal">
      <div class="lounge-empty">
        <p class="lounge-empty__kicker">No verified prices yet</p>
        <p class="lounge-empty__title">We don't have public prices for {country.name} retailers yet</p>
        <p class="lounge-empty__body">
          {country.name} retailers in our directory don't expose public per-SKU pricing to anonymous browsers —
          most use catalogue-only sites or login-walled carts. We list the retailers below; for live prices, browse a neighbouring market.
        </p>
        <a href="/finder/" class="btn btn-accent lounge-empty__cta">Back to country picker</a>
      </div>
    </section>
  )}

  {/* ─── RETAILERS IN THIS COUNTRY ─────────────────────────────────────── */}
  <section class="section-cream">
    <div class="container-wide py-16 reveal">
      <h2 class="finder-h2 mb-2">Where to buy in {country.name}</h2>
      <p class="text-[color:var(--color-text-soft)] mb-8 max-w-2xl">
        Every retailer we've mapped in {country.name}. LCDH = official La Casa del Habano franchise.
      </p>

      <div class="finder-retailer-grid">
        {retailers.map((r) => {
          // Every retailer on a country dashboard is in *that* country, so by
          // construction the listed price IS all-in for visitors of this page.
          // Still surface it explicitly — buyers absorb a green check faster
          // than they parse "Ships within EU."
          const allIn = isPriceAllInFor(r, country.code);
          return (
            <a href={r.url} class="finder-retailer" target="_blank" rel="noopener noreferrer sponsored">
              <div class="finder-retailer__head">
                <h3 class="finder-retailer__name">{r.name}</h3>
                {r.status === "lcdh" && <span class="finder-badge finder-badge--gold">LCDH</span>}
                {r.status === "habanos-specialist" && <span class="finder-badge">Habanos Specialist</span>}
                {r.status === "reservation" && <span class="finder-badge finder-badge--burgundy">Reservation</span>}
                {r.status === "mixed" && <span class="finder-badge finder-badge--muted">Mixed catalogue</span>}
              </div>
              {r.city && <p class="finder-retailer__city">{r.city}</p>}
              <p class="finder-retailer__meta">
                {allIn && (
                  <span class="finder-retailer__duty" title={`Listed price includes excise duty + VAT in ${country.name}.`}>
                    ✓ Duty-paid in {country.flag} {country.name}
                  </span>
                )}
                <span class="finder-retailer__ships">
                  Ships {r.shipsTo === "domestic" ? "domestic only" : r.shipsTo === "eu" ? "within EU · duty extra cross-border" : "worldwide · duty extra cross-border"}
                </span>
                {!r.hasPublicPricing && <span class="finder-retailer__catalog"> · catalogue only</span>}
              </p>
              <p class="finder-retailer__url">{new URL(r.url).hostname.replace("www.", "")} →</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* ─── VISIT IN PERSON — curated cigar lounges / LCDH / retailers in this country ─── */}
  {localPlaces.length > 0 && (
    <section class="container-wide py-12 md:py-16 reveal" id="finder-country-places">
      <div class="mb-8">
        <p class="lounge-label">Visit in person</p>
        <h2 class="finder-h2 mt-2">Cigar lounges &amp; LCDH in {country.name}</h2>
        <p class="mt-3 text-[color:var(--color-text-soft)] max-w-2xl">
          The Finder tracks online retailers. For walk-in humidors, Casa del Habano franchises,
          and cigar-friendly bars across {country.name}, the TNC map below is the curated list.
        </p>
      </div>

      <div class="finder-places-grid">
        {localPlaces.map((p) => (
          <a
            class="finder-place"
            href={p.mapHref}
            target={p.website ? "_blank" : "_self"}
            rel={p.website ? "noopener" : undefined}
          >
            <p class="finder-place__type">{p.typeLabel}</p>
            <p class="finder-place__name">{p.name}</p>
            <p class="finder-place__city">{p.city}</p>
            {p.address && <p class="finder-place__address">{p.address}</p>}
            {p.note && <p class="finder-place__note">{p.note}</p>}
          </a>
        ))}
      </div>

      <p class="mt-6 text-sm text-[color:var(--color-text-soft)]">
        Looking for the full TNC cigar-places map across Europe?
        <a href="/lounge/" style="color:var(--color-gold-hover);text-decoration:underline;margin-left:0.4em;">
          Open The Lounge map →
        </a>
      </p>
    </section>
  )}

  {/* ─── FAQ ─── PAA box wins for "buy cuban cigars in {country}" queries. */}
  <FaqSchema
    items={countryFaq}
    heading={`Buying Cuban cigars in ${country.name} — frequently asked questions`}
    containerClass="container-narrow"
  />

  <Newsletter
    heading={`Be the first to know about ${country.name} price drops`}
    blurb="One email per week with the biggest cuts on Cuban cigars in your country. Free."
  />
</BaseLayout>

<style>
  .finder-country-hero {
    background:
      radial-gradient(circle at 15% 25%, rgba(201, 169, 97, 0.12), transparent 55%),
      linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-soft) 100%);
    border-bottom: 1px solid var(--color-border);
  }
  .finder-country-hero__back {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 2rem;
  }
  .finder-country-hero__back:hover { color: var(--color-accent); }

  .finder-country-hero__head {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-bottom: 2rem;
  }
  .finder-country-hero__flag { font-size: 4.5rem; line-height: 1; }
  .finder-country-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 0.98;
    color: var(--color-text);
    margin-top: 0.45rem;
  }

  .finder-country-hero__meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 640px) { .finder-country-hero__meta { grid-template-columns: repeat(4, 1fr); } }
  .finder-country-hero__metric { display: flex; flex-direction: column; gap: 0.25rem; }
  .finder-country-hero__n {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .finder-country-hero__l {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .finder-country-hero__status {
    display: inline-block;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .finder-country-hero__status[data-status="open"] { background: rgba(201, 169, 97, 0.18); color: var(--color-gold); }
  .finder-country-hero__status[data-status="restricted"] { background: rgba(110, 38, 32, 0.12); color: var(--color-burgundy); }
  .finder-country-hero__status[data-status="closed"] { background: var(--color-surface); color: var(--color-text-muted); }

  .finder-country-hero__note {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-soft);
    max-width: 64ch;
    padding: 1rem 1.2rem;
    background: var(--color-bg);
    border-left: 3px solid var(--color-gold);
    border-radius: 0 4px 4px 0;
  }

  .finder-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.022em;
    line-height: 1.05;
    color: var(--color-text);
  }

  /* Table (mirrors landing-page styles) */
  .finder-table-wrap { overflow-x: auto; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-bg); }
  .finder-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .finder-table th {
    text-align: left;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: 1rem 1.1rem;
    background: var(--color-bg-soft);
    border-bottom: 1px solid var(--color-border);
  }
  .finder-table td {
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--color-border-soft);
    vertical-align: middle;
  }
  .finder-table tr:last-child td { border-bottom: none; }
  .finder-table tr:hover td { background: var(--color-bg-soft); }
  .finder-table__num { text-align: right; font-variant-numeric: tabular-nums; }
  .finder-table__brand { min-width: 180px; }
