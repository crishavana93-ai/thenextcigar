---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/newspaper.css";
import CigarCursor from "../../components/newspaper/CigarCursor.astro";
import NewspaperMasthead from "../../components/newspaper/NewspaperMasthead.astro";
import SectionFlag from "../../components/newspaper/SectionFlag.astro";
import FaqSchema from "../../components/finder/FaqSchema.astro";
import { MASTHEAD as masthead } from "../../data/masthead";
import {
  COUNTRIES,
  RETAILERS,
  SKUS,
  PRICE_SNAPSHOTS,
  snapshotsForCountry,
  retailersForCountry,
  bestPriceInCountry,
  formatPrice,
  toEUR,
  type CountryCode,
} from "../../data/finder-data.ts";
import { policyFor } from "../../data/country-config.ts";
import { places as cigarPlaces } from "../../data/cigar-places.ts";

export async function getStaticPaths() {
  return COUNTRIES.map((c) => ({ params: { country: c.code } }));
}

const { country: countryCode } = Astro.params as { country: CountryCode };
const country = COUNTRIES.find((c) => c.code === countryCode);
if (!country) return Astro.redirect("/finder/");

const policy = policyFor(country.code);
const retailers = retailersForCountry(country.code);
const snapshots = snapshotsForCountry(country.code);

// SKUs available in this country, sorted cheapest first
const skuRows = SKUS
  .map((sku) => ({ sku, snap: bestPriceInCountry(sku.id, country.code) }))
  .filter((r): r is { sku: typeof SKUS[number]; snap: NonNullable<ReturnType<typeof bestPriceInCountry>> } => !!r.snap)
  .sort((a, b) => a.snap.price - b.snap.price);

const statusLabel: Record<typeof country.status, string> = {
  open: "Online sale legal",
  restricted: "Restricted online sale",
  closed: "No online sale",
};

// FAQ block (SEO-preserved)
const cheapestRow = skuRows[0];
const retailerCount = retailers.length;
const cheapestLine = cheapestRow
  ? `The cheapest in-stock box on our ${country.name} tracker right now is <strong><a href="/finder/sku/${cheapestRow.sku.slug}/">${cheapestRow.sku.brand} ${cheapestRow.sku.vitola}</a></strong> at approximately <strong>${cheapestRow.snap.currency} ${Math.round(cheapestRow.snap.price).toLocaleString("en-US")}</strong>.`
  : `We're tracking ${SKUS.length} Cuban SKUs across this market — refresh weekly for live availability.`;

const statusAnswers: Record<typeof country.status, string> = {
  open: `<p>Yes. Licensed retailers based in ${country.name} sell Cuban (Habanos) cigars online with public pricing and ship domestically. Cross-border EU shipments are accepted by many of them but face destination-country tobacco duty + VAT.</p>`,
  restricted: `<p>Restricted. ${country.name} permits online tobacco sale only under specific conditions (often: identity verification, no public price display, or shipping limited to certain regions).</p>`,
  closed: `<p>No. ${country.name} does not permit online Cuban-cigar sale. The retailers listed are in-store walk-in only.</p>`,
};

const countryFaq = [
  { q: `Can I legally buy Cuban cigars online in ${country.name}?`, a: statusAnswers[country.status] },
  { q: `Where is the cheapest place to buy Cuban cigars in ${country.name} right now?`,
    a: `<p>${cheapestLine}</p>` },
  { q: `Will I pay tobacco duty + VAT on top of the listed price?`,
    a: `<p>If you buy from a retailer based in ${country.name} and ship to a ${country.name} address: <strong>no</strong> — duty + VAT are already included in the listed price. If you buy from a retailer in another country and ship to ${country.name}: <strong>yes</strong> — ${country.name} charges its own tobacco excise + VAT at customs.</p>` },
  { q: `What's the difference between an LCDH, a Habanos Specialist, and a generic tobacconist?`,
    a: `<p><strong>LCDH (La Casa del Habano)</strong> is the official franchise network of Habanos S.A. <strong>Habanos Specialist</strong> is licensed with trained staff and guaranteed authenticity. <strong>Generic tobacconist</strong> sells Cuban alongside other origins.</p>` },
];

// Local places
const placeTypeLabels: Record<string, string> = {
  casadelhabano: "Casa del Habano", house: "Brand flagship", lounge: "Lounge",
  retailer: "Retailer", club: "Private club", pub: "Cigar-friendly bar",
};
const localPlaces = cigarPlaces
  .filter((p) => p.country.toLowerCase() === country.name.toLowerCase())
  .slice(0, 8)
  .map((p) => ({
    ...p,
    typeLabel: placeTypeLabels[p.type] || p.type,
    mapHref: p.website || `https://www.google.com/maps/search/?api=1&query=${p.lat},${p.lng}`,
  }));

// JSON-LD (SEO preserved)
const itemListJsonLd = {
  "@context": "https://schema.org/",
  "@type": "ItemList",
  name: `Cuban cigar prices in ${country.name}`,
  numberOfItems: skuRows.length,
  itemListElement: skuRows.map(({ sku, snap }, i) => ({
    "@type": "ListItem", position: i + 1,
    item: {
      "@type": "Product", name: `${sku.brand} ${sku.vitola}`,
      brand: { "@type": "Brand", name: sku.brand },
      url: `https://thenextcigar.com/finder/sku/${sku.slug}/`,
      offers: {
        "@type": "Offer", priceCurrency: snap.currency, price: snap.price.toFixed(2),
        availability: "https://schema.org/InStock",
        seller: { "@type": "Organization", name: RETAILERS.find((r) => r.id === snap.retailerId)!.name },
      },
    },
  })),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org/", "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "The Finder", item: "https://thenextcigar.com/finder/" },
    { "@type": "ListItem", position: 2, name: country.name, item: `https://thenextcigar.com/finder/${country.code}/` },
  ],
};

const statusFlagClass: Record<typeof country.status, string> = {
  open: "finder", restricted: "market", closed: "people",
};
---

<BaseLayout
  title={`Cuban cigar prices in ${country.name} — The Finder · The Next Cigar`}
  description={`${skuRows.length} live prices across ${retailerCount} licensed Habanos retailers in ${country.name}. ${statusLabel[country.status]}.`}
  bareChrome={true}
>
  <link is:inline href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <FaqSchema items={countryFaq} />

  <div class="tnc-cinema">
    <CigarCursor />

    <main class="site-body">
      <NewspaperMasthead {...masthead} />

      <SectionFlag
        number="/01"
        section={`The Finder · ${country.name}`}
        title={`${country.flag} ${country.name}<em> — Cuban cigar prices, live.</em>`}
        status={`${skuRows.length} SKUs · ${retailerCount} retailers · ${statusLabel[country.status]}`}
        live={country.status === "open"}
      />

      <section class="country-hero">
        <a href="/finder/" class="country-back" data-hover>← All countries</a>
        <div class="country-hero-grid">
          <div>
            <span class={`country-status-flag ${statusFlagClass[country.status]}`}>{statusLabel[country.status]}</span>
            {policy?.notes && <p class="country-policy">{policy.notes}</p>}
          </div>
          <div class="country-hero-stats">
            <div><span class="k">SKUs tracked</span><span class="v">{skuRows.length}</span></div>
            <div><span class="k">Retailers</span><span class="v">{retailerCount}</span></div>
            <div><span class="k">Snapshots</span><span class="v">{snapshots.length}</span></div>
          </div>
        </div>
      </section>

      {skuRows.length > 0 && (
        <section class="table-band">
          <div class="table-head">
            <div class="table-flag">Live prices · sorted cheapest first</div>
            <h2>{skuRows.length} SKUs <em>in {country.name} today.</em></h2>
          </div>
          <table class="ticker">
            <thead>
              <tr>
                <th>Vitola</th>
                <th class="num">Price</th>
                <th class="num">EUR eq.</th>
                <th>Retailer</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {skuRows.map(({ sku, snap }) => {
                const retailer = RETAILERS.find((r) => r.id === snap.retailerId);
                const eur = toEUR(snap.price, snap.currency);
                return (
                  <tr>
                    <td>
                      <a href={`/finder/sku/${sku.slug}/`} data-hover>
                        <span class="brand">{sku.brand}</span>
                        <span class="name">{sku.vitola}</span>
                      </a>
                    </td>
                    <td class="num">{formatPrice(snap.price, snap.currency)}</td>
                    <td class="num eur">€{Math.round(eur).toLocaleString()}</td>
                    <td>{retailer?.name}{retailer?.city && <span class="brand">{retailer.city}</span>}</td>
                    <td class="num"><a href={`/finder/sku/${sku.slug}/`} data-hover class="row-cta">Compare all →</a></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </section>
      )}

      {retailers.length > 0 && (
        <section class="retailers-band">
          <div class="retailers-head">
            <div class="retailers-flag">Licensed retailers</div>
            <h2>{retailerCount} shops <em>we track in {country.name}.</em></h2>
          </div>
          <div class="retailers-grid">
            {retailers.map((r) => (
              <a href={r.url} target="_blank" rel="noopener" class="retailer" data-hover>
                <div class="retailer-name">{r.name}</div>
                {r.city && <div class="retailer-city">{r.city}</div>}
                <div class="retailer-status">{r.status.toUpperCase()}</div>
                <div class="retailer-cta">Visit site →</div>
              </a>
            ))}
          </div>
        </section>
      )}

      {localPlaces.length > 0 && (
        <section class="places-band">
          <div class="places-head">
            <div class="places-flag">Visit in person</div>
            <h2>Lounges &amp; houses <em>worth the trip.</em></h2>
          </div>
          <div class="places-grid">
            {localPlaces.map((p) => (
              <a href={p.mapHref} target="_blank" rel="noopener" class="place" data-hover>
                <div class="place-type">{p.typeLabel}</div>
                <h3>{p.name}</h3>
                <div class="place-city">{p.city}</div>
                {p.note && <p>{p.note}</p>}
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="faq-band">
        <div class="faq-head">
          <div class="faq-flag">Frequently asked</div>
          <h2>Buying Cuban <em>in {country.name}.</em></h2>
        </div>
        <div class="faq-list">
          {countryFaq.map((item, i) => (
            <details class="faq-item" open={i === 0}>
              <summary>{item.q}</summary>
              <div class="faq-answer" set:html={item.a}></div>
            </details>
          ))}
        </div>
      </section>

      <section class="footer-strip">
        <div class="footer-strip-inner">
          <div>
            <a href="/" class="footer-strip-mark" data-hover>The Next Cigar</a>
            <div class="footer-strip-tag">The Anthology of the Leaf &middot; Malmö · Lisbon</div>
          </div>
          <div class="footer-strip-links">
            <a href="/finder/" data-hover>Finder</a>
            <a href="/lounge/" data-hover>Lounge</a>
            <a href="/blog/" data-hover>Magazine</a>
            <a href="/shop/" data-hover>Shop</a>
            <a href="/about/" data-hover>About</a>
            <a href="/contact/" data-hover>Contact</a>
          </div>
        </div>
        <div class="footer-strip-copy">
          <span>© 2025–2026 The Next Cigar</span>
          <a href="https://turquinostudios.com" target="_blank" rel="noopener" class="footer-turquino" data-hover>
            <img src="/cinematic/turquino-mark.jpg" alt="" />
            <span>Designed by <em>Turquino Studios</em></span>
          </a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .site-body { padding-bottom: 40px; }

  .country-hero { max-width: 1400px; margin: 0 auto; padding: 32px 40px 40px; border-bottom: 1px solid var(--news-rule); }
  .country-back {
    display: inline-block;
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--news-oxblood);
    padding-bottom: 3px; border-bottom: 1px solid transparent; transition: all 0.2s;
    margin-bottom: 24px;
  }
  .country-back:hover { border-bottom-color: var(--news-oxblood); }
  .country-hero-grid { display: grid; grid-template-columns: 8fr 4fr; gap: 48px; align-items: start; }
  .country-status-flag {
    display: inline-block;
    font-family: var(--news-sans); font-weight: 700; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-ink); color: var(--news-paper); padding: 5px 12px; margin-bottom: 16px;
  }
  .country-status-flag.finder { background: var(--news-pine); }
  .country-status-flag.market { background: var(--news-mahogany); }
  .country-status-flag.people { background: var(--news-ink-mute); }
  .country-policy {
    font-family: var(--news-serif); font-style: italic;
    font-size: clamp(1rem, 1.4vw, 1.2rem); line-height: 1.55;
    color: var(--news-ink-soft); margin: 0; max-width: 640px;
  }
  .country-hero-stats {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
    padding: 20px 24px; border: 1px solid var(--news-ink); background: var(--news-paper-cream);
  }
  .country-hero-stats > div { text-align: center; }
  .country-hero-stats .k {
    font-family: var(--news-mono); font-size: 9px; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--news-ink-mute); display: block; margin-bottom: 6px;
  }
  .country-hero-stats .v {
    font-family: var(--news-serif); font-weight: 600;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem); color: var(--news-oxblood); letter-spacing: -0.018em;
  }

  /* Ticker table */
  .table-band { max-width: 1400px; margin: 0 auto; padding: 40px 40px; border-bottom: 1px solid var(--news-rule); }
  .table-head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 24px; padding-bottom: 12px; border-bottom: 4px double var(--news-ink);
    flex-wrap: wrap; gap: 12px;
  }
  .table-flag {
    font-family: var(--news-sans); font-weight: 700; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-oxblood); color: var(--news-paper); padding: 6px 12px;
  }
  .table-head h2 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.4rem, 2.2vw, 1.85rem); margin: 0; letter-spacing: -0.016em;
  }
  .table-head h2 :global(em) { font-style: italic; color: var(--news-oxblood); font-weight: 400; }
  .ticker { width: 100%; border-collapse: collapse; border-top: 2px solid var(--news-ink); border-bottom: 2px solid var(--news-ink); font-family: var(--news-serif); font-size: 14px; }
  .ticker thead th {
    font-family: var(--news-mono); font-weight: 500; font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--news-ink); text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--news-ink); background: var(--news-paper-dark);
  }
  .ticker thead th.num { text-align: right; }
  .ticker tbody tr { border-bottom: 1px solid var(--news-rule); transition: background 0.2s; }
  .ticker tbody tr:hover { background: rgba(138, 43, 30, 0.06); }
  .ticker td { padding: 12px 8px; vertical-align: middle; }
  .ticker td.num { text-align: right; font-family: var(--news-mono); font-size: 13px; font-weight: 500; }
  .ticker td.num.eur { color: var(--news-oxblood); }
  .ticker .brand { font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--news-ink-mute); display: block; margin-top: 2px; }
  .ticker .name { font-family: var(--news-serif); font-weight: 500; font-size: 15px; color: var(--news-ink); }
  .row-cta { font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--news-oxblood); text-transform: uppercase; }
  .row-cta:hover { color: var(--news-ember); }

  /* Retailers grid — cards */
  .retailers-band { max-width: 1400px; margin: 0 auto; padding: 40px 40px; border-bottom: 1px solid var(--news-rule); }
  .retailers-head { display: grid; grid-template-columns: auto 1fr; gap: 32px; align-items: baseline; margin-bottom: 24px; padding-bottom: 12px; border-bottom: 4px double var(--news-ink); }
  .retailers-flag {
    font-family: var(--news-sans); font-weight: 700; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-mahogany); color: var(--news-paper); padding: 6px 12px; align-self: start;
  }
  .retailers-head h2 { font-family: var(--news-serif); font-weight: 500; font-size: clamp(1.4rem, 2.2vw, 1.85rem); margin: 0; letter-spacing: -0.016em; }
  .retailers-head h2 :global(em) { font-style: italic; color: var(--news-oxblood); font-weight: 400; }
  .retailers-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .retailer {
    display: flex; flex-direction: column; gap: 4px;
    padding: 16px 18px; border: 1px solid var(--news-ink); background: var(--news-paper);
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .retailer:hover { transform: translateY(-2px); }
  .retailer-name { font-family: var(--news-serif); font-weight: 500; font-size: 15px; color: var(--news-ink); letter-spacing: -0.012em; }
  .retailer-city { font-family: var(--news-serif); font-style: italic; font-size: 12.5px; color: var(--news-ink-soft); }
  .retailer-status { font-family: var(--news-mono); font-size: 9px; letter-spacing: 0.18em; color: var(--news-oxblood); margin-top: 6px; }
  .retailer-cta { font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--news-ink-mute); margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--news-rule); }

  /* Places */
  .places-band { max-width: 1400px; margin: 0 auto; padding: 40px 40px; border-bottom: 1px solid var(--news-rule); }
  .places-head { display: grid; grid-template-columns: auto 1fr; gap: 32px; align-items: baseline; margin-bottom: 24px; padding-bottom: 12px; border-bottom: 4px double var(--news-ink); }
  .places-flag {
    font-family: var(--news-sans); font-weight: 700; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: #3a2a1c; color: var(--news-paper); padding: 6px 12px; align-self: start;
  }
  .places-head h2 { font-family: var(--news-serif); font-weight: 500; font-size: clamp(1.4rem, 2.2vw, 1.85rem); margin: 0; letter-spacing: -0.016em; }
  .places-head h2 :global(em) { font-style: italic; color: var(--news-oxblood); font-weight: 400; }
  .places-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .place {
    padding: 18px 20px; border: 1px solid var(--news-ink); background: var(--news-paper);
    display: flex; flex-direction: column; gap: 6px;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .place:hover { transform: translateY(-2px); }
  .place-type { font-family: var(--news-mono); font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--news-oxblood); margin-bottom: 4px; }
  .place h3 { font-family: var(--news-serif); font-weight: 500; font-size: 17px; letter-spacing: -0.014em; color: var(--news-ink); margin: 0; }
  .place-city { font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--news-ink-mute); }
  .place p { font-family: var(--news-serif); font-style: italic; font-size: 13px; line-height: 1.5; color: var(--news-ink-soft); margin: 6px 0 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  /* FAQ */
  .faq-band { max-width: 900px; margin: 0 auto; padding: 40px 40px; border-bottom: 1px solid var(--news-rule); }
  .faq-head { margin-bottom: 24px; padding-bottom: 12px; border-bottom: 4px double var(--news-ink); }
  .faq-flag {
    display: inline-block;
    font-family: var(--news-sans); font-weight: 700; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-ink); color: var(--news-paper); padding: 5px 12px; margin-bottom: 12px;
  }
  .faq-head h2 { font-family: var(--news-serif); font-weight: 500; font-size: clamp(1.6rem, 2.8vw, 2.2rem); margin: 0; letter-spacing: -0.018em; }
  .faq-head h2 :global(em) { font-style: italic; color: var(--news-oxblood); font-weight: 400; }
  .faq-list { display: flex; flex-direction: column; }
  .faq-item {
    border-bottom: 1px solid var(--news-rule);
    padding: 16px 0;
  }
  .faq-item summary {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem); letter-spacing: -0.01em;
    color: var(--news-ink); cursor: none;
    list-style: none;
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: "+"; font-family: var(--news-mono); font-weight: 500; font-size: 22px;
    color: var(--news-oxblood); transition: transform 0.25s;
  }
  .faq-item[open] summary::after { content: "−"; }
  .faq-item[open] summary { color: var(--news-oxblood); }
  .faq-answer {
    font-family: var(--news-serif); font-size: 15px; line-height: 1.6;
    color: var(--news-ink-soft); padding-top: 12px; padding-left: 4px;
  }
  .faq-answer :global(a) {
    color: var(--news-oxblood); border-bottom: 1px solid var(--news-oxblood); padding-bottom: 1px;
  }
  .faq-answer :global(a:hover) { color: var(--news-ember); border-bottom-color: var(--news-ember); }
  .faq-answer :global(strong) { font-weight: 600; color: var(--news-ink); }

  /* Footer strip */
  .footer-strip { max-width: 1400px; margin: 0 auto; padding: 40px 40px 24px; }
  .footer-strip-inner { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; padding-bottom: 20px; border-bottom: 1px solid var(--news-rule); }
  .footer-strip-mark { font-family: var(--news-serif); font-weight: 600; font-size: 22px; letter-spacing: -0.008em; color: var(--news-ink); display: block; }
