---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/newspaper.css";
import CigarCursor from "../../../components/newspaper/CigarCursor.astro";
import NewspaperMasthead from "../../../components/newspaper/NewspaperMasthead.astro";
import SectionFlag from "../../../components/newspaper/SectionFlag.astro";
import PriceAlertModal from "../../../components/finder/PriceAlertModal.astro";
import SaveAlertButton from "../../../components/finder/SaveAlertButton.astro";
import FaqSchema from "../../../components/finder/FaqSchema.astro";
import { MASTHEAD as masthead } from "../../../data/masthead";
import {
  SKUS,
  RETAILERS,
  snapshotsForSku,
  formatPrice,
  toEUR,
  COUNTRY_BY_CODE,
  RETAILER_BY_ID,
  effectiveShopUrl,
  dutyPaidCountries,
} from "../../../data/finder-data.ts";
import { buildSkuFaq } from "../../../lib/finder/skuFaq.ts";

export async function getStaticPaths() {
  return SKUS.map((sku) => ({ params: { sku: sku.slug } }));
}

const { sku: skuSlug } = Astro.params as { sku: string };
const sku = SKUS.find((s) => s.slug === skuSlug);
if (!sku) return Astro.redirect("/finder/");

const snapshots = snapshotsForSku(sku.id);

// Decorate every snapshot with resolved retailer, country, per-cigar EUR, and
// the exact shop link (effectiveShopUrl → product page if we have it,
// otherwise a same-site search).
const offers = snapshots
  .map(function decorateOffer(snap) {
    const retailer = RETAILER_BY_ID[snap.retailerId];
    const country  = COUNTRY_BY_CODE[retailer.country];
    const eur      = toEUR(snap.price, snap.currency);
    const link     = effectiveShopUrl(snap.sourceUrl, sku, retailer);
    const shopLabel = link.isExact ? "Shop this SKU →" : "Search on site →";
    return {
      snap, retailer, country, eur,
      perCigarEur: eur / sku.boxSize,
      link, shopLabel,
      verifiedDate: new Date(snap.scrapedAt).toLocaleDateString("en-GB", { day: "2-digit", month: "short" }),
    };
  })
  .sort(function rankOffers(a, b) {
    if (a.snap.inStock !== b.snap.inStock) return a.snap.inStock ? -1 : 1;
    return a.eur - b.eur;
  });

const inStockOffers = offers.filter((o) => o.snap.inStock);
const best          = inStockOffers[0];
const eurPrices = inStockOffers.map((o) => o.eur);
const minEur    = eurPrices[0] || 0;
const maxEur    = eurPrices[eurPrices.length - 1] || 0;
const spread    = maxEur && minEur ? Math.round(((maxEur - minEur) / minEur) * 100) : 0;
const allCountries = Array.from(new Set(offers.map((o) => o.country.code)));

// JSON-LD — Product + AggregateOffer + Breadcrumb (SEO preserved)
const productJsonLd = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: `${sku.brand} ${sku.vitola}`,
  brand: { "@type": "Brand", name: sku.brand },
  description: sku.blurb,
  category: "Premium Cuban Cigar",
  additionalProperty: [
    { "@type": "PropertyValue", name: "Vitola", value: sku.shape },
    { "@type": "PropertyValue", name: "Ring gauge", value: String(sku.ring) },
    { "@type": "PropertyValue", name: "Length", value: `${sku.lengthMm} mm` },
    { "@type": "PropertyValue", name: "Box size", value: String(sku.boxSize) },
    { "@type": "PropertyValue", name: "Origin", value: "Cuba (Habanos S.A.)" },
  ],
  ...(inStockOffers.length > 0 && {
    offers: {
      "@type": "AggregateOffer",
      priceCurrency: "EUR",
      lowPrice: minEur.toFixed(2),
      highPrice: maxEur.toFixed(2),
      offerCount: String(inStockOffers.length),
      availability: "https://schema.org/InStock",
      offers: inStockOffers.map((o) => ({
        "@type": "Offer",
        url: o.snap.sourceUrl,
        price: o.snap.price.toFixed(2),
        priceCurrency: o.snap.currency,
        availability: "https://schema.org/InStock",
        seller: { "@type": "Organization", name: o.retailer.name, url: o.retailer.url },
        areaServed: o.country.name,
      })),
    },
  }),
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org/",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "The Finder", item: "https://thenextcigar.com/finder/" },
    { "@type": "ListItem", position: 2, name: sku.brand, item: `https://thenextcigar.com/finder/sku/${sku.slug}/` },
  ],
};

const faqItems = buildSkuFaq({
  sku,
  best,
  offersCount: offers.length,
  sameBrandSkus: SKUS.filter((s) => s.brand === sku.brand && s.id !== sku.id).slice(0, 4),
});

const ogTitle = `${sku.brand} ${sku.vitola} — ${best ? `from ${best.snap.currency} ${best.snap.price.toFixed(0)}` : "European price comparison"}`;
const ogDescription = best
  ? `${offers.length} live offers · cheapest ${formatPrice(best.snap.price, best.snap.currency)} at ${best.retailer.name} · ${allCountries.length} countries tracked.`
  : `Live European price comparison for the ${sku.brand} ${sku.vitola}. Track drops, get alerts.`;

// Same-brand siblings for the "Cigars like this" band
const siblings = SKUS.filter((s) => s.brand === sku.brand && s.id !== sku.id).slice(0, 4);
---

<BaseLayout title={ogTitle} description={ogDescription} bareChrome={true}>
  <link is:inline href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <FaqSchema items={faqItems} />

  <div class="tnc-cinema">
    <CigarCursor />

    <main class="site-body">
      <NewspaperMasthead {...masthead} />

      <SectionFlag
        number="/01"
        section="The Finder · SKU"
        title={`${sku.brand} <em>${sku.vitola}</em>`}
        status={best ? `Cheapest ${formatPrice(best.snap.price, best.snap.currency)} · ${best.retailer.name}, ${best.country.name}` : `${offers.length} tracked offers`}
        live={inStockOffers.length > 0}
      />

      <section class="sku-hero">
        <div class="sku-hero-inner">
          <a href="/finder/" class="sku-back" data-hover>← Back to the Finder</a>

          <div class="sku-hero-grid">
            <div class="sku-hero-lead">
              <div class="sku-hero-brand">{sku.brand} · {sku.line}</div>
              <h1 class="sku-hero-title">{sku.vitola}</h1>
              <p class="sku-hero-blurb">{sku.blurb}</p>

              <div class="sku-hero-specs">
                <div><span class="k">Shape</span><span class="v">{sku.shape}</span></div>
                <div><span class="k">Ring</span><span class="v">{sku.ring}</span></div>
                <div><span class="k">Length</span><span class="v">{sku.lengthMm} mm</span></div>
                <div><span class="k">Box</span><span class="v">{sku.boxSize} cigars</span></div>
                {sku.prestige && <div><span class="k">Tier</span><span class="v">{sku.prestige}</span></div>}
                {sku.strength && <div><span class="k">Strength</span><span class="v">{sku.strength}</span></div>}
              </div>
            </div>

            {best && (
              <aside class="sku-hero-price">
                <div class="sku-hero-price-label">Best value · in stock</div>
                <div class="sku-hero-price-big">{formatPrice(best.snap.price, best.snap.currency)}</div>
                <div class="sku-hero-price-eur">≈ €{Math.round(best.eur).toLocaleString()}</div>
                <div class="sku-hero-price-per">€{best.perCigarEur.toFixed(2)} per cigar · box of {sku.boxSize}</div>
                <div class="sku-hero-price-at">
                  at <strong>{best.retailer.name}</strong> · {best.country.flag} {best.country.name}
                </div>
                <a
                  href={best.link.url}
                  class="sku-hero-cta"
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  data-hover
                  title={best.link.isExact
                    ? "Opens the retailer product page in a new tab"
                    : `We don't have a direct link yet — this opens ${best.retailer.name}'s site search for ${sku.brand} ${sku.vitola}.`}
                >
                  {best.link.isExact ? `Shop at ${best.retailer.name} →` : `Search ${best.retailer.name} for this →`}
                </a>
                <SaveAlertButton
                  sku={sku.slug}
                  productName={`${sku.brand} ${sku.vitola}`}
                  baselineEur={Math.round(best.eur)}
                  baselineLabel={`€${Math.round(best.eur).toLocaleString("en-US")}`}
                  variant="ghost"
                />
                <p class="sku-hero-note">
                  Affiliate disclosure — clicking through earns The Next Cigar a referral commission. Your price is unchanged.
                </p>
              </aside>
            )}
          </div>

          {inStockOffers.length > 1 && (
            <p class="sku-hero-tracker">
              Tracking <strong>{offers.length}</strong> offers across <strong>{allCountries.length}</strong> countries · range €{Math.round(minEur).toLocaleString()}–€{Math.round(maxEur).toLocaleString()} · spread <strong>{spread}%</strong>
            </p>
          )}
        </div>
      </section>

      {offers.length > 0 && (
        <section class="sku-table-band">
          <div class="sku-table-head">
            <div class="sku-table-flag">Every offer we're tracking</div>
            <h2>{offers.length} offers <em>· sorted by EUR</em></h2>
          </div>
          <table class="ticker">
            <thead>
              <tr>
                <th>Retailer</th>
                <th>Country</th>
                <th class="num">Price</th>
                <th class="num">EUR eq.</th>
                <th class="num">Per cigar</th>
                <th>Stock</th>
                <th class="num">Verified</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {offers.map((o) => (
                <tr class:list={[!o.snap.inStock && "out-of-stock"]}>
                  <td>
                    <a href={o.retailer.url} target="_blank" rel="noopener" data-hover>
                      <span class="name">{o.retailer.name}</span>
                      {o.retailer.city && <span class="brand">{o.retailer.city}</span>}
                    </a>
                  </td>
                  <td class="country">{o.country.flag} {o.country.name}</td>
                  <td class="num">{formatPrice(o.snap.price, o.snap.currency)}</td>
                  <td class="num eur">€{Math.round(o.eur).toLocaleString()}</td>
                  <td class="num">€{o.perCigarEur.toFixed(2)}</td>
                  <td>
                    <span class:list={["stock-dot", o.snap.inStock ? "in" : "out"]}>
                      {o.snap.inStock ? "In stock" : "Sold out"}
                    </span>
                  </td>
                  <td class="num">{o.verifiedDate}</td>
                  <td class="num">
                    <a
                      href={o.link.url}
                      target="_blank"
                      rel="noopener sponsored"
                      class="row-cta"
                      data-hover
                      title={o.link.isExact ? "Opens the retailer product page" : `Opens ${o.retailer.name}'s search for this cigar`}
                    >
                      {o.link.isExact ? "Shop →" : "Search →"}
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )}

      {sku.editorial && (
        <section class="sku-editorial">
          <div class="sku-editorial-eyebrow">From the tasting notes</div>
          <div class="sku-editorial-body" set:html={
            sku.editorial.split("\n\n").map(p => `<p>${p.replace(/\n/g, "<br/>")}</p>`).join("")
          }></div>
        </section>
      )}

      {siblings.length > 0 && (
        <section class="siblings-band">
          <div class="siblings-head">
            <div class="siblings-flag">Other {sku.brand} vitolas</div>
            <h2>Same brand <em>— different smoke.</em></h2>
          </div>
          <div class="siblings-grid">
            {siblings.map((s) => (
              <a href={`/finder/sku/${s.slug}/`} class="sibling" data-hover>
                <div class="sibling-brand">{s.brand}</div>
                <div class="sibling-vitola">{s.vitola}</div>
                <div class="sibling-blurb">{s.blurb}</div>
                <div class="sibling-cta">Open on the Finder →</div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="footer-strip">
        <div class="footer-strip-inner">
          <div>
            <a href="/" class="footer-strip-mark" data-hover>The Next Cigar</a>
            <div class="footer-strip-tag">The Anthology of the Leaf &middot; Malmö · Lisbon</div>
          </div>
          <div class="footer-strip-links">
            <a href="/finder/" data-hover>Finder</a>
            <a href="/lounge/" data-hover>Lounge</a>
            <a href="/blog/" data-hover>Magazine</a>
            <a href="/shop/" data-hover>Shop</a>
            <a href="/about/" data-hover>About</a>
            <a href="/contact/" data-hover>Contact</a>
          </div>
        </div>
        <div class="footer-strip-copy">
          <span>© 2025–2026 The Next Cigar</span>
          <a href="https://turquinostudios.com" target="_blank" rel="noopener" class="footer-turquino" data-hover>
            <img src="/cinematic/turquino-mark.jpg" alt="" />
            <span>Designed by <em>Turquino Studios</em></span>
          </a>
        </div>
      </section>
    </main>
  </div>

  <PriceAlertModal />
</BaseLayout>

<style>
  .site-body { padding-bottom: 40px; }

  /* Hero — brand + vitola + best price side by side */
  .sku-hero { max-width: 1400px; margin: 0 auto; padding: 32px 40px 48px; border-bottom: 1px solid var(--news-rule); }
  .sku-hero-inner { max-width: 100%; }
  .sku-back {
    display: inline-block;
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--news-oxblood);
    padding-bottom: 3px; border-bottom: 1px solid transparent; transition: all 0.2s;
    margin-bottom: 28px;
  }
  .sku-back:hover { border-bottom-color: var(--news-oxblood); }
  .sku-hero-grid {
    display: grid; grid-template-columns: 7fr 5fr; gap: 56px; align-items: start;
  }
  .sku-hero-brand {
    font-family: var(--news-mono); font-size: 12px; letter-spacing: 0.24em;
    text-transform: uppercase; color: var(--news-oxblood); margin-bottom: 12px;
  }
  .sku-hero-title {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(2.6rem, 5.6vw, 5.4rem); line-height: 0.96;
    letter-spacing: -0.03em; color: var(--news-ink); margin: 0 0 24px;
  }
  .sku-hero-blurb {
    font-family: var(--news-serif); font-style: italic;
    font-size: clamp(1.05rem, 1.5vw, 1.35rem); line-height: 1.55;
    color: var(--news-ink-soft); margin: 0 0 32px;
  }
  .sku-hero-specs {
    display: grid; grid-template-columns: repeat(3, auto); gap: 20px 32px;
    padding: 20px 0; border-top: 1px solid var(--news-rule); border-bottom: 1px solid var(--news-rule);
  }
  .sku-hero-specs > div { display: flex; flex-direction: column; gap: 4px; }
  .sku-hero-specs .k {
    font-family: var(--news-mono); font-size: 9px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--news-oxblood);
  }
  .sku-hero-specs .v {
    font-family: var(--news-serif); font-size: 15px; color: var(--news-ink); text-transform: capitalize;
  }

  /* Best-value price card */
  .sku-hero-price {
    padding: 28px 28px 32px;
    border: 3px double var(--news-oxblood);
    background: var(--news-paper-cream);
    display: flex; flex-direction: column;
  }
  .sku-hero-price-label {
    font-family: var(--news-mono); font-weight: 700; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--news-oxblood);
    margin-bottom: 12px;
  }
  .sku-hero-price-big {
    font-family: var(--news-serif); font-weight: 600;
    font-size: clamp(2.4rem, 4vw, 3.4rem); line-height: 1;
    letter-spacing: -0.028em; color: var(--news-ink); margin-bottom: 4px;
  }
  .sku-hero-price-eur {
    font-family: var(--news-mono); font-size: 12px; color: var(--news-ink-mute);
    margin-bottom: 12px;
  }
  .sku-hero-price-per {
    font-family: var(--news-serif); font-size: 13px; color: var(--news-ink-soft);
    padding-bottom: 12px; border-bottom: 1px solid var(--news-rule); margin-bottom: 14px;
  }
  .sku-hero-price-at {
    font-family: var(--news-serif); font-size: 14px; line-height: 1.4; color: var(--news-ink);
    margin-bottom: 20px;
  }
  .sku-hero-price-at strong { font-weight: 600; }
  .sku-hero-cta {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 14px 20px; margin-bottom: 12px;
    font-family: var(--news-sans); font-weight: 600; font-size: 12px;
    letter-spacing: 0.1em; text-transform: uppercase;
    background: var(--news-ink); color: var(--news-paper);
    transition: background 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sku-hero-cta:hover { background: var(--news-oxblood); }
  .sku-hero-note {
    font-family: var(--news-serif); font-style: italic; font-size: 11.5px;
    color: var(--news-ink-mute); margin: 12px 0 0; line-height: 1.4;
  }
  .sku-hero-tracker {
    margin-top: 28px; padding-top: 20px; border-top: 4px double var(--news-ink);
    font-family: var(--news-serif); font-size: 15px; color: var(--news-ink-soft);
  }
  .sku-hero-tracker strong { font-weight: 600; color: var(--news-oxblood); }

  /* Offers table — reuses ticker styling from /finder/ */
  .sku-table-band { max-width: 1400px; margin: 0 auto; padding: 40px 40px; border-bottom: 1px solid var(--news-rule); }
  .sku-table-head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 24px; padding-bottom: 12px; border-bottom: 4px double var(--news-ink);
    flex-wrap: wrap; gap: 12px;
  }
  .sku-table-flag {
    font-family: var(--news-sans); font-weight: 700; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-oxblood); color: var(--news-paper); padding: 6px 12px;
  }
  .sku-table-head h2 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.4rem, 2.2vw, 1.85rem); letter-spacing: -0.016em; margin: 0;
  }
  .sku-table-head h2 :global(em) { font-style: italic; color: var(--news-oxblood); font-weight: 400; }

  .ticker { width: 100%; border-collapse: collapse; border-top: 2px solid var(--news-ink); border-bottom: 2px solid var(--news-ink); font-family: var(--news-serif); font-size: 14px; }
  .ticker thead th {
    font-family: var(--news-mono); font-weight: 500; font-size: 9px;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--news-ink);
    text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--news-ink); background: var(--news-paper-dark);
  }
  .ticker thead th.num { text-align: right; }
  .ticker tbody tr { border-bottom: 1px solid var(--news-rule); transition: background 0.2s; }
  .ticker tbody tr:hover { background: rgba(138, 43, 30, 0.06); }
  .ticker tbody tr.out-of-stock { opacity: 0.55; }
  .ticker td { padding: 12px 8px; vertical-align: middle; }
  .ticker td.num { text-align: right; font-family: var(--news-mono); font-size: 13px; font-weight: 500; }
  .ticker td.num.eur { color: var(--news-oxblood); }
  .ticker .brand {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--news-ink-mute); display: block; margin-top: 2px;
  }
  .ticker .name { font-family: var(--news-serif); font-weight: 500; font-size: 15px; color: var(--news-ink); }
  .ticker .country { font-family: var(--news-mono); font-size: 12px; }
  .stock-dot {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .stock-dot::before { content: ""; width: 8px; height: 8px; border-radius: 50%; }
  .stock-dot.in::before  { background: var(--news-pine); }
  .stock-dot.in         { color: var(--news-pine); }
  .stock-dot.out::before { background: var(--news-ink-mute); }
  .stock-dot.out        { color: var(--news-ink-mute); }
  .row-cta {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.16em;
    color: var(--news-oxblood); text-transform: uppercase;
  }
  .row-cta:hover { color: var(--news-ember); }

  /* Editorial writeup */
  .sku-editorial { max-width: 780px; margin: 0 auto; padding: 56px 40px; border-bottom: 1px solid var(--news-rule); }
  .sku-editorial-eyebrow {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--news-oxblood); margin-bottom: 20px;
    display: flex; align-items: center; gap: 12px;
  }
  .sku-editorial-eyebrow::before { content: ""; width: 32px; height: 1px; background: var(--news-oxblood); }
  .sku-editorial-body { font-family: var(--news-serif); font-size: 18px; line-height: 1.68; color: var(--news-ink); }
  .sku-editorial-body :global(p) { margin: 0 0 1.35em; }
  .sku-editorial-body :global(p:first-child::first-letter) {
    font-family: var(--news-serif); font-weight: 700; font-size: 5em; line-height: 0.85;
    float: left; margin: 0.05em 10px -0.05em 0; color: var(--news-oxblood);
  }

  /* Siblings */
  .siblings-band { max-width: 1400px; margin: 0 auto; padding: 48px 40px; border-bottom: 1px solid var(--news-rule); }
  .siblings-head {
    display: grid; grid-template-columns: auto 1fr; gap: 32px; align-items: baseline;
    margin-bottom: 28px; padding-bottom: 12px; border-bottom: 4px double var(--news-ink);
  }
  .siblings-flag {
    font-family: var(--news-sans); font-weight: 700; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-mahogany); color: var(--news-paper); padding: 6px 12px; align-self: start;
  }
