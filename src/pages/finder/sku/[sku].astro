---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Newsletter from "../../../components/Newsletter.astro";
import PriceAlertModal from "../../../components/finder/PriceAlertModal.astro";
import SaveAlertButton from "../../../components/finder/SaveAlertButton.astro";
import {
  SKUS,
  RETAILERS,
  snapshotsForSku,
  formatPrice,
  toEUR,
  COUNTRY_BY_CODE,
  RETAILER_BY_ID,
  effectiveShopUrl,
} from "../../../data/finder-data.ts";

export async function getStaticPaths() {
  return SKUS.map((sku) => ({ params: { sku: sku.slug } }));
}

const { sku: skuSlug } = Astro.params as { sku: string };
const sku = SKUS.find((s) => s.slug === skuSlug);
if (!sku) return Astro.redirect("/finder/");

const snapshots = snapshotsForSku(sku.id);

// Decorate snapshots with retailer + country + per-cigar EUR conversion, sort by EUR
const offers = snapshots
  .map((snap) => {
    const retailer = RETAILER_BY_ID[snap.retailerId];
    const country  = COUNTRY_BY_CODE[retailer.country];
    const eur      = toEUR(snap.price, snap.currency);
    const link     = effectiveShopUrl(snap.sourceUrl, sku, retailer);
    return { snap, retailer, country, eur, perCigarEur: eur / sku.boxSize, link };
  })
  .sort((a, b) => {
    // In-stock first, then by EUR price ascending
    if (a.snap.inStock !== b.snap.inStock) return a.snap.inStock ? -1 : 1;
    return a.eur - b.eur;
  });

const inStockOffers = offers.filter((o) => o.snap.inStock);
const best          = inStockOffers[0];
const allCountries  = Array.from(new Set(offers.map((o) => o.country.code)));

// Editorial: range
const eurPrices = inStockOffers.map((o) => o.eur);
const minEur    = eurPrices[0];
const maxEur    = eurPrices[eurPrices.length - 1];
const spread    = maxEur && minEur ? Math.round(((maxEur - minEur) / minEur) * 100) : 0;

// ----------------------------------------------------------------------------
// Structured data — Product + AggregateOffer + per-retailer Offers
// Tells Google "this is a comparison-shopping page" and unlocks the rich-result
// price-range snippet that cigarfinder.com gets in US results.
// ----------------------------------------------------------------------------
const productJsonLd = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: `${sku.brand} ${sku.vitola}`,
  brand: { "@type": "Brand", name: sku.brand },
  description: sku.blurb,
  category: "Premium Cuban Cigar",
  additionalProperty: [
    { "@type": "PropertyValue", name: "Vitola", value: sku.shape },
    { "@type": "PropertyValue", name: "Ring gauge", value: String(sku.ring) },
    { "@type": "PropertyValue", name: "Length", value: `${sku.lengthMm} mm` },
    { "@type": "PropertyValue", name: "Box size", value: String(sku.boxSize) },
    { "@type": "PropertyValue", name: "Origin", value: "Cuba (Habanos S.A.)" },
  ],
  ...(inStockOffers.length > 0 && {
    aggregateRating: undefined, // populated when /lounge/ ratings exist
    offers: {
      "@type": "AggregateOffer",
      priceCurrency: "EUR",
      lowPrice: minEur.toFixed(2),
      highPrice: maxEur.toFixed(2),
      offerCount: String(inStockOffers.length),
      availability: "https://schema.org/InStock",
      offers: inStockOffers.map((o) => ({
        "@type": "Offer",
        url: o.snap.sourceUrl,
        price: o.snap.price.toFixed(2),
        priceCurrency: o.snap.currency,
        availability: "https://schema.org/InStock",
        seller: { "@type": "Organization", name: o.retailer.name, url: o.retailer.url },
        areaServed: o.country.name,
      })),
    },
  }),
};

// Breadcrumb structured data
const breadcrumbJsonLd = {
  "@context": "https://schema.org/",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "The Finder", item: "https://thenextcigar.com/finder/" },
    { "@type": "ListItem", position: 2, name: sku.brand, item: `https://thenextcigar.com/finder/sku/${sku.slug}/` },
  ],
};

// Open Graph / social copy
const ogTitle = `${sku.brand} ${sku.vitola} — ${best ? `from ${best.snap.currency} ${best.snap.price.toFixed(0)}` : "European price comparison"}`;
const ogDescription = best
  ? `${offers.length} European retailers compared. Cheapest box of ${sku.boxSize}: ${best.retailer.name} (${best.country.name}) at €${best.eur.toFixed(0)}. ${sku.blurb}`
  : `Compare ${sku.brand} ${sku.vitola} prices across ${offers.length} European retailers. ${sku.blurb}`;
---

<BaseLayout
  title={ogTitle}
  description={ogDescription}
  image="/og-finder.svg"
>
  {/* Structured data — Product + AggregateOffer rich-result schema.
      Placed inline (Google accepts JSON-LD anywhere in the document). */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(productJsonLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)}></script>
  {/* ─── SKU HEADER ─────────────────────────────────────────────────────── */}
  <section class="sku-hero" data-finder-sku={sku.id} data-finder-box-size={sku.boxSize}>
    <div class="container-wide pt-12 md:pt-16 pb-10 reveal">
      <a href="/finder/" class="sku-hero__back">← The Finder</a>

      <div class="sku-hero__head">
        <div class="sku-hero__head-text">
          <p class="lounge-label lounge-label--gold">{sku.brand} · {sku.line}</p>
          <h1 class="sku-hero__title">{sku.vitola}</h1>
          <p class="sku-hero__blurb">{sku.blurb}</p>

          <div class="sku-hero__spec">
            <span><strong>{sku.shape}</strong></span>
            <span>Ring {sku.ring}</span>
            <span>{sku.lengthMm} mm</span>
            <span>Box of {sku.boxSize}</span>
            <span class="sku-hero__prestige sku-hero__prestige--{sku.prestige}">{sku.prestige}</span>
          </div>
        </div>

        {best && (
          <aside class="sku-hero__best">
            <p class="lounge-label lounge-label--gold">Best value · in stock</p>
            <p class="sku-hero__best-price">
              {formatPrice(best.snap.price, best.snap.currency)}
              <span class="sku-hero__best-eur">≈ €{best.eur.toLocaleString("en-US", { maximumFractionDigits: 0 })}</span>
            </p>
            <p class="sku-hero__best-percigar">€{best.perCigarEur.toFixed(2)} per cigar · box of {sku.boxSize}</p>
            <p class="sku-hero__best-at">
              at <strong>{best.retailer.name}</strong> · {best.country.flag} {best.country.name}
            </p>
            <a href={best.retailer.url} class="btn btn-primary sku-hero__best-cta" target="_blank" rel="noopener noreferrer sponsored">
              Shop at {best.retailer.name} →
            </a>
            <div class="sku-hero__best-alert">
              <SaveAlertButton
                sku={sku.slug}
                productName={`${sku.brand} ${sku.vitola}`}
                baselineEur={Math.round(best.eur)}
                baselineLabel={`€${Math.round(best.eur).toLocaleString("en-US")}`}
                variant="ghost"
              />
            </div>
            <p class="sku-hero__best-note">
              Affiliate disclosure: clicking through earns The Next Cigar a referral commission.
              The price you pay is unchanged.
            </p>
          </aside>
        )}
      </div>

      {inStockOffers.length > 1 && (
        <p class="sku-hero__summary">
          Tracking <strong>{offers.length} offers</strong> across <strong>{allCountries.length} countries</strong> ·
          range {formatPrice(minEur, "EUR")}–{formatPrice(maxEur, "EUR")} · spread {spread}%
        </p>
      )}
    </div>
  </section>

  {/* ─── OFFERS TABLE ───────────────────────────────────────────────────── */}
  <section class="container-wide pb-16 reveal">
    <div class="finder-table-wrap">
      <table class="finder-table">
        <thead>
          <tr>
            <th>Retailer</th>
            <th>Country</th>
            <th>Status</th>
            <th class="finder-table__num">Box price</th>
            <th class="finder-table__num">≈ EUR</th>
            <th class="finder-table__num">€ / cigar</th>
            <th>Stock</th>
            <th class="finder-table__cta"></th>
          </tr>
        </thead>
        <tbody>
          {offers.map((o, i) => (
            {/* Row class is 'is-unverified' by default — no 'is-oos' lie.
                The hydration script adds 'is-oos' only when a LIVE scrape
                actually reports the retailer as out of stock. */}
            <tr class="is-unverified" data-retailer-id={o.retailer.id}>
              <td data-cell="retailer" data-label="Retailer">
                <span class="finder-table__retailer">{o.retailer.name}</span>
                {o.retailer.status === "lcdh" && <span class="finder-badge finder-badge--gold">LCDH</span>}
                {/* 'Best value' badge intentionally NOT rendered here — it
                    used to be shown for the first row based on the static
                    inStock claim. We now only let the hydration script
                    surface that badge once it knows which LIVE row is
                    actually cheapest AND in stock. */}
              </td>
              <td data-label="Country">{o.country.flag} {o.country.name}</td>
              <td data-label="Status">
                <span
                  class="finder-ships"
                  title={
                    o.retailer.shipsTo === "domestic"
                      ? `Domestic shipping only — duty-paid within ${o.country.name}.`
                      : "Cross-border shipping accepted, but destination-country tobacco duty + VAT applies. SE/DK/FI/IE/UK/CH buyers: expect a surcharge at customs."
                  }
                >
                  Ships {o.retailer.shipsTo === "domestic" ? "domestic" : o.retailer.shipsTo === "eu" ? "EU" : "worldwide"}
                  {o.retailer.shipsTo !== "domestic" && (
                    <span class="finder-ships-warn" aria-label="Cross-border duty warning">ⓘ</span>
                  )}
                </span>
              </td>
              <td class="finder-table__num finder-table__price" data-cell="price" data-label="Box price">
                {formatPrice(o.snap.price, o.snap.currency)}
                {o.snap.originalPrice && (
                  <span class="finder-table__was">was {formatPrice(o.snap.originalPrice, o.snap.currency)}</span>
                )}
              </td>
              <td class="finder-table__num" data-cell="eur" data-label="≈ EUR">€{o.eur.toLocaleString("en-US", { maximumFractionDigits: 0 })}</td>
              <td class="finder-table__num" data-cell="per-cigar" data-label="€ / cigar">€{o.perCigarEur.toFixed(2)}</td>
              <td data-cell="stock" data-label="Stock">
                {/* Default rendering: NEVER claim stock from static research.
                    We only show 'In stock' / 'Out of stock' badges on rows
                    backed by a live scrape — the hydration script overwrites
                    this cell with the real badge when fresh data arrives.
                    For unverified rows we honestly say 'Last verified' so
                    users know the data is historical, not real-time. */}
                <span class="finder-stock finder-stock--unverified" title="No live scrape for this retailer yet — please verify availability on their site before purchasing">
                  Last verified · {(() => {
                    const d = new Date(o.snap.scrapedAt);
                    return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short" });
                  })()}
                </span>
              </td>
              <td class="finder-table__cta">
                <a
                  href={o.link.url}
                  class={o.link.isExact ? "finder-table__compare" : "finder-table__compare finder-table__compare--search"}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  data-cell="shop"
                  title={o.link.isExact
                    ? "Opens the retailer's product page in a new tab"
                    : `We don't have a direct link to this cigar on ${o.retailer.name} yet — this opens their site search for "${sku.brand} ${sku.vitola}".`}
                >
                  {o.link.isExact ? "Shop →" : "Search on site →"}
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="sku-hero__verification" data-verification>
      <strong>Two data sources:</strong>
      Rows with a <span class="finder-badge finder-badge--live">● LIVE</span> badge are scraped every 6 hours
      and reflect the retailer's current price + stock state.
      Rows showing <span class="finder-stock finder-stock--unverified">Last verified · 15 May</span>
      are historical manual research — the retailer <em>may not currently carry this SKU or may be sold out</em>.
      <strong>Always tap "Shop →" and verify availability on the retailer's site before purchasing.</strong>
      We're expanding live-scraping coverage to every SKU monthly.
    </p>

    {/* ─── Duty-paid shipping clarification ─────────────────────────────────
        Critical buyer transparency: "Ships EU" means the retailer accepts EU
        addresses, NOT that no destination-country tobacco duty applies. Sweden
        in particular has been levying tobacco tax on inbound EU shipments
        since 2018 case law; Denmark, Finland, Ireland enforce similar rules;
        UK + Switzerland are outside the EU customs union so all shipments
        face destination duty + VAT. Better to surface this than risk a buyer
        getting a 50% surcharge surprise at the door. */}
    <div class="finder-duty-notice">
      <p>
        <strong>About "Ships EU" and "Ships worldwide".</strong>
        Most retailers ship duty-paid only within their <strong>own country</strong>.
        Cross-border tobacco shipments are subject to <strong>destination-country
        excise duty + VAT</strong>, which the retailer's listed price does not include:
      </p>
      <ul>
        <li><strong>🇸🇪 Sweden, 🇩🇰 Denmark, 🇫🇮 Finland, 🇮🇪 Ireland:</strong> Customs intercepts cross-border tobacco mail orders and levies the destination country's tobacco tax. On a box of 25 Cuban premiums this typically adds <strong>€100–€300</strong>.</li>
        <li><strong>🇬🇧 UK (post-Brexit):</strong> Every EU→UK tobacco shipment faces UK Tobacco Products Duty (~£5.31/kg + 16.5% ad valorem on cigars) + UK VAT (20%). A €765 box typically becomes <strong>£1,250–1,400 delivered</strong>.</li>
        <li><strong>🇨🇭 Switzerland → EU and EU → Switzerland:</strong> Outside the EU customs union — destination duty + VAT applies in both directions.</li>
      </ul>
      <p>
        Always verify the <strong>total delivered cost</strong> on the retailer's checkout page before buying.
        Domestic orders (German buyer → German shop, Swiss → Swiss, etc.) face <strong>no additional duty</strong>
        because the listed price already includes the local tobacco excise.
      </p>
    </div>
  </section>

  {/* ─── EDITORIAL — tasting notes, history, why compare ───────────────── */}
  <section class="container-narrow pb-16 reveal">
    <article class="sku-editorial">
      <p class="lounge-label">About this cigar</p>
      <h2 class="sku-editorial__title">{sku.brand} {sku.vitola} — tasting notes and pricing context</h2>
      {sku.editorial.split("\n\n").map((para) => (
        <p>{para}</p>
      ))}

      <hr />

      <div class="sku-editorial__crosslinks">
        <h3>Compare other {sku.brand} vitolas</h3>
        <ul>
          {SKUS.filter((s) => s.brand === sku.brand && s.id !== sku.id).map((s) => (
            <li><a href={`/finder/sku/${s.slug}/`}>{s.brand} {s.vitola}</a> — {s.shape}, ring {s.ring}</li>
          ))}
        </ul>
        <h3>Or explore by country</h3>
        <ul>
          {Array.from(new Set(offers.map((o) => o.country.code))).map((cc) => {
            const c = COUNTRY_BY_CODE[cc];
            return <li><a href={`/finder/${c.code}/`}>{c.flag} {c.name}</a> — cheapest Cuban cigars</li>;
          })}
        </ul>
      </div>
    </article>
  </section>

  {/* ─── WATCHLIST CTA — wedge feature ─────────────────────────────────── */}
  <section class="section-dark">
    <div class="container-narrow py-16 reveal" style="text-align: center;">
      <p class="lounge-label lounge-label--gold">Save this cigar</p>
      <h2 class="sku-cta__title">
        Want an alert when {sku.brand} {sku.vitola} drops below your number?
      </h2>
      <p class="sku-cta__lead">
        Save this SKU to your watchlist and we'll email you the moment any retailer in your country drops below your threshold.
        Free TNC members get one alert. <a href="/lounge/" style="color:var(--color-gold);text-decoration:underline;">Lounge members</a> get unlimited alerts, push notifications, and a daily deal digest.
      </p>
      <div class="sku-cta__actions">
        <a href="/subscribe/" class="lbtn lbtn-primary lbtn-lg">Save with a free account →</a>
        <a href="/lounge/" class="lbtn lbtn-secondary lbtn-lg">Join The Lounge · $89/yr</a>
      </div>
    </div>
  </section>

  <Newsletter
    heading="Be first when price-drop alerts go live"
    blurb="One email when the watchlist opens. No promotions."
  />
  <PriceAlertModal />

  {/* ──────────────────────────────────────────────────────────────────────
       LIVE PRICE HYDRATION
       ----------------------------------------------------------------------
       Astro renders this page statically at build time using the manual
       PRICE_SNAPSHOTS in src/data/finder-data.ts. After hydration we query
       finder_latest_snapshots_v on Supabase and overlay live scraper data
       on top of any retailer-row whose retailer_id matches a live row.

       For each matched row we:
         - replace box price, EUR conversion, per-cigar, in-stock cells
         - update the retailer's Shop link to the live source_url
         - add a "● LIVE" badge so the user can tell live from static
         - move the "Best value" badge if a cheaper retailer emerges
         - replace the verification footer timestamp

       Rows for retailers we don't yet scrape are left untouched (they
       continue to render the manual May-2026 research).
  ──────────────────────────────────────────────────────────────────────── */}
  <script>
    import { getSupabase } from "../../../lib/supabase";
    import { SKUS, RETAILER_BY_ID, COUNTRY_BY_CODE, formatPrice, toEUR } from "../../../data/finder-data";

    type SnapshotRow = {
      id: string;
      sku: string;
      retailer_id: string;
      pack_size: number;
      price: number;
      currency: string;
      price_eur: number;
      price_per_cigar_eur: number;
      in_stock: boolean;
      source_url: string;
      country_code: string;
      scraped_at: string;
    };

    function relativeTime(iso: string): string {
      const t = new Date(iso).getTime();
      const diff = Date.now() - t;
      const min = Math.floor(diff / 60000);
      if (min < 1)   return "just now";
      if (min < 60)  return `${min} min ago`;
      const hr = Math.floor(min / 60);
      if (hr  < 24)  return `${hr} hr${hr === 1 ? "" : "s"} ago`;
      const d  = Math.floor(hr / 24);
      return `${d} day${d === 1 ? "" : "s"} ago`;
    }

    async function hydrateLivePrices() {
      const hero = document.querySelector<HTMLElement>(".sku-hero[data-finder-sku]");
      if (!hero) return;
      const skuId    = hero.dataset.finderSku!;
      const boxSize  = parseInt(hero.dataset.finderBoxSize || "25", 10);
      const sku      = SKUS.find((s) => s.id === skuId);
      if (!sku) return;

      let data: SnapshotRow[] | null = null;
      try {
        const supabase = getSupabase();
        const { data: rows, error } = await supabase
          .from("finder_latest_snapshots_v")
          .select("*")
          .eq("sku", skuId);
        if (error) throw error;
        data = rows as SnapshotRow[] | null;
      } catch (e) {
        console.warn("[finder] live hydration failed:", e);
        return;
      }
      if (!data || data.length === 0) return;

      // For each retailer, pick the best pack to display. Priority:
      //   1. canonical box-size AND in stock     ← perfect match
      //   2. any pack that is in stock            ← can actually buy today
      //   3. canonical box-size (OOS)             ← can't buy, but right pack to compare
      //   4. anything                             ← last resort
      // In-stock outranks canonical-but-OOS so the "buy now" link is real.
      // The per-cigar column already normalizes for cross-pack comparison.
      const scoreRow = (r: SnapshotRow): number => {
        const isCanonical = r.pack_size === boxSize;
        const inStock = r.in_stock;
        if (isCanonical && inStock) return 4;
        if (inStock) return 3;
        if (isCanonical) return 2;
        return 1;
      };
      const byRetailer = new Map<string, SnapshotRow>();
      for (const row of data) {
        const existing = byRetailer.get(row.retailer_id);
        if (!existing || scoreRow(row) > scoreRow(existing)) {
          byRetailer.set(row.retailer_id, row);
        }
      }

      let newestScrapeAt = "";
      const updatedRetailers: string[] = [];

      // Helper — build a new <tr> from scratch when a live retailer isn't
      // already pre-rendered in the static table. Mirrors the Astro template
      // exactly so subsequent style + querySelector hooks all match.
      function buildRetailerRow(retailerId: string, row: SnapshotRow): HTMLTableRowElement | null {
        const retailer = RETAILER_BY_ID[retailerId];
        if (!retailer) return null;
        const country = COUNTRY_BY_CODE[retailer.country] || { name: retailer.country.toUpperCase(), flag: "" };
        const tr = document.createElement("tr");
        tr.dataset.retailerId = retailerId;
        const shipsLabel = retailer.shipsTo === "domestic" ? "domestic" : retailer.shipsTo === "eu" ? "EU" : "worldwide";
        const statusBadge = retailer.status === "lcdh" ? '<span class="finder-badge finder-badge--gold">LCDH</span>' : "";
        tr.innerHTML = `
          <td data-cell="retailer">
            <span class="finder-table__retailer">${retailer.name}</span>
            ${statusBadge}
          </td>
          <td>${country.flag} ${country.name}</td>
          <td><span class="finder-ships">Ships ${shipsLabel}</span></td>
          <td class="finder-table__num finder-table__price" data-cell="price"></td>
          <td class="finder-table__num" data-cell="eur"></td>
          <td class="finder-table__num" data-cell="per-cigar"></td>
          <td data-cell="stock"></td>
          <td class="finder-table__cta">
            <a href="#" class="finder-table__compare" target="_blank" rel="noopener noreferrer sponsored" data-cell="shop">Shop →</a>
          </td>
        `;
        return tr;
      }

      const tbody = document.querySelector<HTMLTableSectionElement>(".finder-table tbody");

      for (const [retailerId, row] of byRetailer.entries()) {
        let tr = document.querySelector<HTMLTableRowElement>(
          `tr[data-retailer-id="${retailerId}"]`
        );
        // If this live retailer has no static row, inject one. Lets us add
        // a new scraper (e.g. de-cigarmaxx) without touching the SKU template.
        if (!tr && tbody) {
          const newRow = buildRetailerRow(retailerId, row);
          if (newRow) {
            tbody.appendChild(newRow);
            tr = newRow;
          }
        }
        if (!tr) continue;

        // Update visual stock state. Drop the 'is-unverified' class as soon
        // as we have a live data point — the row is no longer historical.
        tr.classList.remove("is-unverified");
        tr.classList.toggle("is-oos", !row.in_stock);

        const r = RETAILER_BY_ID[retailerId];
        const currency = (r ? row.currency : row.currency) as any;

        // Box price (native currency). If the retailer only carries a
        // non-canonical pack size, append "(N-pack)" so users aren't misled
        // into thinking €238 = a full box of 25.
        const priceCell = tr.querySelector<HTMLElement>('[data-cell="price"]');
        if (priceCell) {
          let priceText = formatPrice(row.price, currency);
          if (row.pack_size !== boxSize) {
            priceText += ` <span class="finder-pack-note">(${row.pack_size}-pack)</span>`;
          }
          priceCell.innerHTML = priceText;
        }
        // EUR-normalized. Same annotation rule applies for clarity.
        const eurCell = tr.querySelector<HTMLElement>('[data-cell="eur"]');
        if (eurCell) {
          let eurText = `€${Math.round(row.price_eur).toLocaleString("en-US")}`;
          if (row.pack_size !== boxSize) {
            eurText += ` <span class="finder-pack-note">(${row.pack_size}-pack)</span>`;
          }
          eurCell.innerHTML = eurText;
        }
        // Per-cigar (from generated column — always consistent)
        const perCigarCell = tr.querySelector<HTMLElement>('[data-cell="per-cigar"]');
        if (perCigarCell) {
          perCigarCell.textContent = `€${row.price_per_cigar_eur.toFixed(2)}`;
        }
        // In-stock pill
        const stockCell = tr.querySelector<HTMLElement>('[data-cell="stock"]');
        if (stockCell) {
          stockCell.innerHTML = row.in_stock
            ? '<span class="finder-stock finder-stock--yes">In stock</span>'
            : '<span class="finder-stock finder-stock--no">Out of stock</span>';
        }
        // Shop link → live source_url (scraper always sends exact PDP URLs,
        // so we restore the "Shop →" label + drop the search-fallback class).
        const shopLink = tr.querySelector<HTMLAnchorElement>('[data-cell="shop"]');
        if (shopLink) {
          shopLink.href = row.source_url;
          shopLink.textContent = "Shop →";
          shopLink.classList.remove("finder-table__compare--search");
          shopLink.title = "Opens the retailer's product page in a new tab";
        }

        // Live badge on retailer cell (only add once)
        const retailerCell = tr.querySelector<HTMLElement>('[data-cell="retailer"]');
        if (retailerCell && !retailerCell.querySelector(".finder-badge--live")) {
          const badge = document.createElement("span");
          badge.className = "finder-badge finder-badge--live";
          badge.title = `Live scrape — refreshed ${relativeTime(row.scraped_at)}`;
          badge.textContent = "● LIVE";
          retailerCell.appendChild(badge);
        }

        updatedRetailers.push(retailerId);
        if (!newestScrapeAt || row.scraped_at > newestScrapeAt) {
          newestScrapeAt = row.scraped_at;
        }
      }

      // Re-evaluate "Best value" — only consider rows that are BOTH live-scraped
      // AND confirmed in-stock. Static (unverified) rows are excluded entirely
      // because we don't know if the retailer actually carries the SKU.
      const inStockRows = Array.from(
        document.querySelectorAll<HTMLTableRowElement>("tr[data-retailer-id]")
      ).filter((tr) =>
        !tr.classList.contains("is-oos") &&
        !tr.classList.contains("is-unverified")
      );
      if (inStockRows.length > 0) {
        const ranked = inStockRows
          .map((tr) => {
            const perCigarTxt = tr.querySelector('[data-cell="per-cigar"]')?.textContent || "";
            const v = parseFloat(perCigarTxt.replace(/[^0-9.]/g, ""));
            return { tr, perCigar: Number.isFinite(v) ? v : Infinity };
          })
          .sort((a, b) => a.perCigar - b.perCigar);

        // Remove existing best-value badges
        document.querySelectorAll("[data-best-value-badge]").forEach((b) => b.remove());

        // Add to cheapest row
        const winner = ranked[0]?.tr.querySelector<HTMLElement>('[data-cell="retailer"]');
        if (winner) {
          const badge = document.createElement("span");
          badge.className = "finder-badge finder-badge--accent";
          badge.setAttribute("data-best-value-badge", "");
          badge.textContent = "Best value";
          winner.appendChild(badge);
        }
      }

      // Replace verification footer with live timestamp
      if (newestScrapeAt) {
        const footer = document.querySelector<HTMLElement>("[data-verification]");
        if (footer) {
          const when = relativeTime(newestScrapeAt);
          footer.innerHTML =
            `Live prices refreshed <strong>${when}</strong> via direct retailer scraping ` +
            `(${updatedRetailers.length} retailer${updatedRetailers.length === 1 ? "" : "s"} live). ` +
            `Other rows are manual research from <strong>15 May 2026</strong>. ` +
            `Tap any retailer name to verify the price on their site before purchasing.`;
        }
      }
    }

    // Hydrate after DOM is ready
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", hydrateLivePrices);
    } else {
      hydrateLivePrices();
    }
  </script>
</BaseLayout>

