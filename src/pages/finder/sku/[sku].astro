---
import PaperLayout from "../../../layouts/PaperLayout.astro";
import PriceAlertModal from "../../../components/finder/PriceAlertModal.astro";
import SaveAlertButton from "../../../components/finder/SaveAlertButton.astro";
import {
  SKUS, RETAILER_BY_ID, COUNTRY_BY_CODE, snapshotsForSku, formatPrice, toEUR,
  effectiveShopUrl, dutyPaidCountries, checkedLabel, historyForSku,
} from "../../../data/finder-live";
import { buildSkuFaq } from "../../../lib/finder/skuFaq.ts";
import { COUNTRIES, FX_TO_EUR, isStale, STALE_DAYS } from "../../../data/finder-live";
import { DUTY_RATES } from "../../../data/duty-rates";

/**
 * /finder/sku/[sku]/
 *
 * The stock-table page for one vitola: every retailer we track, the cheapest
 * in-stock box, a 90-day line of the cheapest price in Europe (from the
 * scraper's own history — omitted until there is one), the editorial, and the
 * questions people actually ask. Every number carries its date.
 */

export async function getStaticPaths() {
  return SKUS.map((sku) => ({ params: { sku: sku.slug } }));
}
const { sku: skuSlug } = Astro.params as { sku: string };
const sku = SKUS.find((s) => s.slug === skuSlug);
if (!sku) return Astro.redirect("/finder/");

const offers = snapshotsForSku(sku.id)
  .map((snap) => {
    const retailer = RETAILER_BY_ID[snap.retailerId];
    if (!retailer) return null;
    const country = COUNTRY_BY_CODE[retailer.country];
    const eur = toEUR(snap.price, snap.currency);
    return { snap, retailer, country, eur, per: eur / sku.boxSize, link: effectiveShopUrl(snap.sourceUrl, sku, retailer) };
  })
  .filter((o): o is NonNullable<typeof o> => !!o)
  // Fresh in-stock rows first, then stale in-stock rows, then sold out; by
  // price inside each group. A May row belongs at the bottom, not the top.
  .sort((a, b) => {
    const ga = a.snap.inStock ? (isStale(a.snap) ? 1 : 0) : 2, gb = b.snap.inStock ? (isStale(b.snap) ? 1 : 0) : 2;
    return ga !== gb ? ga - gb : a.eur - b.eur;
  });

const inStock = offers.filter((o) => o.snap.inStock);
// The headline price must be one we read recently. A May row can sit in the
// table with its date on it, but it is not "cheapest in stock" in September.
// Rule (15 Sep): a price older than STALE_DAYS never headlines the page and
// never gets a Buy button. If nothing fresh is in stock we say so and show
// the last price we saw, greyed, with its date.
const best = inStock.find((o) => !isStale(o.snap));
const lastSeen = best ? null : inStock[0] ?? null;
const minEur = inStock[0]?.eur ?? 0;
const maxEur = inStock.at(-1)?.eur ?? 0;
const spread = minEur && maxEur ? Math.round(((maxEur - minEur) / minEur) * 100) : 0;
const countries = [...new Set(offers.map((o) => o.country.code))];
const liveCount = offers.filter((o) => o.snap.live).length;

// 90-day history → SVG line, built at build time.
const hist = historyForSku(sku.id);
let chart: { path: string; area: string; lo: number; hi: number; last: number; first: string; lastDay: string; ticks: { x: number; label: string }[]; dot: { x: number; y: number } } | null = null;
if (hist.length >= 3) {
  const W = 600, H = 150, PL = 44, PR = 10, PT = 10, PB = 22;
  const lo = Math.min(...hist.map((h) => h.eur)), hi = Math.max(...hist.map((h) => h.eur));
  const t0 = Date.parse(hist[0].day), t1 = Date.parse(hist.at(-1)!.day) || t0 + 1;
  const x = (d: string) => PL + ((Date.parse(d) - t0) / Math.max(1, t1 - t0)) * (W - PL - PR);
  const y = (v: number) => PT + (hi === lo ? 0.5 : (hi - v) / (hi - lo)) * (H - PT - PB);
  const pts = hist.map((h) => `${x(h.day).toFixed(1)},${y(h.eur).toFixed(1)}`);
  const path = "M" + pts.join(" L");
  const area = `${path} L${x(hist.at(-1)!.day).toFixed(1)},${H - PB} L${PL},${H - PB} Z`;
  const ticks = [0, 0.5, 1].map((f) => {
    const t = t0 + f * (t1 - t0);
    return { x: PL + f * (W - PL - PR), label: new Date(t).toLocaleDateString("en-GB", { day: "numeric", month: "short" }) };
  });
  chart = { path, area, lo, hi, last: hist.at(-1)!.eur, first: hist[0].day, lastDay: hist.at(-1)!.day, ticks, dot: { x: x(hist.at(-1)!.day), y: y(hist.at(-1)!.eur) } };
}

const siblings = SKUS.filter((s) => s.brand === sku.brand && s.id !== sku.id).slice(0, 5);
const faq = buildSkuFaq({ sku, best: best ? { snap: best.snap, retailer: best.retailer, country: best.country, eur: best.eur, perCigarEur: best.per } as any : undefined, offersCount: offers.length, sameBrandSkus: siblings.slice(0, 4) });
// Landed-cost picker: everything the browser needs, nothing it doesn't.
const landedData = {
  sku: { boxSize: sku.boxSize, ring: sku.ring, lengthMm: sku.lengthMm },
  fx: FX_TO_EUR,
  offers: offers.map((o, idx) => ({ idx, price: o.snap.price, currency: o.snap.currency, from: o.country.code, inStock: o.snap.inStock, retailer: o.retailer.name })),
  names: Object.fromEntries(COUNTRIES.map((c) => [c.code, c.name])),
};
const destinations = COUNTRIES.filter((c) => DUTY_RATES[c.code]).sort((a, b) => a.name.localeCompare(b.name));
const fmtDay = (d: string) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short" });

const url = `https://thenextcigar.com/finder/sku/${sku.slug}/`;
const graph: any[] = [
  // Was "Product" with an AggregateOffer. Dropped 12 September 2026, for the
  // same reason as the Finder list pages: Google requires an "image" on any
  // Product, no photograph of these cigars exists anywhere in finder-data.ts,
  // and we will not invent one or hotlink a retailer's. Every one of these 52
  // was invalid, so nothing was being earned from them to lose.
  //
  // "ItemPage" with a "mainEntity" describes what this page honestly is: an
  // editorial page ABOUT a cigar sold by other people, not a listing of a
  // product we sell. The FAQ and breadcrumb blocks below are the parts that
  // actually earn rich results, and they are untouched.
  //
  // The way back, if you ever want it, is photographs: add an image field to
  // Sku, fill it for the ones you have shot yourself, and restore "@type":
  // "Product" for those only.
  {
    "@type": "ItemPage",
    name: `${sku.brand} ${sku.vitola} — box price compared across Europe`,
    url,
    mainEntity: {
    "@type": "Thing",
    name: `${sku.brand} ${sku.vitola}`,
    description: sku.blurb,
    additionalProperty: [
      { "@type": "PropertyValue", name: "Vitola", value: sku.shape },
      { "@type": "PropertyValue", name: "Ring gauge", value: String(sku.ring) },
      { "@type": "PropertyValue", name: "Length", value: `${sku.lengthMm} mm` },
      { "@type": "PropertyValue", name: "Box size", value: String(sku.boxSize) },
      { "@type": "PropertyValue", name: "Brand", value: sku.brand },
    ],
    },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Markets", item: "https://thenextcigar.com/finder/" },
      { "@type": "ListItem", position: 2, name: `${sku.brand} ${sku.vitola}`, item: url },
    ],
  },
];
if (faq.length >= 2) graph.push({ "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") } })) });
const jsonLd = { "@context": "https://schema.org", "@graph": graph };

const title = `${sku.brand} ${sku.vitola} — box price compared across Europe · The Next Cigar`;
const description = best
  ? `${sku.brand} ${sku.vitola}, box of ${sku.boxSize}: ${offers.length} European retailers compared, cheapest ${formatPrice(best.snap.price, best.snap.currency)} at ${best.retailer.name} (${checkedLabel(best.snap)}). Free price alerts.`
  : `${sku.brand} ${sku.vitola}, box of ${sku.boxSize}: European retailers compared, with the date each price was read.`;
---

<PaperLayout title={title} description={description} section="markets" compact={true} jsonLd={jsonLd}>
  <p class="miga" style="padding-bottom:0;margin-bottom:-14px">Markets · <a href="/finder/">the board</a> · {sku.brand}</p>
  <div class="dateline">
    <h1>{sku.brand} {sku.vitola} <em>— box of {sku.boxSize}, compared.</em></h1>
    <p class="st">
      {offers.length} retailers in {countries.length} countries · {inStock.length} in stock
      {spread > 0 && <> · <b>{spread}% spread</b> between cheapest and dearest</>}
      {liveCount > 0 && <> · <b style="color:var(--live)">{liveCount} live</b></>}
    </p>
  </div>

  <div class="front">
    <!-- LEFT: the file + the quote -->
    <aside>
      {best ? (
        <div class="quote">
          <p class="t">Cheapest in stock</p>
          <p class="big">{formatPrice(best.snap.price, best.snap.currency)}</p>
          <p class="sub">≈ €{Math.round(best.eur).toLocaleString("en-GB")} · €{best.per.toFixed(2)} per cigar</p>
          <p class="sub" style="margin-top:6px">at <b style="color:var(--ink)">{best.retailer.name}</b>, {best.country.name} · {checkedLabel(best.snap)}</p>
          <a class="cta" href={best.link.url} target="_blank" rel="noopener nofollow sponsored">{best.link.isExact ? `Buy at ${best.retailer.name}` : `Search ${best.retailer.name}`} →</a>
          <SaveAlertButton sku={sku.slug} productName={`${sku.brand} ${sku.vitola}`} baselineEur={Math.round(best.eur)} baselineLabel={`€${Math.round(best.eur).toLocaleString("en-GB")}`} variant="ghost" />
          <p class="note" style="margin-top:10px">Clicking through may earn us a commission. Your price is unchanged. Stock is as the retailer reported it when we last read the page; if it was sold out when you got there, <a href={`mailto:contact@thenextcigar.com?subject=${encodeURIComponent(`Sold out: ${sku.brand} ${sku.vitola} at ${best.retailer.name}`)}`}>tell us</a> and we re-read it.</p>
        </div>
      ) : lastSeen ? (
        <div class="quote">
          <p class="t" style="color:var(--mute)">No live in-stock price</p>
          <p class="sub">None of the retailers we re-read has this box in stock this fortnight. The last price we saw was <b style="color:var(--ink)">{formatPrice(lastSeen.snap.price, lastSeen.snap.currency)}</b> at {lastSeen.retailer.name}, {lastSeen.country.name} — {checkedLabel(lastSeen.snap)}. Treat it as history, not a quote.</p>
          <SaveAlertButton sku={sku.slug} productName={`${sku.brand} ${sku.vitola}`} baselineEur={Math.round(lastSeen.eur)} baselineLabel={`€${Math.round(lastSeen.eur).toLocaleString("en-GB")}`} variant="ghost" />
        </div>
      ) : (
        <div class="quote"><p class="t">No in-stock listing</p><p class="sub">Every retailer we track is sold out. Save an alert and we'll email when one comes back.</p><SaveAlertButton sku={sku.slug} productName={`${sku.brand} ${sku.vitola}`} variant="ghost" /></div>
      )}

      <div class="rulehead"><h2>The file</h2></div>
      <dl class="file">
        <dt>Line</dt><dd>{sku.line}</dd>
        <dt>Shape</dt><dd>{sku.shape} · ring {sku.ring} · {sku.lengthMm} mm</dd>
        <dt>Canonical box</dt><dd>{sku.boxSize} cigars</dd>
        <dt>Strength</dt><dd style="text-transform:capitalize">{sku.strength.replace("_", " ")}</dd>
        {sku.flavorNotes?.length > 0 && <><dt>Notes</dt><dd style="font-size:14px">{sku.flavorNotes.join(", ")}</dd></>}
        <dt>Tier</dt><dd style="text-transform:capitalize">{sku.prestige}</dd>
      </dl>

      {siblings.length > 0 && (
        <>
          <div class="rulehead"><h2>Also by {sku.brand}</h2></div>
          <ul class="eds">
            {siblings.map((s) => (<li><a href={`/finder/sku/${s.slug}/`}>{s.vitola}</a><span>box of {s.boxSize}</span></li>))}
          </ul>
        </>
      )}
    </aside>

    <!-- CENTRE: the offers, the chart, the piece -->
    <section>
      <div class="rulehead"><h2>Every listing <em>· cheapest first</em></h2><span class="more">{offers.length} retailers</span></div>
      <p class="dest">
        <label for="dest">Delivered to</label>
        <select id="dest"><option value="">— choose your country —</option>{destinations.map((c) => <option value={c.code}>{c.name}</option>)}</select>
        <span class="hint" id="dest-hint">Pick a country to see what each box costs at your door.</span>
      </p>
      <table class="mk wide offers" id="offers">
        <thead><tr><th>Retailer</th><th class="num">Box</th><th class="num">Per cigar</th><th class="num door" hidden>At your door</th><th></th></tr></thead>
        <tbody>
          {offers.map((o) => (
            <tr class:list={{ oos: !o.snap.inStock, old: o.snap.inStock && isStale(o.snap) }}>
              <td class="v">
                {o.retailer.name} <span class="tag">{o.country.code.toUpperCase()}</span>
                {dutyPaidCountries(o.retailer).length > 1 && <span class="tag ok">duty paid EU</span>}
                <small>{o.retailer.status === "lcdh" ? "La Casa del Habano" : o.retailer.status === "habanos-specialist" ? "Habanos Specialist" : o.retailer.city ?? o.country.name} · {checkedLabel(o.snap)}{o.snap.inStock ? "" : " · sold out"}{o.snap.originalPrice && o.snap.originalPrice > o.snap.price ? ` · was ${formatPrice(o.snap.originalPrice, o.snap.currency)}` : ""}</small>
              </td>
              <td class="num p">{formatPrice(o.snap.price, o.snap.currency)}<small>≈ €{Math.round(o.eur)}</small></td>
              <td class="num p">€{o.per.toFixed(2)}</td>
              <td class="num p door" hidden data-idx={offers.indexOf(o)}></td>
              <td class="num"><a class="go" href={o.link.url} target="_blank" rel="noopener nofollow sponsored">{isStale(o.snap) ? "Check" : o.link.isExact ? "Buy" : "Search"} →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="note">Rows in grey were last read more than {STALE_DAYS} days ago: they are history, not quotes, and never count as the cheapest. Listed price for the box of {sku.boxSize} in the retailer's own currency, their own tax included. A box crossing a border picks up destination duty and VAT on top — the "duty paid EU" mark shows the few retailers whose price is all-in beyond their home market.</p>
      <div class="landed" id="landed" hidden>
        <div class="rulehead"><h2>At your door <em id="landed-title"></em></h2></div>
        <div class="landed-grid">
          <table class="bill" id="landed-bill"></table>
          <div class="prose" style="font-size:14px;max-width:none">
            <p id="landed-how"></p>
            <p id="landed-caveats" class="note" style="margin-top:8px"></p>
            <p class="note" id="landed-src"></p>
          </div>
        </div>
      </div>

      {chart && (
        <div class="spark">
          <div class="rulehead"><h2>Ninety days <em>· cheapest in-stock box in Europe, in euros</em></h2></div>
          <svg viewBox="0 0 600 150" role="img" aria-label={`Cheapest European price for ${sku.brand} ${sku.vitola}, ${fmtDay(chart.first)} to ${fmtDay(chart.lastDay)}: low €${Math.round(chart.lo)}, high €${Math.round(chart.hi)}, now €${Math.round(chart.last)}.`}>
            <line class="grid" x1="44" x2="590" y1="10" y2="10" /><line class="grid" x1="44" x2="590" y1="69" y2="69" /><line class="grid" x1="44" x2="590" y1="128" y2="128" />
            <text class="l" x="40" y="14" text-anchor="end">€{Math.round(chart.hi)}</text>
            <text class="l" x="40" y="132" text-anchor="end">€{Math.round(chart.lo)}</text>
            {chart.ticks.map((t, i) => (<text class="l" x={t.x} y="146" text-anchor={i === 0 ? "start" : i === 2 ? "end" : "middle"}>{t.label}</text>))}
            <path class="area" d={chart.area} /><path class="line" d={chart.path} />
            <circle class="dot" cx={chart.dot.x} cy={chart.dot.y} r="3.5" />
          </svg>
          <p class="spark-legend"><span>Now <b>€{Math.round(chart.last)}</b></span><span>90-day low <b>€{Math.round(chart.lo)}</b></span><span>90-day high <b>€{Math.round(chart.hi)}</b></span><span>{hist.length} readings</span></p>
        </div>
      )}

      <div class="rulehead"><h2>The piece</h2></div>
      <div class="prose cap" style="max-width:none">
        <p><b>{sku.blurb}</b></p>
        {sku.editorial.split(/\n\s*\n/).map((para) => <p>{para}</p>)}
      </div>

      {faq.length > 0 && (
        <>
          <div class="rulehead" style="margin-top:26px"><h2>Questions</h2></div>
          <ul class="faq">
            {faq.map((f) => (<li><h3>{f.q}</h3><div set:html={f.a} /></li>))}
          </ul>
        </>
      )}
    </section>

    <!-- RIGHT -->
    <aside class="rail">
      <div class="rulehead"><h2>Where it's cheapest</h2></div>
      <ul class="eds">
        {countries.map((c) => {
          const o = inStock.find((x) => x.country.code === c);
          return (<li><a href={`/finder/${c}/`}>{COUNTRY_BY_CODE[c].name}</a><span>{o ? `€${Math.round(o.eur)}` : "sold out"}</span></li>);
        })}
      </ul>
      <div class="box">
        <span class="kick">Watchlist · free</span>
        <h3 class="head">Tell me when it drops.</h3>
        <p>One email when this vitola falls below your price or comes back in stock. No charge, no newsletter unless you ask.</p>
        {best && <SaveAlertButton sku={sku.slug} productName={`${sku.brand} ${sku.vitola}`} baselineEur={Math.round(best.eur)} baselineLabel={`€${Math.round(best.eur).toLocaleString("en-GB")}`} variant="primary" />}
      </div>
      <div class="rulehead" style="margin-top:24px"><h2>Read next</h2></div>
      <ul class="list">
        <li><div><a class="head" href="/blog/cuban-cigar-import-duty-germany-switzerland-uk-explained-2026/">Import duty, explained</a><p class="by">What a cross-border box really costs</p></div></li>
        <li><div><a class="head" href="/blog/where-to-buy-cuban-cigars-in-europe-the-2026-retailer-map/">The European retailer map</a><p class="by">Who ships where</p></div></li>
      </ul>
    </aside>
  </div>
  <PriceAlertModal />
  <script type="application/json" id="landed-data" set:html={JSON.stringify(landedData)} />
  <script>
    import { landedCost } from "../../../lib/finder/landed";
    import { DUTY_RATES } from "../../../data/duty-rates";
    const data = JSON.parse(document.getElementById("landed-data")!.textContent || "{}");
    const sel = document.getElementById("dest") as HTMLSelectElement;
    const hint = document.getElementById("dest-hint")!;
    const eur = (n: number) => "€" + Math.round(n).toLocaleString("en-GB");
    function render(code: string) {
      const doorCells = document.querySelectorAll<HTMLElement>("#offers .door");
      const panel = document.getElementById("landed")!;
      if (!code || !(DUTY_RATES as any)[code]) {
        doorCells.forEach((c) => (c.hidden = true)); panel.hidden = true;
        hint.textContent = "Pick a country to see what each box costs at your door.";
        const tb = document.querySelector("#offers tbody")!;
        [...tb.querySelectorAll<HTMLTableRowElement>("tr")]
          .sort((a, b) => Number(a.querySelector("td.door")?.getAttribute("data-idx")) - Number(b.querySelector("td.door")?.getAttribute("data-idx")))
          .forEach((tr) => tb.appendChild(tr));
        return;
      }
      let best: any = null;
      const totals = new Map<number, number>();
      for (const o of data.offers) {
        const r = landedCost({ price: o.price, currency: o.currency, fromCountry: o.from, toCountry: code, boxSize: data.sku.boxSize, ring: data.sku.ring, lengthMm: data.sku.lengthMm, fx: data.fx });
        totals.set(o.idx, r.totalEur);
        const cell = document.querySelector<HTMLElement>(`#offers td.door[data-idx="${o.idx}"]`);
        if (cell) { cell.hidden = false; cell.innerHTML = `${eur(r.totalEur)}<small>${r.sameCountry ? "no extra tax" : "€" + r.perCigarEur.toFixed(2) + " per cigar"}</small>`; }
        if (o.inStock && (!best || r.totalEur < best.r.totalEur)) best = { o, r };
      }
      doorCells.forEach((c) => (c.hidden = false));
      // Re-rank the table by what you'd pay, in-stock first — the same rule
      // the board uses, so the two pages agree.
      const tbody = document.querySelector("#offers tbody")!;
      const trs = [...tbody.querySelectorAll<HTMLTableRowElement>("tr")];
      const idxOf = (tr: HTMLTableRowElement) => Number(tr.querySelector("td.door")?.getAttribute("data-idx") ?? -1);
      trs.sort((a, b) => {
        const ao = a.classList.contains("oos"), bo = b.classList.contains("oos");
        if (ao !== bo) return ao ? 1 : -1;
        return (totals.get(idxOf(a)) ?? Infinity) - (totals.get(idxOf(b)) ?? Infinity);
      });
      trs.forEach((tr) => tbody.appendChild(tr));
      hint.textContent = `Estimated for delivery to ${data.names[code]}. Ranked by what you'd pay at your door, in-stock first.`;
      if (!best) { panel.hidden = true; return; }
      const { o, r } = best;
      document.getElementById("landed-title")!.textContent = `· cheapest to ${data.names[code]}: ${o.retailer}`;
      const rows = [[`Listed price at ${o.retailer}${r.sameCountry ? "" : r.baseEur < o.price * data.fx[o.currency] - 0.5 ? " (minus their VAT — exports are zero-rated)" : ""}`, r.baseEur], ...r.lines.map((l: any) => [l.label, l.eur])];
      document.getElementById("landed-bill")!.innerHTML = rows.map(([k, v]) => `<tr><td>${k}</td><td>${eur(v as number)}</td></tr>`).join("") + `<tr class="tot"><td>At your door · box of ${data.sku.boxSize}</td><td>${eur(r.totalEur)}</td></tr><tr class="tot"><td>Per cigar</td><td>€${r.perCigarEur.toFixed(2)}</td></tr>`;
      document.getElementById("landed-how")!.textContent = r.sameCountry
        ? `A ${data.names[code]} retailer delivering inside ${data.names[code]}: duty and VAT are already in the price. Nothing is added at the door.`
        : `Estimate. Excise is worked out on ${r.gramsPerCigar} g per cigar (from the vitola's ring and length) and on the price paid; VAT is charged on price, duty and excise together. Border parcels are assessed by customs — this is what the law says they should charge, not a promise of what your carrier will do.`;
      document.getElementById("landed-caveats")!.textContent = r.caveats.join(" ");
      document.getElementById("landed-src")!.innerHTML = `Rates: <a href="${r.rate.source.url}" rel="noopener" target="_blank">${r.rate.source.title}</a>, in force from ${r.rate.effective}${r.rate.note ? " — " + r.rate.note : ""}. Checked 11 September 2026.`;
      panel.hidden = false;
    }
    sel.addEventListener("change", () => { render(sel.value); try { localStorage.setItem("tnc-dest", sel.value); } catch {} });
    try { const saved = localStorage.getItem("tnc-dest"); if (saved) { sel.value = saved; render(saved); } } catch {}
  </script>
</PaperLayout>
