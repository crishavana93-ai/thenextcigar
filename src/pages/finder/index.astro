---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/newspaper.css";
import CigarCursor from "../../components/newspaper/CigarCursor.astro";
import NewspaperMasthead from "../../components/newspaper/NewspaperMasthead.astro";
import SectionFlag from "../../components/newspaper/SectionFlag.astro";
import {
  COUNTRIES,
  SKUS,
  RETAILERS,
  PRICE_SNAPSHOTS,
  bestPriceForSku,
  formatPrice,
  toEUR,
} from "../../data/finder-data.ts";

/**
 * /finder/ — The Finder section in newspaper "Business & Markets" style.
 *
 * Layout: masthead + section flag + top-of-fold live price ticker + featured
 * "mover" story + country delta grid + full SKU listing + explainer sidebar.
 * All data live from finder-data.ts — no mockup content.
 */

// Top 5 SKUs by best EUR price (ascending)
const priced = SKUS
  .map((sku) => ({ sku, best: bestPriceForSku(sku.id) }))
  .filter((row): row is { sku: typeof SKUS[number]; best: NonNullable<ReturnType<typeof bestPriceForSku>> } => !!row.best);

const topMovers = priced
  .slice()
  .sort((a, b) => a.best.eur - b.best.eur)
  .slice(0, 5);

// Featured mover — biggest current price drop in the snapshots
const bestDrop = PRICE_SNAPSHOTS
  .filter((s) => s.originalPrice && s.inStock && s.originalPrice > s.price)
  .map((s) => {
    const sku = SKUS.find((k) => k.id === s.skuId);
    const retailer = RETAILERS.find((r) => r.id === s.retailerId);
    if (!sku || !retailer) return null;
    const pct = Math.round(((s.originalPrice! - s.price) / s.originalPrice!) * 100);
    return { snap: s, sku, retailer, pct };
  })
  .filter(Boolean)
  .sort((a, b) => (b!.pct) - (a!.pct))[0];

// All SKUs listed alphabetically by brand for the archive-style table
const allSkus = priced.slice().sort((a, b) => a.sku.brand.localeCompare(b.sku.brand));

// Country grid — every country grouped by retail status
const openCountries = COUNTRIES.filter((c) => c.status === "open");
const restrictedCountries = COUNTRIES.filter((c) => c.status === "restricted");

// Per-country cheapest listing count — a quick "what's live in each country" signal
const skusPerCountry: Record<string, number> = {};
for (const country of COUNTRIES) {
  skusPerCountry[country.code] = new Set(
    PRICE_SNAPSHOTS
      .filter((s) => {
        const r = RETAILERS.find((r) => r.id === s.retailerId);
        return r?.country === country.code && s.inStock;
      })
      .map((s) => s.skuId)
  ).size;
}

const lastUpdated = "6 min ago";

const masthead = {
  volume: "Vol. III",
  issue: `Issue ${new Date().getMonth() + 1 < 10 ? "0" + (new Date().getMonth() + 1) : new Date().getMonth() + 1}`,
  date: new Date().toLocaleDateString("en-GB", { month: "long", year: "numeric" }),
};

// Fmt helpers
function fmtBest(row: { sku: typeof SKUS[number]; best: NonNullable<ReturnType<typeof bestPriceForSku>> }) {
  return formatPrice(row.best.price, row.best.currency);
}
function fmtCountry(code: string) {
  const c = COUNTRIES.find((c) => c.code === code);
  return c?.name || code;
}
function fmtFlag(code: string) {
  const flags: Record<string, string> = {
    DE: "🇩🇪", FR: "🇫🇷", ES: "🇪🇸", IT: "🇮🇹", CH: "🇨🇭", GB: "🇬🇧",
    NL: "🇳🇱", BE: "🇧🇪", SE: "🇸🇪", DK: "🇩🇰", NO: "🇳🇴", FI: "🇫🇮",
    AT: "🇦🇹", PT: "🇵🇹", IE: "🇮🇪", LU: "🇱🇺", PL: "🇵🇱", CZ: "🇨🇿",
  };
  return flags[code] || "";
}
---

<BaseLayout
  title="The Finder — Live Cuban cigar prices across Europe · The Next Cigar"
  description={`${SKUS.length} Cuban cigar SKUs × ${RETAILERS.length} licensed retailers × ${COUNTRIES.length} countries. Prices live, updated every six hours. Free, no signup.`}
  bareChrome={true}
>
  <link
    is:inline
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <div class="tnc-cinema">
    <CigarCursor />

    <main class="site-body">
      <NewspaperMasthead
        volume={masthead.volume}
        issue={masthead.issue}
        date={masthead.date}
      />

      <SectionFlag
        number="/01"
        section="The Finder"
        title={`Business &amp; Markets<em> — Cuban cigars, live.</em>`}
        status={`${SKUS.length} SKUs · ${RETAILERS.length} retailers · ${COUNTRIES.length} countries · updated ${lastUpdated}`}
        live={true}
      />

      <section class="body-grid">

        <!-- MAIN COLUMN -->
        <div class="main-col">

          <div class="ticker-head">
            <h2>Today's <em>five cheapest.</em></h2>
            <span class="updated">Data · {PRICE_SNAPSHOTS.length.toLocaleString()} snapshots</span>
          </div>

          <table class="ticker">
            <thead>
              <tr>
                <th>Vitola</th>
                <th>Cheapest at</th>
                <th class="num">Price</th>
                <th class="num">Retailer</th>
              </tr>
            </thead>
            <tbody>
              {topMovers.map(({ sku, best }) => (
                <tr>
                  <td>
                    <a href={`/finder/sku/${sku.slug}/`} data-hover>
                      <span class="brand">{sku.brand}</span>
                      <span class="name">{sku.vitola}</span>
                    </a>
                  </td>
                  <td class="country">{fmtFlag(best.retailer.country)} {fmtCountry(best.retailer.country)}</td>
                  <td class="num">{fmtBest({ sku, best })}</td>
                  <td class="num">{best.retailer.name}</td>
                </tr>
              ))}
            </tbody>
          </table>

          {bestDrop && (
            <div class="mover">
              <div class="mover-photo" style={`background-image: url("${(bestDrop.sku as any).heroImage || '/og-finder.svg'}")`}></div>
              <div class="mover-copy">
                <div class="mover-flag">This week's mover</div>
                <h3>
                  {bestDrop.sku.brand} <em>{bestDrop.sku.vitola}.</em> {bestDrop.retailer.city || fmtCountry(bestDrop.retailer.country)} undercut the field by {bestDrop.pct}%.
                </h3>
                <p class="mover-stats">
                  Now <strong>{formatPrice(bestDrop.snap.price, bestDrop.snap.currency)}</strong>
                  — was {formatPrice(bestDrop.snap.originalPrice!, bestDrop.snap.currency)}
                  — at <strong>{bestDrop.retailer.name}</strong>.
                </p>
                <p>{bestDrop.sku.blurb}</p>
                <a href={`/finder/sku/${bestDrop.sku.slug}/`} class="mover-cta" data-hover>
                  Open this SKU <span class="arrow">→</span>
                </a>
              </div>
            </div>
          )}

          <div class="all-head">
            <h2>The full <em>catalogue.</em></h2>
            <span class="updated">{allSkus.length} vitolas · sorted by brand</span>
          </div>

          <table class="ticker">
            <thead>
              <tr>
                <th>Brand · Vitola</th>
                <th>Cheapest at</th>
                <th class="num">Best price</th>
                <th class="num">EUR eq.</th>
                <th class="num"></th>
              </tr>
            </thead>
            <tbody>
              {allSkus.map(({ sku, best }) => (
                <tr>
                  <td>
                    <a href={`/finder/sku/${sku.slug}/`} data-hover>
                      <span class="brand">{sku.brand}</span>
                      <span class="name">{sku.vitola}</span>
                    </a>
                  </td>
                  <td class="country">{fmtFlag(best.retailer.country)} {fmtCountry(best.retailer.country)}</td>
                  <td class="num">{formatPrice(best.price, best.currency)}</td>
                  <td class="num eur">€{Math.round(best.eur).toLocaleString()}</td>
                  <td class="num"><a href={`/finder/sku/${sku.slug}/`} data-hover class="row-cta">Compare →</a></td>
                </tr>
              ))}
            </tbody>
          </table>

        </div>

        <!-- SIDEBAR -->
        <aside class="sidebar">
          <div class="side-head">By country · retail status</div>
          <div class="country-grid">
            {openCountries.map((c) => (
              <a href={`/finder/${c.code.toLowerCase()}/`} class="country" data-hover>
                <div class="flag">{fmtFlag(c.code)} {c.code}</div>
                <div class="c-name">{c.name}</div>
                <div class="skus">{skusPerCountry[c.code] || 0} SKUs</div>
              </a>
            ))}
          </div>

          {restrictedCountries.length > 0 && (
            <>
              <div class="side-head restricted">Restricted markets</div>
              <div class="country-grid">
                {restrictedCountries.map((c) => (
                  <div class="country restricted-c">
                    <div class="flag">{fmtFlag(c.code)} {c.code}</div>
                    <div class="c-name">{c.name}</div>
                    <div class="skus">In-country only</div>
                  </div>
                ))}
              </div>
            </>
          )}

          <div class="side-explain">
            <h4>How <em>the Finder</em> works.</h4>
            <p><span class="drop">S</span>ix times a day, we scrape {RETAILERS.length} licensed Habanos retailers across {COUNTRIES.length} European countries. Real prices, real stock. Free to read, no signup — members get watchlist alerts on any vitola and a weekly market letter.</p>
            <a href="/subscribe/" class="side-cta" data-hover>Get price alerts →</a>
          </div>
        </aside>

      </section>

      <section class="footer-strip">
        <div class="footer-strip-inner">
          <div>
            <a href="/" class="footer-strip-mark" data-hover>The Next Cigar</a>
            <div class="footer-strip-tag">The Anthology of the Leaf &middot; Malmö · Lisbon</div>
          </div>
          <div class="footer-strip-links">
            <a href="/finder/" data-hover>Finder</a>
            <a href="/lounge/" data-hover>Lounge</a>
            <a href="/blog/" data-hover>Magazine</a>
            <a href="/shop/" data-hover>Shop</a>
            <a href="/about/" data-hover>About</a>
            <a href="/contact/" data-hover>Contact</a>
          </div>
        </div>
        <div class="footer-strip-copy">© 2025–2026 The Next Cigar · Cristian Ortiz Suárez</div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .site-body { padding-bottom: 40px; }

  /* Main + sidebar broadsheet split */
  .body-grid {
    max-width: 1520px; margin: 0 auto; padding: 40px 40px 64px;
    display: grid; grid-template-columns: 8fr 4fr; gap: 48px;
  }

  /* ── TICKER TABLE HEAD ── */
  .ticker-head, .all-head {
    display: flex; justify-content: space-between; align-items: end;
    margin-bottom: 20px; flex-wrap: wrap; gap: 16px;
  }
  .all-head { margin-top: 56px; padding-top: 32px; border-top: 4px double var(--news-ink); }
  .ticker-head h2, .all-head h2 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    line-height: 1.1; letter-spacing: -0.015em; margin: 0;
  }
  .ticker-head h2 :global(em), .all-head h2 :global(em) {
    font-style: italic; color: var(--news-oxblood); font-weight: 400;
  }
  .ticker-head .updated, .all-head .updated {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--news-ink-mute);
  }

  /* ── TICKER TABLE ── */
  .ticker {
    width: 100%; border-collapse: collapse;
    border-top: 2px solid var(--news-ink);
    border-bottom: 2px solid var(--news-ink);
    font-family: var(--news-serif); font-size: 14px;
  }
  .ticker thead th {
    font-family: var(--news-mono); font-weight: 500; font-size: 9px;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--news-ink);
    text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--news-ink);
    background: var(--news-paper-dark);
  }
  .ticker thead th.num { text-align: right; }
  .ticker tbody tr { border-bottom: 1px solid var(--news-rule); transition: background 0.2s; }
  .ticker tbody tr:hover { background: rgba(138, 43, 30, 0.06); }
  .ticker td { padding: 12px 8px; vertical-align: middle; }
  .ticker td.num { text-align: right; font-family: var(--news-mono); font-size: 13px; font-weight: 500; }
  .ticker td.num.eur { color: var(--news-oxblood); }
  .ticker td .brand {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--news-ink-mute); display: block; margin-bottom: 2px;
  }
  .ticker td .name {
    font-family: var(--news-serif); font-weight: 500; font-size: 15px; color: var(--news-ink);
  }
  .ticker .country { font-family: var(--news-mono); font-size: 12px; letter-spacing: 0.06em; }
  .row-cta {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.16em;
    color: var(--news-oxblood); text-transform: uppercase;
  }
  .row-cta:hover { color: var(--news-ember); }

  /* ── FEATURED MOVER ── */
  .mover {
    margin-top: 48px;
    display: grid; grid-template-columns: 5fr 7fr; gap: 32px; align-items: start;
    padding: 24px 0;
    border-top: 4px double var(--news-ink); border-bottom: 4px double var(--news-ink);
  }
  .mover-photo {
    aspect-ratio: 4 / 5;
    background-size: cover; background-position: center;
    background-color: var(--news-paper-dark);
    filter: grayscale(0.85) sepia(0.35) contrast(1.06);
  }
  .mover-flag {
    display: inline-block;
    font-family: var(--news-sans); font-weight: 700; font-size: 9px;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-oxblood); color: var(--news-paper); padding: 4px 10px;
    margin-bottom: 14px;
  }
  .mover-copy h3 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem); line-height: 1.1;
    letter-spacing: -0.018em; color: var(--news-ink); margin: 0 0 16px;
  }
  .mover-copy h3 em { font-style: italic; color: var(--news-oxblood); font-weight: 400; }
  .mover-copy .mover-stats {
    font-family: var(--news-serif); font-size: 15px; line-height: 1.55;
    color: var(--news-ink); margin: 0 0 12px;
    padding: 12px 0; border-top: 1px solid var(--news-rule); border-bottom: 1px solid var(--news-rule);
  }
  .mover-copy .mover-stats strong { font-weight: 600; color: var(--news-oxblood); }
  .mover-copy p {
    font-family: var(--news-serif); font-size: 15px; line-height: 1.6;
    color: var(--news-ink-soft); margin: 0 0 16px;
  }
  .mover-cta {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--news-sans); font-weight: 600; font-size: 12px;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--news-oxblood);
    border-bottom: 1px solid var(--news-oxblood); padding-bottom: 3px;
  }
  .mover-cta:hover { color: var(--news-ember); border-bottom-color: var(--news-ember); }

  /* ── SIDEBAR ── */
  .sidebar { position: sticky; top: 32px; align-self: start; }
  .side-head {
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--news-oxblood);
    padding-bottom: 8px; border-bottom: 1px solid var(--news-ink); margin-bottom: 16px;
  }
  .side-head.restricted { margin-top: 32px; color: var(--news-ink-mute); }
  .country-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
    background: var(--news-rule); padding: 1px;
  }
  .country {
    padding: 12px 10px; background: var(--news-paper-warm);
    transition: background 0.2s; display: block;
  }
  .country:hover { background: var(--news-paper-cream); }
  .country .flag {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.14em;
    color: var(--news-ink-mute); margin-bottom: 4px;
  }
  .country .c-name {
    font-family: var(--news-serif); font-weight: 500; font-size: 14px;
    color: var(--news-ink); letter-spacing: -0.01em; margin-bottom: 2px;
  }
  .country .skus {
    font-family: var(--news-mono); font-size: 10px; color: var(--news-oxblood);
    letter-spacing: 0.06em;
  }
  .country.restricted-c { opacity: 0.7; cursor: default; }
  .country.restricted-c .skus { color: var(--news-ink-mute); }

  .side-explain {
    margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--news-ink);
  }
  .side-explain h4 {
    font-family: var(--news-serif); font-weight: 500; font-size: 20px;
    line-height: 1.15; margin: 0 0 12px;
    color: var(--news-ink); letter-spacing: -0.012em;
  }
  .side-explain h4 em { font-style: italic; color: var(--news-oxblood); font-weight: 400; }
  .side-explain p {
    font-family: var(--news-serif); font-size: 14px; line-height: 1.55;
    color: var(--news-ink-soft); margin-bottom: 16px;
  }
  .side-explain .drop {
    font-family: var(--news-serif); font-weight: 600; font-size: 3em;
    line-height: 0.85; float: left; margin: 0.08em 5px 0 0; color: var(--news-oxblood);
  }
  .side-cta {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--news-sans); font-weight: 600; font-size: 12px;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--news-oxblood);
    border-bottom: 1px solid var(--news-oxblood); padding-bottom: 2px;
  }

  /* ── Footer strip ── */
  .footer-strip {
    max-width: 1520px; margin: 0 auto; padding: 40px 40px 24px;
  }
  .footer-strip-inner {
    display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center;
    padding-bottom: 20px; border-bottom: 1px solid var(--news-rule);
  }
  .footer-strip-mark {
    font-family: var(--news-serif); font-weight: 600; font-size: 22px;
    letter-spacing: -0.008em; color: var(--news-ink); display: block;
  }
  .footer-strip-tag {
    font-family: var(--news-serif); font-style: italic; font-size: 13px;
    color: var(--news-ink-mute); margin-top: 2px;
  }
  .footer-strip-links {
    display: flex; gap: 24px; flex-wrap: wrap;
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--news-ink-mute);
  }
  .footer-strip-links a { padding: 4px 0; border-bottom: 1px solid transparent; transition: all 0.2s; }
  .footer-strip-links a:hover { color: var(--news-oxblood); border-bottom-color: var(--news-oxblood); }
  .footer-strip-copy {
    margin-top: 16px;
    font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.16em;
    color: var(--news-ink-mute);
  }

  @media (max-width: 900px) {
    .body-grid { grid-template-columns: 1fr; gap: 32px; padding: 32px 20px; }
    .sidebar { position: relative; top: 0; }
    .country-grid { grid-template-columns: 1fr 1fr; }
    .mover { grid-template-columns: 1fr; gap: 20px; }
    .ticker { font-size: 13px; }
    .ticker td { padding: 10px 6px; }
    .footer-strip-inner { grid-template-columns: 1fr; gap: 20px; }
    .footer-strip { padding: 32px 20px 20px; }
  }
</style>
