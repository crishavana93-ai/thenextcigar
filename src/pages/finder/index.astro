  .finder-search__clear:hover { background: var(--color-bg-soft); }
  .finder-search.has-text .finder-search__clear { display: block; }
  .finder-search__country {
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
