---
import PaperLayout from "../../layouts/PaperLayout.astro";
import PriceAlertModal from "../../components/finder/PriceAlertModal.astro";
import {
  COUNTRIES, SKUS, RETAILERS, PRICE_SNAPSHOTS, LIVE_COUNT, NEWEST_SCRAPE,
  bestPriceForSku, formatPrice, toEUR, checkedLabel, effectiveShopUrl, NEW_LISTINGS, RETAILER_BY_ID,
  historyForSku, STALE_DAYS,
} from "../../data/finder-live";
import { FX_TO_EUR } from "../../data/finder-data";
import { DUTY_RATES } from "../../data/duty-rates";

/**
 * /finder/ — "Markets", the stock page of the paper.
 *
 * Every claim on this page is derived: the counts come from the data, each
 * price carries the date it was read, and only rows the scraper re-read
 * within 14 days are called live.
 */

const RET = Object.fromEntries(RETAILERS.map((r) => [r.id, r]));

const priced = SKUS
  .map((sku) => {
    const best = bestPriceForSku(sku.id);
    if (!best) return null;
    const retailer = RET[best.snap.retailerId];
    if (!retailer) return null;
    return { sku, snap: best.snap, retailer, eur: best.eur };
  })
  .filter((r): r is NonNullable<typeof r> => r !== null);

const cheapest = priced.slice().sort((a, b) => a.eur / a.sku.boxSize - b.eur / b.sku.boxSize).slice(0, 6);

// The mover: the biggest discount on the board among prices read within
// the fortnight. A May seed row can't be "this week's" anything, so a
// discount that is not live is not a mover; if nothing live is discounted
// the block simply doesn't render.
const mover = PRICE_SNAPSHOTS
  .filter((s) => s.live && s.originalPrice && s.inStock && s.originalPrice > s.price)
  .map((s) => {
    const sku = SKUS.find((k) => k.id === s.skuId);
    const retailer = RET[s.retailerId];
    if (!sku || !retailer) return null;
    return { snap: s, sku, retailer, pct: Math.round(((s.originalPrice! - s.price) / s.originalPrice!) * 100) };
  })
  .filter((m): m is NonNullable<typeof m> => m !== null)
  .sort((a, b) => b.pct - a.pct)[0];

// When no retailer is advertising a discount, the mover is the vitola whose
// cheapest live box has fallen most against its own 90-day median — a real
// movement in the market rather than a sticker a shop chose to print.
const fallen = !mover ? priced
  .filter((row) => row.snap.live && row.snap.inStock)
  .map((row) => {
    const h = historyForSku(row.sku.id).filter((x) => x.eur > 0);
    if (h.length < 14) return null;
    const eurs = h.map((x) => x.eur).sort((a, b) => a - b);
    const median = eurs[Math.floor(eurs.length / 2)];
    const pct = Math.round(((median - row.eur) / median) * 100);
    // A fall of 5%+ or a rise of 10%+ against the median; the rise is the
    // more common story on this board (the usual cheap source sells out).
    return pct >= 5 || pct <= -10 ? { ...row, pct, median, days: h.length } : null;
  })
  .filter((m): m is NonNullable<typeof m> => m !== null)
  .sort((a, b) => Math.abs(b.pct) - Math.abs(a.pct))[0] : undefined;

// ── Is this a good price right now? ────────────────────────────────────────
// PRICE_HISTORY holds 90 days of the cheapest daily EUR box price per SKU. A
// price list tells you what something costs; only history tells you whether
// that is a number to act on. Two signals, both derived, both silent unless
// they are true:
//   "90-day low"   — today's cheapest box is at or below the lowest we have
//                    recorded in the window (needs 14+ days of data to mean
//                    anything).
//   "above usual"  — today's cheapest is 10%+ over the 90-day median.
// Nothing is shown for rows in between, because "about normal" is noise.
type Signal = { kind: "low" | "high"; label: string; title: string } | null;
function priceSignal(skuId: string, nowEur: number): Signal {
  const h = historyForSku(skuId).filter((x) => x.eur > 0);
  if (h.length < 14) return null;
  const eurs = h.map((x) => x.eur).sort((a, b) => a - b);
  const min = eurs[0];
  const median = eurs[Math.floor(eurs.length / 2)];
  const days = h.length;
  if (nowEur <= min * 1.005) {
    return { kind: "low", label: `${days}-day low`, title: `Cheapest box price we have recorded in the last ${days} days.` };
  }
  // "above usual" — enabled 13 September, after being held back for a day on
  // a wrong diagnosis. I assumed a 44-day median of EUR 53 for a box of 25
  // Jose L. Piedra Brevas had to be pack-priced-as-box contamination. It is
  // not: Noblego and Cigarmaxx sold that box at EUR 53.35 for 250 days, then
  // went out of stock on 10 September, leaving EGM in Switzerland at EUR 120
  // as the cheapest available. "124% above usual" is exactly true, and it is
  // the most useful thing the board can say — the cheap source is gone and
  // you are about to pay double. The cleanup SQL correctly deleted nothing.
  //
  // The signal compares today's cheapest IN-STOCK box against the 90-day
  // median of the cheapest box each day, in-stock only, same pack size. A
  // high reading therefore usually means "the usual source is sold out",
  // which the tooltip now says.
  const HIGH_SIGNAL_ENABLED = true;
  if (HIGH_SIGNAL_ENABLED && median > 0 && nowEur >= median * 1.10) {
    const pct = Math.round(((nowEur - median) / median) * 100);
    return { kind: "high", label: `+${pct}% vs usual`, title: `Today's cheapest available box is ${pct}% above its ${days}-day median of €${median.toFixed(0)} — the usual cheapest source is most likely sold out.` };
  }
  return null;
}

// The full board, alphabetical by brand then vitola.
const board = priced.slice().sort((a, b) =>
  a.sku.brand.localeCompare(b.sku.brand) || a.sku.vitola.localeCompare(b.sku.vitola));
// Vitolas with no in-stock price younger than STALE_DAYS. They are not on the
// board — a May row is not a price — but they are not hidden either.
const unpriced = SKUS.filter((s) => !priced.some((r) => r.sku.id === s.id))
  .sort((a, b) => a.brand.localeCompare(b.brand) || a.vitola.localeCompare(b.vitola));
const brands = [...new Set(board.map((r) => r.sku.brand))];

const pricedRetailers = new Set(PRICE_SNAPSHOTS.map((s) => s.retailerId)).size;
const pricedCountries = new Set(PRICE_SNAPSHOTS.map((s) => RET[s.retailerId]?.country).filter(Boolean)).size;
const newest = NEWEST_SCRAPE ? new Date(NEWEST_SCRAPE).toLocaleDateString("en-GB", { day: "numeric", month: "short" }) : "";

const open = COUNTRIES.filter((c) => c.status === "open");
const restricted = COUNTRIES.filter((c) => c.status !== "open");
const skusIn = (code: string) => new Set(
  PRICE_SNAPSHOTS.filter((s) => RET[s.retailerId]?.country === code && s.inStock).map((s) => s.skuId)
).size;

const status = LIVE_COUNT > 0
  ? `${SKUS.length} vitolas · ${pricedRetailers} retailers with prices · ${RETAILERS.length} in the directory · <b>${LIVE_COUNT} live</b> · latest ${newest}`
  : `${SKUS.length} vitolas · ${pricedRetailers} retailers with prices · ${RETAILERS.length} in the directory · checked ${newest}`;

const newest20 = NEW_LISTINGS.slice(0, 12);
const fmtSeen = (d: string) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short" });
const releaseCountries = COUNTRIES.filter((c) => c.status === "open").sort((a, b) => a.name.localeCompare(b.name));

// ── Landed cost on the board ───────────────────────────────────────────────
// The board has always ranked by the retailer's sticker price, and the note in
// the rail has always admitted that is not what you pay: "a box crossing a
// border picks up destination duty and VAT." Saying so is not the same as
// fixing it. Cigars carry tobacco excise, which is most of the bill and which
// no general duty calculator models, so the cheapest listing is regularly not
// the cheapest box to actually receive.
//
// landedCost() already existed and was already correct — it was just only
// wired into the 52 SKU detail pages, not into the board that the traffic
// lands on. This ships the numbers the browser needs to re-rank the whole
// board against wherever the reader actually lives.
//
// Default stays sticker price. We do not know where anyone is, and guessing
// from an IP would make every number on the page a guess too.
const landedCountries = COUNTRIES
  .filter((c) => DUTY_RATES[c.code])
  .map((c) => ({ code: c.code, name: c.name, flag: c.flag }))
  .sort((a, b) => a.name.localeCompare(b.name));

const boardData = {
  fx: FX_TO_EUR,
  rows: board.map(({ sku, snap, retailer, eur }) => ({
    slug: sku.slug,
    stickerEachEur: eur / sku.boxSize,
    price: snap.price,
    currency: snap.currency,
    from: retailer.country,
    boxSize: sku.boxSize,
    ring: sku.ring,
    lengthMm: sku.lengthMm,
  })),
};

// The rows used to nest a full Product with an Offer inside every ListItem.
// That did two wrong things at once. It duplicated markup the SKU page already
// carries properly, and it declared 94 Cuban cigars as products of this domain
// — which we do not sell, and for which no photograph exists, so Google marked
// every one of them invalid for a missing "image". A list page's job in
// structured data is to name its items and point at them; the item pages carry
// the item markup. That is all this does now.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Cuban cigar box prices across Europe",
  numberOfItems: board.length,
  itemListElement: board.slice(0, 25).map((r, i) => ({
    "@type": "ListItem", position: i + 1,
    name: `${r.sku.brand} ${r.sku.vitola} — box of ${r.sku.boxSize}`,
    url: `https://thenextcigar.com/finder/sku/${r.sku.slug}/`,
  })),
};
---

<PaperLayout
  title="Markets — Cuban cigar box prices compared across Europe · The Next Cigar"
  image="/og-finder.jpg"
  description={`Box prices for ${SKUS.length} Cuban vitolas compared across ${pricedRetailers} European retailers in ${pricedCountries} countries. Every price carries the date it was read. Free, no signup.`}
  section="markets"
  compact={true}
  jsonLd={jsonLd}
>
  <div class="dateline">
    <h1>Markets <em>— Cuban cigars, compared.</em></h1>
    <p class="st" set:html={status} />
  </div>

  <div class="front">
    <!-- LEFT: cheapest per cigar -->
    <aside data-fold-wrap>
      <div class="rulehead"><h2>Cheapest <em>per cigar</em></h2></div>
      <table class="mk fold">
        <thead><tr><th>Vitola</th><th class="num">Per cigar</th></tr></thead>
        <tbody>
          {cheapest.map(({ sku, snap, retailer, eur }) => (
            <tr>
              <td class="v"><a href={`/finder/sku/${sku.slug}/`}>{sku.brand} {sku.vitola}</a><small>{retailer.name} · {String(retailer.country).toUpperCase()}</small></td>
              <td class="p">€{(eur / sku.boxSize).toFixed(0)}<small class:list={{ old: !snap.live }}>{checkedLabel(snap)}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="note fold">Per-cigar price is the box price divided by the canonical box size — the only honest way to compare a box of 10 against a box of 25.</p>

      <div class="rulehead fold" style="margin-top:26px"><h2>Where you can buy</h2></div>
      <ul class="eds fold">
        {open.map((c) => (<li><a href={`/finder/${c.code}/`}>{c.name}</a><span>{skusIn(c.code)} in stock</span></li>))}
      </ul>
      {restricted.length > 0 && (
        <>
          <p class="note fold" style="margin-top:14px"><b>Restricted markets.</b> {restricted.map((c) => c.name).join(", ")} — listed for reference; online sale to consumers is limited or in-country only.</p>
        </>
      )}
      <button class="fold-btn" type="button" data-fold>Cheapest per cigar, and where to buy ▾</button>
    </aside>

    <!-- CENTRE: the mover + the board -->
    <section class="board-first" data-fold-wrap>
      {mover && (
        <article style="padding-bottom:18px;border-bottom:1px solid var(--rule);margin-bottom:18px">
          <span class="kick">Box of the week</span>
          <h2 class="head" style="font-size:clamp(28px,3vw,42px);margin-top:8px">
            {mover.retailer.name} cut the {mover.sku.brand} {mover.sku.vitola} by {mover.pct}%.
          </h2>
          <p class="deck" style="margin-top:10px">
            {formatPrice(mover.snap.price, mover.snap.currency)} for the box of {mover.sku.boxSize}, down from {formatPrice(mover.snap.originalPrice!, mover.snap.currency)} — {checkedLabel(mover.snap)}. {mover.sku.blurb}
          </p>
          <p class="by" style="margin-top:8px">
            <a href={`/finder/sku/${mover.sku.slug}/`}>Compare every retailer for this vitola →</a>
          </p>
        </article>
      )}
      {!mover && fallen && (
        <article style="padding-bottom:18px;border-bottom:1px solid var(--rule);margin-bottom:18px">
          <span class="kick">Box of the week</span>
          <h2 class="head" style="font-size:clamp(28px,3vw,42px);margin-top:8px">
            {fallen.sku.brand} {fallen.sku.vitola} is {Math.abs(fallen.pct)}% {fallen.pct > 0 ? "under" : "over"} its usual price.
          </h2>
          <p class="deck" style="margin-top:10px">
            €{fallen.eur.toFixed(0)} for the box of {fallen.sku.boxSize} is the cheapest live listing, at {fallen.retailer.name}, against a {fallen.days}-day median of €{fallen.median.toFixed(0)} — {checkedLabel(fallen.snap)}.{fallen.pct < 0 ? " A rise on this board usually means the usual cheapest source has sold out." : ""} {fallen.sku.blurb}
          </p>
          <p class="by" style="margin-top:8px">
            <a href={`/finder/sku/${fallen.sku.slug}/`}>Compare every retailer for this vitola →</a>
          </p>
        </article>
      )}

      <div class="rulehead">
        <h2>The board <em id="board-sub">· {board.length} vitolas, cheapest listing</em></h2>
        <span class="more">{brands.length} brands</span>
      </div>

      <p class="firstvisit" id="firstvisit" hidden>
        <b>New here?</b> Pick where you live and the board re-prices every box to your door —
        duty, tobacco excise and VAT included. The cheapest listing is often not the cheapest box.
        <button type="button" class="firstvisit__x" id="firstvisit-x" aria-label="Dismiss">×</button>
      </p>
      <div class="landed-bar">
        <label for="board-ship">Ship it to</label>
        <select id="board-ship">
          <option value="">— nowhere yet, show listed prices —</option>
          {landedCountries.map((c) => <option value={c.code}>{c.flag} {c.name}</option>)}
        </select>
        <span class="landed-bar__hint" id="board-hint">Pick a country and the board re-ranks by what a box actually costs at your door — duty, tobacco excise and VAT included.</span>
      </div>

      <table class="mk wide" id="board-table">
        <thead>
          <tr><th>Vitola</th><th>Cheapest at</th><th class="num" id="th-box">Box</th><th class="num" id="th-each">Per cigar</th></tr>
        </thead>
        <tbody id="board-body">
          {board.map(({ sku, snap, retailer, eur }) => (
            <tr class:list={{ oos: !snap.inStock }} data-slug={sku.slug}>
              <td class="v">
                <a href={`/finder/sku/${sku.slug}/`}>{sku.brand} {sku.vitola}</a>
                {(() => { const sig = priceSignal(sku.id, eur); return sig ? <span class:list={["sig", sig.kind]} title={sig.title}>{sig.label}</span> : null; })()}
                <small>box of {sku.boxSize} · {sku.shape}</small>
                <button type="button" class="bell" data-save-alert data-sku={sku.slug} data-product-name={`${sku.brand} ${sku.vitola}`} data-baseline-eur={Math.round(eur)} data-baseline-label={`€${Math.round(eur).toLocaleString("en-GB")}`} title="Email me when this box drops" aria-label={`Price alert for ${sku.brand} ${sku.vitola}`}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10 21a2 2 0 0 0 4 0"/></svg>
                </button>
              </td>
              <td class="v" style="font-size:14px">
                <a href={effectiveShopUrl(snap.sourceUrl, sku, retailer).url} rel="nofollow noopener" target="_blank">{retailer.name}</a>
                <small>{String(retailer.country).toUpperCase()} · {checkedLabel(snap)}{snap.inStock ? "" : " · sold out"}</small>
              </td>
              <td class="num p" data-box data-sticker={formatPrice(snap.price, snap.currency)}>{formatPrice(snap.price, snap.currency)}</td>
              <td class="num p" data-each data-sticker={`€${(eur / sku.boxSize).toFixed(0)}`}>€{(eur / sku.boxSize).toFixed(0)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {board.length > 15 && <button class="fold-btn" type="button" data-fold>Show all {board.length} vitolas ▾</button>}
      {unpriced.length > 0 && (
        <p class="note" style="margin-top:14px"><b>Not priced this fortnight ({unpriced.length}):</b> {unpriced.map((s, i) => (<><a href={`/finder/sku/${s.slug}/`}>{s.brand} {s.vitola}</a>{i < unpriced.length - 1 ? ", " : ""}</>))}. No retailer we re-read has these in stock, and we don't headline a price older than {STALE_DAYS} days. Their pages keep the last price seen, dated.</p>
      )}
    </section>

    <!-- RIGHT: how it works -->
    <aside class="rail" data-fold-wrap>
      <div class="rulehead"><h2>How the board works</h2></div>
      <div class="prose fold" style="font-size:15px;max-width:none">
        <p>We keep a directory of {RETAILERS.length} licensed Habanos retailers across {COUNTRIES.length} European countries and record box prices from the {pricedRetailers} that publish them, in {pricedCountries} countries.</p>
        <p>Prices marked <b style="color:var(--live)">live</b> were re-read from the retailer's own product page by our scraper within the last fortnight. The rest carry the date a person last checked them. Stock and price move constantly, so confirm on the retailer's page before you order.</p>
        <p>Every price is the retailer's listed price for the canonical box, in their own currency, with their own tax included. It is not what you will pay at your door: a box crossing a border picks up destination duty and VAT.</p>
      </div>
      <div class="box fold">
        <span class="kick">Watchlist · free</span>
        <h3 class="head">Tell me when it drops.</h3>
        <p>Members get an email when any vitola on the board falls or comes back in stock. No charge.</p>
        <a class="cta" href="/lounge/signup/">Join the Lounge</a>
      </div>

      <div class="rulehead" style="margin-top:24px"><h2>Newly listed</h2></div>
      {newest20.length > 0 ? (
        <ul class="list">
          {newest20.map((n) => (<li><div><a class="head" style="font-size:17px" href={n.url} target="_blank" rel="noopener nofollow">{n.title}</a><p class="by">{RETAILER_BY_ID[n.retailerId]?.name ?? n.retailerId} · {n.country.toUpperCase()}{n.price ? ` · ${n.currency} ${n.price}` : ""} · seen {fmtSeen(n.firstSeen)}</p></div></li>))}
        </ul>
      ) : (
        <p class="note">Product pages that appear on a tracked retailer's Cuban listing show up here within six hours. Nothing new since the crawler started.</p>
      )}
      <div class="box" id="release">
        <span class="kick">Release watch · free</span>
        <h3 class="head">One email when something new is listed.</h3>
        <p>New size, restock or a fresh release — we say only what we saw: a product page that wasn't there before. Four crawls a day.</p>
        <form id="release-form" class="rw">
          <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" />
          <select name="country"><option value="">Every retailer we track</option>{releaseCountries.map((c) => <option value={c.code}>{c.name} only</option>)}</select>
          <button type="submit" class="cta">Watch new listings</button>
          <p class="note" id="release-status" aria-live="polite"></p>
        </form>
      </div>
      <script is:inline>
        (function(){var f=document.getElementById("release-form"),st=document.getElementById("release-status");if(!f)return;
        f.addEventListener("submit",async function(e){e.preventDefault();var b=f.querySelector("button");b.disabled=true;st.textContent="Saving…";
        try{var r=await fetch("/api/watchlist/release",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({email:f.email.value,country:f.country.value})});var d=await r.json();st.textContent=d.ok?d.message:(d.error||"That didn't work — try again.");if(d.ok)f.email.value="";}
        catch(_){st.textContent="Network error — try again.";}b.disabled=false;});})();
      </script>
      <div class="rulehead fold" style="margin-top:24px"><h2>Read next</h2></div>
      <ul class="list fold">
        <li><div><a class="head" href="/finder/index/">The Habanos Index</a><p class="by">What a Cuban cigar costs in Europe, day by day</p></div></li>
        <li><div><a class="head" href="/blog/where-to-buy-cuban-cigars-in-europe-the-2026-retailer-map/">The European retailer map</a><p class="by">Who ships where, and whose price is all-in</p></div></li>
        <li><div><a class="head" href="/blog/cuban-cigar-import-duty-germany-switzerland-uk-explained-2026/">Import duty, explained</a><p class="by">What a cross-border box really costs</p></div></li>
        <li><div><a class="head" href="/blog/cuban-cigar-sizes-vitolas-explained-2026-guide/">Vitolas explained</a><p class="by">Why a box of 10 and a box of 25 aren't comparable</p></div></li>
      </ul>
      <button class="fold-btn" type="button" data-fold>How the board works, and what to read next ▾</button>
    </aside>
  </div>

  <script type="application/json" id="board-data" set:html={JSON.stringify(boardData)} />
  <script>
    // Re-rank the board by what a box actually costs at the reader's door.
    //
    // landedCost() is the same pure function the SKU pages use, so the board
    // and the detail page can never disagree. Everything runs client-side from
    // a JSON payload: the page stays static, and nobody's location is sent
    // anywhere or guessed from an IP.
    import { landedCost } from "../../lib/finder/landed";

    const el = (id: string) => document.getElementById(id);
    const dataEl = el("board-data");
    const sel = el("board-ship") as HTMLSelectElement | null;
    const body = el("board-body");
    if (dataEl && sel && body) {
      const data = JSON.parse(dataEl.textContent || "{}");
      const byslug: Record<string, any> = {};
      for (const r of data.rows) byslug[r.slug] = r;

      const rows = Array.from(body.querySelectorAll("tr")) as HTMLTableRowElement[];
      // The board's default display is alphabetical. The comparison that
      // matters is against the order the STICKER PRICE would give, or else
      // every row "moves" and the hint becomes noise.
      const alphaOrder = rows.map((r) => r.dataset.slug || "");
      const stickerOrder = rows.slice()
        .sort((a, b) => (byslug[a.dataset.slug || ""]?.stickerEachEur ?? 1e9) - (byslug[b.dataset.slug || ""]?.stickerEachEur ?? 1e9))
        .map((r) => r.dataset.slug || "");

      function reset() {
        for (const tr of rows) {
          for (const key of ["box", "each"]) {
            const td = tr.querySelector(`[data-${key}]`) as HTMLElement | null;
            if (td) { td.textContent = td.dataset.sticker || ""; td.classList.remove("landed-val"); }
          }
          body!.appendChild(tr);
        }
        // Restore the original alphabetical order.
        const pos: Record<string, number> = {};
        alphaOrder.forEach((sl, i) => { pos[sl] = i; });
        rows.slice().sort((a, b) => pos[a.dataset.slug || ""] - pos[b.dataset.slug || ""])
            .forEach((tr) => body!.appendChild(tr));
        el("th-box")!.textContent = "Box";
        el("th-each")!.textContent = "Per cigar";
        el("board-sub")!.textContent = `· ${rows.length} vitolas, cheapest listing`;
        el("board-hint")!.textContent =
          "Pick a country and the board re-ranks by what a box actually costs at your door — duty, tobacco excise and VAT included.";
      }

      function apply(code: string) {
        const priced: { tr: HTMLTableRowElement; total: number; each: number }[] = [];
        for (const tr of rows) {
          const src = byslug[tr.dataset.slug || ""];
          if (!src) continue;
          let r;
          try {
            r = landedCost({
              price: src.price, currency: src.currency,
              fromCountry: src.from, toCountry: code,
              boxSize: src.boxSize, ring: src.ring, lengthMm: src.lengthMm,
              fx: data.fx,
            });
          } catch { continue; }
          priced.push({ tr, total: r.totalEur, each: r.perCigarEur });
        }
        if (!priced.length) { reset(); return; }

        priced.sort((a, b) => a.each - b.each);

        for (const { tr, total, each } of priced) {
          const box = tr.querySelector("[data-box]") as HTMLElement | null;
          const per = tr.querySelector("[data-each]") as HTMLElement | null;
          if (box) { box.textContent = "€" + Math.round(total); box.classList.add("landed-val"); }
          if (per) { per.textContent = "€" + each.toFixed(0); per.classList.add("landed-val"); }
          body!.appendChild(tr);
        }

        el("th-box")!.textContent = "At your door";
        el("th-each")!.textContent = "Per cigar";
        const name = sel!.options[sel!.selectedIndex].text.replace(/^\S+\s/, "");
        el("board-sub")!.textContent = `· ${priced.length} vitolas, delivered to ${name}`;

        // The point of the whole exercise: say plainly when the ranking moved.
        // "Moved" is measured by rank-by-value, not by list position: a row is
        // counted only if the number of rows strictly cheaper than it differs
        // between sticker and landed. Two boxes tied at EUR 7 a cigar swapping
        // seats is not movement, and counting it would make the hint a lie.
        const stickerEach = (tr: HTMLTableRowElement) => byslug[tr.dataset.slug || ""]?.stickerEachEur ?? 1e9;
        const rankBy = (vals: number[]) => vals.map((v) => vals.filter((w) => w < v - 1e-9).length);
        const sRank = rankBy(priced.map((p) => stickerEach(p.tr)));
        const lRank = rankBy(priced.map((p) => p.each));
        const moved = priced.filter((_, i) => sRank[i] !== lRank[i]).length;
        el("board-hint")!.textContent = moved > 0
          ? `Re-ranked by landed cost to ${name}. ${moved} of ${priced.length} rows are not where the sticker price put them — excise and VAT do not respect a price list.`
          : `Landed cost to ${name}. The order happens to be unchanged.`;
      }

      let saved = "";
      try { saved = localStorage.getItem("tnc:ship-to") || ""; } catch {}
      if (saved && Array.from(sel.options).some((o) => o.value === saved)) {
        sel.value = saved; apply(saved);
      }

      // First-visit nudge. Not a tour: one inline sentence pointing at the
      // one control that matters on this page, shown only to someone who has
      // neither chosen a country nor dismissed it before. Either action ends
      // it for good. Readers arrive here from Google, not from the front page,
      // so this is the only place an introduction can actually reach them.
      const nudge = el("firstvisit");
      const nudgeX = el("firstvisit-x");
      let seen = false;
      try { seen = localStorage.getItem("tnc:finder-intro") === "1"; } catch {}
      const dismissNudge = () => {
        if (nudge) nudge.hidden = true;
        try { localStorage.setItem("tnc:finder-intro", "1"); } catch {}
      };
      if (nudge && !seen && !saved) nudge.hidden = false;
      nudgeX?.addEventListener("click", dismissNudge);

      sel.addEventListener("change", () => {
        const code = sel.value;
        try { localStorage.setItem("tnc:ship-to", code); } catch {}
        if (code) { apply(code); dismissNudge(); } else reset();
      });
    }
  </script>

  <style>
    .firstvisit{position:relative;margin:0 0 10px;padding:10px 34px 10px 12px;
      border:1px solid var(--rule);border-left:3px solid var(--ox);background:var(--paper-2);
      font-size:14px;line-height:1.45;color:var(--ink-2)}
    .firstvisit b{color:var(--ink)}
    .firstvisit__x{position:absolute;top:6px;right:8px;border:0;background:none;
      font:20px/1 var(--sans,system-ui);color:var(--mute);cursor:pointer;padding:2px 6px}
    .firstvisit__x:hover{color:var(--ink)}
    .landed-bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;
      padding:10px 0 14px;border-bottom:1px solid var(--rule);margin-bottom:10px}
    .landed-bar label{font:600 13px/1 var(--sans,system-ui);letter-spacing:.06em;
      text-transform:uppercase;color:var(--mute)}
    .landed-bar select{font:inherit;font-size:15px;padding:6px 8px;
      background:var(--paper);color:var(--ink);border:1px solid var(--rule);border-radius:2px}
    .landed-bar__hint{flex:1 1 260px;font-size:13px;line-height:1.4;color:var(--mute)}
    .landed-val{color:var(--ox);font-variant-numeric:tabular-nums}
    .sig{display:inline-block;margin-left:6px;padding:1px 6px;border-radius:2px;
      font:600 10.5px/1.5 var(--sans,system-ui);letter-spacing:.04em;text-transform:uppercase;
      vertical-align:2px;border:1px solid currentColor;cursor:help}
    .sig.low{color:var(--live)}
    .sig.high{color:var(--ox)}
    /* Bell on every row: the free alert, where the reader is already looking */
    .bell{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;margin:4px 0 0;padding:0;border:1px solid var(--rule-2,#D9D5CC);border-radius:50%;background:transparent;color:var(--mute);cursor:pointer;vertical-align:middle}
    .bell:hover{color:var(--ox);border-color:var(--ox)}
    tr.oos .bell{color:var(--ox);border-color:var(--ox)}
    @media (max-width:560px){.bell{width:32px;height:32px}}
    @media (max-width:600px){
      .landed-bar{gap:8px}
      .landed-bar select{flex:1 1 100%}
    }
  </style>
  <PriceAlertModal />
  <script>
    // Row bells dispatch the same event the vitola page's Save-alert button does.
    document.querySelectorAll<HTMLButtonElement>("[data-save-alert]").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.dispatchEvent(new CustomEvent("open-price-alert", { detail: {
          sku: btn.dataset.sku, productName: btn.dataset.productName,
          baselineEur: Number(btn.dataset.baselineEur) || null, baselineLabel: btn.dataset.baselineLabel || null,
        } }));
      });
    });
  </script>
</PaperLayout>
