<script>
  import { matchKnownBrand, TRACKED_BRAND_NAMES, KNOWN_BRANDS, SKUS } from "../../data/finder-data";

  // Finder search — client-side filter for the SKU catalog table.
  // No API calls, no spinner: every needed datum is already on the row as a
  // data-* attribute (brand, name, countries, in-stock countries). We just
  // walk the rows and flip `hidden` based on the current filter state.
  (function initFinderSearch() {
    const input    = document.getElementById("finder-search-input") as HTMLInputElement | null;
    const country  = document.getElementById("finder-search-country") as HTMLSelectElement | null;
    const instock  = document.getElementById("finder-search-instock") as HTMLInputElement | null;
    const wrap     = document.querySelector<HTMLElement>(".finder-search");
    const clearBtn = document.querySelector<HTMLButtonElement>("[data-finder-clear]");
    const resetBtn = document.querySelector<HTMLButtonElement>("[data-finder-reset]");
    const empty    = document.querySelector<HTMLElement>("[data-finder-empty]");
    const count    = document.querySelector<HTMLElement>("[data-finder-count]");
    const rows     = Array.from(
      document.querySelectorAll<HTMLTableRowElement>("tr[data-finder-sku-row]")
    );
    const chips    = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-brand-chip]")
    );
    if (!input || !country || !instock || rows.length === 0) return;

    let activeBrand = ""; // empty = "all brands"

    function applyFilter() {
      const q          = input.value.trim().toLowerCase();
      const wantCty    = country.value;       // "" or country code
      const wantStock  = instock.checked;
      let visible      = 0;

      for (const row of rows) {
        const name       = row.dataset.skuName || "";
        const brand      = row.dataset.skuBrand || "";
        const cties      = (row.dataset.skuCountries || "").split(",");
        const stockCties = (row.dataset.skuInstockCountries || "").split(",");
        const anyInStock = row.dataset.skuAnyInstock === "1";

        // Free-text match — token-level so "petit edmundo" still matches even
        // if the user typed it out of order. Empty query passes.
        const tokens = q.split(/\s+/).filter(Boolean);
        const textOk = tokens.every((t) => name.includes(t));

        // Brand chip — empty matches everything.
        const brandOk = !activeBrand || brand === activeBrand;

        // Country — if a country is chosen, the SKU must have at least one
        // snapshot from that country (or, if in-stock toggled, an in-stock one).
        let countryOk = true;
        if (wantCty) {
          countryOk = wantStock
            ? stockCties.includes(wantCty)
            : cties.includes(wantCty);
        }

        // In-stock toggle without a country picks any in-stock SKU globally.
        const stockOk = !wantStock || (wantCty ? stockCties.includes(wantCty) : anyInStock);

        const show = textOk && brandOk && countryOk && stockOk;
        if (show) visible++;
        row.toggleAttribute("hidden", !show);
      }

      // Visible state UI
      if (wrap) wrap.classList.toggle("has-text", q.length > 0);
      if (empty) empty.toggleAttribute("hidden", visible !== 0);

      // ─── Brand-aware empty state ─────────────────────────────────────────
      // When the user's query matches a brand we recognise but don't track
      // (e.g. "Juan Lopez", "Davidoff"), swap the generic 'no matches'
      // message for a brand-specific one. Distinguishes "we know that brand
      // but haven't onboarded it" from "we don't know what you typed".
      if (empty && visible === 0 && q.length >= 2) {
        const matched = matchKnownBrand(q);
        const defaultEl = empty.querySelector<HTMLElement>("[data-empty-default]");
        const brandEl   = empty.querySelector<HTMLElement>("[data-empty-brand]");
        const eyebrowEl = empty.querySelector<HTMLElement>("[data-empty-brand-eyebrow]");
        const nameEl    = empty.querySelector<HTMLElement>("[data-empty-brand-name]");
        const noteEl    = empty.querySelector<HTMLElement>("[data-empty-brand-note]");
        // Don't surface the brand UI if the brand IS one we track —
        // that means the filter is on but the country/stock toggle is the
        // reason for zero hits, not the brand itself.
        const isTracked = matched && TRACKED_BRAND_NAMES.has(matched.name);
        if (matched && !isTracked && defaultEl && brandEl && eyebrowEl && nameEl && noteEl) {
          // Origin → human label
          const originLabel: Record<string, string> = {
            cuba: "Cuban Habano",
            dominican: "Dominican premium",
            nicaragua: "Nicaraguan premium",
            honduras: "Honduran premium",
            spain: "Spanish premium",
            other: "International premium",
          };
          eyebrowEl.textContent = `${originLabel[matched.origin] || "Premium cigar"} · Not yet tracked`;
          nameEl.textContent = matched.name;
          // Default note copy varies by origin (Cuban: 'on the shortlist',
          // non-Cuban: 'we focus on Cuban' — manages expectations honestly).
          const defaultNote = matched.origin === "cuba"
            ? "We launched with the 12 most-traded Cuban premium SKUs. This brand is on the shortlist — we're expanding the catalogue monthly."
            : "The Finder focuses on Cuban (Habanos) cigars at launch. We may expand to other origins later — for now, this brand isn't in scope.";
          noteEl.textContent = matched.shortNote
            ? `${matched.shortNote} ${defaultNote}`
            : defaultNote;
          defaultEl.hidden = true;
          brandEl.hidden = false;
        } else if (defaultEl && brandEl) {
          defaultEl.hidden = false;
          brandEl.hidden = true;
        }
      }

      if (count) {
        if (visible === 0) {
          count.textContent = "No cigars match those filters.";
        } else if (visible === rows.length && !q && !wantCty && !wantStock && !activeBrand) {
          count.textContent = `Showing all ${rows.length} cigars`;
        } else {
          count.textContent =
            `Showing ${visible} of ${rows.length} cigar${rows.length === 1 ? "" : "s"}` +
            (q ? ` matching "${input.value.trim()}"` : "");
        }
      }
    }

    // ─ Input handlers ─────────────────────────────────────────────────────
    input.addEventListener("input", applyFilter);
    country.addEventListener("change", applyFilter);
    instock.addEventListener("change", applyFilter);

    clearBtn?.addEventListener("click", () => {
      input.value = "";
      input.focus();
      applyFilter();
    });

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        activeBrand = chip.dataset.brandChip || "";
        chips.forEach((c) => c.classList.remove("is-active"));
        chip.classList.add("is-active");
        applyFilter();
      });
    });

    resetBtn?.addEventListener("click", () => {
      input.value     = "";
      country.value   = "";
      instock.checked = false;
      activeBrand     = "";
      chips.forEach((c, i) => c.classList.toggle("is-active", i === 0));
      applyFilter();
    });

    // ─ Persist filter state across page navigations via URL hash ──────────
    // /finder/#q=cohiba&brand=Cohiba&cty=de — share a filtered view, restore
    // on back/forward, deep-link from a blog post.
    function readFromHash() {
      const hash = window.location.hash.replace(/^#/, "");
      if (!hash) return false;
      const p = new URLSearchParams(hash);
      let used = false;
      if (p.has("q"))     { input.value     = p.get("q")    || ""; used = true; }
      if (p.has("cty"))   { country.value   = p.get("cty")  || ""; used = true; }
      if (p.has("stock")) { instock.checked = p.get("stock") === "1"; used = true; }
      if (p.has("brand")) {
        const b = p.get("brand") || "";
        activeBrand = b;
        chips.forEach((c) => c.classList.toggle("is-active", (c.dataset.brandChip || "") === b));
        used = true;
      }
      return used;
    }
    function writeToHash() {
      const p = new URLSearchParams();
      if (input.value.trim()) p.set("q", input.value.trim());
      if (country.value)      p.set("cty", country.value);
      if (instock.checked)    p.set("stock", "1");
      if (activeBrand)        p.set("brand", activeBrand);
      const s = p.toString();
      const newHash = s ? "#" + s : "";
      if (window.location.hash !== newHash) {
        // Replace, don't push — typing is too granular for back-button history.
        history.replaceState(null, "", window.location.pathname + window.location.search + newHash);
      }
    }
    let writeTimer: ReturnType<typeof setTimeout> | null = null;
    function debouncedWrite() {
      if (writeTimer) clearTimeout(writeTimer);
      writeTimer = setTimeout(writeToHash, 250);
    }
    input.addEventListener("input", debouncedWrite);
    country.addEventListener("change", debouncedWrite);
    instock.addEventListener("change", debouncedWrite);
    chips.forEach((chip) => chip.addEventListener("click", debouncedWrite));

    // ─── Autocomplete dropdown ────────────────────────────────────────────
    // Two suggestion sources:
    //   1. Tracked SKUs whose brand/vitola/shape matches the query — these
    //      get a green "TRACKED" tag and click → /finder/sku/{slug}/
    //   2. Known brands we recognise but don't track yet — gold "REQUEST"
    //      tag; click fills the input so the smart empty state fires.
    const ac = document.querySelector<HTMLElement>("[data-finder-ac]");
    let acActive = -1;
    let acItems: HTMLElement[] = [];

    function escapeHtmlAc(s: string): string {
      return s.replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
    }
    function highlight(text: string, q: string): string {
      if (!q) return escapeHtmlAc(text);
      const i = text.toLowerCase().indexOf(q.toLowerCase());
      if (i < 0) return escapeHtmlAc(text);
      return escapeHtmlAc(text.slice(0, i)) +
        "<mark>" + escapeHtmlAc(text.slice(i, i + q.length)) + "</mark>" +
        escapeHtmlAc(text.slice(i + q.length));
    }

    function buildSuggestions(q: string): string {
      const ql = q.trim().toLowerCase();
      if (ql.length < 1) return "";

      // Tracked SKUs — match against brand + vitola + shape + line.
      type AcSku = { sku: typeof SKUS[number]; haystack: string };
      const trackedHits: AcSku[] = SKUS.map((sku) => ({
        sku,
        haystack: `${sku.brand} ${sku.vitola} ${sku.shape} ${sku.line}`.toLowerCase(),
      })).filter((x) => x.haystack.includes(ql)).slice(0, 6);

      // Known untracked brands — exclude ones we already track.
      const brandHits = KNOWN_BRANDS.filter((b) => {
        if (TRACKED_BRAND_NAMES.has(b.name)) return false;
        const aliasMatch = b.aliases.some((a) => a.includes(ql) || ql.includes(a));
        return aliasMatch || b.name.toLowerCase().includes(ql);
      }).slice(0, 4);

      if (trackedHits.length === 0 && brandHits.length === 0) return "";

      const originLabel: Record<string, string> = {
        cuba: "Cuban", dominican: "Dominican", nicaragua: "Nicaraguan",
        honduras: "Honduran", spain: "Spanish", other: "International",
      };

      const parts: string[] = [];
      if (trackedHits.length > 0) {
        parts.push(`<div class="finder-search__ac-section-label">In our catalogue</div>`);
        for (let i = 0; i < trackedHits.length; i++) {
          const { sku } = trackedHits[i];
          parts.push(
            `<a class="finder-search__ac-item" role="option" href="/finder/sku/${sku.slug}/" data-ac-index="${i}">
               <span class="finder-search__ac-item-label">
                 <span class="finder-search__ac-item-title">${highlight(`${sku.brand} ${sku.vitola}`, q)}</span>
                 <span class="finder-search__ac-item-meta">${escapeHtmlAc(sku.shape)} · ring ${sku.ring} · box ${sku.boxSize}</span>
               </span>
               <span class="finder-search__ac-item-tag finder-search__ac-item-tag--tracked">Tracked</span>
             </a>`
          );
        }
      }
      if (brandHits.length > 0) {
        parts.push(`<div class="finder-search__ac-section-label">Other premium brands</div>`);
        const baseIdx = trackedHits.length;
        for (let i = 0; i < brandHits.length; i++) {
          const b = brandHits[i];
          parts.push(
            `<button type="button" class="finder-search__ac-item" role="option" data-ac-brand="${escapeHtmlAc(b.name)}" data-ac-index="${baseIdx + i}">
               <span class="finder-search__ac-item-label">
                 <span class="finder-search__ac-item-title">${highlight(b.name, q)}</span>
                 <span class="finder-search__ac-item-meta">${originLabel[b.origin] || "Premium"} · not yet in catalogue</span>
               </span>
               <span class="finder-search__ac-item-tag finder-search__ac-item-tag--untracked">Request</span>
             </button>`
          );
        }
      }
      return parts.join("");
    }

    function updateAutocomplete() {
      if (!ac) return;
      const html = buildSuggestions(input.value);
      if (!html) {
        ac.hidden = true;
        ac.innerHTML = "";
        acItems = [];
        acActive = -1;
        return;
      }
      ac.innerHTML = html;
      ac.hidden = false;
      acItems = Array.from(ac.querySelectorAll<HTMLElement>("[data-ac-index]"));
      acActive = -1;
      // Click a brand suggestion → fill input with brand name so the smart
      // empty state fires + filter narrows. SKU suggestions are <a href>
      // and navigate naturally without preventDefault.
      acItems.forEach((item) => {
        const brandName = item.getAttribute("data-ac-brand");
        if (brandName) {
          item.addEventListener("click", () => {
            input.value = brandName;
            ac.hidden = true;
            applyFilter();
            input.focus();
          });
        }
      });
    }

    function moveAcActive(delta: number) {
      if (acItems.length === 0) return;
      acActive = (acActive + delta + acItems.length) % acItems.length;
      acItems.forEach((it, i) => it.classList.toggle("is-active", i === acActive));
      acItems[acActive]?.scrollIntoView({ block: "nearest" });
    }

    input.addEventListener("input", updateAutocomplete);
    input.addEventListener("focus", updateAutocomplete);
    input.addEventListener("keydown", (e) => {
      if (!ac || ac.hidden) return;
      if (e.key === "ArrowDown") { e.preventDefault(); moveAcActive(1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); moveAcActive(-1); }
      else if (e.key === "Enter" && acActive >= 0) {
        e.preventDefault();
        acItems[acActive]?.click();
      } else if (e.key === "Escape") {
        ac.hidden = true;
      }
    });
    // Hide on outside click.
    document.addEventListener("click", (e) => {
      if (!ac) return;
      const wrapEl = input.closest(".finder-search__input-wrap");
      if (wrapEl && !wrapEl.contains(e.target as Node)) ac.hidden = true;
    });
    // Hide when filter is reset.
    resetBtn?.addEventListener("click", () => { if (ac) ac.hidden = true; });
    clearBtn?.addEventListener("click", () => { if (ac) ac.hidden = true; });

    // ─ Init ──────────────────────────────────────────────────────────────
    if (readFromHash()) applyFilter();
  })();
</script>
