  }
  .finder-search__instock input { accent-color: var(--color-gold); }
  .finder-search__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }
  .finder-search__chip {
    padding: 0.32rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: #fafafa;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-soft);
    cursor: pointer;
    transition: all 0.12s ease;
    white-space: nowrap;
  }
  .finder-search__chip:hover {
    border-color: var(--color-gold);
    color: var(--color-text);
  }
  .finder-search__chip.is-active {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: #1a1612;
    font-weight: 700;
  }
  .finder-search__count {
    margin: 0.85rem 0 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
  .finder-search__empty {
    padding: 2.5rem 1.5rem;
    text-align: center;
    color: var(--color-text-soft);
    font-size: 0.95rem;
  }
  .finder-search__empty p { margin: 0 0 0.5rem; }
  .finder-search__empty-reset {
    background: transparent;
    border: 0;
    color: var(--color-gold-hover);
    cursor: pointer;
    text-decoration: underline;
    font: inherit;
    padding: 0;
  }
  .finder-search__empty-reset:hover { color: var(--color-text); }
  /* Rows hidden by filter — kept in DOM for SEO + state, just visually removed. */
  tr[data-finder-sku-row][hidden] { display: none !important; }
</style>

<script>
  // Finder search — client-side filter for the SKU catalog table.
  // No API calls, no spinner: every needed datum is already on the row as a
  // data-* attribute (brand, name, countries, in-stock countries). We just
  // walk the rows and flip `hidden` based on the current filter state.
  (function initFinderSearch() {
    const input    = document.getElementById("finder-search-input") as HTMLInputElement | null;
    const country  = document.getElementById("finder-search-country") as HTMLSelectElement | null;
    const instock  = document.getElementById("finder-search-instock") as HTMLInputElement | null;
    const wrap     = document.querySelector<HTMLElement>(".finder-search");
    const clearBtn = document.querySelector<HTMLButtonElement>("[data-finder-clear]");
    const resetBtn = document.querySelector<HTMLButtonElement>("[data-finder-reset]");
    const empty    = document.querySelector<HTMLElement>("[data-finder-empty]");
    const count    = document.querySelector<HTMLElement>("[data-finder-count]");
    const rows     = Array.from(
      document.querySelectorAll<HTMLTableRowElement>("tr[data-finder-sku-row]")
    );
    const chips    = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-brand-chip]")
    );
    if (!input || !country || !instock || rows.length === 0) return;

    let activeBrand = ""; // empty = "all brands"

    function applyFilter() {
      const q          = input.value.trim().toLowerCase();
      const wantCty    = country.value;       // "" or country code
      const wantStock  = instock.checked;
      let visible      = 0;

      for (const row of rows) {
        const name       = row.dataset.skuName || "";
        const brand      = row.dataset.skuBrand || "";
        const cties      = (row.dataset.skuCountries || "").split(",");
        const stockCties = (row.dataset.skuInstockCountries || "").split(",");
        const anyInStock = row.dataset.skuAnyInstock === "1";

        // Free-text match — token-level so "petit edmundo" still matches even
        // if the user typed it out of order. Empty query passes.
        const tokens = q.split(/\s+/).filter(Boolean);
        const textOk = tokens.every((t) => name.includes(t));

        // Brand chip — empty matches everything.
        const brandOk = !activeBrand || brand === activeBrand;

        // Country — if a country is chosen, the SKU must have at least one
        // snapshot from that country (or, if in-stock toggled, an in-stock one).
        let countryOk = true;
        if (wantCty) {
          countryOk = wantStock
            ? stockCties.includes(wantCty)
            : cties.includes(wantCty);
        }

        // In-stock toggle without a country picks any in-stock SKU globally.
        const stockOk = !wantStock || (wantCty ? stockCties.includes(wantCty) : anyInStock);

        const show = textOk && brandOk && countryOk && stockOk;
        if (show) visible++;
        row.toggleAttribute("hidden", !show);
      }

      // Visible state UI
      if (wrap) wrap.classList.toggle("has-text", q.length > 0);
      if (empty) empty.toggleAttribute("hidden", visible !== 0);
      if (count) {
        if (visible === 0) {
          count.textContent = "No cigars match those filters.";
        } else if (visible === rows.length && !q && !wantCty && !wantStock && !activeBrand) {
          count.textContent = `Showing all ${rows.length} cigars`;
        } else {
          count.textContent =
            `Showing ${visible} of ${rows.length} cigar${rows.length === 1 ? "" : "s"}` +
            (q ? ` matching "${input.value.trim()}"` : "");
        }
      }
    }

    // ─ Input handlers ─────────────────────────────────────────────────────
    input.addEventListener("input", applyFilter);
    country.addEventListener("change", applyFilter);
    instock.addEventListener("change", applyFilter);

    clearBtn?.addEventListener("click", () => {
      input.value = "";
      input.focus();
      applyFilter();
    });

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        activeBrand = chip.dataset.brandChip || "";
        chips.forEach((c) => c.classList.remove("is-active"));
        chip.classList.add("is-active");
        applyFilter();
      });
    });

    resetBtn?.addEventListener("click", () => {
      input.value     = "";
      country.value   = "";
      instock.checked = false;
      activeBrand     = "";
      chips.forEach((c, i) => c.classList.toggle("is-active", i === 0));
      applyFilter();
    });

    // ─ Persist filter state across page navigations via URL hash ──────────
    // /finder/#q=cohiba&brand=Cohiba&cty=de — share a filtered view, restore
    // on back/forward, deep-link from a blog post.
    function readFromHash() {
      const hash = window.location.hash.replace(/^#/, "");
      if (!hash) return false;
      const p = new URLSearchParams(hash);
      let used = false;
      if (p.has("q"))     { input.value     = p.get("q")    || ""; used = true; }
      if (p.has("cty"))   { country.value   = p.get("cty")  || ""; used = true; }
      if (p.has("stock")) { instock.checked = p.get("stock") === "1"; used = true; }
      if (p.has("brand")) {
        const b = p.get("brand") || "";
        activeBrand = b;
        chips.forEach((c) => c.classList.toggle("is-active", (c.dataset.brandChip || "") === b));
        used = true;
      }
      return used;
    }
    function writeToHash() {
      const p = new URLSearchParams();
      if (input.value.trim()) p.set("q", input.value.trim());
      if (country.value)      p.set("cty", country.value);
      if (instock.checked)    p.set("stock", "1");
      if (activeBrand)        p.set("brand", activeBrand);
      const s = p.toString();
      const newHash = s ? "#" + s : "";
      if (window.location.hash !== newHash) {
        // Replace, don't push — typing is too granular for back-button history.
        history.replaceState(null, "", window.location.pathname + window.location.search + newHash);
      }
    }
    let writeTimer: ReturnType<typeof setTimeout> | null = null;
    function debouncedWrite() {
      if (writeTimer) clearTimeout(writeTimer);
      writeTimer = setTimeout(writeToHash, 250);
    }
    input.addEventListener("input", debouncedWrite);
    country.addEventListener("change", debouncedWrite);
    instock.addEventListener("change", debouncedWrite);
    chips.forEach((chip) => chip.addEventListener("click", debouncedWrite));

    // ─ Init ──────────────────────────────────────────────────────────────
    if (readFromHash()) applyFilter();
  })();
</script>
