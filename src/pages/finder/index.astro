    min-width: 9.5rem;
  }
  .finder-search__instock {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 0.9rem;
    background: #fafafa;
    border: 1px solid var(--color-border);
