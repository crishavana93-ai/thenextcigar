---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/newspaper.css";
import CigarCursor from "../components/newspaper/CigarCursor.astro";
import NewspaperMasthead from "../components/newspaper/NewspaperMasthead.astro";
import SectionFlag from "../components/newspaper/SectionFlag.astro";
import { MASTHEAD as masthead } from "";


---

<BaseLayout
  title="Contact — The Next Cigar"
  description="Get in touch with the editorial desk."
  bareChrome={true}
>
  <link is:inline href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <div class="tnc-cinema">
    <CigarCursor />

    <main class="site-body">
      <NewspaperMasthead {...masthead} />

      <SectionFlag
        number="/06"
        section="Contact"
        title={`Reach the <em>desk.</em>`}
        status="Malmö · Lisbon · Response within 48h"
      />

      <section class="contact-wrap">
        <div class="contact-lead">
          <p class="lead-eyebrow">The inbox is open</p>
          <h1>Story tips, brand pitches, corrections, and hellos.</h1>
          <p class="standfirst">
            We read everything. Editorial desk answers within 48 hours during weekdays. If it's urgent — press deadline, factory tour opportunity, breaking regulatory news — mark the subject <em>URGENT</em>.
          </p>
        </div>

        <div class="contact-grid">
          <div class="contact-col">
            <div class="col-flag oxblood">Editorial</div>
            <h3>Story tips &amp; corrections</h3>
            <p>Got a tip on an upcoming release, a factory you want covered, an event we should send someone to? A correction on something we've published? We read every tip.</p>
            <a href="mailto:contact@thenextcigar.com?subject=Story%20tip" class="contact-cta" data-hover>contact@thenextcigar.com →</a>
          </div>

          <div class="contact-col">
            <div class="col-flag">Business</div>
            <h3>Sponsorship &amp; partnerships</h3>
            <p>We accept sponsorship on labelled placements only, from products we'd carry ourselves. Rate card on request. No paid links, no press releases published as posts.</p>
            <a href="mailto:contact@thenextcigar.com?subject=Sponsorship" class="contact-cta" data-hover>contact@thenextcigar.com →</a>
          </div>

          <div class="contact-col">
            <div class="col-flag pine">Retailers</div>
            <h3>Add your shop to the Finder</h3>
            <p>Cuban-cigar retailer in Europe with a public website that lists prices in a machine-readable format? We'd like to add you. Zero fee. Live traffic in return.</p>
            <a href="mailto:contact@thenextcigar.com?subject=Retailer%20listing" class="contact-cta" data-hover>contact@thenextcigar.com →</a>
          </div>

          <div class="contact-col">
            <div class="col-flag mahogany">Shop &amp; Guatabey</div>
            <h3>Fabric, hardware, orders</h3>
            <p>Supplier of guayabera-grade linen, humidor hardware, cedar tubes, or an artisan whose ashtray we should stock? Wholesale-quantity questions.</p>
            <a href="mailto:contact@thenextcigar.com?subject=Shop%20supplier" class="contact-cta" data-hover>contact@thenextcigar.com →</a>
          </div>
        </div>

        <div class="contact-ornament">◆ ◆ ◆</div>

        <div class="contact-post">
          <div class="col-flag">Post</div>
          <p>
            <strong>The Next Cigar</strong><br/>
            c/o Cristian Ortiz Suárez<br/>
            Malmö, Sweden · Lisboa, Portugal
          </p>
        </div>
      </section>

      <section class="footer-strip">
        <div class="footer-strip-inner">
          <div>
            <a href="/" class="footer-strip-mark" data-hover>The Next Cigar</a>
            <div class="footer-strip-tag">The Anthology of the Leaf &middot; Malmö · Lisbon</div>
          </div>
          <div class="footer-strip-links">
            <a href="/finder/" data-hover>Finder</a>
            <a href="/lounge/" data-hover>Lounge</a>
            <a href="/blog/" data-hover>Magazine</a>
            <a href="/shop/" data-hover>Shop</a>
            <a href="/about/" data-hover>About</a>
            <a href="/contact/" data-hover>Contact</a>
          </div>
        </div>
        <div class="footer-strip-copy">© 2025–2026 The Next Cigar · Cristian Ortiz Suárez</div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .site-body { padding-bottom: 40px; }
  .contact-wrap { max-width: 1200px; margin: 0 auto; padding: 48px 40px 80px; }
  .contact-lead { max-width: 780px; margin: 0 auto 48px; text-align: left; }
  .contact-lead .lead-eyebrow {
    font-family: var(--news-mono); font-size: 11px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--news-oxblood); margin-bottom: 20px;
    display: flex; align-items: center; gap: 12px;
  }
  .contact-lead .lead-eyebrow::before {
    content: ""; width: 32px; height: 1px; background: var(--news-oxblood);
  }
  .contact-lead h1 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(2rem, 4vw, 3.6rem); line-height: 1.02;
    letter-spacing: -0.028em; color: var(--news-ink); margin: 0 0 24px;
  }
  .contact-lead .standfirst {
    font-family: var(--news-serif); font-style: italic;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem); line-height: 1.55;
    color: var(--news-ink-soft); margin: 0;
    padding-bottom: 24px; border-bottom: 1px solid var(--news-rule);
  }
  .contact-lead .standfirst em { color: var(--news-oxblood); font-style: italic; font-weight: 500; }

  .contact-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px;
    margin-top: 40px;
  }
  .contact-col {
    padding: 28px 28px 32px;
    border: 1px solid var(--news-ink);
    background: var(--news-paper);
    display: flex; flex-direction: column;
  }
  .col-flag {
    display: inline-block; align-self: flex-start;
    font-family: var(--news-sans); font-size: 9px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    background: var(--news-ink); color: var(--news-paper);
    padding: 4px 10px; margin-bottom: 14px;
  }
  .col-flag.oxblood { background: var(--news-oxblood); }
  .col-flag.pine { background: var(--news-pine); }
  .col-flag.mahogany { background: var(--news-mahogany); }
  .contact-col h3 {
    font-family: var(--news-serif); font-weight: 500;
    font-size: clamp(1.2rem, 1.8vw, 1.5rem); line-height: 1.15;
    letter-spacing: -0.014em; color: var(--news-ink); margin: 0 0 12px;
  }
  .contact-col p {
    font-family: var(--news-serif); font-size: 15px; line-height: 1.55;
    color: var(--news-ink-soft); margin: 0 0 20px; flex: 1;
  }
  .contact-cta {
    font-family: var(--news-mono); font-size: 12px; letter-spacing: 0.12em;
    text-transform: lowercase; color: var(--news-oxblood);
    border-bottom: 1px solid var(--news-oxblood); padding-bottom: 3px;
    align-self: flex-start;
  }
  .contact-cta:hover { color: var(--news-ember); border-bottom-color: var(--news-ember); }

  .contact-ornament {
    text-align: center; margin: 56px 0 32px;
    font-family: var(--news-serif); font-size: 16px; letter-spacing: 0.5em;
    color: var(--news-oxblood);
  }

  .contact-post {
    max-width: 400px; margin: 0 auto; text-align: left;
    padding-top: 24px; border-top: 1px solid var(--news-rule);
  }
  .contact-post p {
    font-family: var(--news-serif); font-size: 15px; line-height: 1.6;
    color: var(--news-ink-soft); margin: 12px 0 0;
  }
  .contact-post strong { color: var(--news-ink); font-weight: 600; }

  .footer-strip { max-width: 1520px; margin: 0 auto; padding: 40px 40px 24px; }
  .footer-strip-inner {
    display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center;
    padding-bottom: 20px; border-bottom: 1px solid var(--news-rule);
  }
  .footer-strip-mark { font-family: var(--news-serif); font-weight: 600; font-size: 22px; letter-spacing: -0.008em; color: var(--news-ink); display: block; }
  .footer-strip-tag { font-family: var(--news-serif); font-style: italic; font-size: 13px; color: var(--news-ink-mute); margin-top: 2px; }
  .footer-strip-links { display: flex; gap: 24px; flex-wrap: wrap; font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--news-ink-mute); }
  .footer-strip-links a { padding: 4px 0; border-bottom: 1px solid transparent; transition: all 0.2s; }
  .footer-strip-links a:hover { color: var(--news-oxblood); border-bottom-color: var(--news-oxblood); }
  .footer-strip-copy { margin-top: 16px; font-family: var(--news-mono); font-size: 10px; letter-spacing: 0.16em; color: var(--news-ink-mute); }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-wrap, .footer-strip { padding: 32px 20px; }
    .footer-strip-inner { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
