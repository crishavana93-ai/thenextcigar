# ─── Supabase (The Lounge — required) ──────────────────────────────────────
# Get these from Supabase Dashboard → Settings → API.
# PUBLIC_ prefix is required so Astro exposes them to the browser.
# Both are safe to expose; the anon key is rate-limited and protected by RLS.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_jwt_here

# ─── Snipcart (Shop — already in use) ───────────────────────────────────────
PUBLIC_SNIPCART_API_KEY=YOUR_PUBLIC_API_KEY

# ─── Optional: Mailerlite (used by NotifyMeForm) ────────────────────────────
# Already loaded inline in BaseLayout.astro; account ID 2332920

# ─── Supabase service-role (SERVER-ONLY; never expose to browser) ──────────
# Required by Cloudflare Pages Functions like /api/watchlist/save so they can
# write rows on behalf of anonymous email-capture users (bypasses RLS).
# Set this in Cloudflare Pages → Settings → Environment variables (Production).
# Get it from Supabase Dashboard → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_jwt_here

# ─── Scraper admin token (SERVER-ONLY, manual-trigger only) ────────────────
# Required by /api/scraper/[retailer] Pages Functions to authorize manual
# scrape triggers during development. Generate via: openssl rand -hex 32
# Set in Cloudflare Pages -> Settings -> Environment variables (Production).
SCRAPER_ADMIN_TOKEN=set_a_secret_here
