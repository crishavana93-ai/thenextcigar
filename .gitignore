# build output
dist/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Migration intermediate files (already in migration/.gitignore but belt-and-suspenders)
migration/dump/
migration/.env

# Large media — never commit these directly to git
The Next Cigar photos/
*.mp4
*.mov
*.avi
*.zip
*.dmg

# Cinematic assets are intentional deployment payloads — must be tracked.
# Add exceptions here for anything under public/cinematic/ so they escape
# the blanket *.mp4 / *.mov rules above.
!public/cinematic/*.mp4
!public/cinematic/*.mov
!public/cinematic/*.webm

# Astro FUSE / linter transient temp files
.fuse_hidden*
src/**/.fuse_hidden*

# CMS uploads stay tracked (they're how the editor saves images)
!public/uploads/
outreach/

# Gemini / AI source files dropped at project root — not for production
Gemini_Generated_Image_*.png
/5.png
